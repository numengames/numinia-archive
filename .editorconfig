#
# Shared editor settings (STD-015 DEV-003): what the repository already does,
# written down so every editor does it too. https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown; keep them.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
