---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
import Layout from "@/layouts/Layout.astro";
import { placeOf } from "@/lib/classification";
// The drawer this index opens, from the scheme: "Assurance · Observing".
const here = placeOf("missions/")!;
import Icon from "@/components/Icon.astro";
import PageHero from "@/components/PageHero.astro";
import { getCollection } from "astro:content";
import { useT } from "@/i18n/ui";
const t = useT();

const HUMAN_COST: Record<string, number> = { XS: 130, S: 520, M: 1560, L: 3900, XL: 7800 };
const COMPUTE_MOCK: Record<string, number> = { XS: 0.5, S: 1.5, M: 4, L: 10, XL: 25 };

const PRIORITY_COLOR: Record<string, string> = {
  critical: "bg-red/10 text-red",
  high: "bg-accent/10 text-accent",
  medium: "bg-yellow/10 text-yellow",
  low: "bg-green/10 text-green",
};
// Priority reads as a colored dot; type as a house Phosphor glyph (§7.3).
const PRIORITY_DOT: Record<string, string> = {
  critical: "bg-red",
  high: "bg-yellow",
  medium: "bg-accent",
  low: "bg-green",
};
const TYPE_ICON: Record<string, string> = { biological: "dna", digital: "robot", hybrid: "git-branch" };

// MIS-133 (was MIS-115b) — priority as TEXT, in level 3. The left border carries the same
// datum as colour, and never alone: WCAG AA is a project standard, and a
// greyscale print loses colour entirely. Colour reinforces, text states.
const PRIORITY_TEXT: Record<string, string> = {
  critical: "text-red",
  high: "text-yellow",
  medium: "text-dim",
  low: "text-dim",
};
// The left border. Same four values, same meaning, redundant on purpose.
const PRIORITY_BORDER: Record<string, string> = {
  critical: "border-l-red",
  high: "border-l-yellow",
  medium: "border-l-border",
  low: "border-l-border",
};

const STATUS_COLOR: Record<string, string> = {
  // Motion: Design System v5.1.0 §10.1-04 "Elevación" — 120ms, hover of
  // surfaces, WITHOUT displacement. Not invented: it is the catalogue entry for
  // exactly this case, and the catalogue is closed at fourteen. The global
  // prefers-reduced-motion rule (§892) already collapses it to 0.001ms.
  "todo": "border-border bg-card hover:bg-card-hover transition-colors duration-[120ms]",
  "in-progress": "border-accent/20 bg-accent/5 hover:bg-accent/10 transition-colors duration-[120ms]",
  "in-review": "border-yellow/20 bg-yellow/5 hover:bg-yellow/10 transition-colors duration-[120ms]",
  "done": "border-green/20 bg-green/5 hover:bg-green/10 transition-colors duration-[120ms]",
};
const STATUS_ID_COLOR: Record<string, string> = {
  "todo": "text-dim",
  "in-progress": "text-accent",
  "in-review": "text-yellow",
  "done": "text-green",
};

const entries = await getCollection("missions");
const missions = entries
  .map((e) => {
    const f = e.data as Record<string, any>;
    const effort = ["XS", "S", "M", "L", "XL"].includes((f.effort || "").toUpperCase())
      ? (f.effort as string).toUpperCase()
      : "M";
    // `todo` is the status STD-001 §9 declares for a mission nobody has picked
    // up; `backlog` is the retired spelling that 50 documents still carry and
    // HDR-004 flags. The board renders one column for both, labelled by the
    // standard's word, so a conformant mission is visible instead of having to
    // choose between obeying STD-001 and appearing here at all.
    // `draft` rides along too; ordering is the frontend's concern (MIS-066).
    const RETIRED_TO_TODO = { draft: "todo", backlog: "todo" };
    const status = (RETIRED_TO_TODO[f.status as string] || f.status) as string;
    const type = (f.type_execution || "hybrid") as string;
    return {
      id: (f.id as string).toUpperCase(),
      title: f.title as string,
      status,
      priority: (f.priority as string) || "medium",
      effort,
      guild: (f.guild as string) || "—",
      assignedTo: f.assigned_to && f.assigned_to !== "null" ? (f.assigned_to as string) : null,
      type,
      // MIS-132 (was MIS-115a) — the dates the board sorts by, and shows. Trimmed to a day:
      // frontmatter carries both "2026-08-25" and "2026-04-07T19:43:00Z".
      updated: typeof f.updated === "string" ? f.updated.slice(0, 10) : null,
      completed: typeof f.completed === "string" ? f.completed.slice(0, 10) : null,
      humanCostEur: HUMAN_COST[effort],
      computeCostEur: type === "biological" ? null : COMPUTE_MOCK[effort],
    };
  });

// MIS-132 (was MIS-115a) — group order by operability, and the sort inside each group.
//
// WAS: columns ran backlog → in-progress → in-review → done, and every group
// sorted by `a.id.localeCompare(b.id)` — creation order wearing a numeric
// disguise, in which MIS-011 outranks MIS-110 forever regardless of what
// happened to either.
//
// The order below is what a reader needs first: what is moving, then what is
// waiting on someone, then what is available, then what shipped.
const COLUMN_ORDER = ["in-progress", "in-review", "todo", "done"];

// Backlog is the exception and sorts by PRIORITY, not by date (Oracle,
// 2026-08-25). A backlog sorted by date says which mission was WRITTEN most
// recently, which tells a reader nothing about what to pick up. Sorted by
// priority it is the queue it claims to be.
const PRIORITY_RANK: Record<string, number> = {
  critical: 0, high: 1, medium: 2, low: 3,
};

// Ties break on ID: arbitrary, and declared — the same tiebreak the selection
// draft uses. Arbitrary-and-declared beats arbitrary-and-invented.
const byId = (a: { id: string }, b: { id: string }) => a.id.localeCompare(b.id);

const newestFirst = (field: "updated" | "completed") =>
  (a: Record<string, any>, b: Record<string, any>) => {
    const x = a[field] ?? a.updated ?? "";
    const y = b[field] ?? b.updated ?? "";
    if (x === y) return byId(a as any, b as any);
    return y.localeCompare(x);           // descending: most recent first
  };

const byPriority = (a: Record<string, any>, b: Record<string, any>) => {
  const d = (PRIORITY_RANK[a.priority] ?? 9) - (PRIORITY_RANK[b.priority] ?? 9);
  return d !== 0 ? d : byId(a as any, b as any);
};

function sortForColumn(key: string, list: any[]) {
  if (key === "todo") return [...list].sort(byPriority);
  if (key === "done") return [...list].sort(newestFirst("completed"));
  return [...list].sort(newestFirst("updated"));
}

const columns = [
  { key: "in-progress", label: t("board.filter.inProgress"), accent: "text-accent", counter: "bg-accent/20" },
  { key: "in-review", label: t("board.filter.inReview"), accent: "text-yellow", counter: "bg-yellow/20" },
  { key: "todo", label: t("board.col.backlog"), accent: "text-dim", counter: "bg-border" },
  { key: "done", label: t("board.col.done"), accent: "text-green", counter: "bg-green/20" },
];
const byStatus = (key: string) => sortForColumn(key, missions.filter((m) => m.status === key));
const frozen = sortForColumn("frozen", missions.filter((m) => m.status === "frozen"));

const done = byStatus("done");
const inProg = byStatus("in-progress");
const critical = missions.filter((m) => m.priority === "critical");
const fmt = (n: number) => (n >= 1000 ? "€" + (n / 1000).toFixed(1) + "k" : "€" + Math.round(n));
const fmtSmall = (n: number) => (n < 1 ? "€" + n.toFixed(2) : "€" + n.toFixed(1));

// MIS-115 — the "Human est." and "Compute est." header boxes were retired on
// 2026-08-25. They summed per-mission figures that are NOT real estimates, and
// a total of invented numbers served in production is a false claim wearing the
// shape of a datum. A legend asterisk was not enough: a header is read without
// its legend, and the sum is the most authoritative-looking thing on the page.
//
// They come back when MIS-048 produces real estimates. Per-mission figures are
// left untouched on the cards — this retires the AGGREGATE, which is the part
// that reads as a measurement of the whole archive.
const stats = [
  { value: String(missions.length), label: "Total", box: "border-border bg-card", text: "text-foreground" },
  { value: String(critical.length), label: t("board.filter.critical"), box: "border-red/20 bg-red/5", text: "text-red" },
  { value: String(inProg.length), label: t("board.filter.inProgress"), box: "border-accent/20 bg-accent/5", text: "text-accent" },
  { value: String(done.length), label: t("board.col.done"), box: "border-green/20 bg-green/5", text: "text-green" },
];

---

<Layout
  title="Missions — Numen Games CAO"
  description="The work itself: what was promised, what got done, and the evidence that says so."
  canonicalPath="/missions"
  activeNav="missions/"
>
  <PageHero
    label={`${here.fn.name} · ${here.activity.name}`}
    title="Mission Board"
    description="The work itself: what was promised, what got done, and the evidence that says so."
  />

  <section class="pb-24">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6">

      <!-- Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-4 gap-3 mb-10">
        {stats.map((s) => (
          <div class={"rounded-xl border p-4 text-center " + s.box}>
            <p class={"font-display text-2xl sm:text-3xl " + s.text}>{s.value}</p>
            <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim mt-1">{s.label}</p>
          </div>
        ))}
      </div>

      <!-- Search bar -->
      <div class="mb-6" id="search-container">
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-dim" aria-hidden="true">
            <Icon name="magnifying-glass" size={14} />
          </span>
          <input
            id="search-input"
            type="search"
            placeholder={t("board.searchPlaceholder")}
            autocomplete="off"
            class="w-full bg-card border border-border rounded-xl pl-10 pr-10 py-3 font-mono text-sm text-foreground placeholder:text-dim/40 focus:outline-none focus:border-accent/60 focus:ring-1 focus:ring-accent/20 transition-all duration-200 hover:border-border/80"
            aria-label={t("board.searchAria")}
          />
          <button
            id="search-clear"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-dim hover:text-foreground transition-colors duration-150 hidden p-0.5 rounded"
            aria-label={t("board.clearAria")}
            tabindex="0"
          >
            <Icon name="x" size={14} />
          </button>
        </div>
      </div>

      <!-- Filters -->
      <div class="mb-8 space-y-2.5" id="filter-bar">
        <div class="flex flex-wrap gap-2 items-center">
          <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim w-14 shrink-0">{t("board.status")}</span>
          {["all", "todo", "in-progress", "in-review", "done"].map((s) => (
            <button data-filter="status" data-value={s}
              class={"filter-btn inline-flex min-h-[44px] min-w-[44px] items-center justify-center font-mono text-[0.65rem] px-3 rounded-full border transition-all duration-150 lg:min-h-0 lg:min-w-0 lg:py-1.5 " + (s === "all" ? "border-accent bg-accent/10 text-accent" : "border-border text-dim hover:border-accent/40 hover:text-foreground")}
              aria-pressed={s === "all" ? "true" : "false"}>
              {s === "all" ? t("board.filter.all") : s === "todo" ? t("board.col.backlog") : s === "in-progress" ? t("board.filter.inProgress") : s === "in-review" ? t("board.filter.inReview") : t("board.col.done")}
            </button>
          ))}
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim w-14 shrink-0">{t("board.priority")}</span>
          {["all", "critical", "high", "medium", "low"].map((p) => (
            <button data-filter="priority" data-value={p}
              class={"filter-btn inline-flex min-h-[44px] min-w-[44px] items-center justify-center font-mono text-[0.65rem] px-3 rounded-full border transition-all duration-150 lg:min-h-0 lg:min-w-0 lg:py-1.5 " + (p === "all" ? "border-accent bg-accent/10 text-accent" : "border-border text-dim hover:border-accent/40 hover:text-foreground")}
              aria-pressed={p === "all" ? "true" : "false"}>
              {p === "all" ? t("board.filter.all") : p === "critical" ? t("board.filter.critical") : p === "high" ? t("board.filter.high") : p === "medium" ? t("board.filter.medium") : t("board.filter.low")}
            </button>
          ))}
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim w-14 shrink-0">{t("board.effort")}</span>
          {["all", "XS", "S", "M", "L", "XL"].map((e) => (
            <button data-filter="effort" data-value={e}
              class={"filter-btn inline-flex min-h-[44px] min-w-[44px] items-center justify-center font-mono text-[0.65rem] px-3 rounded-full border transition-all duration-150 lg:min-h-0 lg:min-w-0 lg:py-1.5 " + (e === "all" ? "border-accent bg-accent/10 text-accent" : "border-border text-dim hover:border-accent/40 hover:text-foreground")}
              aria-pressed={e === "all" ? "true" : "false"}>
              {e}
            </button>
          ))}
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim w-14 shrink-0">{t("board.guild")}</span>
          {["all", "Sentinels", "Alchemists", "Exegetes", "Procurators"].map((g) => (
            <button data-filter="guild" data-value={g}
              class={"filter-btn inline-flex min-h-[44px] min-w-[44px] items-center justify-center font-mono text-[0.65rem] px-3 rounded-full border transition-all duration-150 lg:min-h-0 lg:min-w-0 lg:py-1.5 " + (g === "all" ? "border-accent bg-accent/10 text-accent" : "border-border text-dim hover:border-accent/40 hover:text-foreground")}
              aria-pressed={g === "all" ? "true" : "false"}>
              {g}
            </button>
          ))}
        </div>
        <p id="filter-summary" class="font-mono text-[0.6rem] text-dim hidden pt-0.5">
          Showing <span id="filter-count" class="text-accent">0</span> missions
        </p>
      </div>

      <!-- Kanban -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4" id="kanban-board">
        {columns.map((col) => {
          const colMissions = byStatus(col.key);
          return (
            <div class="flex flex-col" data-column={col.key}>
              <div class="flex items-center gap-2 mb-3 px-1">
                <span class={"font-mono text-[0.65rem] uppercase tracking-widest font-semibold " + col.accent}>{col.label}</span>
                <span class={"col-counter inline-flex items-center justify-center w-5 h-5 rounded-full font-mono text-[0.6rem] text-foreground " + col.counter}>{colMissions.length}</span>
              </div>
              <div class="col-cards flex flex-col gap-2 min-h-[80px]" id={"col-" + col.key}>
                {colMissions.length === 0 ? (
                  <div class="rounded-lg border border-dashed border-border/20 p-6 text-center">
                    <p class="font-mono text-[0.6rem] text-dim/30">empty</p>
                  </div>
                ) : colMissions.map((m) => (
                  <a
                    href={"/missions/" + m.id.toLowerCase()}
                    class={(STATUS_COLOR[m.status] || STATUS_COLOR["todo"]) + " " + (PRIORITY_BORDER[m.priority] || "border-l-border") + " rounded-lg border border-l-[3px] p-4 mission-card cursor-pointer block"}
                    data-status={m.status}
                    data-priority={m.priority}
                    data-effort={m.effort}
                    data-guild={m.guild}
                    data-searchable={[m.id, m.title, m.assignedTo || "", m.guild].join(" ").toLowerCase()}
                  >
                    {/* MIS-133 (was MIS-115b) — three levels, and nothing below the scale.
                        The card used 0.5/0.55/0.6rem (8/9/10px): three sizes
                        the Design System v5.1.0 §4.3 does not define, its
                        smallest being `etiqueta` at 0.75rem/12px. Everything
                        here is a token that already exists.

                        1 · title     cuerpo.m  1rem/16px     weight 600
                        2 · id, date  cuerpo.s  0.875rem/14px mono
                        3 · the rest  etiqueta  0.75rem/12px  mono, uppercase

                        Title stepped DOWN from cuerpo.l (1.44rem) to cuerpo.m
                        on the Oracle's judgement in production: at 23px it
                        dominated the card instead of leading it. It is still
                        read first — it is the only Sans, the only weight 600,
                        and the only thing at full foreground colour, while
                        levels 2 and 3 are mono and dimmed. Hierarchy does not
                        need size alone to do the work. */}

                    {/* LEVEL 1 — the title. Sans (inherited), per §4.2:
                        "Sans for what is asserted, Mono for what is measured".
                        The title asserts; the id, date and labels measure. */}
                    <p class="text-[1rem] font-semibold text-foreground leading-snug tracking-[-0.01em] mb-2">{m.title}</p>

                    {/* LEVEL 2 — who it is and when it moved. */}
                    <div class="flex items-baseline justify-between gap-3 mb-2">
                      <span class={"font-mono text-[0.875rem] font-medium " + (STATUS_ID_COLOR[m.status] || "text-dim")}>{m.id}</span>
                      {(m.status === "done" ? m.completed ?? m.updated : m.updated) && (
                        <span class="font-mono text-[0.875rem] text-dim">
                          <time datetime={m.status === "done" ? m.completed ?? m.updated : m.updated}>
                            {m.status === "done" ? m.completed ?? m.updated : m.updated}
                          </time>
                        </span>
                      )}
                    </div>

                    {/* LEVEL 3 — everything else, one weight, one size.
                        The priority is WRITTEN here as well as carried by the
                        left border: colour is never the only bearer of the
                        datum (WCAG AA, and a greyscale print loses it). */}
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.75rem] uppercase tracking-[0.1em] text-dim">
                      <span class={PRIORITY_TEXT[m.priority] || "text-dim"}>{m.priority}</span>
                      <span class="inline-flex items-center gap-1">
                        <Icon name={TYPE_ICON[m.type] || "git-branch"} size={11} />
                        {m.effort}
                      </span>
                      <span>{m.guild}</span>
                      {m.assignedTo && (
                        <span class="inline-flex items-center gap-1">
                          <Icon name="sword" size={11} /> {m.assignedTo}
                        </span>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Frozen -->
      {frozen.length > 0 && (
        <div class="mt-8">
          <button id="freeze-toggle" class="flex min-h-[44px] items-center gap-3 w-full text-left mb-3 group" aria-expanded="false">
            <span class="inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-widest text-dim group-hover:text-foreground transition-colors"><Icon name="snowflake" size={11} /> Frozen</span>
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-border font-mono text-[0.6rem] text-foreground">{frozen.length}</span>
            <span class="h-px flex-1 bg-border"></span>
            <span id="freeze-chevron" class="font-mono text-[0.6rem] text-dim transition-all">▼ show</span>
          </button>
          <div id="freeze-cards" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {frozen.map((m) => (
              <div class="rounded-lg border border-dim/20 bg-dim/5 p-3.5 mission-card"
                data-status={m.status} data-priority={m.priority} data-effort={m.effort} data-guild={m.guild}
                data-searchable={[m.id, m.title, m.assignedTo || "", m.guild].join(" ").toLowerCase()}>
                {/* MIS-133 (was MIS-115b) — same three levels as the column cards. Frozen
                    renders in its own block, and applying the hierarchy only
                    to the columns would leave two card designs on one page. */}
                <p class="text-[1rem] font-semibold text-foreground/60 leading-snug tracking-[-0.01em] mb-2">{m.title}</p>
                <div class="flex items-baseline justify-between gap-3 mb-2">
                  <span class="font-mono text-[0.875rem] font-medium text-dim">{m.id}</span>
                  {m.updated && (
                    <span class="font-mono text-[0.875rem] text-dim">
                      <time datetime={m.updated}>{m.updated}</time>
                    </span>
                  )}
                </div>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.75rem] uppercase tracking-[0.1em] text-dim">
                  <span class={PRIORITY_TEXT[m.priority] || "text-dim"}>{m.priority}</span>
                  <span>{m.effort}</span>
                  <span>{m.guild}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- No cancelled column: `cancelled` left the vocabulary on 2026-08-30 (STD-001 §7);
           a cancelled mission is frozen with freeze_reason: cancelled and shows above. MIS-135 row 2. -->

      <!-- Footer -->
      <div class="mt-12 grid sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-border/50 bg-card/50 p-5">
          <p class="font-mono text-[0.65rem] uppercase tracking-widest text-accent mb-3">{t("board.costLegend")}</p>
          <div class="space-y-2">
            <p class="inline-flex items-center gap-1.5 font-mono text-[0.6rem] text-dim leading-relaxed"><Icon name="user" size={10} /> Human estimate — hours × €65/h freelancer rate</p>
            <p class="inline-flex items-center gap-1.5 font-mono text-[0.6rem] text-dim leading-relaxed"><Icon name="robot" size={10} /> Compute — AI API cost (mock until MIS-048)</p>
          </div>
        </div>
        <div class="rounded-xl border border-border/50 bg-card/50 p-5">
          <p class="font-mono text-[0.65rem] uppercase tracking-widest text-accent mb-3">{t("board.about")}</p>
          <p class="font-mono text-[0.6rem] text-dim leading-relaxed">
            Built from the <span class="text-accent">missions/</span> folder of numinia-nwos
            at deploy time. The repo is the source of truth; every push rebuilds the board.
          </p>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
// Filters + search operate on the server-rendered cards (MIS-066: data is
// baked at build; only the interaction layer runs in the browser).
const activeFilters: Record<string, string> = { status: "all", priority: "all", effort: "all", guild: "all" };
let searchQuery = "";

function applyFilters() {
  const q = searchQuery.toLowerCase().trim();
  const cards = document.querySelectorAll<HTMLElement>(".mission-card");
  let visible = 0;

  cards.forEach((card) => {
    const matchFilters =
      (activeFilters.status === "all" || card.dataset.status === activeFilters.status) &&
      (activeFilters.priority === "all" || card.dataset.priority === activeFilters.priority) &&
      (activeFilters.effort === "all" || card.dataset.effort === activeFilters.effort) &&
      (activeFilters.guild === "all" || card.dataset.guild === activeFilters.guild);
    const matchSearch = q === "" || (card.dataset.searchable || "").includes(q);
    const match = matchFilters && matchSearch;
    card.classList.toggle("hidden", !match);
    if (match) visible++;
  });

  for (const key of ["todo", "in-progress", "in-review", "done"]) {
    const col = document.getElementById("col-" + key);
    if (!col) continue;
    const allCards = [...col.querySelectorAll(".mission-card")];
    if (allCards.length === 0) continue;
    const visibleCount = allCards.filter((c) => !c.classList.contains("hidden")).length;
    let emptyState = col.querySelector(".col-empty-state");
    if (!emptyState) {
      emptyState = document.createElement("div");
      emptyState.className = "col-empty-state rounded-lg border border-dashed border-border/20 p-6 text-center";
      emptyState.innerHTML = '<p class="font-mono text-[0.6rem] text-dim/30">no matches</p>';
      col.appendChild(emptyState);
    }
    emptyState.classList.toggle("hidden", visibleCount > 0);
  }

  const anyActive = Object.values(activeFilters).some((v) => v !== "all") || q !== "";
  const summary = document.getElementById("filter-summary");
  const countEl = document.getElementById("filter-count");
  if (summary && countEl) {
    summary.classList.toggle("hidden", !anyActive);
    countEl.textContent = String(visible);
  }
}

document.querySelectorAll<HTMLElement>(".filter-btn").forEach((btn) => {
  btn.addEventListener("click", () => {
    const ft = btn.dataset.filter as string;
    const val = btn.dataset.value as string;
    activeFilters[ft] = val;
    document.querySelectorAll<HTMLElement>('.filter-btn[data-filter="' + ft + '"]').forEach((b) => {
      const active = b.dataset.value === val;
      b.classList.toggle("border-accent", active);
      b.classList.toggle("bg-accent/10", active);
      b.classList.toggle("text-accent", active);
      b.classList.toggle("border-border", !active);
      b.classList.toggle("text-dim", !active);
      b.setAttribute("aria-pressed", active ? "true" : "false");
    });
    applyFilters();
  });
});

const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
const searchClear = document.getElementById("search-clear");

searchInput?.addEventListener("input", (e) => {
  searchQuery = (e.target as HTMLInputElement).value;
  searchClear?.classList.toggle("hidden", searchQuery === "");
  applyFilters();
});

searchClear?.addEventListener("click", () => {
  if (searchInput) searchInput.value = "";
  searchQuery = "";
  searchClear.classList.add("hidden");
  searchInput?.focus();
  applyFilters();
});

searchInput?.addEventListener("keydown", (e) => {
  if ((e as KeyboardEvent).key === "Escape") searchClear?.click();
});

for (const key of ["freeze"]) {
  document.getElementById(key + "-toggle")?.addEventListener("click", () => {
    const content = document.getElementById(key + "-cards");
    const chevron = document.getElementById(key + "-chevron");
    const toggle = document.getElementById(key + "-toggle");
    if (content && chevron) {
      const hidden = content.classList.toggle("hidden");
      chevron.textContent = hidden ? "▼ show" : "▲ hide";
      toggle?.setAttribute("aria-expanded", hidden ? "false" : "true");
    }
  });
}
</script>
