---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
import "@/styles/global.css";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  activeNav?: string;
}

// STD-023 §19 — this site's row: the same name and line the footer's
// Numen Games column, the share card (scripts/share-card.mjs) and this head
// read. Two sites never present alike; nwos.numen.games is the service,
// this is the archive.
const {
  title = "NWOS — the archive of Numen Games",
  description = "The archive of Numen Games, built in public: canon, decisions, missions, how the work is done.",
  canonicalPath = "",
  ogImage,
  activeNav,
} = Astro.props;

const siteUrl = "https://numinia.org";
const canonical = `${siteUrl}${canonicalPath}`;
const resolvedOgImage = ogImage ?? `${siteUrl}/og-card.png`;
// MIS-120(e) — one corpus, in English, and lang says so. This is the signal
// the browser reads to offer its own translation; declaring anything else
// suppresses the offer for the very readers who need it (DEC-006).
const locale = "en";
const ogLocale = "en_US";
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14110F" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NWOS — Numen Games" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={resolvedOgImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Fonts: Geist (loaded via @fontsource-variable in Layout frontmatter) -->

    <title>{title}</title>

    <slot name="head" />
  </head>
  <body class="relative overflow-x-hidden">
    <!-- El cielo del Velo (§2.7.1).
         `width`/`height` are set in JS from window.innerWidth, which on mobile
         includes the scrollbar gutter: measured at 375 px the canvas came back
         399 px and dragged the page 24 px wide. The attribute below only sizes
         the drawing buffer; `w-full h-full` keeps the ELEMENT inside its fixed
         inset, so the bitmap can be as wide as it likes without the layout
         noticing. -->
    <canvas
      id="starfield"
      class="pointer-events-none fixed inset-0 -z-10 h-full w-full"
      aria-hidden="true"
    ></canvas>
    <!-- Registro del Velo (§2.7): niebla + rejilla las pinta body::before
         en una sola capa (global.css). /diseno no pasa por este Layout. -->

    <Navigation activeNav={activeNav} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- Starfield script — MMO colors + alphaDir fade -->
    <script is:inline>
      (function () {
        const canvas = document.getElementById("starfield");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        // Escala de rareza canónica (Sistema de Diseño v5.0.0 §2.7.1/§3.6)
        const TIERS = [
          { color: "249,235,220", weight: 60, minR: 0.3, maxR: 1.2 },  // Común — Arena #F9EBDC
          { color: "143,196,107", weight: 25, minR: 0.5, maxR: 1.5 },  // Poco común #8FC46B
          { color: "93,155,214",  weight: 10, minR: 0.6, maxR: 1.8 },  // Raro #5D9BD6
          { color: "169,139,224", weight: 4,  minR: 0.8, maxR: 2.5 },  // Épico #A98BE0
          { color: "239,165,23",  weight: 1,  minR: 1.0, maxR: 3.0 },  // Legendario — Ámbar #EFA517
        ];
        // §2.7.1: con prefers-reduced-motion el cielo se detiene y las
        // estrellas quedan fijas a alfa media.
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Weighted pool
        const pool = [];
        TIERS.forEach((t, i) => { for (let w = 0; w < t.weight; w++) pool.push(i); });

        const STAR_COUNT = 175;
        let stars = [];
        let W = 0, H = 0;

        function resize() {
          // clientWidth, not innerWidth: innerWidth counts the scrollbar
          // gutter, and a canvas sized to it reports 399 px inside a 375 px
          // viewport — which is exactly how a decorative background ends up
          // giving a page of prose a horizontal scrollbar.
          W = canvas.width = document.documentElement.clientWidth;
          H = canvas.height = document.documentElement.clientHeight;
        }

        function initStars() {
          stars = [];
          for (let i = 0; i < STAR_COUNT; i++) {
            const ti = pool[Math.floor(Math.random() * pool.length)];
            const t = TIERS[ti];
            stars.push({
              x: Math.random() * W,
              y: Math.random() * H,
              r: t.minR + Math.random() * (t.maxR - t.minR),
              alpha: Math.random(),
              alphaDir: Math.random() > 0.5 ? 1 : -1,
              speed: Math.random() * 0.004 + 0.002,
              vx: (Math.random() - 0.5) * 0.06,
              vy: (Math.random() - 0.5) * 0.06,
              tierIdx: ti,
            });
          }
        }

        function drawStill() {
          ctx.clearRect(0, 0, W, H);
          for (const s of stars) {
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(${TIERS[s.tierIdx].color}, 0.45)`;
            ctx.fill();
          }
        }

        // The sky breathes at 30fps, not 60: at ±0.06px per frame nobody
        // sees the difference, and it halves the animation's CPU cost.
        // It also stops entirely when the tab is hidden.
        const FRAME_MS = 1000 / 30;
        let lastFrame = 0;

        function draw(now) {
          requestAnimationFrame(draw);
          if (document.hidden) return;
          if (now - lastFrame < FRAME_MS) return;
          lastFrame = now;

          ctx.clearRect(0, 0, W, H);

          for (const s of stars) {
            // Movimiento suave
            s.x += s.vx;
            s.y += s.vy;
            if (s.x < -2) s.x = W + 2;
            if (s.x > W + 2) s.x = -2;
            if (s.y < -2) s.y = H + 2;
            if (s.y > H + 2) s.y = -2;

            // Fade in/out — sistema alphaDir
            s.alpha += s.alphaDir * s.speed;
            if (s.alpha > 0.85) { s.alpha = 0.85; s.alphaDir = -1; }
            if (s.alpha < 0.05) { s.alpha = 0.05; s.alphaDir = 1; }

            ctx.beginPath();
            ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(${TIERS[s.tierIdx].color}, ${s.alpha})`;
            ctx.fill();
          }
        }

        let resizeTimer;
        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            resize();
            initStars();
            if (reducedMotion) drawStill();
          }, 200);
        });

        resize();
        initStars();
        // Start through rAF so `draw` always receives a real timestamp —
        // calling it directly would feed it undefined and defeat the cap.
        if (reducedMotion) drawStill();
        else requestAnimationFrame(draw);
      })();
    </script>

  </body>
</html>
