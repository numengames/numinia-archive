---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { getWardley } from "@/lib/wardley";

// MIS-071 phase 4 — this page renders from the archive.
//
// RPT-2026-04-07-wardley-map.md was extracted FROM this page in phase 2
// (its sections are headed "per /wardley"). The extraction was faithful —
// 12 components, 36 prose fields and every coordinate matched — and then
// nothing read it back. Two identical archives, one of them silent, either
// free to drift on the next edit.
//
// The prose, the coordinates and the layer membership now come from the
// document. What stays here is what the document does not carry: node
// colours, Tailwind classes, SVG geometry. Visual choices are not archive
// content.
const doc = await getWardley();

// Palette by layer id — presentation, not content.
const PALETTE: Record<string, { color: string; bg: string; border: string }> = {
  commodity: { color: "#3a332d", bg: "bg-[#3a332d]/10", border: "border-[#3a332d]/30" },
  foundation: { color: "#8a7d72", bg: "bg-[#8a7d72]/10", border: "border-[#8a7d72]/30" },
  differentiator: { color: "#a98be0", bg: "bg-[#a98be0]/10", border: "border-[#a98be0]/30" },
  frontier: { color: "#a6dad5", bg: "bg-[#a6dad5]/10", border: "border-[#a6dad5]/30" },
  // "structure" has no story-layer section of its own, but two components
  // (Protocols, Operational Reports) declare it in the report. Without this
  // entry they fall through to the fallback and silently lose their amber.
  structure: { color: "#efa517", bg: "bg-[#efa517]/10", border: "border-[#efa517]/30" },
};

const LAYER_ID: Record<string, string> = {
  "The Foundation": "commodity",
  "The Structure": "foundation",
  "The Differentiators": "differentiator",
  "The Frontier": "frontier",
};

// Archive content + local palette. The template below is unchanged.
const components = doc.components.map((c) => ({
  ...c,
  color: PALETTE[c.layer]?.color ?? "#8a7d72",
}));

const byName = new Map(doc.components.map((c) => [c.name, c.id]));
const layers = doc.layers.map((l) => {
  const id = LAYER_ID[l.label] ?? "foundation";
  return {
    id,
    label: l.label,
    subtitle: l.subtitle,
    description: l.description,
    ids: l.componentNames.map((n) => byName.get(n)).filter(Boolean) as string[],
    ...PALETTE[id],
  };
});
---

<Layout
  title="Wardley Map — Narrative Work OS · Numen Games"
  description="A strategic map of the Narrative Work OS — what's visible, what's evolving, where the moat actually is."
  canonicalPath="/system/wardley"
  activeNav="system/"
>
  <!-- Hero -->
  <section class="pt-16 pb-12 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Numen Games · Strategy</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl text-foreground mb-4">Wardley Map</h1>
      <p class="text-lg text-muted-foreground leading-relaxed mb-6">
        A strategic map of the Narrative Work OS. Two axes tell the full story: <strong class="text-foreground">how visible</strong> each component is to the user, and <strong class="text-foreground">how evolved</strong> it is in the market.
      </p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-border bg-card p-5">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-2">Y axis — Visibility</p>
          <p class="text-sm text-muted-foreground">From <span class="text-foreground">infrastructure</span> (invisible to users) to <span class="text-foreground">visible</span> (what users interact with directly).</p>
        </div>
        <div class="rounded-xl border border-border bg-card p-5">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-2">X axis — Evolution</p>
          <p class="text-sm text-muted-foreground">From <span class="text-foreground">Genesis</span> (novel, unstable) → Custom → Product → <span class="text-foreground">Commodity</span> (standardized, available everywhere).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Scroll story -->
  <section class="py-16 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6 space-y-16">
      {layers.map((layer, i) => (
        <div class="story-layer opacity-0 translate-y-6 transition-all duration-700" data-layer={layer.id}>
          <div class={`rounded-2xl border ${layer.border} ${layer.bg} p-8`}>
            <div class="flex items-start gap-4 mb-4">
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim mt-1">Layer {i + 1}</span>
              <div>
                <h2 class="font-display text-2xl mb-1" style={`color: ${layer.color}`}>{layer.label}</h2>
                <p class="font-mono text-[0.7rem] text-muted-foreground">{layer.subtitle}</p>
              </div>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed mb-5">{layer.description}</p>
            <div class="flex flex-wrap gap-2">
              {components.filter(c => layer.ids.includes(c.id)).map(c => (
                <button
                  class="component-pill font-mono text-[0.65rem] px-3 py-1.5 rounded-full border cursor-pointer transition-all hover:scale-105"
                  style={`border-color: ${layer.color}40; color: ${layer.color}; background: ${layer.color}10`}
                  data-id={c.id}
                >
                  {c.name}
                </button>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Full interactive map -->
  <section class="py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <div class="mb-6 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Full Map</span>
        <span class="h-px flex-1 bg-border"></span>
        <span class="font-mono text-[0.6rem] text-dim">Click any node for detail</span>
      </div>

      <div class="relative rounded-2xl border border-border bg-card overflow-hidden">
        <!-- Axis labels -->
        <div class="absolute left-0 top-0 bottom-8 w-8 flex items-center justify-center">
          <span class="font-mono text-[0.55rem] uppercase tracking-[0.15em] text-dim rotate-[-90deg] whitespace-nowrap">Visible to user ↑</span>
        </div>
        <div class="absolute bottom-0 left-8 right-0 h-8 flex items-center justify-center gap-4">
          <span class="font-mono text-[0.55rem] text-dim">Genesis</span>
          <span class="h-px flex-1 bg-border/50"></span>
          <span class="font-mono text-[0.55rem] text-dim">Custom</span>
          <span class="h-px flex-1 bg-border/50"></span>
          <span class="font-mono text-[0.55rem] text-dim">Product</span>
          <span class="h-px flex-1 bg-border/50"></span>
          <span class="font-mono text-[0.55rem] text-dim">Commodity</span>
        </div>

        <!-- SVG Map -->
        <svg
          id="wardley-svg"
          viewBox="0 0 900 520"
          class="w-full ml-8"
          style="padding-bottom: 32px; height: 480px;"
        >
          <!-- Grid lines -->
          <defs>
            <pattern id="grid" width="90" height="52" patternUnits="userSpaceOnUse">
              <path d="M 90 0 L 0 0 0 52" fill="none" stroke="#292420" stroke-width="0.5"/>
            </pattern>
          </defs>
          <rect width="900" height="520" fill="url(#grid)" opacity="0.5"/>

          <!-- Evolution zone labels -->
          <text x="112" y="510" font-size="9" fill="#3a332d" font-family="monospace" text-anchor="middle">Genesis</text>
          <text x="337" y="510" font-size="9" fill="#3a332d" font-family="monospace" text-anchor="middle">Custom</text>
          <text x="562" y="510" font-size="9" fill="#3a332d" font-family="monospace" text-anchor="middle">Product</text>
          <text x="787" y="510" font-size="9" fill="#3a332d" font-family="monospace" text-anchor="middle">Commodity</text>

          <!-- Zone dividers -->
          <line x1="225" y1="0" x2="225" y2="500" stroke="#292420" stroke-width="1" stroke-dasharray="4,4"/>
          <line x1="450" y1="0" x2="450" y2="500" stroke="#292420" stroke-width="1" stroke-dasharray="4,4"/>
          <line x1="675" y1="0" x2="675" y2="500" stroke="#292420" stroke-width="1" stroke-dasharray="4,4"/>

          <!-- Dependency lines (subtle) -->
          <g opacity="0.15" stroke="#8a7d72" stroke-width="1" fill="none">
            <!-- Narrative → Mission -->
            <line x1="108" y1="52" x2="234" y2="145"/>
            <!-- Mission → Agents -->
            <line x1="234" y1="145" x2="189" y2="218"/>
            <!-- Mission → Blueprints -->
            <line x1="234" y1="145" x2="360" y2="249"/>
            <!-- Mission → Decisions -->
            <line x1="234" y1="145" x2="405" y2="275"/>
            <!-- Agents → Files -->
            <line x1="189" y1="218" x2="648" y2="426"/>
            <!-- Files → GitHub -->
            <line x1="648" y1="426" x2="828" y2="483"/>
            <!-- Files → LLMs -->
            <line x1="648" y1="426" x2="765" y2="472"/>
          </g>

          <!-- Nodes -->
          {components.map((c) => {
            const cx = (c.x / 100) * 900;
            const cy = (c.y / 100) * 500;
            const r = c.layer === "commodity" ? 6 : c.layer === "frontier" ? 10 : 8;
            return (
              <g
                class="wardley-node cursor-pointer"
                data-id={c.id}
                transform={`translate(${cx}, ${cy})`}
              >
                <circle
                  r={r + 6}
                  fill={c.color}
                  opacity="0.08"
                  class="node-halo transition-all duration-200"
                />
                <circle
                  r={r}
                  fill={c.color}
                  class="node-dot transition-all duration-200"
                />
                <text
                  x="0"
                  y={-(r + 8)}
                  text-anchor="middle"
                  font-size="9"
                  fill={c.color}
                  font-family="monospace"
                  class="node-label pointer-events-none select-none"
                >
                  {c.name}
                </text>
              </g>
            );
          })}
        </svg>
      </div>

      <!-- Detail card (hidden by default) -->
      <div id="detail-card" class="hidden mt-6 rounded-2xl border border-accent/30 bg-card p-6 transition-all">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div>
            <p id="detail-evolution" class="font-mono text-[0.6rem] text-dim mb-1"></p>
            <h3 id="detail-name" class="font-display text-2xl text-foreground"></h3>
          </div>
          <button id="detail-close" class="inline-flex items-center gap-1.5 font-mono text-[0.65rem] text-dim hover:text-foreground transition-colors"><Icon name="x" size={11} /> close</button>
        </div>
        <div class="grid sm:grid-cols-3 gap-4">
          <div>
            <p class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim mb-2">What it does</p>
            <p id="detail-why" class="text-sm text-muted-foreground leading-relaxed"></p>
          </div>
          <div>
            <p class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim mb-2">Strategic tension</p>
            <p id="detail-tension" class="text-sm text-muted-foreground leading-relaxed"></p>
          </div>
          <div>
            <p class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim mb-2">Moat</p>
            <p id="detail-moat" class="text-sm text-muted-foreground leading-relaxed"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Strategic tensions summary -->
  <section class="py-16 border-t border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="mb-6 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Strategic Tensions</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <div class="space-y-4">
        {[
          {
            t: "Narrative first = adoption barrier",
            d: "The most visible component is also the most Genesis. Users hit the lore before the value. The /nwos page is the mitigation — substance first, narrative optional.",
            sev: "high",
          },
          {
            t: "LLM commoditization window: 18–24 months",
            d: "Notion AI, Confluence AI, and Microsoft Copilot will offer native agents with the same LLMs. Using AI is not a moat — it's table stakes. The real moat is what the system doesn't lose: every mission closed with an Execution Reality section, every decision with its rejected alternatives, every blueprint with its delta table. That knowledge can't live anywhere else. An organization with 1 year of NWOS has 365 days of structured institutional memory that can't be imported into Notion. That inertia grows with time.",
            sev: "high",
          },
          {
            t: "File Layer: commodity for devs, genesis for orgs",
            d: "Markdown + git is standard for developers. For traditional organizations, it's an alien workflow. This is why startup ICPs succeed and PYME traditional fails at 10% rate.",
            sev: "medium",
          },
          {
            t: "Rituals are fragile at scale",
            d: "Dark Council and Lunar Coven generate the highest cultural engagement. They also generate the highest churn risk if vocabulary isn't adopted quickly. Must be opt-in.",
            sev: "medium",
          },
        ].map((item) => (
          <div class={`rounded-xl border p-5 ${item.sev === "high" ? "border-red/20 bg-red/5" : "border-yellow/20 bg-yellow/5"}`}>
            <div class="flex items-start gap-3">
              <span class={`inline-flex items-center gap-1 font-mono text-[0.6rem] mt-0.5 flex-shrink-0 ${item.sev === "high" ? "text-red" : "text-yellow"}`}>
                <Icon name={item.sev === "high" ? "warning" : "circle"} size={10} />
                {item.sev === "high" ? "High" : "Medium"}
              </span>
              <div>
                <p class="font-semibold text-sm text-foreground mb-1">{item.t}</p>
                <p class="text-sm text-muted-foreground leading-relaxed">{item.d}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Moat -->  
  <section class="py-16 border-t border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="mb-6 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">The strategic bet</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <div class="rounded-2xl border border-accent/30 bg-accent/5 p-7 mb-6">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-accent mb-4">The moat is what the system doesn't lose</p>
        <p class="text-sm text-muted-foreground leading-relaxed mb-4">
          Notion AI can answer questions about what you have in Notion. But it can't answer:
        </p>
        <div class="space-y-3 mb-6">
          {[
            { q: "\"Why did we make this decision 6 months ago, what alternatives did we reject, and what did we learn executing it?\"", why: "Notion has documents. NWOS has a Decision Registry — append-only, with rejected alternatives and explicit reasoning." },
            { q: "\"What have we learned across the last 20 missions that should change how we approach the next ones?\"", why: "Notion has tasks with checkboxes. NWOS missions have Epistemic Value and Execution Reality — the learning is the artifact." },
            { q: "\"What's the gap between where we are today and where we need to be, and which missions close it?\"", why: "Notion has pages. NWOS Blueprints have delta tables that map gaps to missions explicitly." },
          ].map((item) => (
            <div class="rounded-xl border border-border bg-card/50 p-4">
              <p class="text-sm italic text-foreground/70 mb-2">{item.q}</p>
              <p class="font-mono text-[0.6rem] text-accent">→ {item.why}</p>
            </div>
          ))}
        </div>
        <div class="border-t border-border/50 pt-5">
          <p class="text-sm text-muted-foreground leading-relaxed mb-3">
            <strong class="text-foreground">Notion stores what you did.</strong> The NWOS stores what you learned doing it. That difference can't be bridged with an AI plugin — it requires redesigning how the organization works from the root.
          </p>
          <p class="text-sm text-muted-foreground leading-relaxed">
            An organization with 1 year of NWOS has 365 days of decisions with context, missions with Execution Reality, and blueprints updated week by week. That archive is irreplaceable. And it can't be imported into any other tool.
          </p>
        </div>
      </div>
      <div class="rounded-xl border border-border bg-card p-5">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-3">The window: 18–24 months</p>
        <p class="text-sm text-muted-foreground leading-relaxed">
          The goal is to establish Mission System + Decision Registry + Blueprints as the standard for AI-integrated organizations before large players commoditize individual components. Not to be the first to use LLMs — to be the first to build knowledge infrastructure that compounds.
        </p>
      </div>
    </div>
  </section>

  <!-- Footer link to repo -->
  <section class="py-10 border-t border-border">
    <div class="mx-auto max-w-[800px] px-6 flex flex-wrap items-center justify-between gap-4">
      <p class="inline-flex items-center gap-1.5 font-mono text-[0.65rem] text-dim"><span>Wardley Map v0.1.0 · Nimrod</span> <Icon name="sword" size={11} /> <span>· 2026-04-07</span></p>
      <div class="flex gap-4">
        <a href="https://github.com/numengames/numinia-archive/blob/main/blueprints/BLU-001-wardley-map.md" target="_blank" rel="noopener noreferrer" class="font-mono text-[0.65rem] text-accent hover:text-accent/80 transition-colors">
          Source .md →
        </a>
        <a href="/blueprints/nwos-system" class="font-mono text-[0.65rem] text-dim hover:text-foreground transition-colors">
          NWOS overview →
        </a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ components }}>
  // Scroll animation
  const layers = document.querySelectorAll(".story-layer");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-6");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  layers.forEach((el) => observer.observe(el));

  // Node interaction
  const detailCard = document.getElementById("detail-card");
  const detailName = document.getElementById("detail-name");
  const detailEvolution = document.getElementById("detail-evolution");
  const detailWhy = document.getElementById("detail-why");
  const detailTension = document.getElementById("detail-tension");
  const detailMoat = document.getElementById("detail-moat");
  const detailClose = document.getElementById("detail-close");

  function showDetail(id) {
    const c = components.find((x) => x.id === id);
    if (!c) return;
    detailName.textContent = c.name;
    detailEvolution.textContent = `${c.evolution} · ${c.visibility}`;
    detailWhy.textContent = c.why;
    detailTension.textContent = c.tension;
    detailMoat.textContent = c.moat;
    detailCard.classList.remove("hidden");
    detailCard.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  // SVG nodes
  document.querySelectorAll(".wardley-node").forEach((node) => {
    node.addEventListener("click", () => showDetail(node.dataset.id));
    node.addEventListener("mouseenter", () => {
      node.querySelector(".node-dot").setAttribute("r", "12");
      node.querySelector(".node-halo").setAttribute("r", "18");
    });
    node.addEventListener("mouseleave", () => {
      const c = components.find((x) => x.id === node.dataset.id);
      const r = c?.layer === "commodity" ? 6 : c?.layer === "frontier" ? 10 : 8;
      node.querySelector(".node-dot").setAttribute("r", String(r));
      node.querySelector(".node-halo").setAttribute("r", String(r + 6));
    });
  });

  // Pills in story
  document.querySelectorAll(".component-pill").forEach((pill) => {
    pill.addEventListener("click", () => {
      showDetail(pill.dataset.id);
      document.getElementById("wardley-svg")?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  });

  detailClose?.addEventListener("click", () => detailCard.classList.add("hidden"));
</script>
