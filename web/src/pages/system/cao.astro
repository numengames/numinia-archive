//
// ON THE LANGUAGE. This page was written in Spanish while the rest of the
// site moved to English. The words are translated here, nothing else: the
// same figures, the same date, the same signature. Object keys stay Spanish
// (`nombre`, `rol`, `gremio`, `coste`) because renaming them is a refactor,
// not a translation, and the two should not ride in one commit.
//
// ON THE FIGURES. Everything below is typed by hand and stamped 2026-04-07 —
// it is not read from the instrument, unlike /telemetry. That is DBT-021: the
// page holds its own content instead of the corpus holding it.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";

// CAO metrics — updated by the agents
const metrics = {
  updated: "2026-04-07",
  period: "2026-04-02 / 2026-04-07",
  agentes: [
    {
      id: "nimrod",
      nombre: "Nimrod",
      rol: "Keeper of the Gates",
      gremio: "Sentinels",
      modelo: "claude-sonnet-4.6",
      estado: "activo",
      misiones: 58,
      prs: 41,
      docs: 80,
      coste: 100,
      color: "accent",
    },
    {
      id: "alquimista-01",
      nombre: "Alquimista-01",
      rol: "Digital CTO",
      gremio: "Alchemists",
      modelo: "claude-sonnet-4.6",
      estado: "diseñado",
      misiones: 0,
      prs: 0,
      docs: 0,
      coste: 0,
      color: "yellow",
    },
    {
      id: "exegeta-01",
      nombre: "Exegeta-01",
      rol: "Content & Lore",
      gremio: "Exegetes",
      modelo: "claude-haiku-3.5",
      estado: "diseñado",
      misiones: 0,
      prs: 0,
      docs: 0,
      coste: 0,
      color: "blue",
    },
    {
      id: "procurador-01",
      nombre: "Procurador-01",
      rol: "Sales & BD",
      gremio: "Procurators",
      modelo: "claude-haiku-3.5",
      estado: "diseñado",
      misiones: 0,
      prs: 0,
      docs: 0,
      coste: 0,
      color: "purple",
    },
    {
      id: "adonaz",
      nombre: "Adonaz",
      rol: "Archivist General",
      gremio: "Exegetes",
      modelo: "claude-sonnet-4.6",
      estado: "activo",
      misiones: 2,
      prs: 0,
      docs: 5,
      coste: 2,
      color: "blue",
    },
    {
      id: "procyon",
      nombre: "Procyon",
      rol: "CAO Coordinator",
      gremio: "Coordinator",
      modelo: "claude-sonnet-4.6",
      estado: "previsto-2028",
      misiones: 0,
      prs: 0,
      docs: 0,
      coste: 0,
      color: "green",
    },
  ],
  totales: {
    misiones: 58,
    coste: 102,
    activos: 2,
    total: 6,
  },
};

const estadoStyles: Record<string, string> = {
  "activo": "bg-green/10 text-green",
  "diseñado": "bg-accent/10 text-accent",
  "previsto-2028": "bg-muted text-muted-foreground",
};

const estadoLabel: Record<string, string> = {
  "activo": "Active",
  "diseñado": "Designed",
  "previsto-2028": "Planned 2028",
};
---

<Layout
  title="CAO Dashboard — Numen Games"
  description="Metrics panel of the Centralised Autonomous Organisation of Numen Games. Digital agents, missions, costs and ROI."
  canonicalPath="/system/cao"
  activeNav="system/"
>
  <PageHero
    label="Numen Games · CAO"
    title="Agent Dashboard"
    description="Live metrics of the digital agents of the Centralised Autonomous Organisation."
  />

  <section class="pb-20">
    <div class="mx-auto max-w-[1100px] px-6">

      <!-- Meta info -->
      <div class="mb-10 flex flex-wrap gap-6 font-mono text-[0.7rem] text-dim">
        <span>Period <span class="text-muted-foreground">{metrics.period}</span></span>
        <span>Updated <span class="text-muted-foreground">{metrics.updated}</span></span>
      </div>

      <!-- Global KPIs -->
      <div class="grid gap-4 sm:grid-cols-4 mb-12">
        <div class="rounded-xl border border-border bg-card p-6">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-2">Missions</p>
          <p class="font-display text-4xl text-foreground">{metrics.totales.misiones}</p>
          <p class="text-xs text-muted-foreground mt-1">completed</p>
        </div>
        <div class="rounded-xl border border-border bg-card p-6">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-2">Total cost</p>
          <p class="font-display text-4xl text-foreground">${metrics.totales.coste}</p>
          <p class="text-xs text-muted-foreground mt-1">USD over 3 days</p>
        </div>
        <div class="rounded-xl border border-border bg-card p-6">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-2">Active agents</p>
          <p class="font-display text-4xl text-foreground">{metrics.totales.activos}<span class="text-muted-foreground text-2xl">/{metrics.totales.total}</span></p>
          <p class="text-xs text-muted-foreground mt-1">of {metrics.totales.total} designed</p>
        </div>
        <div class="rounded-xl border border-accent/20 bg-accent/5 p-6">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-accent mb-2">Estimated ROI</p>
          <p class="font-display text-2xl text-foreground">+40x</p>
          <p class="text-xs text-muted-foreground mt-1">infrastructure valued >$2K</p>
        </div>
      </div>

      <!-- Agents -->
      <div class="mb-4 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Agents</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {metrics.agentes.map((agente) => (
          <div class="rounded-xl border border-border bg-card p-6">
            <div class="flex items-start justify-between mb-4">
              <span class:list={["inline-flex rounded-full px-2 py-0.5 font-mono text-[0.6rem] font-medium", estadoStyles[agente.estado] || "bg-muted text-muted-foreground"]}>
                {estadoLabel[agente.estado] || agente.estado}
              </span>
              <span class="font-mono text-[0.6rem] text-dim">{agente.modelo}</span>
            </div>

            <h3 class="font-display text-xl text-foreground mb-1">{agente.nombre}</h3>
            <p class="font-mono text-xs text-dim mb-1">{agente.rol}</p>
            <p class="font-mono text-xs text-muted-foreground mb-5">{agente.gremio}</p>

            <div class="grid grid-cols-3 gap-3 border-t border-border pt-4">
              <div>
                <p class="font-mono text-[0.6rem] text-dim mb-1">Missions</p>
                <p class="font-display text-lg text-foreground">{agente.misiones}</p>
              </div>
              <div>
                <p class="font-mono text-[0.6rem] text-dim mb-1">PRs</p>
                <p class="font-display text-lg text-foreground">{agente.prs}</p>
              </div>
              <div>
                <p class="font-mono text-[0.6rem] text-dim mb-1">Cost</p>
                <p class="font-display text-lg text-foreground">${agente.coste}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Note -->
      <div class="mt-12 rounded-xl border border-border/50 bg-card/50 p-6">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-accent mb-2">About this dashboard</p>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Metrics of the CAO (Centralised Autonomous Organisation) of Numen Games. The digital agents operate around the clock running missions while the Oracles rest. Updated automatically on each reporting cycle.
        </p>
      </div>

    </div>
  </section>
</Layout>
