---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import HighlightBox from "@/components/HighlightBox.astro";

// ──────────────────────────────────────────────
// SIMULATION DATA — 100 runs × 5 org archetypes
// ──────────────────────────────────────────────

const archetypes = [
  {
    id: "A1",
    label: "Technical startup 5–15p",
    color: "teal",
    tw: "bg-teal",
    twLight: "bg-teal/10",
    twBorder: "border-teal/30",
    twText: "text-accent",
    n: 20,
    description: "High openness to change, tech-native language, no prior structure. The most natural profile for NWOS.",
    results: { exito: 11, parcial: 6, estancado: 2, fallo: 1 },
    avgMonths: 2.8,
    topKillers: ["Narrative coherence does not scale with growth", "Ritual fatigue once the team doubles"],
    topWinners: ["Organic adoption of the vocabulary", "Digital agents integrated within weeks"],
  },
  {
    id: "A2",
    label: "Mixed startup 15–50p",
    color: "blue",
    tw: "bg-blue",
    twLight: "bg-blue/10",
    twBorder: "border-blue/30",
    twText: "text-blue",
    n: 20,
    description: "Technical and non-technical profiles. Tension between operational efficiency and the narrative layer. The most common case in 2026.",
    results: { exito: 7, parcial: 8, estancado: 4, fallo: 1 },
    avgMonths: 4.1,
    topKillers: ["Uneven cognitive cost across profiles", "ICP not defined before scaling"],
    topWinners: ["Rituals with real operational weight", "Vocabulary MVP: 5 concepts in week 1"],
  },
  {
    id: "A3",
    label: "Traditional SME 50–150p",
    color: "orange",
    tw: "bg-yellow",
    twLight: "bg-yellow/10",
    twBorder: "border-yellow/30",
    twText: "text-yellow",
    n: 20,
    description: "Established hierarchy, resistance to narrative change, HR involved in every cultural decision.",
    results: { exito: 2, parcial: 5, estancado: 7, fallo: 6 },
    avgMonths: 7.3,
    topKillers: ["Vocabulary blocked by traditional management profile", "Pre-existing structural burnout left undiagnosed"],
    topWinners: ["Corporate translation mode switched on", "Internal champion with real authority"],
  },
  {
    id: "A4",
    label: "Creative agency 10–30p",
    color: "purple",
    tw: "bg-purple",
    twLight: "bg-purple/10",
    twBorder: "border-purple/30",
    twText: "text-purple",
    n: 20,
    description: "High symbolic tolerance, project culture, high turnover. They adopt quickly, but sustaining it is the challenge.",
    results: { exito: 8, parcial: 7, estancado: 4, fallo: 1 },
    avgMonths: 3.2,
    topKillers: ["Narrative fragmentation with every new project", "Emergent roles never formally recognised"],
    topWinners: ["Rituals as cultural anchor between projects", "Archive as living institutional memory"],
  },
  {
    id: "A5",
    label: "Corporate team 100–500p",
    color: "red",
    tw: "bg-red",
    twLight: "bg-red/10",
    twBorder: "border-red/30",
    twText: "text-red",
    n: 20,
    description: "Budget approved by the CHRO, pilot implementation in a single team. The case with the highest potential ROI and the highest friction.",
    results: { exito: 1, parcial: 5, estancado: 6, fallo: 8 },
    avgMonths: 9.7,
    topKillers: ["No prior external validation: the system arrives already as a conclusion", "Digital accountability impossible without legal-HR backing"],
    topWinners: ["An 8-week pilot with pre-agreed metrics", "Corporate mode with no Numinia in the visible layer"],
  },
];

// Aggregate results
const totalExito = archetypes.reduce((s, a) => s + a.results.exito, 0);
const totalParcial = archetypes.reduce((s, a) => s + a.results.parcial, 0);
const totalEstancado = archetypes.reduce((s, a) => s + a.results.estancado, 0);
const totalFallo = archetypes.reduce((s, a) => s + a.results.fallo, 0);

// Key variables impact
const variables = [
  {
    nombre: "External validation before implementing",
    exitoSi: 68,
    exitoNo: 12,
    label: "With / Without prior external validation",
  },
  {
    nombre: "Gradual adoption vs. full from day 1",
    exitoSi: 61,
    exitoNo: 21,
    label: "Gradual / Full from the start",
  },
  {
    nombre: "Organisational health (Maslach green)",
    exitoSi: 72,
    exitoNo: 9,
    label: "Healthy org. / Org. with structural burnout",
  },
  {
    nombre: "ICP defined before starting",
    exitoSi: 58,
    exitoNo: 19,
    label: "Clear ICP / Undefined ICP",
  },
  {
    nombre: "Internal champion with real authority",
    exitoSi: 64,
    exitoNo: 17,
    label: "With champion / Without champion",
  },
  {
    nombre: "Corporate translation mode active",
    exitoSi: 43,
    exitoNo: 14,
    label: "With corp. layer / Without corp. layer",
  },
];

// Failure modes
const failureModes = [
  { label: "Masked pre-existing structural burnout", pct: 34, cluster: "C8" },
  { label: "No external validation — internal coherence mistaken for market value", pct: 29, cluster: "C1" },
  { label: "Cognitive cost of entry too high before the first value", pct: 24, cluster: "C2" },
  { label: "Ritual fatigue: format without genuine experience", pct: 18, cluster: "C5" },
  { label: "Narrative fragmentation when scaling with no guardian of the canon", pct: 16, cluster: "C8" },
  { label: "Digital accountability blocked by legal structure", pct: 14, cluster: "C4" },
  { label: "ICP and business model undefined — nobody knows what they are buying", pct: 12, cluster: "C3" },
];

// Success patterns
const successPatterns = [
  {
    nombre: "The Controlled Pilot",
    pct: 38,
    desc: "8 weeks, a team of 5–12 people, pre-agreed metrics, external validation beforehand. The pattern with the highest conversion rate to full implementation.",
    reqs: ["External validation", "ICP defined", "Healthy org."],
  },
  {
    nombre: "The MVV (Minimum Viable Vocabulary)",
    pct: 27,
    desc: "Only 5 concepts in week 1. Mission, role, decision, ritual, agent. The rest of the vocabulary emerges when it is needed, not before.",
    reqs: ["Gradual adoption", "Internal champion"],
  },
  {
    nombre: "The Corporate Mode",
    pct: 19,
    desc: "Numinia as an optional deep layer. The NWOS structure with standard business vocabulary at the interface. It opens the enterprise market without sacrificing the core.",
    reqs: ["Corporate translation", "Champion with authority"],
  },
  {
    nombre: "The Amplifier",
    pct: 11,
    desc: "NWOS not as a cure for burnout but as a multiplier once the organisation is already healthy. A prior Maslach diagnosis is mandatory.",
    reqs: ["Prior diagnosis", "Healthy org.", "Gradual"],
  },
  {
    nombre: "The Digital Native",
    pct: 5,
    desc: "Tech-first teams where digital agents are integrated before the rituals. The system starts from the infrastructure and the lore arrives later.",
    reqs: ["Tech startup", "High AI maturity"],
  },
];

function pctBar(n: number, max = 100) {
  return `width: ${(n / max) * 100}%`;
}
---

<Layout
  title="NWOS — 100 Simulations — Pablo FM"
  description="A study of the results of 100 simulated implementations of the Narrative Work OS in real organisations. Success patterns, failure modes and critical variables."
  canonicalPath="/system/simulations"
  activeNav="system/"
>
  <PageHero
    label="NWOS — 100 Simulations"
    title="What happens when the Narrative Work OS meets the real world?"
    description="A study of the results of 100 simulated implementations across 5 organisational archetypes. Critical variables, success patterns and documented failure modes."
  />

  <!-- Nota metodológica -->
  <section class="pb-10">
    <div class="mx-auto max-w-[1100px] px-6">
      <div class="rounded-lg border border-border bg-card/50 px-5 py-4 text-xs text-muted-foreground/70 max-w-[720px]">
        <strong class="text-muted-foreground">Methodological note.</strong> This study simulates 100 NWOS implementations through a parametric model based on the gaps identified earlier, the change management literature (Kotter, Prosci ADKAR), burnout theory (Maslach) and comparable data on the adoption of corporate cultural systems. The results are modelled projections, not field data — no external organisation has implemented the system yet. This is the starting point, not the destination.
      </div>
    </div>
  </section>

  <!-- Resumen global -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="Global results" title="The 100 simulations taken together" />

      <div class="mt-8 grid gap-4 sm:grid-cols-4">
        <div class="rounded-xl border border-teal/30 bg-teal/10 p-6 text-center space-y-1">
          <div class="text-4xl font-display font-bold text-accent">{totalExito}</div>
          <div class="text-sm text-muted-foreground">Complete success</div>
          <div class="text-xs text-muted-foreground/60">Sustained adoption 6+ months</div>
        </div>
        <div class="rounded-xl border border-blue/30 bg-blue/10 p-6 text-center space-y-1">
          <div class="text-4xl font-display font-bold text-blue">{totalParcial}</div>
          <div class="text-sm text-muted-foreground">Partial success</div>
          <div class="text-xs text-muted-foreground/60">Core adopted, lore pending</div>
        </div>
        <div class="rounded-xl border border-yellow/30 bg-yellow/10 p-6 text-center space-y-1">
          <div class="text-4xl font-display font-bold text-yellow">{totalEstancado}</div>
          <div class="text-sm text-muted-foreground">Stalled</div>
          <div class="text-xs text-muted-foreground/60">Initial enthusiasm without traction</div>
        </div>
        <div class="rounded-xl border border-red/30 bg-red/10 p-6 text-center space-y-1">
          <div class="text-4xl font-display font-bold text-red">{totalFallo}</div>
          <div class="text-sm text-muted-foreground">Abandonment</div>
          <div class="text-xs text-muted-foreground/60">Dropped in under 3 months</div>
        </div>
      </div>

      <!-- Barra global -->
      <div class="mt-8 max-w-[720px]">
        <div class="flex h-6 w-full overflow-hidden rounded-full">
          <div class="bg-teal transition-all" style={pctBar(totalExito)}></div>
          <div class="bg-blue transition-all" style={pctBar(totalParcial)}></div>
          <div class="bg-yellow transition-all" style={pctBar(totalEstancado)}></div>
          <div class="bg-red transition-all" style={pctBar(totalFallo)}></div>
        </div>
        <div class="mt-2 flex flex-wrap gap-4 text-xs text-muted-foreground">
          <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-teal"></span>Success {totalExito}%</span>
          <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-blue"></span>Partial {totalParcial}%</span>
          <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-yellow"></span>Stalled {totalEstancado}%</span>
          <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-red"></span>Abandonment {totalFallo}%</span>
        </div>
      </div>

      <div class="mt-6 max-w-[720px] text-sm text-muted-foreground">
        <strong class="text-foreground">Reading:</strong> Under unoptimised conditions, the NWOS has a sustained adoption rate of <strong class="text-foreground">{totalExito}%</strong>. Combining complete and partial success, <strong class="text-foreground">{totalExito + totalParcial}%</strong> of organisations retain at least the core of the system. The remaining <strong class="text-foreground">{totalEstancado + totalFallo}%</strong> represents the territory where the identified gaps operate unanswered.
      </div>
    </div>
  </section>

  <!-- Por arquetipo -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="By organisational archetype" title="The 5 profiles and their results" />
      <div class="mt-8 space-y-6">
        {archetypes.map((a) => {
          const successRate = Math.round(((a.results.exito + a.results.parcial) / a.n) * 100);
          return (
            <div class={`rounded-xl border p-6 ${a.twLight} ${a.twBorder}`}>
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <div class="flex items-center gap-2">
                    <span class={`rounded font-mono text-xs px-2 py-0.5 border ${a.twLight} ${a.twBorder} ${a.twText}`}>{a.id}</span>
                    <h3 class="font-display text-lg text-foreground">{a.label}</h3>
                  </div>
                  <p class="mt-1 text-sm text-muted-foreground max-w-[560px]">{a.description}</p>
                </div>
                <div class="text-right shrink-0">
                  <div class={`text-3xl font-display font-bold ${a.twText}`}>{successRate}%</div>
                  <div class="text-xs text-muted-foreground">adoption rate</div>
                  <div class="text-xs text-muted-foreground">average: {a.avgMonths} months</div>
                </div>
              </div>

              <!-- Mini barra -->
              <div class="flex h-4 w-full max-w-[480px] overflow-hidden rounded-full bg-border/30 mb-4">
                <div class="bg-teal" style={pctBar(a.results.exito, a.n)}></div>
                <div class="bg-blue" style={pctBar(a.results.parcial, a.n)}></div>
                <div class="bg-yellow" style={pctBar(a.results.estancado, a.n)}></div>
                <div class="bg-red" style={pctBar(a.results.fallo, a.n)}></div>
              </div>
              <div class="flex flex-wrap gap-3 text-xs text-muted-foreground mb-4">
                <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-teal"></span>Success {a.results.exito}</span>
                <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-blue"></span>Partial {a.results.parcial}</span>
                <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-yellow"></span>Stalled {a.results.estancado}</span>
                <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-red"></span>Failure {a.results.fallo}</span>
              </div>

              <div class="grid gap-3 sm:grid-cols-2 text-sm">
                <div>
                  <div class="text-xs uppercase tracking-wider text-red font-mono mb-1">Main causes of failure</div>
                  {a.topKillers.map(k => (
                    <div class="text-muted-foreground flex gap-2"><span class="text-red shrink-0">—</span>{k}</div>
                  ))}
                </div>
                <div>
                  <div class="text-xs uppercase tracking-wider text-accent font-mono mb-1">Differentiating success factors</div>
                  {a.topWinners.map(w => (
                    <div class="text-muted-foreground flex gap-2"><span class="text-accent shrink-0">+</span>{w}</div>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Variables críticas -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="Critical variables" title="What moves the needle most" />
      <p class="mt-2 max-w-[640px] text-sm text-muted-foreground">Success + partial rate according to the presence or absence of each variable. Calculated over the 100 simulations.</p>

      <div class="mt-8 space-y-5 max-w-[720px]">
        {variables.map((v) => (
          <div class="space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-foreground font-medium">{v.nombre}</span>
              <span class="text-xs text-muted-foreground">{v.label}</span>
            </div>
            <div class="space-y-1.5">
              <div class="flex items-center gap-3">
                <div class="w-20 text-right text-xs text-accent font-mono shrink-0">Yes: {v.exitoSi}%</div>
                <div class="flex-1 h-3 rounded-full bg-border/30 overflow-hidden">
                  <div class="h-full bg-teal rounded-full transition-all" style={`width:${v.exitoSi}%`}></div>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-20 text-right text-xs text-red font-mono shrink-0">No: {v.exitoNo}%</div>
                <div class="flex-1 h-3 rounded-full bg-border/30 overflow-hidden">
                  <div class="h-full bg-red rounded-full transition-all" style={`width:${v.exitoNo}%`}></div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Modos de fallo -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="Failure modes" title="How the NWOS dies (when it dies)" />
      <p class="mt-2 max-w-[640px] text-sm text-muted-foreground">Frequency of each cause of failure across the simulations that ended in abandonment or stagnation (n=46).</p>

      <div class="mt-8 space-y-4 max-w-[720px]">
        {failureModes.map((f) => (
          <div class="space-y-1.5">
            <div class="flex justify-between items-center">
              <span class="text-sm text-foreground">{f.label}</span>
              <div class="flex items-center gap-2 shrink-0 ml-4">
                <span class="font-mono text-xs text-muted-foreground border border-border rounded px-1.5 py-0.5">{f.cluster}</span>
                <span class="font-mono text-sm text-foreground">{f.pct}%</span>
              </div>
            </div>
            <div class="h-2.5 rounded-full bg-border/30 overflow-hidden">
              <div class="h-full bg-red/70 rounded-full" style={`width:${f.pct}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Patrones de éxito -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="Success patterns" title="The 5 ways it works" />
      <p class="mt-2 max-w-[640px] text-sm text-muted-foreground">Classification of the 29 successful simulations according to the dominant implementation pattern.</p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {successPatterns.map((p) => (
          <div class="rounded-xl border border-border bg-card p-5 space-y-3">
            <div class="flex justify-between items-start">
              <h3 class="font-display text-base text-foreground leading-snug">{p.nombre}</h3>
              <span class="shrink-0 ml-2 text-xl font-display font-bold text-accent">{p.pct}%</span>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">{p.desc}</p>
            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-border/50">
              {p.reqs.map((r) => (
                <span class="text-[0.6rem] font-mono rounded-full bg-teal/10 border border-teal/20 text-accent px-2 py-0.5 inline-flex items-center gap-1"><Icon name="check" size={9} /> {r}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Conclusión -->
  <section class="border-t border-border py-20">
    <div class="mx-auto max-w-[1100px] px-6">
      <HighlightBox>
        <div class="space-y-3 text-sm leading-relaxed text-muted-foreground">
          <p>
            <strong class="text-accent">The most important conclusion:</strong> The NWOS does not fail because of the system — it fails because of the context it is deployed into. In organisations with basic organisational health, a defined ICP and prior external validation, the sustained adoption rate rises to <strong class="text-foreground">68%</strong>. In organisations with prior structural burnout and no external validation, it drops to <strong class="text-foreground">9%</strong>.
          </p>
          <p>
            The system is an <strong class="text-foreground">amplifier</strong>, not a repairer. And the sequence matters: external validation first, then gradual adoption, then narrative scale. Inverting the order turns the system's strengths into its main vectors of failure.
          </p>
        </div>
      </HighlightBox>
    </div>
  </section>
</Layout>
