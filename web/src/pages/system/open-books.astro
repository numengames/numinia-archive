  $('#ob-pl').innerHTML = `<thead><tr><th></th>${rows.map((r) => `<th class="ob-n">${r.y}</th>`).join('')}</tr></thead><tbody>` +
    `<tr><td>Projects</td>${rows.map((r) => `<td class="ob-n">${r.proj.toFixed(1)}</td>`).join('')}</tr>` +
    `<tr><td>Income, projects</td>${rows.map((r) => `<td class="ob-n">${eur(r.pr)}</td>`).join('')}</tr>` +
    `<tr><td>Income, hosting</td>${rows.map((r) => `<td class="ob-n">${eur(r.host)}</td>`).join('')}</tr>` +
    `<tr><td>Cost of running</td>${rows.map((r) => `<td class="ob-n">−${eur(r.cost)}</td>`).join('')}</tr></tbody>` +
    `<tfoot><tr><td>Result</td>${rows.map((r) => `<td class="ob-n">${c(r.res)}</td>`).join('')}</tr><tr><td style="font-weight:400">Accumulated</td>${rows.map((r) => `<td class="ob-n">${c(r.cum)}</td>`).join('')}</tr></tfoot>`;
