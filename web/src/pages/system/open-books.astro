---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// Open books — the books of Numen Games S.L., from the day it was born
// (16 February 2024). One company card, five figures, six rooms: spending,
// company and owners, funding, clients and tenders, cash and runway, and
// every line.
//
// What is real and what is not is said on every figure: a green dot is a
// public or booked fact (the FY2025 received-invoices book, the BORME,
// ENISA's loan search); an amber dot is a simulation the reader can move
// (cash in the bank, income). Nothing simulated is presented as a fact.
//
// The ledger is @/lib/books (src/data/ledger-2025.csv): companies by name,
// one line per invoice; people and counsel one line a month each group, with
// a headcount, so nobody's pay can be read (STD-036 LED-006, DBT-022 §1.7).
// The company is @/data/company (public registers only); the loan is
// @/data/enisa; money in, cash and the business plan are @/data/money, each
// figure real, declared, plan or simulated; payroll is @/data/payroll.csv,
// one line a month for all staff, simulated until the payslips come. The markdown view (composed-md.ts) reads the same three.
//
// Who holds which share is NOT on this page: the Registry does not publish
// it and the partners have not yet agreed to. It enters from the deeds.
import Layout from "@/layouts/Layout.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { bookLines, bookLines2026, payrollLines, payrollQuarters, saleLines, cashBooks, BOOK_CATEGORIES } from "@/lib/books";
import { reconcile, futures, runRate } from "@/lib/cash";
import { TAX_KINDS, VAT_RESULTS, CALENDAR, VAT_2024_ESTIMATE, CORPORATE, GESTORIA_QUESTIONS, type VatResult } from "@/data/tax";
import { COMPANY, CAPITAL_STEPS, ACTS, ORGANS, bormeUrl } from "@/data/company";
import { ENISA, ENISA_INTEREST_TOTAL } from "@/data/enisa";
import { ROUNDS, CLIENTS, CASH, FUTURES, PLAN, GLOSSARY, MONEY_IN_TOTAL } from "@/data/money";
import { repoFileUrl } from "@/lib/build-info";

type AnyLine = ReturnType<typeof bookLines>[number] & { kind?: string; withholding?: string };
const lines = ([...bookLines(), ...bookLines2026(), ...payrollLines()] as AnyLine[]).map((l) => ({ d: l.date, a: l.period_from, b: l.period_to, c: l.category, w: l.supplier, n: Number(l.base), h: Number(l.headcount || 0), bl: l.billing, k: l.kind || "real" }));
const lines25 = lines.filter((l) => l.d.startsWith("2025"));
const TOTAL = lines25.reduce((s, l) => s + l.n, 0);
const q3 = lines.filter((l) => l.d >= "2026-07-01" && l.d <= "2026-09-30");
const MONTH_NOW = q3.reduce((s, l) => s + l.n, 0) / 3;
const payQ = payrollQuarters();
const payNow = Number(payQ[payQ.length - 1].employer_cost) / 3;
const YEARS = [
  { year: "2024", from: "2024-02-16", to: "2024-12-31", label: "2024, from 16 Feb", note: "payroll only: the 2024 invoice book is not loaded yet" },
  { year: "2025", from: "2025-01-01", to: "2025-12-31", label: "2025", note: "the whole invoice book and payroll" },
  { year: "2026", from: "2026-01-01", to: "2026-09-30", label: "2026, to 30 Sep", note: "payroll all year; invoices from July only" },
];

// Taxes, computed from the lines (STD-036 LED-009): VAT quarter by quarter,
// withholding and social security from payroll, the company's losses.
const sales = saleLines();
const qOf = (d: string) => `${d.slice(0, 4)}-Q${Math.floor((Number(d.slice(5, 7)) - 1) / 3) + 1}`;
const QS = ["2024", "2025", "2026"].flatMap((y) => [1, 2, 3, 4].map((q) => `${y}-Q${q}`));
const add = (o: Record<string, number>, k: string, v: number) => (o[k] = (o[k] ?? 0) + v);
const vIn: Record<string, number> = {}, vOut: Record<string, number> = {}, vRc: Record<string, number> = {}, wh: Record<string, number> = {}, ss: Record<string, number> = {};
for (const l of [...bookLines(), ...bookLines2026()] as AnyLine[]) {
  const q = qOf(l.date);
  if (l.vat === "21") add(vIn, q, Number(l.base) * 0.21);
  if (l.vat === "ISP") add(vRc, q, Number(l.base) * 0.21);
  if (Number(l.withholding || 0)) add(wh, q, Number(l.withholding));
}
for (const x of sales) if (x.vat === "21") add(vOut, qOf(x.date), Number(x.base) * 0.21);
for (const p of payQ) { add(wh, p.quarter, Number(p.income_tax)); add(ss, p.quarter, Number(p.social_security)); }
const share24: Record<string, number> = { "2024-Q1": 1.5, "2024-Q2": 3, "2024-Q3": 3, "2024-Q4": 3 };
for (const q in share24) vIn[q] = (VAT_2024_ESTIMATE.inputVat * share24[q]) / 10.5;
for (const q of ["2026-Q1", "2026-Q2", "2026-Q4"]) vIn[q] = vIn["2026-Q3"];
const kindOf = (q: string) => (q.startsWith("2024") || q === "2026-Q1" || q === "2026-Q2" ? "simulated" : q === "2026-Q4" ? "projected" : "estimate");
let credit = 0;
const VAT_Q = QS.map((q) => {
  const out = vOut[q] ?? 0, inp = vIn[q] ?? 0, before = credit, net = out - inp - before;
  let result: VatResult, amount: number;
  if (net > 0) { result = "to pay"; amount = net; credit = 0; }
  else if (q.endsWith("Q4")) { result = "to refund"; amount = -net; credit = 0; }
  else { result = "to offset"; amount = -net; credit = -net; }
  return { q, out, inp, rc: vRc[q] ?? 0, before, result, amount, kind: kindOf(q), wh: wh[q] ?? 0, ss: ss[q] ?? 0 };
});
const VAT_YEARS = ["2024", "2025", "2026"].map((y) => {
  const r = VAT_Q.filter((x) => x.q.startsWith(y));
  return { y, out: r.reduce((s, x) => s + x.out, 0), inp: r.reduce((s, x) => s + x.inp, 0), paid: r.filter((x) => x.result === "to pay").reduce((s, x) => s + x.amount, 0), refund: r.find((x) => x.result === "to refund")?.amount ?? 0, wh: r.reduce((s, x) => s + x.wh, 0), ss: r.reduce((s, x) => s + x.ss, 0), kind: y === "2025" ? "estimate" : "simulated" };
});
const creditNow = VAT_Q.find((x) => x.q === "2026-Q3")!.amount;
const sales25 = sales.filter((x) => x.date.startsWith("2025")).reduce((s, x) => s + Number(x.base), 0);
const loss25 = TOTAL - sales25;
const loss24floor = lines.filter((l) => l.d.startsWith("2024")).reduce((s, l) => s + l.n, 0) - sales.filter((x) => x.date.startsWith("2024")).reduce((s, x) => s + Number(x.base), 0);
const TAX = { calendar: CALENDAR, creditNow, refund25: VAT_YEARS[1].refund };
const byCat: Record<string, number> = {};
for (const l of lines25) byCat[l.c] = (byCat[l.c] ?? 0) + l.n;
const cats = Object.keys(BOOK_CATEGORIES).filter((c) => byCat[c]).sort((a, b) => byCat[b] - byCat[a]);
const eur = (n: number, d = 0) => n.toLocaleString("en-GB", { minimumFractionDigits: d, maximumFractionDigits: d }) + " €";
const date = (s: string) => new Date(s + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
let capRun = 0;
const capSteps = CAPITAL_STEPS.map((s) => ({ ...s, after: (capRun += s.increase) }));
const partners = 3000 + ROUNDS.reduce((s, r) => s + r.amount, 0);
const clientsIn = CLIENTS.reduce((s, c) => s + c.amount, 0);
// The cash: the bank balance, walked back to the lines (STD-036 LED-011),
// and the next quarter in three futures (LED-012), all from @/lib/cash.
const BOOKS = cashBooks();
const RECON = reconcile(BOOKS, { capital: 3000, rounds: ROUNDS.map((r) => ({ what: r.what, amount: r.amount, kind: r.kind })), loan: ENISA.principal }, { amount: CASH.amount, kind: CASH.kind, asOf: CASH.asOf });
const RATE = runRate(BOOKS);
const FUT: Record<string, ReturnType<typeof futures>> = {};
for (const pe of FUTURES.payrollEnds) for (const inc of FUTURES.income) FUT[`${pe}|${inc}`] = futures(BOOKS, { cash: CASH.amount, asOf: CASH.asOf, payrollEnds: pe, oneOff: FUTURES.oneOff, income: inc, incomeFrom: FUTURES.incomeFrom });
const KIND_PILL: Record<string, [string, string]> = { real: ["ob-pill--real", "real"], declared: ["ob-pill--decl", "declared"], plan: ["ob-pill--plan", "plan"], simulated: ["ob-pill--sim", "estimate"] };
const ym = (s: string) => new Date(s + "-01T00:00:00Z").toLocaleDateString("en-GB", { month: "long", timeZone: "UTC" });
const DATA = { fut: FUT, futures: FUTURES, rate: RATE, moneyIn: MONEY_IN_TOTAL, payNow, monthNow: MONTH_NOW, tax: TAX, cash: CASH, plan: PLAN, clientsIn, lines, cats: BOOK_CATEGORIES, years: YEARS, total: TOTAL, capital: COMPANY.capital, enisaQuarter: ENISA.interest[ENISA.interest.length - 1].amount, principal: ENISA.principal };
---

<Layout
  title="Open books — Numen Games S.L."
  description="The books of Numen Games S.L. since it was incorporated on 16 February 2024: what it spends, who governs it, where the money came from and how long it lasts. Real FY2025 figures; every simulation says so."
  canonicalPath="/system/open-books"
  activeNav="system/"
>
  <section class="ob" id="cq">
   <div class="ob-wrap">
    <header class="ob-hero">
     <div>
      <span class="ob-k ob-accent">System — Open books</span>
      <h1>The books of Numen Games S.L., since the day it was born.</h1>
      <p class="ob-lead">From {date(COMPANY.incorporated)}, the day the company was incorporated. What it costs to run, who governs it, where the money came from and how long it lasts. Every figure says whether it is real or a simulation you can move.</p>
      <div class="ob-badges">
       <span class="ob-badge ob-real">real — the FY2025 invoice book, Q3 2026 invoices, payroll, the Mercantile Registry, ENISA's loan register</span>
       <span class="ob-badge ob-decl">declared — said by the company, its document still to load: the rounds, the client income, the bank balance</span>
       <span class="ob-badge ob-plan">plan — the business plan: what the company intends</span>
       <span class="ob-badge ob-sim">simulated — estimates of the books not loaded, part of payroll, the futures you choose</span>
       <span class="ob-badge">not loaded yet — the 2024 invoice book, January–June 2026 invoices, the bank statement, the filed tax returns</span>
      </div>
      <div class="ob-toolbar"><DocToolbar mdUrl="/system/open-books.md" filename="numen-games-open-books.md" repoUrl={repoFileUrl("web/src/data/ledger-2025.csv")} lang="en" /></div>
     </div>
     <aside class="ob-card" id="ob-card" aria-label="Company card">
      <span class="ob-k">Company card</span>
      <h2>{COMPANY.name}</h2>
      <p class="ob-cardsub">{COMPANY.form} · Madrid · <span class="ob-pill ob-pill--real">emerging company</span></p>
      <dl>
       <dt>Tax ID</dt><dd class="ob-mono">{COMPANY.taxId}</dd>
       <dt>Office</dt><dd>{COMPANY.address[0]}<br />{COMPANY.address[1]}</dd>
       <dt>Born</dt><dd>{date(COMPANY.incorporated)} <span class="ob-dim">· Numinia conceived {date(COMPANY.conceived)}</span></dd>
       <dt>Capital</dt><dd class="ob-mono">{eur(COMPANY.capital, 2)}</dd>
       <dt>Registry</dt><dd class="ob-mono">{COMPANY.registry}</dd>
       <dt>Activity</dt><dd>{COMPANY.activity}</dd>
       <dt>Governed by</dt><dd>{COMPANY.governedBy}</dd>
       <dt>Contact</dt><dd><a href={`mailto:${COMPANY.contact}`}>{COMPANY.contact}</a></dd>
      </dl>
      <p class="ob-cardfoot">Emerging company under Law 28/2022 since {date(COMPANY.emerging.since)}, for {COMPANY.emerging.years} years (<a href={bormeUrl(COMPANY.emerging.borme)} target="_blank" rel="noopener noreferrer">BORME</a>).</p>
     </aside>
    </header>

    <div class="ob-kpis" id="ob-kpis"></div>

    <nav class="ob-rooms" role="tablist" aria-label="Rooms">
     <button type="button" class="ob-room" role="tab" data-room="spend" aria-selected="true">Spending</button>
     <button type="button" class="ob-room" role="tab" data-room="company" aria-selected="false">Company &amp; owners</button>
     <button type="button" class="ob-room" role="tab" data-room="funding" aria-selected="false">Funding <small>loans · capital · grants</small></button>
     <button type="button" class="ob-room" role="tab" data-room="clients" aria-selected="false">Clients &amp; tenders</button>
     <button type="button" class="ob-room" role="tab" data-room="cash" aria-selected="false">Cash &amp; runway</button>
     <button type="button" class="ob-room" role="tab" data-room="tax" aria-selected="false">Taxes</button>
     <button type="button" class="ob-room" role="tab" data-room="plan" aria-selected="false">Business plan</button>
     <button type="button" class="ob-room" role="tab" data-room="lines" aria-selected="false">Every line</button>
    </nav>

    <section class="ob-panel ob-on" id="ob-p-spend" role="tabpanel">
     <div class="ob-sec">
      <h3>What it costs, day by day</h3>
      <p class="ob-sub">Each cost is spread over the time it pays for: a monthly service over its month, the loan's interest over its quarter, a yearly licence over its year, a one-off purchase on its day. Hover or tap a bar to see what it is made of.</p>
      <div class="ob-box">
       <div class="ob-ctrl">
        <span class="ob-k">Year</span>
        <div class="ob-seg" id="ob-year"><button type="button" data-v="2024">2024</button><button type="button" data-v="2025" aria-pressed="true">2025</button><button type="button" data-v="2026">2026</button></div>
        <span class="ob-k">Period</span>
        <div class="ob-seg" id="ob-gran"><button type="button" data-v="day">Day</button><button type="button" data-v="week">Week</button><button type="button" data-v="month" aria-pressed="true">Month</button><button type="button" data-v="quarter">Quarter</button><button type="button" data-v="year">Year</button></div>
        <span class="ob-k">Chart</span>
        <div class="ob-seg" id="ob-kind"><button type="button" data-v="bars" aria-pressed="true">Stacked</button><button type="button" data-v="share">Share</button><button type="button" data-v="lines">Lines</button><button type="button" data-v="tree">Map</button></div>
        <span class="ob-k">Count</span>
        <div class="ob-seg" id="ob-mode"><button type="button" data-v="use" aria-pressed="true">Consumed</button><button type="button" data-v="bill">Billed</button></div>
       </div>
       <p class="ob-readout" id="ob-readout" aria-live="polite"></p>
       <div class="ob-chart" id="ob-chart"></div>
       <div class="ob-legend" id="ob-legend"></div>
      </div>
     </div>
     <div class="ob-sec ob-grid2">
      <div>
       <h3>Where it goes</h3>
       <p class="ob-sub">FY2025, net of VAT, by what it pays for, payroll included at employer cost.</p>
       <div class="ob-box"><table class="ob-t">
        <thead><tr><th>What</th><th class="ob-n">FY2025</th><th class="ob-n">Share</th></tr></thead>
        <tbody>{cats.map((c) => <tr><td><i class="ob-sw" style={`background:${BOOK_CATEGORIES[c].color}`}></i>{BOOK_CATEGORIES[c].label}</td><td class="ob-n">{eur(byCat[c])}</td><td class="ob-n">{(byCat[c] / TOTAL * 100).toFixed(1)}%</td></tr>)}</tbody>
        <tfoot><tr><td>Total</td><td class="ob-n">{eur(TOTAL)}</td><td></td></tr></tfoot>
       </table></div>
      </div>
      <div>
       <h3>What we pay for now</h3>
       <p class="ob-sub">Services still billed every month, at their last month's rate; LiveKit, Cursor and the old gestoría were cancelled in 2026, and Microsoft is to be retired around April 2027. Each supplier's card: <a href="/system/sys-012-suppliers">SYS-012</a>.</p>
       <div class="ob-box"><table class="ob-t" id="ob-now"></table></div>
      </div>
     </div>
    </section>

    <section class="ob-panel" id="ob-p-company" role="tabpanel">
     <div class="ob-sec ob-grid2">
      <div>
       <h3>How the capital grew</h3>
       <p class="ob-sub">The share capital is public and exact: {eur(COMPANY.capital, 2)}, raised in {CAPITAL_STEPS.length} steps. Who holds which part is not in the Registry and is not published here until the partners agree; it enters from the deeds.</p>
       <div class="ob-box">
        <div class="ob-capgrow" aria-hidden="true">{capSteps.map((s) => <div style={`width:${s.increase / COMPANY.capital * 100}%`} title={`${s.what}: +${eur(s.increase, 2)}`}></div>)}</div>
        <table class="ob-t">
         <thead><tr><th>Date</th><th>Step</th><th class="ob-n">Increase</th><th class="ob-n">Capital after</th></tr></thead>
         <tbody>{capSteps.map((s) => <tr><td class="ob-mono">{s.date}</td><td>{s.what} · <a href={bormeUrl(s.borme)} target="_blank" rel="noopener noreferrer">BORME</a></td><td class="ob-n">+{eur(s.increase, 2)}</td><td class="ob-n">{eur(s.after, 2)}</td></tr>)}</tbody>
        </table>
        <p class="ob-note"><span class="ob-pill ob-pill--real">real</span> Amounts and dates from the Mercantile Registry's gazette. The nominal only: any share premium paid on top, and each partner's part, are in the deeds.</p>
       </div>
      </div>
      <div>
       <h3>Every registered act</h3>
       <p class="ob-sub">What the Mercantile Registry and ENISA have published about the company.</p>
       <div class="ob-box ob-tl">{ACTS.map((a) => <div class={`ob-ev ob-ev--${a.kind}`}><div class="ob-evd">{a.date}</div><div class="ob-evh">{a.title}</div><div class="ob-evx">{a.text}</div><div class="ob-evs">{a.source.startsWith("BORME") ? <a href={bormeUrl(a.source)} target="_blank" rel="noopener noreferrer">{a.source}</a> : <a href={a.source} target="_blank" rel="noopener noreferrer">ENISA public loan search</a>}</div></div>)}</div>
      </div>
     </div>
     <div class="ob-sec ob-grid2">
      <div>
       <h3>Who governs it</h3>
       <p class="ob-sub">The company's organs, as registered. The Oracles and the guilds, the house's own roles, are in the canon.</p>
       <div class="ob-box ob-org">
        <div class="ob-node"><div class="ob-k">{ORGANS.meeting.role}</div><div class="ob-nm">{ORGANS.meeting.who}</div><div class="ob-dim">{ORGANS.meeting.note}</div></div>
        <div class="ob-edge"></div>
        <div class="ob-node ob-node--on"><div class="ob-k">{ORGANS.director.role}</div><div class="ob-nm">{ORGANS.director.who}</div><div class="ob-dim">{ORGANS.director.note}</div></div>
        <div class="ob-orgrow">{ORGANS.attorneys.map((a) => <div class="ob-node"><div class="ob-k">{a.role}</div><div class="ob-nm">{a.who}</div><div class="ob-dim">{a.note}</div></div>)}</div>
       </div>
      </div>
      <div>
       <h3>What a board would ask</h3>
       <p class="ob-sub">What this room answers today, and what it cannot yet.</p>
       <div class="ob-box"><table class="ob-t">
        <tbody>
         <tr><td>How much capital went in, and when?</td><td class="ob-n"><span class="ob-pill ob-pill--real">yes</span></td></tr>
         <tr><td>Who decides, and since when?</td><td class="ob-n"><span class="ob-pill ob-pill--real">yes</span></td></tr>
         <tr><td>What the company owes</td><td class="ob-n"><span class="ob-pill ob-pill--real">the loan</span></td></tr>
         <tr><td>Who owns which part</td><td class="ob-n"><span class="ob-pill ob-pill--empty">with the partners' consent</span></td></tr>
         <tr><td>At what valuation each step was taken</td><td class="ob-n"><span class="ob-pill ob-pill--empty">needs the deeds</span></td></tr>
         <tr><td>Annual accounts filed (FY2024, FY2025)</td><td class="ob-n"><span class="ob-pill ob-pill--empty">to load</span></td></tr>
        </tbody>
       </table></div>
      </div>
     </div>
    </section>

    <section class="ob-panel" id="ob-p-funding" role="tabpanel">
     <div class="ob-sec">
      <h3>Where the money came from</h3>
      <p class="ob-sub">Three kinds of money, never mixed: what the partners put in, what the company owes, and what clients paid. About {eur(MONEY_IN_TOTAL)} in all since 2024. Grants: none.</p>
      <div class="ob-box">
       <div class="ob-capgrow ob-capgrow--src" aria-hidden="true"><div style={`width:${partners / MONEY_IN_TOTAL * 100}%;background:rgb(var(--yellow))`}><span>Partners · {eur(partners)}</span></div><div style={`width:${ENISA.principal / MONEY_IN_TOTAL * 100}%;background:rgb(var(--blue))`}><span>ENISA · {eur(ENISA.principal)}</span></div><div style={`width:${clientsIn / MONEY_IN_TOTAL * 100}%;background:rgb(var(--green))`}></div></div>
       <div class="ob-grid3">
        <div><span class="ob-k">Equity · partners</span><div class="ob-big">{eur(partners)} <span class="ob-pill ob-pill--decl">declared</span></div><p class="ob-note">3,000 € at incorporation and two rounds; the registry shows {eur(COMPANY.capital, 2)} of nominal, the rest is share premium</p></div>
        <div><span class="ob-k">Debt · loans</span><div class="ob-big">{eur(ENISA.principal)} <span class="ob-pill ob-pill--real">real</span></div><p class="ob-note">ENISA, participative, still owed</p></div>
        <div><span class="ob-k">Clients</span><div class="ob-big">{eur(clientsIn)} <span class="ob-pill ob-pill--decl">declared</span></div><p class="ob-note">one client so far, in several invoices</p></div>
       </div>
      </div>
     </div>
     <div class="ob-sec">
      <h3>The rounds</h3>
      <p class="ob-sub">What the partners paid in each round, next to the nominal the Registry published. The difference is share premium: equity, not debt. Who paid which part enters from the deeds, with the partners' consent.</p>
      <div class="ob-box"><div class="ob-xs"><table class="ob-t">
       <thead><tr><th>Date</th><th>Round</th><th class="ob-n">Nominal (BORME)</th><th class="ob-n">Paid in</th><th></th></tr></thead>
       <tbody><tr><td class="ob-mono">2024-02-16</td><td>Incorporation</td><td class="ob-n">3,000 €</td><td class="ob-n">3,000 €</td><td class="ob-n"><span class="ob-pill ob-pill--real">real</span></td></tr>{ROUNDS.map((r) => <tr><td class="ob-mono">{r.date}</td><td>{r.what} · <a href={bormeUrl(r.borme)} target="_blank" rel="noopener noreferrer">BORME</a></td><td class="ob-n">{eur(r.nominal, 2)}</td><td class="ob-n">≈ {eur(r.amount)}</td><td class="ob-n"><span class="ob-pill ob-pill--decl">declared</span></td></tr>)}</tbody>
       <tfoot><tr><td colspan="2">Partners, together</td><td class="ob-n">{eur(COMPANY.capital, 2)}</td><td class="ob-n">≈ {eur(partners)}</td><td></td></tr></tfoot>
      </table></div><p class="ob-note"><span class="ob-pill ob-pill--decl">declared</span> The amounts paid are the company's word, rounded; they turn real when the deeds are loaded. ENISA usually lends up to what the partners put in: the first round came six months before the loan.</p></div>
     </div>
     <div class="ob-sec" id="cq-sec-enisa">
      <h3>The ENISA loan</h3>
      <div class="ob-box ob-enisa">
       <a class="ob-seal" href={ENISA.lenderUrl} target="_blank" rel="noopener noreferrer"><img src={ENISA.seal} width="240" height="160" alt="Financiada por ENISA — Ministerio de Industria y Turismo" loading="lazy" decoding="async" /></a>
       <div>
        <div class="ob-facts">
         <div class="ob-fact"><span class="ob-k">Granted</span><div class="ob-big">{eur(ENISA.principal)}</div></div>
         <div class="ob-fact"><span class="ob-k">Signed</span><div class="ob-big">{date(ENISA.signed)}</div></div>
         <div class="ob-fact"><span class="ob-k">Interest 2025</span><div class="ob-big">{eur(ENISA_INTEREST_TOTAL, 2)}</div></div>
         <div class="ob-fact"><span class="ob-k">Outstanding</span><div class="ob-big ob-dim">to load</div></div>
        </div>
        <table class="ob-t"><thead><tr><th>Quarter</th><th class="ob-n">Interest (net)</th></tr></thead><tbody>{ENISA.interest.map((q) => <tr><td>{q.quarter}</td><td class="ob-n">{eur(q.amount, 2)}</td></tr>)}</tbody></table>
        <p class="ob-why">A participative loan: no guarantee asked, interest partly tied to results, counted as equity for dissolution purposes. It is debt: ENISA holds no shares. <span class="ob-pill ob-pill--real">real</span> Amount and date as published in <a href={ENISA.register} target="_blank" rel="noopener noreferrer">ENISA's public loan search</a>; interest from the 2025 invoice book. Term, grace and repayment come from the contract. The record: <a href="/operations/ops-017-the-enisa-loan">{ENISA.record} The ENISA loan</a>.</p>
       </div>
      </div>
     </div>
     <div class="ob-sec ob-grid2">
      <div class="ob-empty"><h4>Grants</h4>None. The national grants register (BDNS) lists nothing for {COMPANY.taxId} under grants, state aid or de minimis aid, checked on 30 September 2026. When one is granted, it appears here with its call, amount and conditions.</div>
      <div class="ob-empty"><h4>Emerging-company status</h4>Recognised on {date(COMPANY.emerging.since)} under Law 28/2022, for {COMPANY.emerging.years} years: tax advantages, not money.</div>
     </div>
    </section>

    <section class="ob-panel" id="ob-p-clients" role="tabpanel">
     <div class="ob-sec ob-grid2">
      <div>
       <h3>Clients</h3>
       <p class="ob-sub">Who pays Numen Games, and for what: from the issued-invoices book, the way costs come from the received one.</p>
       <div class="ob-box"><table class="ob-t">
        <thead><tr><th>Sector</th><th>What for</th><th class="ob-n">Income</th></tr></thead>
        <tbody>{CLIENTS.map((c) => <tr><td>{c.sector}</td><td>{c.what} <span class="ob-dim">· {c.invoices}</span></td><td class="ob-n">≈ {eur(c.amount)} <span class="ob-pill ob-pill--decl">declared</span></td></tr>)}</tbody>
        <tfoot><tr><td colspan="2">Since 2024</td><td class="ob-n">≈ {eur(clientsIn)}</td></tr></tfoot>
       </table>
       <p class="ob-note">Everything invoiced since 2024. In 2025 the company cost about {eur(TOTAL / 12)} a month, payroll included: all its income would have paid for about {(DATA.clientsIn / (TOTAL / 12)).toFixed(1)} months. Each client appears by sector until it agrees to be named. The US invoices were in dollars, converted at the European Central Bank's rate of each invoice's date; the bank statement will give the rate actually received.</p></div>
      </div>
      <div>
       <h3>Tenders</h3>
       <p class="ob-sub">Public contracts the company bids for, won or lost: the call, the amount, the result.</p>
       <div class="ob-empty"><h4>None recorded</h4>When the first bid is filed, it gets its record in the archive and a line here, linked to the public procurement platform.</div>
      </div>
     </div>
     <div class="ob-sec">
      <h3>Pipeline</h3>
      <p class="ob-sub">Every chance to sell has its public record: <a href="/system/pipeline">the pipeline</a> and <a href="/opportunities/">the opportunities</a>.</p>
     </div>
    </section>

    <section class="ob-panel" id="ob-p-cash" role="tabpanel">
     <div class="ob-sec">
      <h3>Time to tomb</h3>
      <p class="ob-sub">The bank held about {eur(CASH.amount)} on {date(CASH.asOf)}, in the company's words, until the statement is loaded. From then the counter spends it second by second at today's monthly cost, in the future chosen below.</p>
      <div class="ob-box ob-count" id="ob-countdown" aria-live="off">
       <div><span class="ob-k">Cash left, now <span class="ob-pill ob-pill--decl">declared</span></span><div class="ob-cnum" id="ob-cnow">—</div><div class="ob-dim">{eur(CASH.amount)} on {date(CASH.asOf)}, less the cost since</div></div>
       <div><span class="ob-k">The money runs out in</span><div class="ob-clock" id="ob-clock">—</div><div class="ob-dim" id="ob-cdate"></div></div>
      </div>
     </div>
     <div class="ob-sec">
      <h3>Where the cash comes from</h3>
      <p class="ob-sub">Everything that came in, less everything that went out, should be what the bank holds. Two books are not loaded yet, so they enter as estimates; what is left after them is a difference nobody has explained yet.</p>
      <div class="ob-box">
       <p class="ob-alert" id="ob-recon-alert" role="status" hidden={!RECON.alert}><b>The figures do not add up yet.</b> After the estimates, {eur(Math.abs(RECON.gap))} {RECON.gap > 0 ? "should be in the bank and is not" : "is in the bank and the books do not explain it"}. It closes when the 2024 book, the January–June 2026 invoices and the bank statement are loaded.</p>
       <div class="ob-xs"><table class="ob-t ob-recon" id="ob-recon">
        <thead><tr><th>Step</th><th class="ob-n">Amount</th><th>Kind</th></tr></thead>
        <tbody>
         <tr class="ob-rh"><td colspan="3">Money in, since 16 February 2024</td></tr>
         {RECON.rows.filter((r) => r.group === "in").map((r) => <tr><td>{r.label} <span class="ob-dim">· {r.note}</span></td><td class="ob-n">{eur(r.amount)}</td><td><span class={`ob-pill ${KIND_PILL[r.kind][0]}`}>{KIND_PILL[r.kind][1]}</span></td></tr>)}
         <tr class="ob-rs"><td>Money in</td><td class="ob-n">{eur(RECON.moneyIn)}</td><td></td></tr>
         <tr class="ob-rh"><td colspan="3">Less what went out, loaded in the books</td></tr>
         {RECON.rows.filter((r) => r.group === "out").map((r) => <tr><td>{r.label} <span class="ob-dim">· {r.note}</span></td><td class="ob-n">−{eur(r.amount)}</td><td><span class={`ob-pill ${KIND_PILL[r.kind][0]}`}>{KIND_PILL[r.kind][1]}</span></td></tr>)}
         <tr class="ob-rh"><td colspan="3">Less what went out, books not loaded yet</td></tr>
         {RECON.rows.filter((r) => r.group === "missing").map((r) => <tr><td>{r.label} <span class="ob-dim">· {r.note}</span></td><td class="ob-n">−{eur(r.amount)}</td><td><span class={`ob-pill ${KIND_PILL[r.kind][0]}`}>{KIND_PILL[r.kind][1]}</span></td></tr>)}
         <tr class="ob-rs"><td>Cash the books expect</td><td class="ob-n">{eur(RECON.expected)}</td><td><span class="ob-pill ob-pill--sim">estimate</span></td></tr>
         <tr><td>Cash in the bank, {date(CASH.asOf)} <span class="ob-dim">· the company's word, until the statement is loaded</span></td><td class="ob-n">{eur(CASH.amount)}</td><td><span class="ob-pill ob-pill--decl">declared</span></td></tr>
        </tbody>
        <tfoot><tr class={RECON.alert ? "ob-gap" : ""}><td>Difference not explained</td><td class="ob-n">{RECON.gap > 0 ? "−" : "+"}{eur(Math.abs(RECON.gap))}</td><td></td></tr></tfoot>
       </table></div>
       <p class="ob-note">Money in and out includes VAT where it was charged, since that is what the bank saw; the books elsewhere on this page are net of VAT. What can still move the difference: lawyers and freelancers paid in 2024, VAT refunds Hacienda has paid, any ENISA principal already repaid, whether the 2026 round came in whole, and bank fees.</p>
      </div>
     </div>
     <div class="ob-sec">
      <h3>The next quarter, three ways</h3>
      <p class="ob-sub">Three futures from today's monthly cost of {eur(RATE.total)}, looked at for three months and no further: beyond a quarter a forecast is a guess. Each says the day the cash runs out if its third month went on for ever.</p>
      <div class="ob-box ob-sliders" id="ob-fctl">
       <span class="ob-k">Payroll ends at the end of</span>
       <div class="ob-seg" id="ob-pend">{FUTURES.payrollEnds.map((m, i) => <button type="button" data-v={m} aria-pressed={String(i === 0)}>{ym(m)}</button>)}</div>
       <span class="ob-k">Income a month, from {ym(FUTURES.incomeFrom)}</span>
       <div class="ob-seg" id="ob-finc">{FUTURES.income.map((v, i) => <button type="button" data-v={String(v)} aria-pressed={String(i === 1)}>{eur(v)}</button>)}</div>
       <span class="ob-pill ob-pill--sim">simulated — the futures</span>
      </div>
      <div class="ob-scen" id="ob-futures"></div>
     </div>
     <div class="ob-sec ob-grid2">
      <div>
       <h3>Cash, month by month</h3>
       <p class="ob-sub">Cash at the end of each of the next three months in each future, from the bank balance of 1 October 2026. Where a line crosses zero, the cash is gone.</p>
       <div class="ob-box"><div class="ob-chart" id="ob-tomb"></div></div>
      </div>
      <div>
       <h3>What closing costs</h3>
       <p class="ob-sub">Winding up a Spanish S.L. is not free, and the loan does not disappear with it.</p>
       <div class="ob-box"><table class="ob-t" id="ob-close"></table><p class="ob-note">Estimates for a company this size, not quotes. A participative loan ranks after ordinary creditors, but it is still owed; the figure assumes no principal repaid yet. The gestoría and the contract give the exact numbers.</p></div>
      </div>
     </div>
    </section>

    <section class="ob-panel" id="ob-p-tax" role="tabpanel">
     <div class="ob-sec">
      <h3>Taxes, explained from zero</h3>
      <p class="ob-sub">A company does not pay one tax: it pays some, collects others for Hacienda, and is owed some back. Every figure in this room is computed from the lines of the books and is an <b>estimate</b> until the gestoría's filed returns are loaded. This is not tax advice; the gestoría files and decides.</p>
      <div class="ob-box ob-count ob-taxcount" id="ob-taxcount" aria-live="off">
       <div><span class="ob-k">Next filing</span><div class="ob-nm" id="ob-tnext">—</div><div class="ob-clock ob-clock--tax" id="ob-tclock">—</div><div class="ob-dim" id="ob-tdue"></div></div>
       <div class="ob-tgrid">
        <div><span class="ob-k">To pay at that filing <span class="ob-pill ob-pill--sim">estimate</span></span><div class="ob-tpay" id="ob-tpay">—</div></div>
        <div><span class="ob-k">VAT Hacienda owes us now <span class="ob-pill ob-pill--sim">estimate</span></span><div class="ob-cnum ob-pos">{eur(creditNow)}</div></div>
       </div>
      </div>
     </div>
     <div class="ob-sec">
      <div class="ob-box ob-gq" id="ob-gq">
       <div><span class="ob-k">Open questions for the gestoría</span><div class="ob-cnum">{GESTORIA_QUESTIONS.length}</div></div>
       <ul>{GESTORIA_QUESTIONS.map((q) => <li>{q.topic} <span class="ob-dim">· moves {q.moves}</span></li>)}</ul>
      </div>
     </div>
     <div class="ob-sec">
      <h3>The five kinds of tax that touch the company</h3>
      <p class="ob-sub">What each one is, who really pays it, how often, and what it means for us.</p>
      <div class="ob-taxkinds">{TAX_KINDS.map((t) => <div class="ob-box ob-tk"><span class="ob-k">{t.spanish} · every {t.every}</span><h4>{t.name}</h4><p>{t.plain}</p><p><b>Who really pays it.</b> {t.whoPays}</p><p><b>For us.</b> {t.ours}</p><p class="ob-dim">Form: {t.form}</p></div>)}</div>
     </div>
     <div class="ob-sec">
      <h3>VAT: the three ways a quarter can end</h3>
      <p class="ob-sub">Every quarter the company adds up the VAT it charged its clients and the VAT its suppliers charged it, and files the difference on form 303. The difference ends in one of three ways, with the words of Hacienda's own form.</p>
      <div class="ob-grid3">{(Object.keys(VAT_RESULTS) as VatResult[]).map((k) => <div class="ob-box"><span class={`ob-pill ob-res ob-res--${k.replace(" ", "-")}`}>{VAT_RESULTS[k].label}</span><p class="ob-tkp">{VAT_RESULTS[k].plain}</p></div>)}</div>
      <p class="ob-why">Why Hacienda owes us money: our one large client is a city in the United States, and a service sold outside the European Union carries no Spanish VAT. So almost no VAT came in, while every Spanish supplier charged us 21%. Foreign suppliers that do not charge VAT (reverse charge) change nothing: the company declares their VAT and deducts it in the same return, so it nets to zero.</p>
     </div>
     <div class="ob-sec">
      <h3>VAT quarter by quarter</h3>
      <p class="ob-sub">VAT charged to clients, VAT paid to suppliers, the credit carried from earlier quarters, and the result. In the fourth quarter a credit can be asked back in cash instead of carried on.</p>
      <div class="ob-box"><div class="ob-xs"><table class="ob-t">
       <thead><tr><th>Quarter</th><th class="ob-n">Charged</th><th class="ob-n">Paid to suppliers</th><th class="ob-n">Carried in</th><th>Result</th><th class="ob-n">Amount</th><th>Kind</th></tr></thead>
       <tbody>{VAT_Q.map((x) => <tr><td class="ob-mono">{x.q}</td><td class="ob-n">{eur(x.out)}</td><td class="ob-n">{eur(x.inp)}</td><td class="ob-n">{x.before ? eur(x.before) : "—"}</td><td><span class={`ob-pill ob-res ob-res--${x.result.replace(" ", "-")}`}>{VAT_RESULTS[x.result].label}</span></td><td class="ob-n">{eur(x.amount)}</td><td><span class={`ob-pill ${x.kind === "estimate" ? "ob-pill--real" : "ob-pill--sim"}`}>{x.kind === "estimate" ? "from the book" : x.kind}</span></td></tr>)}</tbody>
      </table></div>
      <p class="ob-note"><span class="ob-pill ob-pill--real">from the book</span> computed from real invoice lines, not yet checked against the filed return. <span class="ob-pill ob-pill--sim">simulated</span> 2024 and January–June 2026, whose invoice books are not loaded: {VAT_2024_ESTIMATE.why} January–June 2026 repeats July–September. <span class="ob-pill ob-pill--sim">projected</span> the quarter still running.</p></div>
     </div>
     <div class="ob-sec ob-grid2">
      <div>
       <h3>Year by year</h3>
       <p class="ob-sub">What the company handed over and what it can ask back, by year.</p>
       <div class="ob-box"><div class="ob-xs"><table class="ob-t">
        <thead><tr><th>Year</th><th class="ob-n">VAT paid</th><th class="ob-n">VAT to ask back</th><th class="ob-n">Income tax withheld</th><th class="ob-n">Social security</th></tr></thead>
        <tbody>{VAT_YEARS.map((y) => <tr><td>{y.y} <span class={`ob-pill ${y.kind === "estimate" ? "ob-pill--real" : "ob-pill--sim"}`}>{y.kind === "estimate" ? "from the book" : "simulated"}</span></td><td class="ob-n">{eur(y.paid)}</td><td class="ob-n ob-pos">{eur(y.refund)}</td><td class="ob-n">{eur(y.wh)}</td><td class="ob-n">{eur(y.ss)}</td></tr>)}</tbody>
       </table></div>
       <p class="ob-note">The refund is asked for in the fourth quarter's return, filed in January, and Hacienda has six months to pay it. Whether the 2024 and 2025 refunds were asked for and paid is in those returns, not loaded yet. Income tax withheld is from payroll and, from July 2026, from professionals' invoices; the 2025 freelancers' withholding is in the gestoría's books.</p></div>
      </div>
      <div>
       <h3>Corporate tax and the losses kept</h3>
       <p class="ob-sub">The company's own income tax is paid on profit. So far there has been none.</p>
       <div class="ob-box"><table class="ob-t"><tbody>
        <tr><td>Loss, 2025 <span class="ob-pill ob-pill--real">from the book</span></td><td class="ob-n ob-neg">−{eur(loss25)}</td></tr>
        <tr><td>Loss, 2024 <span class="ob-pill ob-pill--sim">at least</span></td><td class="ob-n ob-neg">−{eur(loss24floor)}</td></tr>
        <tr><td>Corporate tax paid</td><td class="ob-n">0 €</td></tr>
        <tr><td>Tax those losses will save, at {CORPORATE.rate * 100}%</td><td class="ob-n ob-pos">{eur((loss25 + loss24floor) * CORPORATE.rate)}</td></tr>
       </tbody></table>
       <p class="ob-note">Losses are not lost: they are kept and subtracted from future profits, so the first profitable years pay less or nothing. {CORPORATE.note} The 2024 loss counts only payroll until the 2024 book is loaded. The loan's interest is a deductible financial expense, already inside the loss.</p></div>
      </div>
     </div>
     <div class="ob-sec">
      <h3>The calendar</h3>
      <p class="ob-sub">Every filing of the next twelve months. A deadline that falls on a weekend moves to the next working day.</p>
      <div class="ob-box"><div class="ob-xs"><table class="ob-t" id="ob-tcal">
       <thead><tr><th>By</th><th>What</th><th>Form</th><th class="ob-n">Estimate</th></tr></thead>
       <tbody>{CALENDAR.map((c) => <tr data-due={c.due}><td class="ob-mono">{c.due}</td><td>{c.what}</td><td class="ob-mono">{c.form}</td><td class="ob-n">{c.estimate}</td></tr>)}</tbody>
      </table></div></div>
     </div>
    </section>

    <section class="ob-panel" id="ob-p-plan" role="tabpanel">
     <div class="ob-sec ob-grid2">
      <div>
       <h3>The vision</h3>
       <p class="ob-sub"><span class="ob-pill ob-pill--plan">plan</span> Drafted {date(PLAN.drafted)}. A plan is a promise to ourselves, not a fact; it is shown next to what happened so the gap can be read.</p>
       <div class="ob-box"><p class="ob-vision">{PLAN.vision}</p></div>
      </div>
      <div>
       <h3>Where we are</h3>
       <p class="ob-sub">The delicate moment, in four figures.</p>
       <div class="ob-box"><table class="ob-t"><tbody>
        <tr><td>Money in since 2024</td><td class="ob-n">≈ {eur(MONEY_IN_TOTAL)}</td></tr>
        <tr><td>Clients so far</td><td class="ob-n">1 · ≈ {eur(clientsIn)}</td></tr>
        <tr><td>Still owed to ENISA</td><td class="ob-n">{eur(ENISA.principal)}</td></tr>
        <tr><td>Cash in the bank, {date(CASH.asOf)}</td><td class="ob-n">{eur(CASH.amount)} <span class="ob-pill ob-pill--decl">declared</span></td></tr>
       </tbody></table></div>
      </div>
     </div>
     <div class="ob-sec">
      <h3>The assumptions</h3>
      <p class="ob-sub">Move them: the plan below is recomputed from these five numbers. They start where the company hopes to be in {PLAN.start}.</p>
      <div class="ob-box ob-sliders" id="ob-plan-in">
       <label>Projects a year <input type="range" data-k="projectsPerYear" min="0" max="12" step="1" /> <b></b></label>
       <label>Average project <input type="range" data-k="projectSize" min="5000" max="80000" step="1000" /> <b></b></label>
       <label>Hosting a world, a month <input type="range" data-k="hostingPerWorld" min="0" max="1500" step="50" /> <b></b></label>
       <label>Monthly cost <input type="range" data-k="monthlyCost" min="2000" max="20000" step="250" /> <b></b></label>
       <label>Growth a year <input type="range" data-k="growth" min="0" max="1" step="0.05" /> <b></b></label>
       <span class="ob-pill ob-pill--plan">plan</span>
      </div>
     </div>
     <div class="ob-sec ob-grid2">
      <div>
       <h3>Profit and loss, three years</h3>
       <p class="ob-sub">Income from projects and from hosting the worlds already sold, against the cost of running.</p>
       <div class="ob-box"><table class="ob-t" id="ob-pl"></table></div>
      </div>
      <div>
       <h3>Break-even and what is missing</h3>
       <p class="ob-sub">How many projects a year pay the cost, and how much money the plan needs before it pays itself.</p>
       <div class="ob-box" id="ob-be"></div>
      </div>
     </div>
     <div class="ob-sec">
      <h3>Cash, month by month</h3>
      <p class="ob-sub">The plan's cash for the next 36 months, starting from the cash in the bank on 1 October 2026. Where the line falls below zero, the company needs money before then.</p>
      <div class="ob-box"><div class="ob-chart" id="ob-plan-cash"></div></div>
     </div>
     <div class="ob-sec ob-grid2">
      <div>
       <h3>Plan against reality</h3>
       <p class="ob-sub">Each month, what the plan said and what happened. It starts when the plan is a month old.</p>
       <div class="ob-empty"><h4>From November 2026</h4>The first month of the plan closes on 31 October. From then on, a line a month: planned income, real income, planned cost, real cost.</div>
      </div>
      <div>
       <h3>How to read a startup</h3>
       <p class="ob-sub">The words this page uses, with our figures as the example.</p>
       <div class="ob-box"><dl class="ob-gl">{GLOSSARY.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl></div>
      </div>
     </div>
    </section>

    <section class="ob-panel" id="ob-p-lines" role="tabpanel">
     <div class="ob-sec">
      <h3>Every line</h3>
      <p class="ob-sub">The ledger itself: FY2025, net of VAT, newest first. Companies one line per invoice; people and counsel one line a month each group, with how many they were, so nobody's pay can be read. The invoices stay with the company.</p>
      <div class="ob-box">
       <div class="ob-ctrl"><input id="ob-q" type="search" placeholder="Search a supplier" aria-label="Search a supplier" autocomplete="off" /><div class="ob-seg" id="ob-lcat"></div><a class="ob-dl" href="/system/open-books.csv" download="numen-games-ledger-2025.csv">Download (CSV)</a></div>
       <div class="ob-scroll"><table class="ob-t" id="ob-ledger"></table></div>
      </div>
     </div>
    </section>
   </div>
  </section>
  <div id="ob-tip" role="tooltip"></div>
</Layout>

<script is:inline id="ob-data" type="application/json" set:html={JSON.stringify(DATA)} />

<style is:global>
.ob{padding:40px 0 80px}
.ob-wrap{max-width:1180px;margin:0 auto;padding:0 24px}
.ob-k{display:block;font:500 .64rem var(--font-mono);letter-spacing:.18em;text-transform:uppercase;color:rgb(var(--text-dim))}
.ob-accent{color:rgb(var(--accent))}
.ob-mono{font-family:var(--font-mono);font-size:.8rem}
.ob-dim{color:rgb(var(--text-dim))}
.ob-hero{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:28px;align-items:start;margin-bottom:24px}
