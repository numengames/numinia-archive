---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// Open books — the books of Numen Games S.L., from the day it was born
// (16 February 2024). One company card, five figures, six rooms: spending,
// company and owners, funding, clients and tenders, cash and runway, and
// every line.
//
// What is real and what is not is said on every figure: a green dot is a
// public or booked fact (the FY2025 received-invoices book, the BORME,
// ENISA's loan search); an amber dot is a simulation the reader can move
// (cash in the bank, income). Nothing simulated is presented as a fact.
//
// The ledger is @/lib/books (src/data/ledger-2025.csv): companies by name,
// one line per invoice; people and counsel one line a month each group, with
// a headcount, so nobody's pay can be read (STD-036 LED-006, DBT-022 §1.7).
// The company is @/data/company (public registers only); the loan is
// @/data/enisa; money in, cash and the business plan are @/data/money, each
// figure real, declared, plan or simulated; payroll is @/data/payroll.csv,
// one line a month for all staff, simulated until the payslips come. The markdown view (composed-md.ts) reads the same three.
//
// Who holds which share is NOT on this page: the Registry does not publish
// it and the partners have not yet agreed to. It enters from the deeds.
import Layout from "@/layouts/Layout.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { bookLines, BOOK_CATEGORIES, BOOK_YEARS } from "@/lib/books";
import { COMPANY, CAPITAL_STEPS, ACTS, ORGANS, bormeUrl } from "@/data/company";
import { ENISA, ENISA_INTEREST_TOTAL } from "@/data/enisa";
import { ROUNDS, CLIENTS, CASH, PLAN, GLOSSARY, MONEY_IN_TOTAL } from "@/data/money";
import payrollRaw from "@/data/payroll.csv?raw";
import { repoFileUrl } from "@/lib/build-info";

const lines = bookLines().map((l) => ({ d: l.date, a: l.period_from, b: l.period_to, c: l.category, w: l.supplier, n: Number(l.base), h: Number(l.headcount || 0) }));
const TOTAL = lines.reduce((s, l) => s + l.n, 0);
const byCat: Record<string, number> = {};
for (const l of lines) byCat[l.c] = (byCat[l.c] ?? 0) + l.n;
const cats = Object.keys(BOOK_CATEGORIES).filter((c) => byCat[c]).sort((a, b) => byCat[b] - byCat[a]);
const eur = (n: number, d = 0) => n.toLocaleString("en-GB", { minimumFractionDigits: d, maximumFractionDigits: d }) + " €";
const date = (s: string) => new Date(s + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
let capRun = 0;
const capSteps = CAPITAL_STEPS.map((s) => ({ ...s, after: (capRun += s.increase) }));
const payroll = payrollRaw.trim().split("\n").slice(1).map((l) => { const [m, h, g, ss] = l.split(";"); return { m, h: Number(h), g: Number(g), ss: Number(ss) }; });
const pay25 = payroll.filter((p) => p.m.startsWith("2025")).reduce((s, p) => s + p.g + p.ss, 0);
const payNow = payroll[payroll.length - 1];
const partners = 3000 + ROUNDS.reduce((s, r) => s + r.amount, 0);
const clientsIn = CLIENTS.reduce((s, c) => s + c.amount, 0);
const DATA = { moneyIn: MONEY_IN_TOTAL, payroll, payNow: payNow.g + payNow.ss, cash: CASH, plan: PLAN, clientsIn, lines, cats: BOOK_CATEGORIES, years: BOOK_YEARS, total: TOTAL, capital: COMPANY.capital, enisaQuarter: ENISA.interest[ENISA.interest.length - 1].amount, principal: ENISA.principal };
---

<Layout
  title="Open books — Numen Games S.L."
  description="The books of Numen Games S.L. since it was incorporated on 16 February 2024: what it spends, who governs it, where the money came from and how long it lasts. Real FY2025 figures; every simulation says so."
  canonicalPath="/system/open-books"
  activeNav="system/"
>
  <section class="ob" id="cq">
   <div class="ob-wrap">
    <header class="ob-hero">
     <div>
      <span class="ob-k ob-accent">System — Open books</span>
      <h1>The books of Numen Games S.L., since the day it was born.</h1>
      <p class="ob-lead">From {date(COMPANY.incorporated)}, the day the company was incorporated. What it costs to run, who governs it, where the money came from and how long it lasts. Every figure says whether it is real or a simulation you can move.</p>
      <div class="ob-badges">
       <span class="ob-badge ob-real">real — the FY2025 invoice book, the Mercantile Registry, ENISA's loan register</span>
       <span class="ob-badge ob-decl">declared — said by the company, its document still to load: the rounds, the client income</span>
       <span class="ob-badge ob-plan">plan — the business plan: what the company intends</span>
       <span class="ob-badge ob-sim">simulated — cash in the bank, payroll, income, to try scenarios</span>
       <span class="ob-badge">not loaded yet — FY2024 (from 16 Feb), FY2026 invoices, the bank balance</span>
      </div>
      <div class="ob-toolbar"><DocToolbar mdUrl="/system/open-books.md" filename="numen-games-open-books.md" repoUrl={repoFileUrl("web/src/data/ledger-2025.csv")} lang="en" /></div>
     </div>
     <aside class="ob-card" id="ob-card" aria-label="Company card">
      <span class="ob-k">Company card</span>
      <h2>{COMPANY.name}</h2>
      <p class="ob-cardsub">{COMPANY.form} · Madrid · <span class="ob-pill ob-pill--real">emerging company</span></p>
      <dl>
       <dt>Tax ID</dt><dd class="ob-mono">{COMPANY.taxId}</dd>
       <dt>Office</dt><dd>{COMPANY.address[0]}<br />{COMPANY.address[1]}</dd>
       <dt>Born</dt><dd>{date(COMPANY.incorporated)} <span class="ob-dim">· Numinia conceived {date(COMPANY.conceived)}</span></dd>
       <dt>Capital</dt><dd class="ob-mono">{eur(COMPANY.capital, 2)}</dd>
       <dt>Registry</dt><dd class="ob-mono">{COMPANY.registry}</dd>
       <dt>Activity</dt><dd>{COMPANY.activity}</dd>
       <dt>Governed by</dt><dd>{COMPANY.governedBy}</dd>
       <dt>Contact</dt><dd><a href={`mailto:${COMPANY.contact}`}>{COMPANY.contact}</a></dd>
      </dl>
      <p class="ob-cardfoot">Emerging company under Law 28/2022 since {date(COMPANY.emerging.since)}, for {COMPANY.emerging.years} years (<a href={bormeUrl(COMPANY.emerging.borme)} target="_blank" rel="noopener noreferrer">BORME</a>).</p>
     </aside>
    </header>

    <div class="ob-kpis" id="ob-kpis"></div>

    <nav class="ob-rooms" role="tablist" aria-label="Rooms">
     <button type="button" class="ob-room" role="tab" data-room="spend" aria-selected="true">Spending</button>
     <button type="button" class="ob-room" role="tab" data-room="company" aria-selected="false">Company &amp; owners</button>
     <button type="button" class="ob-room" role="tab" data-room="funding" aria-selected="false">Funding <small>loans · capital · grants</small></button>
     <button type="button" class="ob-room" role="tab" data-room="clients" aria-selected="false">Clients &amp; tenders</button>
     <button type="button" class="ob-room" role="tab" data-room="cash" aria-selected="false">Cash &amp; runway</button>
     <button type="button" class="ob-room" role="tab" data-room="plan" aria-selected="false">Business plan</button>
     <button type="button" class="ob-room" role="tab" data-room="lines" aria-selected="false">Every line</button>
    </nav>

    <section class="ob-panel ob-on" id="ob-p-spend" role="tabpanel">
     <div class="ob-sec">
      <h3>What it costs, day by day</h3>
      <p class="ob-sub">Each cost is spread over the time it pays for: a monthly service over its month, the loan's interest over its quarter, a yearly licence over its year, a one-off purchase on its day. Hover or tap a bar to see what it is made of.</p>
      <div class="ob-box">
       <div class="ob-ctrl">
        <span class="ob-k">Period</span>
        <div class="ob-seg" id="ob-gran"><button type="button" data-v="day">Day</button><button type="button" data-v="week">Week</button><button type="button" data-v="month" aria-pressed="true">Month</button><button type="button" data-v="quarter">Quarter</button><button type="button" data-v="year">Year</button></div>
        <span class="ob-k">Chart</span>
        <div class="ob-seg" id="ob-kind"><button type="button" data-v="bars" aria-pressed="true">Stacked</button><button type="button" data-v="share">Share</button><button type="button" data-v="lines">Lines</button><button type="button" data-v="tree">Map</button></div>
        <span class="ob-k">Count</span>
        <div class="ob-seg" id="ob-mode"><button type="button" data-v="use" aria-pressed="true">Consumed</button><button type="button" data-v="bill">Billed</button></div>
       </div>
       <p class="ob-readout" id="ob-readout" aria-live="polite"></p>
       <div class="ob-chart" id="ob-chart"></div>
       <div class="ob-legend" id="ob-legend"></div>
      </div>
     </div>
     <div class="ob-sec ob-grid2">
      <div>
       <h3>Where it goes</h3>
       <p class="ob-sub">FY2025, net of VAT, by what it pays for.</p>
       <div class="ob-box"><table class="ob-t">
        <thead><tr><th>What</th><th class="ob-n">FY2025</th><th class="ob-n">Share</th></tr></thead>
        <tbody>{cats.map((c) => <tr><td><i class="ob-sw" style={`background:${BOOK_CATEGORIES[c].color}`}></i>{BOOK_CATEGORIES[c].label}</td><td class="ob-n">{eur(byCat[c])}</td><td class="ob-n">{(byCat[c] / TOTAL * 100).toFixed(1)}%</td></tr>)}</tbody>
        <tfoot><tr><td>Total</td><td class="ob-n">{eur(TOTAL)}</td><td></td></tr></tfoot>
       </table></div>
      </div>
      <div>
       <h3>What we pay for now</h3>
       <p class="ob-sub">Services billed every month, at their last month's rate. Each supplier's card: <a href="/system/sys-012-suppliers">SYS-012</a>.</p>
       <div class="ob-box"><table class="ob-t" id="ob-now"></table></div>
      </div>
     </div>
    </section>

    <section class="ob-panel" id="ob-p-company" role="tabpanel">
     <div class="ob-sec ob-grid2">
      <div>
       <h3>How the capital grew</h3>
       <p class="ob-sub">The share capital is public and exact: {eur(COMPANY.capital, 2)}, raised in {CAPITAL_STEPS.length} steps. Who holds which part is not in the Registry and is not published here until the partners agree; it enters from the deeds.</p>
       <div class="ob-box">
        <div class="ob-capgrow" aria-hidden="true">{capSteps.map((s) => <div style={`width:${s.increase / COMPANY.capital * 100}%`} title={`${s.what}: +${eur(s.increase, 2)}`}></div>)}</div>
        <table class="ob-t">
         <thead><tr><th>Date</th><th>Step</th><th class="ob-n">Increase</th><th class="ob-n">Capital after</th></tr></thead>
         <tbody>{capSteps.map((s) => <tr><td class="ob-mono">{s.date}</td><td>{s.what} · <a href={bormeUrl(s.borme)} target="_blank" rel="noopener noreferrer">BORME</a></td><td class="ob-n">+{eur(s.increase, 2)}</td><td class="ob-n">{eur(s.after, 2)}</td></tr>)}</tbody>
        </table>
        <p class="ob-note"><span class="ob-pill ob-pill--real">real</span> Amounts and dates from the Mercantile Registry's gazette. The nominal only: any share premium paid on top, and each partner's part, are in the deeds.</p>
       </div>
      </div>
      <div>
       <h3>Every registered act</h3>
       <p class="ob-sub">What the Mercantile Registry and ENISA have published about the company.</p>
       <div class="ob-box ob-tl">{ACTS.map((a) => <div class={`ob-ev ob-ev--${a.kind}`}><div class="ob-evd">{a.date}</div><div class="ob-evh">{a.title}</div><div class="ob-evx">{a.text}</div><div class="ob-evs">{a.source.startsWith("BORME") ? <a href={bormeUrl(a.source)} target="_blank" rel="noopener noreferrer">{a.source}</a> : <a href={a.source} target="_blank" rel="noopener noreferrer">ENISA public loan search</a>}</div></div>)}</div>
      </div>
     </div>
     <div class="ob-sec ob-grid2">
      <div>
       <h3>Who governs it</h3>
       <p class="ob-sub">The company's organs, as registered. The Oracles and the guilds, the house's own roles, are in the canon.</p>
       <div class="ob-box ob-org">
        <div class="ob-node"><div class="ob-k">{ORGANS.meeting.role}</div><div class="ob-nm">{ORGANS.meeting.who}</div><div class="ob-dim">{ORGANS.meeting.note}</div></div>
        <div class="ob-edge"></div>
        <div class="ob-node ob-node--on"><div class="ob-k">{ORGANS.director.role}</div><div class="ob-nm">{ORGANS.director.who}</div><div class="ob-dim">{ORGANS.director.note}</div></div>
        <div class="ob-orgrow">{ORGANS.attorneys.map((a) => <div class="ob-node"><div class="ob-k">{a.role}</div><div class="ob-nm">{a.who}</div><div class="ob-dim">{a.note}</div></div>)}</div>
       </div>
      </div>
      <div>
       <h3>What a board would ask</h3>
       <p class="ob-sub">What this room answers today, and what it cannot yet.</p>
       <div class="ob-box"><table class="ob-t">
        <tbody>
         <tr><td>How much capital went in, and when?</td><td class="ob-n"><span class="ob-pill ob-pill--real">yes</span></td></tr>
         <tr><td>Who decides, and since when?</td><td class="ob-n"><span class="ob-pill ob-pill--real">yes</span></td></tr>
         <tr><td>What the company owes</td><td class="ob-n"><span class="ob-pill ob-pill--real">the loan</span></td></tr>
         <tr><td>Who owns which part</td><td class="ob-n"><span class="ob-pill ob-pill--empty">with the partners' consent</span></td></tr>
         <tr><td>At what valuation each step was taken</td><td class="ob-n"><span class="ob-pill ob-pill--empty">needs the deeds</span></td></tr>
         <tr><td>Annual accounts filed (FY2024, FY2025)</td><td class="ob-n"><span class="ob-pill ob-pill--empty">to load</span></td></tr>
        </tbody>
       </table></div>
      </div>
     </div>
    </section>

    <section class="ob-panel" id="ob-p-funding" role="tabpanel">
     <div class="ob-sec">
      <h3>Where the money came from</h3>
      <p class="ob-sub">Three kinds of money, never mixed: what the partners put in, what the company owes, and what clients paid. About {eur(MONEY_IN_TOTAL)} in all since 2024. Grants: none.</p>
      <div class="ob-box">
       <div class="ob-capgrow ob-capgrow--src" aria-hidden="true"><div style={`width:${partners / MONEY_IN_TOTAL * 100}%;background:rgb(var(--yellow))`}><span>Partners · {eur(partners)}</span></div><div style={`width:${ENISA.principal / MONEY_IN_TOTAL * 100}%;background:rgb(var(--blue))`}><span>ENISA · {eur(ENISA.principal)}</span></div><div style={`width:${clientsIn / MONEY_IN_TOTAL * 100}%;background:rgb(var(--green))`}></div></div>
       <div class="ob-grid3">
        <div><span class="ob-k">Equity · partners</span><div class="ob-big">{eur(partners)} <span class="ob-pill ob-pill--decl">declared</span></div><p class="ob-note">3,000 € at incorporation and two rounds; the registry shows {eur(COMPANY.capital, 2)} of nominal, the rest is share premium</p></div>
        <div><span class="ob-k">Debt · loans</span><div class="ob-big">{eur(ENISA.principal)} <span class="ob-pill ob-pill--real">real</span></div><p class="ob-note">ENISA, participative, still owed</p></div>
        <div><span class="ob-k">Clients</span><div class="ob-big">{eur(clientsIn)} <span class="ob-pill ob-pill--decl">declared</span></div><p class="ob-note">one client so far, in several invoices</p></div>
       </div>
      </div>
     </div>
     <div class="ob-sec">
      <h3>The rounds</h3>
      <p class="ob-sub">What the partners paid in each round, next to the nominal the Registry published. The difference is share premium: equity, not debt. Who paid which part enters from the deeds, with the partners' consent.</p>
      <div class="ob-box"><table class="ob-t">
       <thead><tr><th>Date</th><th>Round</th><th class="ob-n">Nominal (BORME)</th><th class="ob-n">Paid in</th><th></th></tr></thead>
       <tbody><tr><td class="ob-mono">2024-02-16</td><td>Incorporation</td><td class="ob-n">3,000 €</td><td class="ob-n">3,000 €</td><td class="ob-n"><span class="ob-pill ob-pill--real">real</span></td></tr>{ROUNDS.map((r) => <tr><td class="ob-mono">{r.date}</td><td>{r.what} · <a href={bormeUrl(r.borme)} target="_blank" rel="noopener noreferrer">BORME</a></td><td class="ob-n">{eur(r.nominal, 2)}</td><td class="ob-n">≈ {eur(r.amount)}</td><td class="ob-n"><span class="ob-pill ob-pill--decl">declared</span></td></tr>)}</tbody>
       <tfoot><tr><td colspan="2">Partners, together</td><td class="ob-n">{eur(COMPANY.capital, 2)}</td><td class="ob-n">≈ {eur(partners)}</td><td></td></tr></tfoot>
      </table><p class="ob-note"><span class="ob-pill ob-pill--decl">declared</span> The amounts paid are the company's word, rounded; they turn real when the deeds are loaded. ENISA usually lends up to what the partners put in: the first round came six months before the loan.</p></div>
     </div>
     <div class="ob-sec" id="cq-sec-enisa">
      <h3>The ENISA loan</h3>
      <div class="ob-box ob-enisa">
       <a class="ob-seal" href={ENISA.lenderUrl} target="_blank" rel="noopener noreferrer"><img src={ENISA.seal} width="240" height="160" alt="Financiada por ENISA — Ministerio de Industria y Turismo" loading="lazy" decoding="async" /></a>
       <div>
        <div class="ob-facts">
         <div class="ob-fact"><span class="ob-k">Granted</span><div class="ob-big">{eur(ENISA.principal)}</div></div>
         <div class="ob-fact"><span class="ob-k">Signed</span><div class="ob-big">{date(ENISA.signed)}</div></div>
         <div class="ob-fact"><span class="ob-k">Interest 2025</span><div class="ob-big">{eur(ENISA_INTEREST_TOTAL, 2)}</div></div>
         <div class="ob-fact"><span class="ob-k">Outstanding</span><div class="ob-big ob-dim">to load</div></div>
        </div>
        <table class="ob-t"><thead><tr><th>Quarter</th><th class="ob-n">Interest (net)</th></tr></thead><tbody>{ENISA.interest.map((q) => <tr><td>{q.quarter}</td><td class="ob-n">{eur(q.amount, 2)}</td></tr>)}</tbody></table>
        <p class="ob-why">A participative loan: no guarantee asked, interest partly tied to results, counted as equity for dissolution purposes. It is debt: ENISA holds no shares. <span class="ob-pill ob-pill--real">real</span> Amount and date as published in <a href={ENISA.register} target="_blank" rel="noopener noreferrer">ENISA's public loan search</a>; interest from the 2025 invoice book. Term, grace and repayment come from the contract. The record: <a href="/operations/ops-017-the-enisa-loan">{ENISA.record} The ENISA loan</a>.</p>
       </div>
      </div>
     </div>
     <div class="ob-sec ob-grid2">
      <div class="ob-empty"><h4>Grants</h4>None. The national grants register (BDNS) lists nothing for {COMPANY.taxId} under grants, state aid or de minimis aid, checked on 30 September 2026. When one is granted, it appears here with its call, amount and conditions.</div>
      <div class="ob-empty"><h4>Emerging-company status</h4>Recognised on {date(COMPANY.emerging.since)} under Law 28/2022, for {COMPANY.emerging.years} years: tax advantages, not money.</div>
     </div>
    </section>

    <section class="ob-panel" id="ob-p-clients" role="tabpanel">
     <div class="ob-sec ob-grid2">
      <div>
       <h3>Clients</h3>
       <p class="ob-sub">Who pays Numen Games, and for what: from the issued-invoices book, the way costs come from the received one.</p>
       <div class="ob-box"><table class="ob-t">
        <thead><tr><th>Sector</th><th>What for</th><th class="ob-n">Income</th></tr></thead>
        <tbody>{CLIENTS.map((c) => <tr><td>{c.sector}</td><td>{c.what} <span class="ob-dim">· {c.invoices}</span></td><td class="ob-n">≈ {eur(c.amount)} <span class="ob-pill ob-pill--decl">declared</span></td></tr>)}</tbody>
        <tfoot><tr><td colspan="2">Since 2024</td><td class="ob-n">≈ {eur(clientsIn)}</td></tr></tfoot>
       </table>
       <p class="ob-note">One client so far. Against a monthly cost of about {eur(DATA.total / 12 + pay25 / 12)} that is roughly six weeks of running. Each client appears by sector until it agrees to be named; the invoices enter from the issued-invoices book.</p></div>
      </div>
      <div>
       <h3>Tenders</h3>
       <p class="ob-sub">Public contracts the company bids for, won or lost: the call, the amount, the result.</p>
       <div class="ob-empty"><h4>None recorded</h4>When the first bid is filed, it gets its record in the archive and a line here, linked to the public procurement platform.</div>
      </div>
     </div>
     <div class="ob-sec">
      <h3>Pipeline</h3>
      <p class="ob-sub">Every chance to sell has its public record: <a href="/system/pipeline">the pipeline</a> and <a href="/opportunities/">the opportunities</a>.</p>
     </div>
    </section>

    <section class="ob-panel" id="ob-p-cash" role="tabpanel">
     <div class="ob-sec">
      <h3>Time to tomb</h3>
      <p class="ob-sub">The company says very little cash is left. Until the bank balance is loaded, the counter runs on the cash you set below, from {date(CASH.asOf)}, at today's monthly cost.</p>
      <div class="ob-box ob-count" id="ob-countdown" aria-live="off">
       <div><span class="ob-k">Cash left, now <span class="ob-pill ob-pill--sim">simulated</span></span><div class="ob-cnum" id="ob-cnow">—</div></div>
       <div><span class="ob-k">The money runs out in</span><div class="ob-clock" id="ob-clock">—</div><div class="ob-dim" id="ob-cdate"></div></div>
      </div>
     </div>
     <div class="ob-sec">
      <h3>How long the money lasts</h3>
      <p class="ob-sub">Three ways to run the company from here, each with its monthly cost from the FY2025 book and how long the cash would last. The bank balance is not loaded yet: move it, and the income, to see how the answer changes. Payroll is simulated too, until the payslips are loaded.</p>
      <div class="ob-box ob-sliders">
       <label>Cash in the bank <input type="range" id="ob-cash" min="0" max="150000" step="500" value="8000" /> <b id="ob-cashv"></b></label>
       <label>Income a month <input type="range" id="ob-inc" min="0" max="20000" step="250" value="0" /> <b id="ob-incv"></b></label>
       <span class="ob-pill ob-pill--sim">simulated — both</span>
      </div>
      <div class="ob-scen" id="ob-scen"></div>
     </div>
     <div class="ob-sec ob-grid2">
      <div>
       <h3>Time to tomb</h3>
       <p class="ob-sub">Cash at the end of each month for the next two years if the company keeps running as in 2025. Where the line crosses zero, it stops.</p>
       <div class="ob-box"><div class="ob-chart" id="ob-tomb"></div></div>
      </div>
      <div>
       <h3>What closing costs</h3>
       <p class="ob-sub">Winding up a Spanish S.L. is not free, and the loan does not disappear with it.</p>
       <div class="ob-box"><table class="ob-t" id="ob-close"></table><p class="ob-note">Estimates for a company this size, not quotes. A participative loan ranks after ordinary creditors, but it is still owed; the figure assumes no principal repaid yet. The gestoría and the contract give the exact numbers.</p></div>
      </div>
     </div>
    </section>

