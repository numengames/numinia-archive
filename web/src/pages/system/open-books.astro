const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const off = new Set();
const state = { g: 'month', kind: 'bars', mode: 'use' };

// One row per day of FY2025: consumed (spread over period_from..period_to) or billed (on its date).
const days = []; for (let t = Y0; t <= Y1; t += DAY) days.push(t);
const cache = {};
function daily(mode) {
  if (cache[mode]) return cache[mode];
  const M = days.map((t) => ({ t, c: {}, w: {} }));
  for (const l of L) {
    let a = mode === 'bill' ? T(l.d) : T(l.a), b = mode === 'bill' ? T(l.d) : T(l.b);
    const per = l.n / (Math.round((b - a) / DAY) + 1);
    a = Math.max(a, Y0); b = Math.min(b, Y1);
    for (let t = a; t <= b; t += DAY) { const r = M[Math.round((t - Y0) / DAY)]; r.c[l.c] = (r.c[l.c] || 0) + per; r.w[l.w] = (r.w[l.w] || 0) + per; }
  }
  return (cache[mode] = M);
}
function bucket(g, t) {
  const d = new Date(t), m = d.getUTCMonth();
  if (g === 'day') return [iso(t), `${d.getUTCDate()} ${MON[m]} 2025`, `${d.getUTCDate()} ${MON[m]}`];
  if (g === 'week') { const s = t - ((d.getUTCDay() + 6) % 7) * DAY, sd = new Date(s); return [iso(s), `week of ${sd.getUTCDate()} ${MON[sd.getUTCMonth()]}`, `${sd.getUTCDate()} ${MON[sd.getUTCMonth()]}`]; }
  if (g === 'month') return [iso(t).slice(0, 7), `${MON[m]} 2025`, MON[m]];
  if (g === 'quarter') { const q = Math.floor(m / 3) + 1; return ['Q' + q, `Q${q} 2025`, 'Q' + q]; }
  return ['2025', 'FY2025', '2025'];
}
function series() {
  const out = new Map();
  for (const r of daily(state.mode)) {
    const [k, lab, ax] = bucket(state.g, r.t);
    let b = out.get(k); if (!b) out.set(k, (b = { k, lab, ax, c: {}, w: {}, n: 0 }));
    b.n++; for (const c in r.c) b.c[c] = (b.c[c] || 0) + r.c[c]; for (const w in r.w) b.w[w] = (b.w[w] || 0) + r.w[w];
  }
  let arr = [...out.values()];
  if (state.g === 'year') arr = D.years.map((y) => (y.loaded ? arr[0] : { k: y.year, lab: y.year === '2024' ? '2024, from 16 Feb' : y.year, ax: y.year, c: {}, w: {}, n: 0, empty: true }));
  for (const b of arr) b.t = ORDER.filter((c) => !off.has(c)).reduce((s, c) => s + (b.c[c] || 0), 0);
  return arr;
}

// The tooltip: total, per day, every category with its share, and who weighs most.
const tip = $('#ob-tip');
function tipHTML(b) {
  if (b.empty) return `<div class="t">${b.lab}</div><div style="margin-top:6px;color:rgb(var(--text-muted))">This year's book is not loaded yet. The company existed; its costs appear here when the gestoría's book is brought.</div>`;
  const small = b.t < 1000, cs = ORDER.filter((c) => !off.has(c) && b.c[c] > 0.005).sort((x, y) => b.c[y] - b.c[x]);
  const who = Object.entries(b.w).sort((x, y) => y[1] - x[1]).slice(0, 4);
  return `<div class="t">${b.lab} · ${state.mode === 'use' ? 'consumed' : 'billed'}</div><div class="big">${eur(b.t, 2)}${b.n > 1 ? ` <small>· ${eur(b.t / b.n, 2)} a day</small>` : ''}</div>` +
    cs.map((c) => { const p = b.t ? (b.c[c] / b.t) * 100 : 0; return `<div class="row"><i style="background:${CATS[c].color}"></i><span>${CATS[c].label}</span><span class="a">${eur(b.c[c], small ? 2 : 0)}</span><span class="p">${p.toFixed(0)}%</span></div><div class="bar"><b style="width:${p}%;background:${CATS[c].color}"></b></div>`; }).join('') +
    (who.length ? `<div class="who">${who.map(([w, v]) => `<div><span>${w}</span><span>${eur(v, small ? 2 : 0)}</span></div>`).join('')}</div>` : '');
}
function place(x, y) { const r = tip.getBoundingClientRect(); let l = x + 16, t = y + 16; if (l + r.width > innerWidth - 8) l = Math.max(8, x - r.width - 16); if (t + r.height > innerHeight - 8) t = Math.max(8, y - r.height - 16); tip.style.left = l + 'px'; tip.style.top = t + 'px'; }
function show(e, b) { tip.innerHTML = tipHTML(b); tip.classList.add('ob-on'); place(e.clientX, e.clientY); }
function hide() { tip.classList.remove('ob-on'); $$('.ob-hov').forEach((x) => x.classList.remove('ob-hov')); }
document.addEventListener('scroll', hide, { passive: true });
document.addEventListener('click', (e) => { if (!e.target.closest('.ob-hit,.ob-tm')) hide(); });
function bindTip(el, b) {
  el.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') show(e, b); });
  el.addEventListener('pointermove', (e) => { if (e.pointerType !== 'touch') place(e.clientX, e.clientY); });
  el.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') hide(); });
  el.addEventListener('click', (e) => { hide(); el.classList.add('ob-hov'); show(e, b); });
}

// The spending chart: stacked, share, lines or a map of categories.
function draw() {
  const S = series(), el = $('#ob-chart'), W = 1100, H = 300, pl = 52, pr = 8, pt = 10, pb = 28;
  const act = ORDER.filter((c) => !off.has(c)), real = S.filter((b) => !b.empty);
  const total = real.reduce((s, b) => s + b.t, 0), peak = real.reduce((m, b) => (b.t > m.t ? b : m), real[0]);
  const unit = state.g;
  $('#ob-readout').innerHTML = `FY2025, ${state.mode === 'use' ? 'consumed' : 'billed'}: <b>${eur(total)}</b>` + (real.length > 1 ? ` · average <b>${eur(total / real.length, unit === 'day' ? 2 : 0)}</b> a ${unit} · highest <b>${peak.lab}</b>, ${eur(peak.t)}` : '');
  if (state.kind === 'tree') { el.innerHTML = tree(S, W, H); legend(); return; }
  const n = S.length, cw = (W - pl - pr) / n, bw = Math.max(1, cw * (n > 60 ? 0.9 : 0.66));
  const max = state.kind === 'share' ? 1 : Math.max(...S.map((b) => (state.kind === 'lines' ? Math.max(0, ...act.map((c) => b.c[c] || 0)) : b.t))) * 1.08 || 1;
  const y = (v) => pt + (H - pt - pb) * (1 - v / max);
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Spending in FY2025, by ${unit}">`;
  for (let i = 0; i <= 4; i++) { const v = (max * i) / 4; s += `<line class="ob-grid" x1="${pl}" x2="${W - pr}" y1="${y(v)}" y2="${y(v)}" stroke-width="${i ? 0.5 : 1}"/><text class="ob-ax" x="${pl - 8}" y="${y(v) + 4}" text-anchor="end">${state.kind === 'share' ? Math.round(v * 100) + '%' : v >= 1000 ? (v / 1000).toFixed(v >= 10000 ? 0 : 1) + 'k' : Math.round(v)}</text>`; }
  if (state.kind === 'lines') for (const c of act) s += `<polyline points="${S.map((b, i) => `${pl + i * cw + cw / 2},${y(b.c[c] || 0)}`).join(' ')}" fill="none" stroke="${CATS[c].color}" stroke-width="1.8" stroke-linejoin="round"/>`;
  const every = n > 40 ? Math.ceil(n / 12) : 1;
  S.forEach((b, i) => {
    const x = pl + i * cw + (cw - bw) / 2;
    if (b.empty) s += `<rect class="ob-hatch" x="${x}" y="${pt}" width="${bw}" height="${H - pt - pb}" rx="3"/><text class="ob-ax" x="${x + bw / 2}" y="${H / 2}" text-anchor="middle">not loaded</text>`;
    else if (state.kind !== 'lines') { let acc = 0; for (const c of act) { const v = (b.c[c] || 0) / (state.kind === 'share' && b.t ? b.t : 1); if (v <= 0) continue; const y1 = y(acc + v), y0 = y(acc); s += `<rect x="${x}" y="${y1}" width="${bw}" height="${Math.max(0, y0 - y1)}" fill="${CATS[c].color}" opacity=".92"/>`; acc += v; } }
    s += `<rect class="ob-hit" data-i="${i}" x="${pl + i * cw}" y="${pt}" width="${cw}" height="${H - pt - pb}"/>`;
    if (i % every === 0) s += `<text class="ob-ax" x="${pl + i * cw + cw / 2}" y="${H - 8}" text-anchor="middle">${b.ax}</text>`;
  });
  el.innerHTML = s + '</svg>';
  el.querySelectorAll('.ob-hit').forEach((r) => bindTip(r, S[+r.dataset.i]));
  legend();
}
function tree(S, W, H) {
  const tot = {}; for (const b of S) for (const c in b.c) if (!off.has(c)) tot[c] = (tot[c] || 0) + b.c[c];
  const items = Object.entries(tot).filter((x) => x[1] > 0).sort((a, b) => b[1] - a[1]), sum = items.reduce((s, x) => s + x[1], 0) || 1;
  const rows = [items.slice(0, 3), items.slice(3)].filter((r) => r.length), rs = rows.map((r) => r.reduce((a, b) => a + b[1], 0));
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Spending in FY2025, as a map of categories">`, y = 0;
  rows.forEach((r, ri) => { const h = (H * rs[ri]) / sum; let x = 0; r.forEach(([c, v]) => { const w = (W * v) / rs[ri];
    s += `<g class="ob-tm" data-c="${c}" style="cursor:crosshair"><rect x="${x + 1}" y="${y + 1}" width="${Math.max(0, w - 2)}" height="${Math.max(0, h - 2)}" rx="6" fill="${CATS[c].color}" opacity=".88"/>` + (w > 110 && h > 44 ? `<text x="${x + 12}" y="${y + 24}" font-size="13" fill="#141110" font-weight="600">${CATS[c].label}</text><text x="${x + 12}" y="${y + 42}" font-size="12" fill="#141110">${eur(v)} · ${((v / sum) * 100).toFixed(0)}%</text>` : '') + '</g>'; x += w; }); y += h; });
  setTimeout(() => $$('.ob-tm').forEach((g) => { const c = g.dataset.c, w = {}; for (const l of L) if (l.c === c) w[l.w] = (w[l.w] || 0) + l.n; bindTip(g, { lab: CATS[c].label + ' · FY2025', t: tot[c], n: 365, c: { [c]: tot[c] }, w }); }));
  return s + '</svg>';
}
function legend() {
  $('#ob-legend').innerHTML = ORDER.filter((c) => L.some((l) => l.c === c)).map((c) => `<button type="button" data-c="${c}" aria-pressed="${!off.has(c)}"><i class="ob-sw" style="background:${CATS[c].color};margin:0"></i>${CATS[c].label}</button>`).join('');
  $$('#ob-legend button').forEach((b) => (b.onclick = () => { const c = b.dataset.c; off.has(c) ? off.delete(c) : off.add(c); hide(); draw(); }));
}
function seg(id, key, fn) { $$(`#${id} button`).forEach((b) => (b.onclick = () => { $$(`#${id} button`).forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); state[key] = b.dataset.v; hide(); fn(); })); }
seg('ob-gran', 'g', draw); seg('ob-kind', 'kind', draw); seg('ob-mode', 'mode', draw);

// What we pay for now: monthly services still billed in Oct–Dec, at their last month.
const rec = {};
for (const l of L) if (l.a.slice(0, 7) === l.b.slice(0, 7) && l.a.endsWith('-01') && !['people', 'counsel'].includes(l.c)) { const m = l.a.slice(0, 7); (rec[l.w] = rec[l.w] || {})[m] = (rec[l.w][m] || 0) + l.n; }
const now = Object.entries(rec).map(([w, ms]) => { const last = Object.keys(ms).sort().pop(); return [w, ms[last], last]; }).filter((r) => r[2] >= '2025-10').sort((a, b) => b[1] - a[1]);
const nowSum = now.reduce((s, r) => s + r[1], 0);
$('#ob-now').innerHTML = '<thead><tr><th>Service</th><th class="ob-n">A month</th><th class="ob-n">A year</th></tr></thead><tbody>' + now.map(([w, v]) => `<tr><td>${w}</td><td class="ob-n">${eur(v)}</td><td class="ob-n">${eur(v * 12)}</td></tr>`).join('') + `</tbody><tfoot><tr><td>Together</td><td class="ob-n">${eur(nowSum)}</td><td class="ob-n">${eur(nowSum * 12)}</td></tr></tfoot>`;

// Cash and runway.
const byCat = {}; for (const l of L) byCat[l.c] = (byCat[l.c] || 0) + l.n;
const payNow = D.payNow; // simulated: today's payroll, all staff together
const burn = D.total / 12 + payNow;
const lean = burn - payNow - ['people', 'counsel', 'studios', 'events', 'hardware'].reduce((s, c) => s + (byCat[c] || 0), 0) / 12;
const ASLEEP = [['Gestoría, minimum fee', 50], ['Loan interest', D.enisaQuarter / 3], ['Registry and annual accounts filing', 10], ['Bank, domain and mail', 25], ['Password vault and signature', 15]];
const dorm = ASLEEP.reduce((s, x) => s + x[1], 0);
const CLOSE = [['Notary and registry: dissolution, liquidation, cancellation', 1500], ['Gestoría: final accounts and returns', 1800], ['Legal counsel', 1500], ['ENISA: principal still owed', D.principal]];
const closeTotal = CLOSE.reduce((s, x) => s + x[1], 0);
const lasts = (m) => (m === Infinity ? 'indefinitely' : m > 120 ? 'ten years or more' : m.toFixed(1) + ' months');
function runway() {
  const cash = +$('#ob-cash').value, inc = +$('#ob-inc').value;
  $('#ob-cashv').textContent = eur(cash); $('#ob-incv').textContent = eur(inc);
  const sc = [['Keep running', burn, 'as in 2025, plus today\'s payroll (simulated)', ['Payroll: one person, ' + eur(payNow) + ' with social security', 'Contractors and counsel stay', 'Every service stays']],
    ['Lean', lean, 'services and the loan only', ['Payroll, contractors, counsel and studios paused', 'Cloud, AI and software stay', 'The loan keeps costing']],
    ['Asleep', dorm, 'a dormant company that still exists', ASLEEP.map(([k, v]) => `${k}: ${eur(v)}`)]];
  $('#ob-scen').innerHTML = sc.map(([h, c, sub, li], i) => { const net = c - inc, m = net <= 0 ? Infinity : cash / net; return `<div class="ob-sc ${i === 0 ? 'hi' : ''}"><span class="ob-k">${h}</span><div class="v">${eur(c)} <small>/ month</small></div><div style="font-size:.82rem;color:rgb(var(--text-muted))">${sub}</div><div>Lasts <b style="font-family:var(--font-mono)">${lasts(m)}</b></div><ul>${li.map((x) => `<li>${x}</li>`).join('')}</ul></div>`; }).join('');
  const W = 600, H = 210, pl = 50, N = 24, pts = []; let c = cash; for (let i = 0; i <= N; i++) { pts.push(c); c += inc - burn; }
  const lo = Math.min(0, ...pts), hi = Math.max(1, ...pts), y = (v) => 10 + (H - 40) * (1 - (v - lo) / (hi - lo || 1)), x = (i) => pl + ((W - pl - 8) * i) / N;
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Cash over the next 24 months"><line class="ob-zero" x1="${pl}" x2="${W - 8}" y1="${y(0)}" y2="${y(0)}"/><text class="ob-ax" x="${pl - 6}" y="${y(0) + 4}" text-anchor="end">0 €</text><polyline class="ob-line" points="${pts.map((v, i) => x(i) + ',' + y(v)).join(' ')}"/>`;
  const z = pts.findIndex((v) => v < 0); if (z > 0) s += `<line class="ob-mark" x1="${x(z)}" x2="${x(z)}" y1="10" y2="${H - 30}"/><text class="ob-ax" x="${x(z) + 6}" y="22" style="fill:rgb(var(--yellow))">runs out in month ${z}</text>`;
  for (let i = 0; i <= N; i += 6) s += `<text class="ob-ax" x="${x(i)}" y="${H - 10}" text-anchor="middle">+${i} m</text>`;
  $('#ob-tomb').innerHTML = s + '</svg>';
  $('#ob-close').innerHTML = '<thead><tr><th>Item</th><th class="ob-n">Estimate</th></tr></thead><tbody>' + CLOSE.map(([k, v]) => `<tr><td>${k}</td><td class="ob-n">${eur(v)}</td></tr>`).join('') + `</tbody><tfoot><tr><td>To close cleanly</td><td class="ob-n">${eur(closeTotal)}</td></tr><tr><td style="font-weight:400;color:rgb(var(--text-muted))">Cash left after closing</td><td class="ob-n" style="color:rgb(var(${cash - closeTotal < 0 ? '--red' : '--green'}))">${eur(cash - closeTotal)}</td></tr></tfoot>`;
  const m = cash / Math.max(1, burn - inc);
  $('#ob-kpis').innerHTML = [['Spent in 2025', eur(D.total), `net of VAT · ${L.length} lines`, 'real'], ['A month, on average', eur(burn), 'what running cost in 2025', 'real'], ['Owed to ENISA', eur(D.principal), 'participative loan, 2024', 'real'], ['Money in', '≈ ' + eur(D.moneyIn), 'partners, ENISA and clients since 2024', 'decl'], ['Time to tomb', burn - inc <= 0 ? '—' : m.toFixed(1) + ' months', "at today's cost · simulated cash", 'sim', m < 6]]
    .map(([k, v, sub, t, a]) => `<div class="ob-kpi ${a ? 'alert' : ''}"><span class="dot ${t}" title="${t === 'real' ? 'real figure' : t === 'decl' ? 'declared, document to load' : 'simulated'}"></span><span class="ob-k">${k}</span><span class="v">${v}</span><span class="s">${sub}</span></div>`).join('');
}
$('#ob-cash').addEventListener('input', () => { runway(); tick(); planDraw(); });

// The time-to-tomb counter: the cash set above, spent second by second since
// the day the company said how little was left, at today's monthly cost.
const SEC_MONTH = 30.4375 * 86400, ASOF = Date.parse(D.cash.asOf + 'T00:00:00Z');
function tick() {
  const cash = +$('#ob-cash').value, inc = +$('#ob-inc').value, net = burn - inc;
  const now = Date.now(), left = cash - Math.max(0, (now - ASOF) / 1000) * (net / SEC_MONTH);
  $('#ob-cnow').textContent = eur(Math.max(0, left), 2);
  if (net <= 0) { $('#ob-clock').textContent = 'it does not run out'; $('#ob-cdate').textContent = 'income covers the cost'; return; }
  const secs = Math.max(0, (left / net) * SEC_MONTH), dd = Math.floor(secs / 86400), hh = Math.floor(secs % 86400 / 3600), mm = Math.floor(secs % 3600 / 60), ss = Math.floor(secs % 60);
  const p = (n) => String(n).padStart(2, '0');
  $('#ob-clock').innerHTML = secs <= 0 ? 'out of cash' : `${dd}<small>days</small>${p(hh)}<small>h</small>${p(mm)}<small>m</small>${p(ss)}<small>s</small>`;
  $('#ob-cdate').textContent = secs <= 0 ? 'at this cost, the cash set above is already spent' : 'on ' + new Date(now + secs * 1000).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) + ', at ' + eur(net) + ' a month';
}
setInterval(tick, 1000);

// The business plan: five assumptions, three years, break-even, cash.
const A = { ...D.plan.assumptions };
const fmtA = { projectsPerYear: (v) => v + ' a year', projectSize: (v) => eur(v), hostingPerWorld: (v) => eur(v), monthlyCost: (v) => eur(v), growth: (v) => '+' + Math.round(v * 100) + '%' };
$$('#ob-plan-in input').forEach((el) => { const k = el.dataset.k; el.value = A[k]; el.nextElementSibling.textContent = fmtA[k](A[k]); el.addEventListener('input', () => { A[k] = +el.value; el.nextElementSibling.textContent = fmtA[k](A[k]); planDraw(); }); });
function planDraw() {
  const y0 = +D.plan.start, rows = []; let worlds = 1, cum = 0;
  for (let i = 0; i < 3; i++) {
    const g = Math.pow(1 + A.growth, i), proj = A.projectsPerYear * g, pr = proj * A.projectSize;
    const host = worlds * A.hostingPerWorld * 12 + (proj * A.hostingPerWorld * 12) / 2, cost = A.monthlyCost * 12 * Math.pow(1 + A.growth / 2, i), res = pr + host - cost;
    cum += res; worlds += proj; rows.push({ y: y0 + i, proj, pr, host, cost, res, cum });
  }
  const c = (v) => `<span class="${v < 0 ? 'ob-neg' : 'ob-pos'}">${eur(v)}</span>`;
  $('#ob-pl').innerHTML = `<thead><tr><th></th>${rows.map((r) => `<th class="ob-n">${r.y}</th>`).join('')}</tr></thead><tbody>` +
    `<tr><td>Projects</td>${rows.map((r) => `<td class="ob-n">${r.proj.toFixed(1)}</td>`).join('')}</tr>` +
    `<tr><td>Income, projects</td>${rows.map((r) => `<td class="ob-n">${eur(r.pr)}</td>`).join('')}</tr>` +
    `<tr><td>Income, hosting</td>${rows.map((r) => `<td class="ob-n">${eur(r.host)}</td>`).join('')}</tr>` +
    `<tr><td>Cost of running</td>${rows.map((r) => `<td class="ob-n">−${eur(r.cost)}</td>`).join('')}</tr></tbody>` +
    `<tfoot><tr><td>Result</td>${rows.map((r) => `<td class="ob-n">${c(r.res)}</td>`).join('')}</tr><tr><td style="font-weight:400">Accumulated</td>${rows.map((r) => `<td class="ob-n">${c(r.cum)}</td>`).join('')}</tr></tfoot>`;
  const be = A.projectSize > 0 ? (A.monthlyCost * 12) / A.projectSize : Infinity;
  const cash0 = +$('#ob-cash').value; let cash = cash0, low = cash0, lowAt = 0; const pts = [cash0]; let w = 1;
  for (let m = 1; m <= 36; m++) { const g = Math.pow(1 + A.growth, Math.floor((m - 1) / 12)), pm = (A.projectsPerYear * g) / 12; w += pm; cash += pm * A.projectSize + w * A.hostingPerWorld - A.monthlyCost * Math.pow(1 + A.growth / 2, Math.floor((m - 1) / 12)); pts.push(cash); if (cash < low) { low = cash; lowAt = m; } }
  const need = Math.max(0, -low);
  $('#ob-be').innerHTML = `<span class="ob-k">Projects a year to break even</span><div class="ob-be-big">${be === Infinity ? '—' : be.toFixed(1)}</div><p class="ob-note">at ${eur(A.projectSize)} a project and ${eur(A.monthlyCost)} a month, before hosting. Today: one client since 2024.</p>` +
    `<span class="ob-k" style="margin-top:14px">Money the plan needs</span><div class="ob-be-big ${need ? 'ob-neg' : 'ob-pos'}">${need ? eur(need) : 'none'}</div><p class="ob-note">${need ? `the lowest point of cash, in month ${lowAt}: a round, a loan or a client must arrive before then` : 'the cash never falls below zero in 36 months'}. Starting from ${eur(cash0)} of cash, simulated.</p>`;
  const W = 1100, H = 240, pl = 56, N = 36, lo = Math.min(0, ...pts), hi = Math.max(1, ...pts), y = (v) => 10 + (H - 40) * (1 - (v - lo) / (hi - lo || 1)), x = (i) => pl + ((W - pl - 8) * i) / N;
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Planned cash over the next 36 months"><line class="ob-zero" x1="${pl}" x2="${W - 8}" y1="${y(0)}" y2="${y(0)}"/><text class="ob-ax" x="${pl - 6}" y="${y(0) + 4}" text-anchor="end">0 €</text><text class="ob-ax" x="${pl - 6}" y="${y(hi) + 4}" text-anchor="end">${(hi / 1000).toFixed(0)}k</text><polyline points="${pts.map((v, i) => x(i) + ',' + y(v)).join(' ')}" fill="none" stroke="rgb(167 123 224)" stroke-width="2"/>`;
  for (let i = 0; i <= N; i += 6) s += `<text class="ob-ax" x="${x(i)}" y="${H - 10}" text-anchor="middle">+${i} m</text>`;
  $('#ob-plan-cash').innerHTML = s + '</svg>';
}
 $('#ob-inc').addEventListener('input', () => { runway(); tick(); });

// Every line.
let lc = '';
$('#ob-lcat').innerHTML = '<button type="button" data-v="" aria-pressed="true">All</button>' + ORDER.filter((c) => byCat[c]).map((c) => `<button type="button" data-v="${c}">${CATS[c].label.split(/[ ,]/)[0]}</button>`).join('');
$$('#ob-lcat button').forEach((b) => (b.onclick = () => { $$('#ob-lcat button').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); lc = b.dataset.v; ledger(); }));
function ledger() {
  const q = $('#ob-q').value.toLowerCase(), rs = L.filter((l) => (!lc || l.c === lc) && (!q || l.w.toLowerCase().includes(q))).sort((a, b) => (a.d < b.d ? 1 : -1));
  $('#ob-ledger').innerHTML = '<thead><tr><th>Date</th><th>Who</th><th>What</th><th class="ob-n">Net</th></tr></thead><tbody>' + rs.map((l) => `<tr><td class="ob-mono">${l.d}</td><td>${l.w}${l.h ? ` <span class="ob-dim">· ${l.h}</span>` : ''}</td><td><i class="ob-sw" style="background:${CATS[l.c].color}"></i>${CATS[l.c].label}</td><td class="ob-n">${eur(l.n, 2)}</td></tr>`).join('') + `</tbody><tfoot><tr><td colspan="3">${rs.length} lines</td><td class="ob-n">${eur(rs.reduce((s, l) => s + l.n, 0), 2)}</td></tr></tfoot>`;
}
$('#ob-q').addEventListener('input', ledger);

// Rooms: tabs, arrow keys, and the address remembers the room.
function open(room, push) {
  $$('.ob-room').forEach((x) => x.setAttribute('aria-selected', String(x.dataset.room === room)));
  $$('.ob-panel').forEach((p) => p.classList.toggle('ob-on', p.id === 'ob-p-' + room)); hide();
  if (push) history.replaceState(null, '', '#' + room);
}
$$('.ob-room').forEach((b, i, all) => { b.onclick = () => open(b.dataset.room, true); b.onkeydown = (e) => { const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (d) { const nx = all[(i + d + all.length) % all.length]; nx.focus(); open(nx.dataset.room, true); } }; });
const start = location.hash.slice(1); if ($$('.ob-room').some((b) => b.dataset.room === start)) open(start, false);

draw(); runway(); ledger(); tick(); planDraw();
})();
</script>
