  const need = Math.max(0, -low);
  $('#ob-be').innerHTML = `<span class="ob-k">Projects a year to break even</span><div class="ob-be-big">${be === Infinity ? '—' : be.toFixed(1)}</div><p class="ob-note">at ${eur(A.projectSize)} a project and ${eur(A.monthlyCost)} a month, before hosting. Today: one client since 2024.</p>` +
    `<span class="ob-k" style="margin-top:14px">Money the plan needs</span><div class="ob-be-big ${need ? 'ob-neg' : 'ob-pos'}">${need ? eur(need) : 'none'}</div><p class="ob-note">${need ? `the lowest point of cash, in month ${lowAt}: a round, a loan or a client must arrive before then` : 'the cash never falls below zero in 36 months'}. Starting from the ${eur(cash0)} in the bank on 1 October 2026, declared.</p>`;
  const W = 1100, H = 240, pl = 56, N = 36, lo = Math.min(0, ...pts), hi = Math.max(1, ...pts), y = (v) => 10 + (H - 40) * (1 - (v - lo) / (hi - lo || 1)), x = (i) => pl + ((W - pl - 8) * i) / N;
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Planned cash over the next 36 months"><line class="ob-zero" x1="${pl}" x2="${W - 8}" y1="${y(0)}" y2="${y(0)}"/><text class="ob-ax" x="${pl - 6}" y="${y(0) + 4}" text-anchor="end">0 €</text><text class="ob-ax" x="${pl - 6}" y="${y(hi) + 4}" text-anchor="end">${(hi / 1000).toFixed(0)}k</text><polyline points="${pts.map((v, i) => x(i) + ',' + y(v)).join(' ')}" fill="none" stroke="rgb(167 123 224)" stroke-width="2"/>`;
  for (let i = 0; i <= N; i += 6) s += `<text class="ob-ax" x="${x(i)}" y="${H - 10}" text-anchor="middle">+${i} m</text>`;
  $('#ob-plan-cash').innerHTML = s + '</svg>';
}

// Every line.
let lc = '';
$('#ob-lcat').innerHTML = '<button type="button" data-v="" aria-pressed="true">All</button>' + ORDER.filter((c) => byCat[c]).map((c) => `<button type="button" data-v="${c}">${CATS[c].label.split(/[ ,]/)[0]}</button>`).join('');
$$('#ob-lcat button').forEach((b) => (b.onclick = () => { $$('#ob-lcat button').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); lc = b.dataset.v; ledger(); }));
function ledger() {
  const q = $('#ob-q').value.toLowerCase(), rs = L.filter((l) => (!lc || l.c === lc) && (!q || l.w.toLowerCase().includes(q))).sort((a, b) => (a.d < b.d ? 1 : -1));
  $('#ob-ledger').innerHTML = '<thead><tr><th>Date</th><th>Who</th><th>What</th><th class="ob-n">Net</th></tr></thead><tbody>' + rs.map((l) => `<tr><td class="ob-mono">${l.d}</td><td>${l.w}${l.h ? ` <span class="ob-dim">· ${l.h}</span>` : ''}</td><td><i class="ob-sw" style="background:${CATS[l.c].color}"></i>${CATS[l.c].label}</td><td class="ob-n">${eur(l.n, 2)}</td></tr>`).join('') + `</tbody><tfoot><tr><td colspan="3">${rs.length} lines</td><td class="ob-n">${eur(rs.reduce((s, l) => s + l.n, 0), 2)}</td></tr></tfoot>`;
}
$('#ob-q').addEventListener('input', ledger);

// Rooms: tabs, arrow keys, and the address remembers the room.
function open(room, push) {
  $$('.ob-room').forEach((x) => x.setAttribute('aria-selected', String(x.dataset.room === room)));
  $$('.ob-panel').forEach((p) => p.classList.toggle('ob-on', p.id === 'ob-p-' + room)); hide();
  if (push) history.replaceState(null, '', '#' + room);
}
$$('.ob-room').forEach((b, i, all) => { b.onclick = () => open(b.dataset.room, true); b.onkeydown = (e) => { const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (d) { const nx = all[(i + d + all.length) % all.length]; nx.focus(); open(nx.dataset.room, true); } }; });
const start = location.hash.slice(1); if ($$('.ob-room').some((b) => b.dataset.room === start)) open(start, false);

draw(); runway(); ledger(); tick(); planDraw();
})();
</script>
