// The business plan: five assumptions, three years, break-even, cash.
const A = { ...D.plan.assumptions };
const fmtA = { projectsPerYear: (v) => v + ' a year', projectSize: (v) => eur(v), hostingPerWorld: (v) => eur(v), monthlyCost: (v) => eur(v), growth: (v) => '+' + Math.round(v * 100) + '%' };
$$('#ob-plan-in input').forEach((el) => { const k = el.dataset.k; el.value = A[k]; el.nextElementSibling.textContent = fmtA[k](A[k]); el.addEventListener('input', () => { A[k] = +el.value; el.nextElementSibling.textContent = fmtA[k](A[k]); planDraw(); }); });
