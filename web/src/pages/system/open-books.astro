    const g = Math.pow(1 + A.growth, i), proj = A.projectsPerYear * g, pr = proj * A.projectSize;
    const host = worlds * A.hostingPerWorld * 12 + (proj * A.hostingPerWorld * 12) / 2, cost = A.monthlyCost * 12 * Math.pow(1 + A.growth / 2, i), res = pr + host - cost;
