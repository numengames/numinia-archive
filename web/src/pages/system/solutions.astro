import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import HighlightBox from "@/components/HighlightBox.astro";

const clusters = [
  {
    id: "C1",
    titulo: "External validation & founder bubble",
    descripcion: "The system has only ever been tested by its creators. There is no evidence that it works for anyone else, in any context, without the founders being there to explain it.",
    gaps: [
      { origen: "Business", label: "No external proof of value" },
      { origen: "Product", label: "Founder bubble / Inverse survivorship bias" },
      { origen: "Theory", label: "Founder bias as the only test case" },
    ],
    soluciones: [
      {
        titulo: "Blind exposure experiment",
        descripcion: "Design a 48h onboarding protocol with no founder intervention: documentation alone, no spoken explanations, no prior context. Measure how much the participant understands, what frustrates them and what resonates. The first person to get through it alone is the real minimum validation.",
        agentes: ["Business", "Product"],
      },
      {
        titulo: "Trusted external ambassador",
        descripcion: "Identify a trusted person outside Numen Games (not from the immediate ecosystem) with a genuine target profile — a team manager at a 20-100 person company — and give them full access for 2 weeks. Their unfiltered feedback is worth more than 6 months of internal analysis.",
        agentes: ["Business", "Theory"],
      },
      {
        titulo: "Separate 'the system works' from 'we work'",
        descripcion: "Design a controlled experiment: the same team operating for 4 weeks with NWOS and 4 weeks without it, measuring output, decision speed and self-reported engagement. If there is no measurable difference, the system is not adding value — the team is.",
        agentes: ["Product", "Theory"],
      },
    ],
  },
  {
    id: "C2",
    titulo: "Adoption complexity & cognitive cost",
    descripcion: "The NWOS vocabulary and its layers of abstraction create an enormous barrier to entry. What is fluid for the founders is a completely alien world to any outsider, before they get any benefit at all.",
    gaps: [
      { origen: "Business", label: "Adoption complexity vs. organisational inertia" },
      { origen: "Product", label: "Cognitive cost of entry vs. perceived benefit" },
      { origen: "Theory", label: "Cognitive load and the philosophy-to-practice translation gap" },
    ],
    soluciones: [
      {
        titulo: "Minimum Viable Vocabulary (MVV)",
        descripcion: "Identify the 5 indispensable concepts someone needs to be operational on their first day. The rest can come later. If you cannot operate the system with 5 words, the system has too many layers for its current phase.",
        agentes: ["Product", "Theory"],
      },
      {
        titulo: "Corporate translation layer",
        descripcion: "Create an 'organisation mode': the same NWOS structures with standard vocabulary (role, project, milestone, team, decision). The narrative world of Numinia remains an optional deep layer, not an entry requirement. Same system, two languages.",
        agentes: ["Business", "Product"],
      },
      {
        titulo: "Progressive onboarding with value at every step",
        descripcion: "Restructure the onboarding so that each new layer of vocabulary arrives with an immediate tangible benefit. The whole system is not explained at the start: it is revealed as the person needs it. Inspired by the best games of progressive design.",
        agentes: ["Product", "Theory"],
      },
    ],
  },
  {
    id: "C3",
    titulo: "Business model & buyer",
    descripcion: "There is no defined ICP, no clear budget line, no operational monetisation model. The NWOS could be SaaS, consultancy, a licensed methodology or training — and that ambiguity in the bootstrapping phase is lethal.",
    gaps: [
      { origen: "Business", label: "The phantom buyer problem" },
      { origen: "Business", label: "Undetermined business model at a critical phase" },
      { origen: "Business", label: "Dependence on evangelism vs. organic demand" },
    ],
    soluciones: [
      {
        titulo: "Bet on a single segment now",
        descripcion: "Choose ONE buyer profile for the next 6 months and design the entire go-to-market around it. Candidates: the CEO of a 15-50 person startup who already feels the culture problem, or the CHRO of a tech company looking for an alternative to OKRs. ICP ambiguity is the main blocker to traction.",
        agentes: ["Business"],
      },
      {
        titulo: "Look for existing demand, don't create new demand",
        descripcion: "Map the problems organisations are actively trying to solve today (culture tools, talent management, onboarding AI into teams) and reframe the NWOS as a solution to those problems. The market is not looking for a 'Narrative Work OS' — it is looking for retention, engagement and productivity.",
        agentes: ["Business"],
      },
      {
        titulo: "Hybrid model: consultancy first, product later",
        descripcion: "The first 3 external implementations as a premium consultancy service (not SaaS). Each implementation generates learning about which part of the system is genuinely valuable, what can be standardised and which metric the client uses to justify the spend. That knowledge builds the product.",
        agentes: ["Business", "Product"],
      },
    ],
  },
  {
    id: "C4",
    titulo: "Accountability & digital citizenship",
    descripcion: "Putting LLMs and humans on an equal footing in roles and missions creates dangerous ambiguity about who answers for what. In organisations with a legal structure, HR and external clients, chains of accountability have to be unambiguous.",
    gaps: [
      { origen: "Product", label: "LLM-human equivalence: the accountability problem" },
      { origen: "Theory", label: "Asymmetry of agency in digital citizenship" },
    ],
    soluciones: [
      {
        titulo: "Differentiated citizenship with explicit human responsibility",
        descripcion: "Keep the narrative equivalence (agents have a role, a rank, missions) but add a layer of accountability: every digital agent has a named 'human tutor' who answers for its decisions. The narrative levels; the protocol differentiates.",
        agentes: ["Product", "Theory"],
      },
      {
        titulo: "Decision protocol with mandatory human signature",
        descripcion: "Define which categories of decision require a human signature in the Stones of the Path, regardless of who carried out the analysis. The digital agent proposes, the human signs. This preserves the coherence of the world without erasing the chain of responsibility.",
        agentes: ["Product"],
      },
      {
        titulo: "Separate the narrative plane from the legal-operational plane",
        descripcion: "Document explicitly that the digital citizenship of the agents exists on the narrative plane (Numinia), not on the operational plane (Numen Games S.L.). The two planes coexist; one does not replace the other. This separation makes the system defensible before any external audit.",
        agentes: ["Business", "Theory"],
      },
    ],
  },
  {
    id: "C5",
    titulo: "Authenticity vs. performance & ritual fatigue",
    descripcion: "Rituals and ranks can degenerate into theatre: formal participation without real involvement. The research in organisational psychology is clear — imposed identity systems produce surface acting, not genuine transformation.",
    gaps: [
      { origen: "Product", label: "Ritual fatigue and performative theatre" },
      { origen: "Theory", label: "The performative compliance trap (surface acting)" },
    ],
    soluciones: [
      {
        titulo: "Opt-in rituals with a real effect on the system",
        descripcion: "Redesign the rituals so that participation has concrete consequences for the state of the system (missions unlocked, decisions activated, resources distributed), not merely symbolic value. When a ritual carries operational weight, genuine and performative participation tell themselves apart.",
        agentes: ["Product", "Theory"],
      },
      {
        titulo: "Authenticity vs. compliance metrics",
        descripcion: "Design indicators that distinguish formal participation from real engagement: time in the system outside mandatory rituals, unsolicited initiatives, contributions to the canon that nobody asked for. If the only moments of participation are the rituals, the system has a problem of intrinsic motivation.",
        agentes: ["Product", "Theory"],
      },
      {
        titulo: "Emergent roles, not assigned ones",
        descripcion: "Change the logic by which guilds and ranks are allocated: instead of being assigned or chosen at the start, let them emerge from real patterns of behaviour in the system. Whoever does Alchemist work receives Alchemist recognition — not the other way round. This removes the incentive to surface act.",
        agentes: ["Theory"],
      },
    ],
  },
  {
    id: "C6",
    titulo: "Metrics & demonstrability of value",
    descripcion: "The system has no mechanisms of its own for measuring whether it is working. Without its own indicators, it cannot demonstrate ROI, cannot detect its own decay and cannot tell itself apart from 'the founding team is simply good'.",
    gaps: [
      { origen: "Product", label: "Metric void: how does the system know it works?" },
      { origen: "Business", label: "Obsolescence risk from the commoditisation of LLMs" },
    ],
    soluciones: [
      {
        titulo: "System health dashboard",
        descripcion: "Define 5-7 NWOS-specific indicators that go beyond standard business output: average time to close a mission, ratio of decisions with complete documentation, ritual participation vs. baseline, bottom-up initiatives generated, time from a mission opening to first progress. Publish them internally as a contract with yourself.",
        agentes: ["Product", "Business"],
      },
      {
        titulo: "A methodological moat, not a technological one",
        descripcion: "Accept that the technological advantage of integrating LLMs is temporarily fleeting and bet on the real moat: the body of knowledge about how to design, implement and maintain an NWOS in a real organisation. That tacit knowledge cannot be copied with a product. The difference between reading about yoga and being a yoga teacher with 10 years of practice.",
        agentes: ["Business"],
      },
      {
        titulo: "Comparable use cases as proof of concept",
        descripcion: "Document the Numen Games case exhaustively as a reference: state before the NWOS (if it can be reconstructed), current state, concrete indicators. One well-documented real case is worth more than 10 theoretical claims. It is the most valuable commercial asset that exists right now.",
        agentes: ["Business", "Product"],
      },
    ],
  },
  {
    id: "C7",
    titulo: "Cultural barrier & unvalidated universalism",
    descripcion: "The esoteric vocabulary provokes rejection in traditional corporate contexts. The Jungian foundation assumes universal psychological structures that cross-cultural research does not confirm for every profile.",
    gaps: [
      { origen: "Business", label: "The metaphor as a barrier to entry" },
      { origen: "Business", label: "Institutional credibility: the corporate world's wall" },
      { origen: "Theory", label: "Jungian universalism vs. cultural and personality variation" },
    ],
    soluciones: [
      {
        titulo: "Explicit compatibility profiles",
        descripcion: "Document which kind of person and organisation the NWOS works best for, and which it does not. Do not try to be universal. Self-filtering is a strength if it is intentional: 'this is not for everyone' is a value proposition, not a weakness, if it is aimed at the right segment.",
        agentes: ["Business", "Theory"],
      },
      {
        titulo: "Configurable cultural interface",
        descripcion: "Design the NWOS with a surface layer (vocabulary, ritual names, narrative aesthetics) that is separable from the structural core. A Japanese organisation or a law firm can use the same grammar of roles/missions/decisions with their own cultural language on top.",
        agentes: ["Product", "Theory"],
      },
      {
        titulo: "Empirical validation of the theoretical foundation",
        descripcion: "Instead of citing Peirce and Jung as an unquestionable foundation, design a minimal research protocol that tests the central hypotheses: do narrative roles produce greater identification than corporate titles? Do named rituals generate more cohesion than standard meetings? Own data > appeals to authority.",
        agentes: ["Theory", "Business"],
      },
    ],
  },
  {
    id: "C8",
    titulo: "NWOS as a painkiller & structural burnout",
    descripcion: "The NWOS intervenes on the values and community dimension of burnout, but does not touch workload, control or fairness — which in most organisations are the primary drivers. Risk: it supplies narrative meaning that masks structural problems without resolving them.",
    gaps: [
      { origen: "Theory", label: "Causal misunderstanding of burnout" },
      { origen: "Product", label: "Narrative coherence does not scale without infrastructure" },
    ],
    soluciones: [
      {
        titulo: "Mandatory prior diagnosis",
        descripcion: "Before implementing the NWOS in any organisation, carry out a diagnosis of Maslach's 6 dimensions. If the workload, control or fairness dimensions are in the red, document that the NWOS is not the appropriate intervention as a first layer. This protects the product from being blamed for problems it cannot solve.",
        agentes: ["Theory"],
      },
      {
        titulo: "NWOS as an amplifier, not as a foundation",
        descripcion: "Reframe the product claim: the NWOS does not resolve structural burnout, it amplifies where the structural conditions are healthy. It is a multiplier of engagement, not a substitute for basic organisational management. This reframing is more honest and more defensible.",
        agentes: ["Business", "Theory"],
      },
      {
        titulo: "Canon maintenance protocol",
        descripcion: "Design an explicit 'canon keeper' role with recognised authority to arbitrate divergent interpretations of the system as it scales. Without that role, narrative coherence fragments inevitably beyond 10-15 people.",
        agentes: ["Product"],
      },
    ],
  },
];

const agentColors: Record<string, string> = {
  Business: "bg-blue/10 text-blue border-blue/30",
  Product: "bg-purple/10 text-purple border-purple/30",
  Theory: "bg-teal/10 text-accent border-teal/30",
};
---

<Layout
  title="NWOS — Solutions — Pablo FM"
  description="Narrative Work OS gaps grouped, with 3 proposed solutions per cluster. Signed by perspective of analysis."
  canonicalPath="/system/solutions"
  activeNav="system/"
>
  <PageHero
    label="NWOS — Solutions"
    title="From blind spots to answers"
    description="20 gaps grouped into 8 clusters. 3 solutions per cluster. Each solution signed by the agent that proposes it."
  />

  <!-- Intro -->
  <section class="pb-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <div class="max-w-[720px] space-y-4 text-base leading-relaxed text-muted-foreground">
        <p>
          The previous analysis identified 20 gaps from three critical perspectives. Many of them point at the same problem from different angles. This document groups them into <strong class="text-foreground">8 clusters</strong> and proposes <strong class="text-foreground">3 solutions per cluster</strong> — ordered from the most immediate to the most structural.
        </p>
        <p>
          Each solution carries the signature of the agents that propose it. Not all perspectives hold the same opinion on every problem.
        </p>
      </div>

      <!-- Agent legend -->
      <div class="mt-8 flex flex-wrap gap-3 text-xs">
        <span class="rounded-full border px-3 py-1 bg-blue/10 text-blue border-blue/30 font-mono">Business</span>
        <span class="rounded-full border px-3 py-1 bg-purple/10 text-purple border-purple/30 font-mono">Product</span>
        <span class="rounded-full border px-3 py-1 bg-teal/10 text-accent border-teal/30 font-mono">Theory</span>
        <span class="ml-2 text-muted-foreground/60 self-center">— perspectives that sign each solution</span>
      </div>
    </div>
  </section>

  <!-- Clusters -->
  {clusters.map((cluster) => (
    <section class="border-t border-border py-16">
      <div class="mx-auto max-w-[1100px] px-6">
        <!-- Cluster header -->
        <div class="flex items-start gap-4 mb-8">
          <div class="shrink-0 rounded-lg border border-accent/30 bg-accent/5 px-3 py-1.5 font-mono text-xs text-accent">{cluster.id}</div>
          <div>
            <h2 class="font-display text-2xl text-foreground">{cluster.titulo}</h2>
            <p class="mt-2 max-w-[680px] text-sm text-muted-foreground">{cluster.descripcion}</p>
            <!-- Gaps origen -->
            <div class="mt-3 flex flex-wrap gap-2">
              {cluster.gaps.map((g) => (
                <span class={`rounded-full border px-2.5 py-0.5 text-[0.65rem] font-mono uppercase tracking-wider ${agentColors[g.origen]}`}>
                  {g.origen}: {g.label}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Soluciones -->
        <div class="grid gap-4 sm:grid-cols-3">
          {cluster.soluciones.map((s, i) => (
            <div class="rounded-xl border border-border bg-card p-5 space-y-3 flex flex-col">
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono text-muted-foreground/50">S{i + 1}</span>
                <h3 class="font-display text-sm text-foreground leading-snug">{s.titulo}</h3>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed flex-1">{s.descripcion}</p>
              <!-- Firmas -->
              <div class="flex flex-wrap gap-1.5 pt-2 border-t border-border/50">
                {s.agentes.map((a) => (
                  <span class={`rounded-full border px-2 py-0.5 text-[0.6rem] font-mono uppercase tracking-wider ${agentColors[a]}`}>
                    {a}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Cierre -->
  <section class="border-t border-border py-20">
    <div class="mx-auto max-w-[1100px] px-6">
      <HighlightBox>
        <p class="text-sm leading-relaxed text-muted-foreground">
          <strong class="text-accent">Recommended action priority:</strong> Clusters C1 (external validation), C2 (adoption complexity) and C3 (business model) are the only ones that block everything else. Without external validation, the solutions to the other clusters are premature optimisation. The rest — digital accountability, ritual authenticity, metrics, cultural barrier, structural burnout — are problems of scale that only activate when there is something to scale.
        </p>
      </HighlightBox>
    </div>
  </section>
</Layout>
