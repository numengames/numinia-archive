---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";

// The narrative dial has three levels, the moon's three stops (2026-09-29):
// L1 Business (new moon), L2 Mixed (half), L3 Numinia (full). The five-level
// scale of MIS-055 (1·3·5·7·10) is retired for narrative; the gamification
// dial keeps its five named thresholds.
const levels = [
  {
    n: 1,
    name: "Business",
    subtitle: "Pure operational language. No metaphors.",
    color: "var(--ink-ceniza)",
    bg: "bg-[var(--ink-ceniza)]/8",
    border: "border-[var(--ink-ceniza)]/25",
    dot: "bg-[var(--ink-ceniza)]",
    who: "Traditional companies, corporate teams, skeptical C-suites.",
    feel: "\"This is a work management system with structured documentation and AI agents.\"",
  },
  {
    n: 2,
    name: "Mixed",
    subtitle: "Half and half: the business words with Numinia's beside them.",
    color: "var(--ink-verde)",
    bg: "bg-[var(--ink-verde)]/8",
    border: "border-[var(--ink-verde)]/25",
    dot: "bg-[var(--ink-verde)]",
    who: "Tech startups, DAOs, companies building culture intentionally.",
    feel: "\"Our missions run through the guilds, tracked in the Archive.\"",
  },
  {
    n: 3,
    name: "Numinia",
    subtitle: "Full immersion. The city is the system.",
    color: "var(--ink-verdemar)",
    bg: "bg-[var(--ink-verdemar)]/8",
    border: "border-[var(--ink-verdemar)]/25",
    dot: "bg-[var(--ink-verdemar)]",
    who: "Numen Games. Organizations ready for a complete narrative operating system.",
    feel: "\"The Guardián de las Puertas runs the Dark Council. The Oráculos govern from the Summa Archive.\"",
  },
];

const gamifLevels = [
  { n: 1, name: "None", desc: "Just the OS. No mechanics of any kind.", color: "var(--ink-ceniza)" },
  { n: 2, name: "Visibility", desc: "Dashboards, streaks, progress %", color: "var(--ink-verde)" },
  { n: 3, name: "Achievement", desc: "Badges, milestones, celebration", color: "var(--ink-ambar)" },
  { n: 4, name: "Progression", desc: "Ranks, reputation, history", color: "var(--ink-ambar)" },
  { n: 5, name: "Full Economy", desc: "Tokens, Prism Cells, real weight", color: "var(--ink-verdemar)" },
];

// Mechanics unlock cumulatively with the gamification dial.
const mechanics = [
  { from: 2, label: "Dashboards · progress % · streaks" },
  { from: 3, label: "Badges · milestones · the system celebrates" },
  { from: 4, label: "Ranks · reputation · the system remembers" },
  { from: 5, label: "Tokens · Prism Cells · real economic weight" },
];

const vocab = [
  {
    category: "Agents & Roles",
    rows: [
      { concept: "Founding Partner", l1: "Founding Partner", l2: "Oracle", l3: "Oráculo" },
      { concept: "Operations Lead", l1: "Head of Operations", l2: "Operations Lead", l3: "Centinela" },
      { concept: "CTO / Innovation", l1: "CTO / Head of Product", l2: "Innovation Lead", l3: "Alquimista" },
      { concept: "Chief of Staff / Knowledge", l1: "Chief of Staff", l2: "Knowledge Lead", l3: "Exégeta" },
      { concept: "COO / Business", l1: "Head of Business", l2: "Business Lead", l3: "Procurador" },
      { concept: "AI Orchestration", l1: "AI Orchestration Layer", l2: "System Intelligence", l3: "Procyon" },
      { concept: "AI Agent", l1: "AI Agent", l2: "Digital Agent", l3: "Agente Digital" },
      { concept: "New member", l1: "New member", l2: "Nomad", l3: "Nómada" },
      { concept: "Team member", l1: "Team member", l2: "Citizen", l3: "Ciudadano" },
      { concept: "Contributor", l1: "Contributor", l2: "Pilgrim", l3: "Peregrino" },
      { concept: "Principal", l1: "Principal", l2: "Vernacular", l3: "Vernáculo" },
      { concept: "Executive", l1: "Executive", l2: "Archon", l3: "Arconte" },
    ],
  },
  {
    category: "Structures",
    rows: [
      { concept: "Profession", l1: "Profession", l2: "Guild", l3: "Gremio" },
      { concept: "Specialization", l1: "Specialization", l2: "Branch", l3: "Rama" },
      { concept: "Subspecialization", l1: "Subspecialization", l2: "House", l3: "Casa" },
      { concept: "Area", l1: "Area", l2: "Faction", l3: "Facción" },
      { concept: "Operations Center", l1: "Operations Center", l2: "CAO", l3: "CAO" },
      { concept: "Design document", l1: "Design document", l2: "Blueprint", l3: "Plano" },
      { concept: "Knowledge Base", l1: "Knowledge Base", l2: "Archive", l3: "Summa Archive" },
      { concept: "Decision Record", l1: "Decision Record", l2: "Decision Stone", l3: "Piedra del Camino" },
      { concept: "Report", l1: "Report", l2: "Dispatch", l3: "Reporte" },
      { concept: "Procedure / SOP", l1: "Procedure / SOP", l2: "Procedure", l3: "Procedimiento" },
    ],
  },
  {
    category: "Actions & Rituals",
    rows: [
      { concept: "Project / Initiative", l1: "Project", l2: "Mission", l3: "Misión" },
      { concept: "Daily Standup", l1: "Daily Standup", l2: "Daily", l3: "Daily" },
      { concept: "Weekly Strategy", l1: "Weekly Strategy Meeting", l2: "Council", l3: "Dark Council" },
      { concept: "Creative Session", l1: "Creative Session", l2: "Coven", l3: "Lunar Coven" },
      { concept: "Onboarding Workshop", l1: "Onboarding", l2: "Session Zero", l3: "Session Zero" },
      { concept: "Experience / Event", l1: "Experience", l2: "Adventure", l3: "Aventura" },
      { concept: "Quarter / Cycle", l1: "Quarter", l2: "Season", l3: "Temporada" },
    ],
  },
  {
    category: "System & Product",
    rows: [
      { concept: "Work Operating System", l1: "Work Operating System", l2: "Narrative Work OS", l3: "Narrative Work OS" },
      { concept: "The Organization", l1: "The Organization", l2: "The City", l3: "Numinia" },
      { concept: "Contribution Credit", l1: "Contribution Credit", l2: "Prism Cell", l3: "Prism Cell" },
      { concept: "Badge / Certificate", l1: "Badge", l2: "Seal", l3: "Sello" },
    ],
  },
];

const colColors = levels.map((l) => l.color);
const colNames = levels.map((l) => `${l.n} · ${l.name}`);

// Data handed to the configurator script.
const narrData = levels.map(({ n, name, color, feel }) => ({ n, name, color, feel }));
const gamifData = gamifLevels.map(({ n, name, color, desc }) => ({ n, name, color, desc }));
const mechData = mechanics;
---

<Layout
  title="Narrative Dial — Language System · Numen Games"
  description="Two dials: three narrative levels, five gamification thresholds. Organizations choose their level of narrative and gamification. The NWOS speaks any language."
  canonicalPath="/system/language"
  activeNav="system/"
>

  <!-- Hero -->
  <section class="pt-16 pb-12 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Numen Games · NWOS · Adaptability</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl text-foreground mb-4">Two Dials. One System.</h1>
      <p class="text-lg text-muted-foreground leading-relaxed">
        The Narrative Work OS speaks any language. Each organization sets two dials — how much narrative (three levels), how much gamification (five thresholds). The system is the same — the vocabulary and the mechanics adapt.
      </p>
    </div>
  </section>

  <!-- Configurator -->
  <section class="py-16 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="mb-8 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Try it — set your dials</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 mb-6">
        <!-- Narrative selector -->
        <div class="rounded-[8px] border border-accent/30 bg-accent/5 p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-accent"><Icon name="mask-happy" size={20} /></span>
              <h2 class="font-display text-lg text-foreground">Narrative</h2>
            </div>
            <span id="narr-readout" class="font-mono text-[0.7rem]"></span>
          </div>
          <div id="narr-buttons" class="flex gap-2" role="radiogroup" aria-label="Narrative level (1 to 3)">
            {levels.map((l) => (
              <button
                type="button"
                role="radio"
                data-dial="narr"
                data-level={l.n}
                aria-checked="false"
                class="dial-btn flex-1 rounded-[8px] border border-border py-2 font-mono text-sm text-muted-foreground transition-colors"
                style={`--lvl-color: ${l.color}`}
                title={l.name}
              >{l.n}</button>
            ))}
          </div>
        </div>

        <!-- Gamification selector -->
        <div class="rounded-[8px] border border-[var(--ink-ambar)]/25 bg-[var(--ink-ambar)]/5 p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-[var(--ink-ambar)]"><Icon name="game-controller" size={20} /></span>
              <h2 class="font-display text-lg text-foreground">Gamification</h2>
            </div>
            <span id="gamif-readout" class="font-mono text-[0.7rem]"></span>
          </div>
          <div id="gamif-buttons" class="flex gap-2" role="radiogroup" aria-label="Gamification level (1 to 5)">
            {gamifLevels.map((l) => (
              <button
                type="button"
                role="radio"
                data-dial="gamif"
                data-level={l.n}
                aria-checked="false"
                class="dial-btn flex-1 rounded-[8px] border border-border py-2 font-mono text-sm text-muted-foreground transition-colors"
                style={`--lvl-color: ${l.color}`}
                title={l.name}
              >{l.n}</button>
            ))}
          </div>
        </div>
      </div>

      <!-- Live preview -->
      <div id="config-preview" class="rounded-[8px] border p-6 transition-colors" aria-live="polite">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-1">Your configuration</p>
        <p class="font-display text-xl mb-4"><span id="preview-title" class="text-foreground"></span></p>
        <p id="preview-feel" class="text-sm italic text-muted-foreground border-l-2 pl-3 mb-5"></p>
        <div id="preview-mechanics" class="grid sm:grid-cols-2 gap-x-6 gap-y-1.5"></div>
        <p class="font-mono text-[0.55rem] text-dim mt-5">Internal config scale (1–10): gamification <span id="preview-internal-gamif"></span></p>
      </div>
    </div>
  </section>

  <!-- The two dials -->
  <section class="py-16 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="mb-8 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">The two dials</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <!-- Narrative dial -->
        <div class="rounded-[8px] border border-accent/30 bg-accent/5 p-7">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-accent"><Icon name="mask-happy" size={24} /></span>
            <div>
              <h2 class="font-display text-xl text-foreground">Narrative Dial</h2>
              <p class="font-mono text-[0.6rem] text-dim">1 → 3 · the moon's three stops</p>
            </div>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed mb-5">
            Controls vocabulary and semantic identity. At 1, it's a business tool. At 3, you're inside a living world.
          </p>
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[0.6rem] text-[var(--ink-ceniza)]">1 — Business</span>
              <span class="font-mono text-[0.6rem] text-[var(--ink-ceniza)]">"Project Management"</span>
            </div>
            <div class="h-2 rounded-full bg-gradient-to-r from-[var(--ink-ceniza)] via-[var(--ink-verde)] to-[var(--ink-verdemar)]"></div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-[0.6rem] text-[var(--ink-verdemar)]">3 — Numinia</span>
              <span class="font-mono text-[0.6rem] text-[var(--ink-verdemar)]">"Misiones del Oráculo"</span>
            </div>
          </div>
        </div>

        <!-- Gamification dial -->
        <div class="rounded-[8px] border border-[var(--ink-ambar)]/25 bg-[var(--ink-ambar)]/5 p-7">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-[var(--ink-ambar)]"><Icon name="game-controller" size={24} /></span>
            <div>
              <h2 class="font-display text-xl text-foreground">Gamification Dial</h2>
              <p class="font-mono text-[0.6rem] text-dim">1 → 5 · five named thresholds</p>
            </div>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed mb-5">
            Gamification has qualitative jumps, not a smooth curve. Five named thresholds. Independent from the narrative dial.
          </p>
          <div class="space-y-2 mb-4">
            {gamifLevels.map((t) => (
              <div class="flex items-center gap-3" data-gamif-row={t.n}>
                <span class="font-mono text-[0.6rem] w-4 text-right flex-shrink-0" style={`color: ${t.color}`}>{t.n}</span>
                <div class="h-1.5 flex-1 rounded-full" style={`background: color-mix(in srgb, ${t.color} 19%, transparent)`}>
                  <div class="h-full rounded-full" style={`width: ${(t.n / 5) * 100}%; background: color-mix(in srgb, ${t.color} 50%, transparent)`}></div>
                </div>
                <span class="font-mono text-[0.6rem] w-24 flex-shrink-0" style={`color: ${t.color}`}>{t.name}</span>
                <span class="font-mono text-[0.55rem] text-dim hidden sm:block">{t.desc}</span>
              </div>
            ))}
          </div>
          <p class="font-mono text-[0.55rem] text-dim italic">Externally 1–5; internally each level maps to the 1–10 config scale (1·3·5·7·10)</p>
        </div>
      </div>

      <!-- Both dials are independent -->
      <div class="mt-6 rounded-[8px] border border-border bg-card/50 p-5">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-3">The dials are independent</p>
        <div class="grid sm:grid-cols-3 gap-4 text-sm text-muted-foreground">
          <div><Icon name="buildings" size={14} class="inline-block align-[-2px]" /> <strong class="text-foreground">Corp standard</strong><br/>Narrative 1 · Gamification 1<br/><span class="text-xs">Pure business tool</span></div>
          <div><Icon name="game-controller" size={14} class="inline-block align-[-2px]" /> <strong class="text-foreground">Gaming company</strong><br/>Narrative 1 · Gamification 5<br/><span class="text-xs">Gamified but business language</span></div>
          <div><Icon name="moon" size={14} class="inline-block align-[-2px]" /> <strong class="text-foreground">Numinia</strong><br/>Narrative 3 · Gamification TBD<br/><span class="text-xs">Full immersion</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- The 3 narrative levels -->
  <section class="py-16 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="mb-8 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Narrative Dial — 3 levels</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <div class="space-y-4">
        {levels.map((level) => (
          <div class={`rounded-[8px] border ${level.border} ${level.bg} p-5 transition-shadow`} data-narr-card={level.n}>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 text-center w-10">
                <div class={`w-8 h-8 rounded-full ${level.dot} mx-auto mb-1 flex items-center justify-center`}>
                  <span class="font-display text-sm text-background font-bold">{level.n}</span>
                </div>
              </div>
              <div class="flex-1">
                <div class="flex flex-wrap items-baseline gap-2 mb-2">
                  <h3 class="font-display text-lg" style={`color: ${level.color}`}>{level.name}</h3>
                  <span class="font-mono text-[0.6rem] text-muted-foreground">{level.subtitle}</span>
                </div>
                <p class="text-xs text-muted-foreground mb-2"><strong class="text-foreground/70">Who:</strong> {level.who}</p>
                <p class="text-xs italic text-muted-foreground border-l-2 pl-3" style={`border-color: color-mix(in srgb, ${level.color} 25%, transparent)`}>{level.feel}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Full vocabulary table -->
  <section class="py-16 border-b border-border">
    <div class="mx-auto max-w-[1100px] px-6">
      <div class="mb-8 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Vocabulary map</span>
        <span class="h-px flex-1 bg-border"></span>
        <span class="font-mono text-[0.6rem] text-dim">Same concept · 3 levels</span>
      </div>

      <div class="space-y-10">
        {vocab.map((section) => (
          <div>
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.15em] text-dim mb-3">{section.category}</p>
            <div class="rounded-[8px] border border-border overflow-x-auto">
              <!-- Header -->
              <div class="grid bg-card/80 border-b border-border" style="grid-template-columns: 1.4fr repeat(3, 1fr); min-width: 560px">
                <div class="px-4 py-2.5">
                  <span class="font-mono text-[0.55rem] uppercase tracking-[0.15em] text-dim">Concept</span>
                </div>
                {colNames.map((name, i) => (
                  <div class="px-3 py-2.5 text-center vocab-cell" data-vocab-level={i + 1}>
                    <span class="font-mono text-[0.55rem] font-medium" style={`color: ${colColors[i]}`}>{name}</span>
                  </div>
                ))}
              </div>
              <!-- Rows -->
              {section.rows.map((row, ri) => (
                <div
                  class={`grid border-b border-border/50 last:border-0 ${ri % 2 === 0 ? "" : "bg-card/30"}`}
                  style="grid-template-columns: 1.4fr repeat(3, 1fr); min-width: 560px"
                >
                  <div class="px-4 py-2.5">
                    <span class="text-xs text-foreground/60">{row.concept}</span>
                  </div>
                  {[row.l1, row.l2, row.l3].map((val, i) => (
                    <div class="px-3 py-2.5 text-center vocab-cell" data-vocab-level={i + 1}>
                      <span class="font-mono text-[0.6rem]" style={`color: color-mix(in srgb, ${colColors[i]} var(--ink-soft), transparent)`}>{val}</span>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why this matters -->
  <section class="py-16 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="mb-6 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Why this changes everything</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {[
          {
            title: "Narrative is a feature, not a requirement",
            desc: "The system works at dial 1. No lore needed. Organizations that want the narrative can unlock it — organizations that don't can ignore it completely.",
          },
          {
            title: "Solves the first-impression problem",
            desc: "A traditional C-suite sees a structured work OS with AI agents. A gaming studio sees a living narrative world. Same system. Different entry points.",
          },
          {
            title: "Gamification is independent",
            desc: "A company can have full gamification (ranks, achievements, tokens) at narrative level 1. The mechanics don't require the metaphors.",
          },
          {
            title: "Numinia is the reference, not the constraint",
            desc: "Numinia (level 3) is what full adoption looks like. It's the vision, not the requirement. Every organization starts wherever they are.",
          },
        ].map((item) => (
          <div class="rounded-[8px] border border-border bg-card p-5">
            <p class="font-semibold text-sm text-foreground mb-2">{item.title}</p>
            <p class="text-xs text-muted-foreground leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Status -->
  <section class="py-12">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="rounded-[8px] border border-yellow/20 bg-yellow/5 p-6">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-yellow mb-3 flex items-center gap-1.5"><Icon name="lightning" size={11} /> Work in progress — MIS-055</p>
        <p class="text-sm text-muted-foreground leading-relaxed mb-3">
          This page documents a system design proposal that emerged from the Dark Council on 2026-04-06. On 2026-08-18 the external scale was fixed at 1–5 per dial; on 2026-09-29 the narrative dial was reduced to three levels, the moon's three stops. The vocabulary table above is a first proposal — it will evolve.
        </p>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Once validated, this becomes <strong class="text-foreground">DEC-006</strong> — a decision that modifies the NWOS architecture to include the two-dial system as a standard configuration parameter.
        </p>
        <div class="flex flex-wrap gap-3 mt-4">
          <!-- MIS-055 was deleted in the alpha-focus cut (RPT-017 v0.4.0) and
               its redirect led to that report, which says nothing about the
               two-dial system. ADR-047 removed such redirects, so this link
               had nowhere left to go. -->
          <a href="/decisions" class="font-mono text-[0.65rem] text-dim hover:text-foreground transition-colors">Decision Registry →</a>
          <a href="/system/sys-006-nwos-system" class="font-mono text-[0.65rem] text-dim hover:text-foreground transition-colors">NWOS overview →</a>
          <a href="https://nwos.numen.games/workspace/faro-austral" target="_blank" rel="noopener noreferrer" class="font-mono text-[0.65rem] text-dim hover:text-foreground transition-colors">See a demo workspace →</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .dial-btn[aria-checked="true"] {
    border-color: var(--lvl-color);
    background: color-mix(in srgb, var(--lvl-color) 15%, transparent);
    color: var(--lvl-color);
    font-weight: 700;
  }
  .vocab-cell.vocab-active {
    background: color-mix(in srgb, var(--vocab-color, var(--ink-verdemar)) 10%, transparent);
    box-shadow: inset 2px 0 0 color-mix(in srgb, var(--vocab-color, var(--ink-verdemar)) 45%, transparent),
      inset -2px 0 0 color-mix(in srgb, var(--vocab-color, var(--ink-verdemar)) 45%, transparent);
  }
  [data-narr-card].narr-active {
    box-shadow: 0 0 0 2px var(--narr-ring, var(--ink-verdemar));
  }
  [data-gamif-row].gamif-active {
    background: color-mix(in srgb, var(--gamif-color, var(--ink-ambar)) 10%, transparent);
    border-radius: 6px;
  }
</style>

<script define:vars={{ narrData, gamifData, mechData }}>
  const INTERNAL = { 1: 1, 2: 3, 3: 5, 4: 7, 5: 10 };
  const state = { narr: 1, gamif: 2 };

  const $ = (sel) => document.querySelector(sel);
  const $$ = (sel) => Array.from(document.querySelectorAll(sel));

  function render() {
    const narr = narrData.find((l) => l.n === state.narr);
    const gamif = gamifData.find((l) => l.n === state.gamif);

    // Selector buttons
    for (const btn of $$(".dial-btn")) {
      const active = Number(btn.dataset.level) === state[btn.dataset.dial];
      btn.setAttribute("aria-checked", String(active));
    }

    // Readouts
    const narrReadout = $("#narr-readout");
    narrReadout.textContent = `${narr.n} · ${narr.name}`;
    narrReadout.style.color = narr.color;
    const gamifReadout = $("#gamif-readout");
    gamifReadout.textContent = `${gamif.n} · ${gamif.name}`;
    gamifReadout.style.color = gamif.color;

    // Preview panel
    const panel = $("#config-preview");
    panel.style.borderColor = `color-mix(in srgb, ${narr.color} 33%, transparent)`;
    panel.style.background = `color-mix(in srgb, ${narr.color} 4%, transparent)`;
    const title = $("#preview-title");
    title.innerHTML = "";
    const narrSpan = document.createElement("span");
    narrSpan.textContent = narr.name;
    narrSpan.style.color = narr.color;
    const gamifSpan = document.createElement("span");
    gamifSpan.textContent = gamif.name;
    gamifSpan.style.color = gamif.color;
    title.append(narrSpan, " · ", gamifSpan);
    $("#preview-feel").textContent = narr.feel;
    $("#preview-feel").style.borderColor = `color-mix(in srgb, ${narr.color} 25%, transparent)`;

    const mech = $("#preview-mechanics");
    mech.innerHTML = "";
    if (state.gamif === 1) {
      const p = document.createElement("p");
      p.className = "font-mono text-[0.65rem] text-dim sm:col-span-2";
      p.textContent = "— No game mechanics. Just the operating system.";
      mech.appendChild(p);
    } else {
      for (const m of mechData) {
        const on = state.gamif >= m.from;
        const p = document.createElement("p");
        p.className = "font-mono text-[0.65rem]";
        p.style.color = on ? gamif.color : "";
        if (!on) p.classList.add("text-dim", "line-through", "opacity-50");
        p.textContent = `${on ? "+" : "–"} ${m.label}`;
        mech.appendChild(p);
      }
    }
    $("#preview-internal-gamif").textContent = String(INTERNAL[state.gamif]);

    // Highlights across the page
    for (const cell of $$("[data-vocab-level]")) {
      const active = Number(cell.dataset.vocabLevel) === state.narr;
      cell.classList.toggle("vocab-active", active);
      if (active) cell.style.setProperty("--vocab-color", narr.color);
    }
    for (const card of $$("[data-narr-card]")) {
      const active = Number(card.dataset.narrCard) === state.narr;
      card.classList.toggle("narr-active", active);
      if (active) card.style.setProperty("--narr-ring", `color-mix(in srgb, ${narr.color} 40%, transparent)`);
    }
    for (const row of $$("[data-gamif-row]")) {
      const active = Number(row.dataset.gamifRow) === state.gamif;
      row.classList.toggle("gamif-active", active);
      if (active) row.style.setProperty("--gamif-color", gamif.color);
    }
  }

  for (const btn of document.querySelectorAll(".dial-btn")) {
    btn.addEventListener("click", () => {
      state[btn.dataset.dial] = Number(btn.dataset.level);
      render();
    });
  }
  render();
</script>
