---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// The pipeline — sales, tenders, grants, collaborations and partners, one
// kind of record (STD-038, STD-039, OPS-018). THIS PAGE STATES NO FIGURE OF
// ITS OWN: the records in opportunities/ are read at build time through the
// sales kit's own tool (src/lib/pipeline.ts), the same tool CI runs on every
// change, so the page and the check cannot disagree. The stage, the next
// step and its day, the deadline, the chance, the funnel's counts and
// conversions, the card's counts and which requirements decide most calls
// are the tool's verdicts; the page only lays them out.
//
// The page answers "what do I do today?" first: four agenda buttons (Today,
// Next 7 days, All open, Closed), a filter bar (search, kind, a range of
// dates) and a list grouped by the next step's day; the timeline and the
// requirements are the other two views; the funnel of the kind shown closes
// the page. Every row is real HTML rendered here. The script places the
// days against the READER's calendar (a static page is read on many days),
// with the functions in src/lib/pipeline-agenda.mjs, and only hides, orders
// and annotates rows — it composes no address (each `url` is made in
// src/lib/pipeline.ts). Without JavaScript every record shows.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { pipeline, decidingRows, CARD_URL, TEMPLATE_URL, KIND_LABEL, KIND_PLURAL, STEP_LABEL, type PRecord } from "@/lib/pipeline";
import { repoFileUrl } from "@/lib/build-info";
import { radarFeed, FEED_REPO } from "@/lib/feed";

const F = pipeline();
const TODAY = F.today;
const KINDS = F.kinds.map((k) => k.kind);
const KEYS = ["all", ...KINDS] as const;
const of = (key: string) => (key === "all" ? F.records : F.records.filter((r) => r.kind === key));
const keyLabel = (k: string) => (k === "all" ? "All" : KIND_PLURAL[k as keyof typeof KIND_PLURAL]);
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? "" : "s"}`;

// presentation only
const money = (n: number) => new Intl.NumberFormat("en-GB", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(n);
const value = (r: PRecord) => (r.value ? money(r.value) : "no money");
const PAYS: Record<string, string> = {
  advance: "paid in advance", milestones: "paid in milestones", "on-delivery": "paid on delivery",
  "on-justification": "paid after justification", "in-kind": "paid in kind", "to-ask": "how it pays: to ask",
};
const pays = (r: PRecord) => {
  const p = r.pays ? (PAYS[r.pays] ?? r.pays.replace(/-/g, " ")) : "how it pays: to ask";
  return (r.pays === "advance" || r.pays === "milestones") && r.advance !== null ? `${p}, ${r.advance} % before the work` : p;
};
const day = (s: string | null) => (s ? s.slice(0, 10) : "");
const lostLine = (r: PRecord) => r.events.find((e) => e.event === "lost")?.text ?? "";
const CHANCE_TIP: Record<string, string> = {
  high: "in a line the house sells, and the house has won in that line before",
  medium: "one of the two: in a line the house sells, or the house has won in that line before",
  low: "outside the house's lines, with no win behind it",
};

// The list: open records by their next step, then closed ones, newest first.
// The script regroups them against the reader's day.
const rows = [
  ...F.records.filter((r) => r.open).sort((a, b) => (a.next?.date ?? "9").localeCompare(b.next?.date ?? "9") || a.id.localeCompare(b.id)),
  ...F.records.filter((r) => !r.open).sort((a, b) => (b.closed ?? "").localeCompare(a.closed ?? "")),
];
const searchText = (r: PRecord) => [r.id, r.title, r.organisation, r.operation, r.line, KIND_LABEL[r.kind], r.next?.action, r.stage, r.reason].filter(Boolean).join(" ").toLowerCase();
const GROUPS = [["late", "Late"], ["today", "Today"], ["week", "Next 7 days"], ["later", "Later"], ["closed", "Closed"]] as const;

// The timeline: one axis for every record, its deadline included.
const dayMs = 864e5;
const t = (d: string) => Date.parse(`${d}T00:00:00Z`);
const axis = (() => {
  const dates = F.records.flatMap((r) => [...r.events.map((e) => e.date), day(r.closes)]).filter(Boolean).concat(TODAY).sort();
  let a = t(dates[0]), b = t(dates[dates.length - 1]);
  if (b - a < 30 * dayMs) b = a + 30 * dayMs;
  const padMs = (b - a) * 0.03; a -= padMs; b += padMs;
  const x = (d: string) => Math.round(((t(d) - a) / (b - a)) * 1000) / 10;
  const months: string[] = [];
  const s = new Date(a); let y = s.getUTCFullYear(), m = s.getUTCMonth() + 1;
  if (m > 11) { m = 0; y++; }
  while (Date.UTC(y, m, 1) <= b) { months.push(new Date(Date.UTC(y, m, 1)).toISOString().slice(0, 10)); m++; if (m > 11) { m = 0; y++; } }
  const step = Math.max(1, Math.ceil(months.length / 8));
  return { x, ticks: months.filter((_, i) => i % step === 0) };
})();
const EV_LABEL: Record<string, string> = { found: "found", out: "the house did", pos: "positive answer", neg: "negative answer", won: "won", lost: "lost", next: "next" };
const span = (r: PRecord) => {
  const ds = [...r.events.map((e) => e.date), day(r.closes)].filter(Boolean).sort();
  return { from: ds[0], to: ds[ds.length - 1] };
};

// The funnel, per kind: the tool's counts and conversions; the bar against the first step.
const POSITIVE = F.steps.findIndex((s) => s.step === "positive");
const funnelOf = (key: string) => F.funnel[key] ?? { counts: F.steps.map(() => 0), conversion: F.steps.map(() => null) };

// Reasons lost and days per stage, under the timeline
const reasons = Object.entries(F.reasons);
const daysAll = KINDS.flatMap((k) => Object.entries(F.daysPerStage[k] ?? {}).filter(([, d]) => d !== null).map(([stage, d]) => ({ k, stage, d: d as number })));

// Asked / we have: only the rows the card marks as deciding, in the card's order
const DECIDING = decidingRows(F.card);
const COUNT_WORD: Record<number, string> = { 3: "three", 4: "four", 5: "five", 6: "six", 7: "seven", 8: "eight", 9: "nine", 10: "ten", 11: "eleven", 12: "twelve" };
const STATE: Record<string, { mark: string; text: string; cls: string }> = {
  yes: { mark: "✓", text: "yes", cls: "pq-yes" },
  no: { mark: "✗", text: "no", cls: "pq-no" },
  check: { mark: "?", text: "check", cls: "pq-check" },
};
const AGENDA = [
  ["today", "Today", "late steps and the day's own"],
  ["week", "Next 7 days", "steps and deadlines"],
  ["open", "All open", "everything still in play"],
  ["closed", "Closed", "won and lost, kept apart"],
] as const;
const RANGES = [["any", "Any"], ["7", "7 days"], ["30", "30 days"], ["90", "90 days"], ["custom", "Dates…"]] as const;
const VIEWS = [["list", "List"], ["timeline", "Timeline"], ["card", "Asked / we have"]] as const;
const openN = F.records.filter((r) => r.open).length;
// The automation's feed (AUT-069): what the tender radar found, unreviewed,
// read from its own repository and checked again here. Never in the funnel.
const FEED = await radarFeed();
const CHANCE_WORD: Record<string, string> = { alta: "high", media: "medium", baja: "low" };
---
<Layout
  title="The pipeline — Numinia"
  description="Sales, tenders, grants, collaborations and partners in one pipeline: what is due today, every record with what it is about, its next step, its deadline and its chance, a timeline, the requirements that decide most calls, and the funnel. Computed from public records; nobody's name in them."
  canonicalPath="/system/pipeline"
  activeNav="system/"
>
  <PageHero
    label="System — The pipeline"
    title="Every opportunity, in one pipeline"
    description="Sales, tenders, grants, collaborations and partners. Start with what is due. Read from the public records: nobody's name in them, the organisation a sector until it agrees."
  />
  <div class="mx-auto max-w-[1100px] px-6 pb-8">
    <DocToolbar
      mdUrl="/system/pipeline.md"
      filename="numinia-pipeline.md"
      repoUrl={repoFileUrl("opportunities")}
      lang="en"
    />
  </div>
  <section class="pb-20" id="pq" data-today={TODAY}><div class="mx-auto max-w-[1100px] px-6">
    <noscript><p class="cq-note">Without JavaScript this page shows every record, open first. The records themselves are plain text: <a href="/opportunities/">/opportunities/</a>; the same figures as tables: <a href="/system/pipeline.md">pipeline.md</a>.</p></noscript>

    <!-- The agenda: the first question is what to do -->
    <div class="pq-ag" id="pq-ag" role="group" aria-label="Agenda">
      {AGENDA.map(([a, label, sub]) => (
        <button type="button" data-a={a} aria-pressed={a === "today" ? "true" : "false"}>
          <b class="pq-ag-n" data-count={a}>{a === "open" ? openN : a === "closed" ? F.records.length - openN : "·"}</b>
          <span class="pq-ag-l">{label}</span>
          <small><span class="pq-ag-late" data-late={a}></span>{sub}</small>
        </button>
      ))}
    </div>

    <!-- The filters: search, kind, a range of dates -->
    <div class="pq-fb">
      <input id="pq-q" type="search" placeholder="Search an organisation, an operation, a step…" aria-label="Search the pipeline" autocomplete="off" />
      <span class="pq-fg"><span class="pq-lbl">Kind</span>
        <span class="pq-seg" id="pq-kind" role="group" aria-label="Kind">
          {KEYS.map((k) => <button type="button" data-k={k} aria-pressed={k === "all" ? "true" : "false"}>{keyLabel(k)}<span class="pq-n" data-kn={k}>{of(k).length}</span></button>)}
        </span>
      </span>
      <span class="pq-fg"><span class="pq-lbl">When</span>
        <span class="pq-seg" id="pq-range" role="group" aria-label="When">
          {RANGES.map(([v, label]) => <button type="button" data-r={v} aria-pressed={v === "any" ? "true" : "false"}>{label}</button>)}
        </span>
        <span class="pq-dates" id="pq-dates" hidden><input type="date" id="pq-from" aria-label="From" /> – <input type="date" id="pq-to" aria-label="To" /></span>
      </span>
    </div>

    <div class="pq-sumrow">
      <span class="pq-sum" id="pq-sum">{plural(F.records.length, "record")}</span>
      <span class="pq-fg">
        <span class="pq-seg" id="pq-sort" role="group" aria-label="Order"><button type="button" data-s="date" aria-pressed="true">By date</button><button type="button" data-s="chance" aria-pressed="false">By chance</button></span>
        <span class="pq-lbl">View</span>
        <span class="pq-seg" id="pq-view" role="group" aria-label="View">
          {VIEWS.map(([v, label]) => <button type="button" data-v={v} aria-pressed={v === "list" ? "true" : "false"}>{label}</button>)}
        </span>
      </span>
    </div>

    <!-- List (default): one row per record -->
    <div class="pq-panel" data-view="list" id="pq-list">
      {GROUPS.map(([g, label]) => <h3 class={`pq-grp pq-grp--${g}`} data-g={g} hidden>{label} · <span data-gn={g}></span></h3>)}
      {rows.map((r) => (
        <article class={`pq-row${r.open ? "" : " pq-row--closed"}`} data-id={r.id} data-kind={r.kind} data-open={r.open ? "1" : "0"}
          data-next={r.next?.date ?? ""} data-closes={day(r.closes)} data-closed={r.closed ?? ""} data-chance={r.chance ?? ""} data-value={r.value} data-q={searchText(r)}>
          <div class="pq-when">
            <b>{r.open ? (r.next?.date ?? "—") : r.closed}</b>
            <span class="pq-rel" data-rel>{r.open ? "next step" : r.stage}</span>
          </div>
          <div class="pq-main">
            <a class="pq-name" href={r.url} title={r.id}><span class={`pq-tag pq-k-${r.kind}`}>{KIND_LABEL[r.kind]}</span> {r.title ?? r.organisation ?? r.id}</a>
            {r.operation && <p class="pq-op"><span class="pq-op-k">What:</span> {r.operation}</p>}
            {(r.contact_email || r.web || r.call) && <p class="pq-op pq-door"><span class="pq-op-k">Write to:</span> {r.contact_email ? <a href={`mailto:${r.contact_email}`}>{r.contact_email}</a> : "their form"}{(r.call ?? r.web) && <> · <a href={(r.call ?? r.web)!} rel="noopener">{r.call ? "the call" : "their page"}</a></>}{r.call && r.web && <> · <a href={r.web} rel="noopener">where they publish it</a></>}</p>}
            {r.open
              ? r.next && <p class="pq-act">→ {r.next.action}</p>
              : <p class={`pq-act${r.stage === "lost" ? " pq-lost" : ""}`}>{r.stage === "lost" ? `Lost — ${r.reason}: ${lostLine(r)}` : "Won"}</p>}
          </div>
          <div class="pq-dl">
            {r.closes
              ? <><span class="pq-lbl">Deadline</span><b>{day(r.closes)}</b><span class="pq-left" data-left></span></>
              : <span class="pq-none">no deadline</span>}
          </div>
          <div class="pq-val">
            <b>{value(r)}</b>
            <span>{pays(r)}</span>
            <span class="pq-meta">{r.chance && <span class={`cq-ch cq-ch--${r.chance}`} title={CHANCE_TIP[r.chance]}>{r.chance} chance</span>} <span class="cq-stage">{r.stage}</span></span>
          </div>
        </article>
      ))}
      <p class="cq-note pq-empty" id="pq-empty" hidden>Nothing here with these filters.</p>
    </div>

    <!-- Timeline -->
    <div class="pq-panel" data-view="timeline" id="pq-tl" hidden>
      <p class="pq-legend"><span class="pq-lg pq-ev-out"></span> the house did something · <span class="pq-lg pq-ev-pos"></span> yes · <span class="pq-lg pq-ev-neg"></span> no · <span class="pq-lg pq-ev-won"></span> won · <span class="pq-lg pq-ev-lost"></span> lost · <span class="pq-lg pq-ev-next"></span> next step · <span class="pq-lg pq-dl-mark"></span> deadline · the upright line is the day the page was built, {TODAY}. The filters above apply here too.</p>
      <div class="pq-gantt">
        <div class="pq-g-axis"><span></span><span class="pq-g-track">{axis.ticks.map((m) => <span class="pq-tick" style={`left:${axis.x(m)}%`}>{m.slice(0, 7)}</span>)}</span></div>
        {rows.map((r) => {
          const s = span(r);
          return (
            <div class={`pq-g-row${r.open ? "" : " pq-g-row--closed"}`} data-id={r.id}>
              <span class="pq-g-label">
                <a class="pq-g-name" href={r.url} title={r.id}><span class={`pq-tag pq-k-${r.kind}`}>{KIND_LABEL[r.kind]}</span> {r.title ?? r.organisation ?? r.id}</a>
                <span class="pq-g-sub">{r.operation ?? value(r)}{!r.open && ` · ${r.stage}`}</span>
              </span>
              <span class="pq-g-track">
                <span class="pq-today" style={`left:${axis.x(TODAY)}%`}></span>
                <span class="pq-span" style={`left:${axis.x(s.from)}%;width:${axis.x(s.to) - axis.x(s.from)}%`}></span>
                {r.events.map((e) => <span class={`pq-dot pq-ev-${e.event}`} style={`left:${axis.x(e.date)}%`} title={`${e.date} · ${EV_LABEL[e.event] ?? e.event}${e.reason ? ` (${e.reason})` : ""} · ${e.text}`} aria-label={`${e.date} · ${e.event} · ${e.text}`} tabindex="0"></span>)}
                {r.closes && <span class="pq-dot pq-dl-mark" style={`left:${axis.x(day(r.closes))}%`} title={`deadline · ${day(r.closes)}`} aria-label={`deadline · ${day(r.closes)}`} tabindex="0"></span>}
              </span>
            </div>
          );
        })}
      </div>
      <div class="pq-two">
        <div>
          <p class="pq-et">Reasons lost</p>
          {reasons.length ? (
            <table class="pq-mini"><tbody>{reasons.map(([reason, count]) => <tr><td>{reason}</td><td class="pq-num">{count}</td></tr>)}</tbody></table>
          ) : <p class="cq-note">Nothing lost yet.</p>}
        </div>
        <div>
          <p class="pq-et">Days per stage, on average</p>
          {daysAll.length ? (
            <table class="pq-mini"><tbody>{daysAll.map((x) => <tr><td><span class={`pq-k-${x.k}`}>{KIND_LABEL[x.k as keyof typeof KIND_LABEL]}</span> <span class="cq-stage">{x.stage}</span></td><td class="pq-num">{x.d} d</td></tr>)}</tbody></table>
          ) : <p class="cq-note">No record has moved past a stage yet, so there are no days to count.</p>}
        </div>
      </div>
    </div>

    <!-- Asked / we have: the requirements the card marks as deciding most calls -->
    <div class="pq-panel" data-view="card" id="pq-card" hidden>
      <p class="pq-legend">What sinks a call most often, what the house holds today, and what would unlock it. Every tender and grant is read against it before it is kept.</p>
      <div class="pq-cardwrap"><table class="pq-cardt"><thead><tr><th>Requirement</th><th>Calls usually ask</th><th>We hold</th><th></th><th>What unlocks it</th><th class="pq-num">Open at check</th></tr></thead><tbody>
        {DECIDING.map((c) => {
          const s = STATE[c.state] ?? { mark: "?", text: c.state, cls: "pq-check" };
          return <tr data-req={c.requirement}><td><b>{c.requirement}</b></td><td>{c.asks}</td><td>{c.house}</td><td class={`pq-mark ${s.cls}`}><span aria-hidden="true">{s.mark}</span> {s.text}</td><td>{c.unlocks}</td><td class="pq-num">{c.check}</td></tr>;
        })}
      </tbody></table></div>
      <p class="pq-funnote">The {COUNT_WORD[DECIDING.length] ?? DECIDING.length} that decide most calls. The full card — every requirement, with sources — is <a href={CARD_URL}>The house's card</a>.</p>
    </div>

    <!-- The funnel of the kind shown: every record that kind ever had -->
    {KEYS.map((key) => {
      const f = funnelOf(key);
      const max = Math.max(1, f.counts[0] ?? 0);
      const noPositive = (f.counts[0] ?? 0) > 0 && POSITIVE >= 0 && f.counts[POSITIVE] === 0;
      return (
        <div class="pq-fun" data-kind={key} hidden={key !== "all"}>
          <p class="pq-et">The funnel — {keyLabel(key)} · {plural(of(key).length, "record")}, open and closed</p>
          <div class="pq-steps">
            {F.steps.map((s, i) => {
              const n = f.counts[i] ?? 0, cv = f.conversion[i] ?? null;
              return (
                <div class={`pq-step${n ? "" : " pq-step--zero"}`} data-step={s.step} data-n={n} data-cv={cv === null ? "" : cv} title={s.means}>
                  <span class="pq-step-name">{i + 1} · {STEP_LABEL[s.step] ?? s.step}</span>
                  <span class="pq-step-n">{n}</span>
                  <span class="pq-step-track"><span class="pq-step-bar" style={`width:${n ? Math.max(3, Math.round((n / max) * 1000) / 10) : 0}%`}></span></span>
                  <span class="pq-step-cv">{cv === null ? (i === 0 ? "where every record starts" : "nothing to carry from the step before") : `${cv} % of the step before`}</span>
                </div>
              );
            })}
          </div>
          {noPositive && <p class="pq-funnote">No positive answer is on record yet: from now on every reply goes into its record's timeline.</p>}
        </div>
      );
    })}

    <section class="pq-feed" data-feed data-feed-state={FEED.state} aria-labelledby="pq-feed-h">
      <h2 id="pq-feed-h" class="pq-et">Unreviewed — what the radar found</h2>
      <p class="pq-funnote">
        The tender radar reads public calls every half hour and writes what passes its filter to
        <a href={FEED_REPO}>its own repository</a>, without review. Shown here as it is, in the radar's Spanish,
        apart from the records and never counted in the funnel. A call becomes a record only through a reviewed pull request.
        {FEED.state === "read" && FEED.published && <> Last written {FEED.published.replace("T", " ")}.</>}
        {FEED.held > 0 && <> {FEED.held} held back here: they read as a person's name or a person's mailbox.</>}
      </p>
      {FEED.state === "unreachable" ? (
        <p class="pq-funnote">The feed could not be read when this page was built.</p>
      ) : FEED.items.length === 0 ? (
        <p class="pq-funnote">Nothing open passes the filter today.</p>
      ) : (
        <ul class="pq-feed-list">
          {FEED.items.map((i) => (
            <li class="pq-feed-item" data-feed-item={i.id} data-in-archive={i.in_archive}>
              <div class="pq-feed-top">
                <a href={i.url} rel="noopener" class="pq-feed-title">{i.title}</a>
                <span class="pq-feed-meta">{CHANCE_WORD[i.chance ?? ""] ?? i.chance} chance{i.closes && <> · closes {i.closes}</>}</span>
              </div>
              <p class="pq-feed-line">{[i.buyer, i.amount].filter(Boolean).join(" · ")}</p>
              {i.blocker && <p class="pq-feed-line"><b>Blocker:</b> {i.blocker}</p>}
              {i.next && <p class="pq-feed-line"><b>Next:</b> {i.next}</p>}
              {i.contact_email && <p class="pq-feed-line"><b>Write to:</b> <a href={`mailto:${i.contact_email}`}>{i.contact_email}</a>{i.web && <> · <a href={i.web} rel="noopener">where they publish it</a></>}</p>}
              {i.in_archive && <p class="pq-feed-line">Already a record: <a href={`/opportunities/${i.in_archive.toLowerCase()}`}>{i.in_archive}</a></p>}
            </li>
          ))}
        </ul>
      )}
    </section>

    <div class="pq-newrow">
      <a id="pq-new" class="pq-new" href={TEMPLATE_URL}>+ Open a new opportunity — the template</a>
      <span class="pq-newnote">One file per opportunity, one line per thing that happens.</span>
    </div>

    <div class="cq-sec">
      <h2>How this page is made</h2>
      <ul class="cq-list">
        <li>Every figure is computed from the records in <a href="/opportunities/">/opportunities/</a> by <code>machine/packages/sales-kit/pipeline.mjs</code>, the same tool that checks them in CI. No number on this page is typed — the funnel's percentages included.</li>
        <li>The kinds, the stages, the events, the five steps and the chance come from the register <a href="/standards/std-038-the-stages-of-an-opportunity">The stages of an opportunity</a>; what a record contains is <a href="/standards/std-039-an-opportunity-has-a-record">An opportunity has a record</a>.</li>
        <li>Each record says what it is about (<em>What</em>) and the line of the house it falls in. Its chance is computed from two questions: is it in a line the house sells, and has the house already won something in that line — high when both, medium when one, low when neither. The lines are in <a href={CARD_URL}>The house's card</a>.</li>
        <li>The deadline is the moment an answer, an offer or an application is due: every tender and grant has one, and any other record when the other side sets one.</li>
        <li>Today and the next seven days are counted against your own calendar, so the page stays right on the days after it is built; a step whose day has passed shows as late until its record moves on.</li>
        <li>A call that fails a requirement is not recorded: what it taught goes into the card.</li>
        <li>The records are public and carry nobody's name; the organisation is a sector and a size until it agrees to be named. A public funder or contracting authority is named, as it publishes its own call.</li>
        <li>A record breaking a rule fails the build of this page, as it fails the CI step: what is shown here has passed.</li>
        <li>The <em>Unreviewed</em> list is the tender radar's, read from its own repository when the page is built (AUT-069 in <a href="/standards/std-017-who-may-change-what">Who may change what</a>). The archive checks it again for names and closed calls; nothing in it is counted above.</li>
      </ul>
    </div>
  </div></section>
</Layout>

<script is:inline id="pq-data" type="application/json" set:html={JSON.stringify(F)} />

<script>
import { clock, groupOf, inAgenda, visible, sortRows, relative, left, isLate, addDays } from "@/lib/pipeline-agenda.mjs";

const $ = (s: string) => document.querySelector(s) as HTMLElement;
const $$ = (s: string) => [...document.querySelectorAll(s)] as HTMLElement[];
const C = clock(new Date());
const rowOf = (el: HTMLElement) => ({
  el, id: el.dataset.id ?? "", kind: el.dataset.kind ?? "", open: el.dataset.open === "1",
  next: el.dataset.next ?? "", closes: el.dataset.closes ?? "", closed: el.dataset.closed ?? "",
  chance: el.dataset.chance ?? "", value: Number(el.dataset.value) || 0, q: el.dataset.q ?? "",
});
const ROWS = $$("#pq-list .pq-row").map(rowOf);
const TL = new Map($$("#pq-tl .pq-g-row").map((el) => [el.dataset.id, el]));
const HEADS = new Map($$("#pq-list .pq-grp").map((el) => [el.dataset.g, el]));
const S = { agenda: "today", kind: "all", range: "any", from: C.today, to: addDays(C.today, 30), q: "", view: "list", sort: "date" };
($("#pq-from") as HTMLInputElement).value = S.from;
($("#pq-to") as HTMLInputElement).value = S.to;
const eur = (n: number) => new Intl.NumberFormat("en-GB", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(n);

// each row's days, read against the reader's calendar
for (const r of ROWS) {
  const rel = r.el.querySelector("[data-rel]");
  if (rel && r.open && r.next) { rel.textContent = relative(r.next, C); rel.classList.toggle("pq-late", isLate(r, C)); }
  const lf = r.el.querySelector("[data-left]");
  if (lf && r.closes) { lf.textContent = left(r.closes, C); lf.classList.toggle("pq-soon", r.closes >= C.today && r.closes <= addDays(C.today, 14)); }
}
// the agenda's counts, over every record
for (const a of ["today", "week", "open", "closed"]) {
  const n = ROWS.filter((r) => inAgenda(r, a, C)).length;
  const b = document.querySelector(`[data-count="${a}"]`); if (b) b.textContent = String(n);
}
const late = ROWS.filter((r) => isLate(r, C)).length;
const lt = document.querySelector('[data-late="today"]'); if (lt && late) lt.textContent = `${late} late · `;

function press(sel: string, key: string, v: string) { $$(sel).forEach((b) => b.setAttribute("aria-pressed", String(b.dataset[key] === v))); }
function draw() {
  press("#pq-ag button", "a", S.agenda); press("#pq-kind button", "k", S.kind); press("#pq-range button", "r", S.range);
  press("#pq-view button", "v", S.view); press("#pq-sort button", "s", S.sort);
  ($("#pq-dates") as HTMLElement).hidden = S.range !== "custom";
  $$(".pq-panel").forEach((p) => { p.hidden = p.dataset.view !== S.view; });
  ($("#pq-sort") as HTMLElement).hidden = S.view !== "list";
  $$(".pq-fun").forEach((f) => { f.hidden = f.dataset.kind !== S.kind; });
  // the kind buttons count what the other filters leave
  const base = ROWS.filter((r) => visible(r, { ...S, kind: "all" }, C));
  $$("[data-kn]").forEach((n) => { const k = n.dataset.kn; n.textContent = String(k === "all" ? base.length : base.filter((r) => r.kind === k).length); });
  const shown = sortRows(ROWS.filter((r) => visible(r, S, C)), S.sort);
  const ids = new Set(shown.map((r) => r.id));
  // the list: grouped by day when ordered by date, one block when by chance
  const list = $("#pq-list"), empty = $("#pq-empty");
  const nodes: HTMLElement[] = [];
  const byDate = S.sort === "date";
  for (const [g, h] of HEADS) {
    const xs = shown.filter((r) => groupOf(r, C) === g);
    h.hidden = !byDate || !xs.length;
    const n = h.querySelector("[data-gn]"); if (n) n.textContent = String(xs.length);
    if (byDate) nodes.push(h, ...xs.map((r) => r.el));
  }
  if (!byDate) nodes.push(...shown.map((r) => r.el));
  for (const r of ROWS) r.el.hidden = !ids.has(r.id);
  for (const r of ROWS.filter((x) => !ids.has(x.id))) nodes.push(r.el);
  if (!byDate) for (const h of HEADS.values()) nodes.unshift(h);
  list.replaceChildren(...nodes, empty);
  empty.hidden = shown.length > 0;
  for (const [id, el] of TL) el.hidden = !ids.has(id ?? "");
  const open = shown.filter((r) => r.open).reduce((a, r) => a + r.value, 0);
  const filtered = S.q || S.kind !== "all" || S.range !== "any";
  const sum = $("#pq-sum");
  sum.textContent = `${shown.length} shown${open ? ` · ${eur(open)} open, before tax` : ""}`;
  if (filtered) {
    const b = document.createElement("button"); b.type = "button"; b.className = "pq-clear"; b.textContent = "clear filters";
    b.addEventListener("click", () => { S.q = ""; S.kind = "all"; S.range = "any"; ($("#pq-q") as HTMLInputElement).value = ""; draw(); });
    sum.append(" · ", b);
  }
}
const on = (sel: string, key: string, set: (v: string) => void) => $$(sel).forEach((b) => b.addEventListener("click", () => { set(b.dataset[key] ?? ""); draw(); }));
on("#pq-ag button", "a", (v) => { S.agenda = v; });
on("#pq-kind button", "k", (v) => { S.kind = v; });
on("#pq-range button", "r", (v) => { S.range = v; });
on("#pq-view button", "v", (v) => { S.view = v; });
on("#pq-sort button", "s", (v) => { S.sort = v; });
$("#pq-q").addEventListener("input", (e) => { S.q = (e.target as HTMLInputElement).value; draw(); });
$("#pq-from").addEventListener("change", (e) => { S.from = (e.target as HTMLInputElement).value; draw(); });
$("#pq-to").addEventListener("change", (e) => { S.to = (e.target as HTMLInputElement).value; draw(); });
draw();
</script>

