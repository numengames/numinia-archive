---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// The pipeline — every chance to sell something, as three readers see it
// (STD-038, STD-039, SYS-010). THIS PAGE STATES NO FIGURE OF ITS OWN: the
// records in opportunities/ are read at build time through the sales kit's
// own tool (src/lib/pipeline.ts), and the browser cuts them by week, month,
// quarter and year. The same tool runs in CI on every change, so the page and
// the check cannot disagree.
//
// Three lenses, one set of records: whoever sells (what needs a move today),
// management (where sales are won and lost, how long they take), anyone
// (the records are public; nobody's name is in them, the organisation is a
// sector until it agrees).
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { pipeline } from "@/lib/pipeline";
import { repoFileUrl } from "@/lib/build-info";
const P = pipeline();
const DATA = { today: P.today, register: P.register, records: P.records, figures: P.figures };
const open = P.records.filter((r) => !P.register.closed.includes(r.state));
---
<Layout
  title="The pipeline — Numinia"
  description="Every chance to sell something, as whoever sells, management and anyone read it: what needs a move, where sales are won and lost, by week, month, quarter and year. Computed from public records; nobody's name in them."
  canonicalPath="/system/pipeline"
  activeNav="system/"
>
  <PageHero
    label="System — The pipeline"
    title="Whom we are trying to sell to"
    description="Every opportunity, at its stage, with what happens next; where sales are won and lost, and how long they take. Read from the public records, nobody's name in them, the organisation a sector until it agrees."
  />
  <div class="mx-auto max-w-[1100px] px-6 pb-8">
    <DocToolbar
      mdUrl="/system/pipeline.md"
      filename="numinia-pipeline.md"
      repoUrl={repoFileUrl("opportunities")}
      lang="en"
    />
  </div>
  <section class="pb-20" id="pq"><div class="mx-auto max-w-[1100px] px-6">
    <noscript><p class="cq-note">This page computes its views in the browser. The records themselves are plain text: <a href="/opportunities/">/opportunities/</a>.</p></noscript>

    <div class="cq-lensbar">
      <div class="cq-tabs" role="tablist" aria-label="Reader" id="pq-lens">
        <button type="button" class="cq-tab" role="tab" data-l="sell" aria-selected="true">Whoever sells</button>
        <button type="button" class="cq-tab" role="tab" data-l="manage" aria-selected="false">Management</button>
        <button type="button" class="cq-tab" role="tab" data-l="anyone" aria-selected="false">Anyone</button>
      </div>
      <p class="cq-note" id="pq-lensnote"></p>
    </div>

    <div class="cq-kpis" id="pq-kpis"></div>

    <!-- whoever sells: what needs a move -->
    <div class="cq-sec" data-lens="sell">
      <h2>Needs a move</h2>
      <p class="cq-sub">Open opportunities, most urgent first: a next date already past, then a stage held longer than the register allows, then the rest by next date.</p>
      <div class="cq-tablewrap"><table class="cq-t" id="pq-open"><thead><tr><th>Record</th><th class="cq-l">Organisation</th><th>Stage</th><th>Value</th><th>Next date</th><th class="cq-l">Next action</th><th>Days in stage</th></tr></thead><tbody></tbody></table></div>
      <p class="cq-note" id="pq-open-empty" hidden>Nothing is open.</p>
    </div>

    <!-- the funnel: everyone -->
    <div class="cq-sec">
      <h2>The funnel</h2>
      <p class="cq-sub">How many opportunities reached each stage, ever. A stage a record passed through counts even if the record has moved on or closed.</p>
      <div class="cq-card"><div class="cq-chart" id="pq-funnel"></div></div>
    </div>

    <!-- by period: everyone -->
    <div class="cq-sec">
      <h2>By period</h2>
      <p class="cq-sub">What happened to the pipeline in each week, month, quarter or year: opened, moved forward, won, lost. Read from the transitions each record carries — this is the weekly, quarterly and annual report, as a view instead of a document.</p>
      <div class="cq-ctrl">
        <div class="cq-tabs" role="tablist" aria-label="Period" id="pq-gran">
          <button type="button" class="cq-tab" role="tab" data-g="week" aria-selected="false">Week</button>
          <button type="button" class="cq-tab" role="tab" data-g="month" aria-selected="true">Month</button>
          <button type="button" class="cq-tab" role="tab" data-g="quarter" aria-selected="false">Quarter</button>
          <button type="button" class="cq-tab" role="tab" data-g="year" aria-selected="false">Year</button>
        </div>
      </div>
      <div class="cq-card"><div class="cq-chart" id="pq-periods"></div></div>
      <div class="cq-tablewrap" style="margin-top:12px"><table class="cq-t" id="pq-ptable"><thead><tr><th>Period</th><th>Opened</th><th>Moved forward</th><th>Proposals sent</th><th>Won</th><th>Lost</th><th>Value won</th></tr></thead><tbody></tbody></table></div>
    </div>

    <!-- management: where it is won and lost -->
    <div class="cq-sec" data-lens="manage">
      <h2>Where sales are won and lost</h2>
      <p class="cq-sub">Average days each stage holds an opportunity, computed from every transition; the reasons the lost ones were lost, from the register's closed list.</p>
      <div class="cq-two">
        <div class="cq-card"><h3 class="cq-h3" style="margin-top:0">Days per stage</h3><div class="cq-chart" id="pq-stagedays"></div></div>
        <div class="cq-card"><h3 class="cq-h3" style="margin-top:0">Why lost</h3><div class="cq-tablewrap"><table class="cq-t" id="pq-reasons"><thead><tr><th class="cq-l">Reason</th><th>Records</th></tr></thead><tbody></tbody></table></div><p class="cq-note" id="pq-reasons-empty" hidden>Nothing lost yet.</p></div>
      </div>
    </div>

    <!-- all records -->
    <div class="cq-sec">
      <h2>Every record</h2>
      <p class="cq-sub">One row per opportunity, in the order they were opened. Each links to its record; a sent proposal sits beside it.</p>
      <div class="cq-tablewrap"><table class="cq-t" id="pq-all"><thead><tr><th>Record</th><th class="cq-l">Organisation</th><th>Sector</th><th>Source</th><th>Stage</th><th>Value</th><th>Opened</th><th>Closed</th><th class="cq-l">Reason</th></tr></thead><tbody></tbody></table></div>
    </div>

    <div class="cq-sec">
      <h2>How this page is made</h2>
      <ul class="cq-list">
        <li>Every figure is computed from the records in <a href="/opportunities/">/opportunities/</a>, read at build time through the same tool that checks them in CI (<code>machine/packages/sales-kit/pipeline.mjs</code>). No number on this page is typed.</li>
        <li>The stages, their stale days and the reasons come from the register <a href="/standards/std-038-the-stages-of-a-sale">The stages of a sale</a>; what a record must contain is <a href="/standards/std-039-an-opportunity-has-a-record">An opportunity has a record</a>.</li>
        <li>The records are public and carry nobody's name; the organisation is written by sector and size until it has agreed to a proposal. Who signs lives in the agreement.</li>
        <li>A record breaking a rule fails the build of this page, as it fails the CI step: what is shown here has passed.</li>
      </ul>
    </div>
  </div></section>
</Layout>

<script is:inline id="pq-data" type="application/json" set:html={JSON.stringify(DATA)} />

<style is:global>
.cq-flag{display:inline-flex;border:1px solid rgb(var(--yellow)/.5);color:rgb(var(--yellow));border-radius:999px;padding:1px 10px;font-family:var(--font-mono);font-size:.6rem;letter-spacing:.04em;vertical-align:1px;white-space:nowrap}
.cq-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
@media (max-width:860px){.cq-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
.cq-kpi{background:rgb(var(--bg-card));border:1px solid rgb(var(--border));border-radius:var(--radius);padding:14px 16px;min-width:0}
.cq-k{display:block;font-family:var(--font-mono);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;color:rgb(var(--text-dim))}
.cq-v{display:block;font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-weight:500;font-size:clamp(1.1rem,4.2vw,1.6rem);line-height:1.2;margin:6px 0 4px;color:rgb(var(--text));white-space:nowrap}
.cq-s{display:block;font-size:.8125rem;line-height:1.45;color:rgb(var(--text-dim))}
.cq-kpi--warn .cq-v{color:rgb(var(--yellow))}
.cq-kpi--today .cq-v{color:rgb(var(--accent))}
.cq-sec{margin-top:56px}
.cq-sec h2{font-family:var(--font-display);font-size:1.5rem;line-height:1.25;margin:0 0 6px;color:rgb(var(--text))}
.cq-sub{color:rgb(var(--text-muted));margin:0 0 16px;max-width:72ch;line-height:1.6}
.cq-card{background:rgb(var(--bg-card));border:1px solid rgb(var(--border));border-radius:var(--radius);padding:16px}
.cq-chart{width:100%;min-height:120px}
.cq-chart svg{display:block;overflow:visible}
.cq-grid{stroke:rgb(var(--border));stroke-width:1}
.cq-ax{font-family:var(--font-mono);font-size:10px;fill:rgb(var(--text-dim))}
.cq-lab{font-family:var(--font-mono);font-size:11px;fill:rgb(var(--text))}
.cq-tabs{display:inline-flex;gap:4px;padding:3px;border:1px solid rgb(var(--border));border-radius:8px;background:rgb(var(--bg-card))}
.cq-tab{min-height:32px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:rgb(var(--text-muted));font-family:var(--font-mono);font-size:.8125rem;cursor:pointer;transition:background .15s,color .15s}
.cq-tab[aria-selected="true"]{background:rgb(var(--accent)/.15);color:rgb(var(--text))}
@media (max-width:1023px){.cq-tab{min-height:44px}}
.cq-ctrl{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin:0 0 12px}
.cq-lensbar{display:grid;gap:8px;margin:0 0 20px}
.cq-note{font-size:.875rem;color:rgb(var(--text-muted));margin:0;line-height:1.55}
.cq-tablewrap{overflow-x:auto}
.cq-t{width:100%;border-collapse:collapse;font-family:var(--font-mono);font-size:.8125rem;font-variant-numeric:tabular-nums}
.cq-t th,.cq-t td{padding:8px 10px;text-align:right;border-bottom:1px solid rgb(var(--border));white-space:nowrap}
.cq-t th{color:rgb(var(--text-dim));font-weight:500;font-size:.7rem;letter-spacing:.08em;text-transform:uppercase}
.cq-t th.cq-l,.cq-t td.cq-l{text-align:left;white-space:normal}
.cq-t td:first-child,.cq-t th:first-child{text-align:left}
.cq-t tr.cq-overdue td{color:rgb(var(--red))}
.cq-t tr.cq-stale td{color:rgb(var(--yellow))}
.cq-t a{color:rgb(var(--accent));text-decoration:none}
.cq-t a:hover{text-decoration:underline}
.cq-h3{font-family:var(--font-display);font-size:1.125rem;margin:28px 0 10px;color:rgb(var(--text))}
.cq-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
@media (max-width:860px){.cq-two{grid-template-columns:minmax(0,1fr)}}
.cq-list{color:rgb(var(--text-muted));line-height:1.6;padding-left:20px}
.cq-list li{margin:6px 0}
.cq-list code{font-family:var(--font-mono);font-size:.85em}
.cq-stage{display:inline-block;padding:1px 8px;border-radius:999px;border:1px solid rgb(var(--border));font-size:.7rem}
.cq-hidden{display:none!important}
@media (prefers-reduced-motion:reduce){.cq-tab{transition:none}}
</style>

<script is:inline>
(() => {
const D = JSON.parse(document.getElementById('pq-data').textContent);
const $ = s => document.querySelector(s), $$ = s => [...document.querySelectorAll(s)];
const REG = D.register, R = D.records, F = D.figures, TODAY = D.today;
const OPEN_STAGES = REG.order.filter(s => !REG.closed.includes(s));
const money = n => new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
const days = (a, b) => Math.round((Date.parse(b) - Date.parse(a)) / 864e5);
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const stageOf = r => `<span class="cq-stage">${r.state}</span>`;
const link = r => `<a href="${r.url}">${r.id}</a>`;
const lastMove = r => r.transitions.length ? r.transitions[r.transitions.length - 1].date : r.opened;

/* ---- lenses ---- */
const LENS_NOTE = {
  sell: 'What to do today: overdue first, then what the register calls stale. Every row links to its record.',
  manage: 'Where the pipeline is worth what, how long each stage holds it, why it is lost. Weighted value counts each open opportunity by how far it has come.',
  anyone: 'The same records, public as they stand: nobody\'s name in them, the organisation a sector until it agrees to a proposal.',
};
let lens = 'sell';
function applyLens() {
  $$('#pq-lens .cq-tab').forEach(b => b.setAttribute('aria-selected', String(b.dataset.l === lens)));
  $('#pq-lensnote').textContent = LENS_NOTE[lens];
  $$('[data-lens]').forEach(el => el.classList.toggle('cq-hidden', el.dataset.lens !== lens && !(lens === 'anyone' && false)));
  // management also sees "needs a move"; anyone sees neither lens block but the shared ones.
  if (lens === 'manage') $('[data-lens="sell"]').classList.remove('cq-hidden');
  kpis();
}
$$('#pq-lens .cq-tab').forEach(b => b.addEventListener('click', () => { lens = b.dataset.l; applyLens(); }));

/* ---- kpis ---- */
const WEIGHT = Object.fromEntries(OPEN_STAGES.map((s, i) => [s, (i + 1) / (OPEN_STAGES.length + 1)]));
function kpis() {
  const open = R.filter(r => !REG.closed.includes(r.state));
  const openValue = open.reduce((a, r) => a + r.value, 0);
  const weighted = open.reduce((a, r) => a + r.value * (WEIGHT[r.state] || 0), 0);
  const won = R.filter(r => r.state === 'won'), lost = R.filter(r => r.state === 'lost');
  const wonValue = won.reduce((a, r) => a + r.value, 0);
  const cards = lens === 'sell' ? [
    ['Open', open.length, `${money(openValue)} before tax`, ''],
    ['Overdue', F.overdue.length, 'next date already past', F.overdue.length ? 'cq-kpi--warn' : ''],
    ['Stale', F.stale.length, 'held past the register\'s days', F.stale.length ? 'cq-kpi--warn' : ''],
    ['Proposals out', open.filter(r => r.state === 'proposed').length, 'sent, awaiting an answer', ''],
  ] : lens === 'manage' ? [
    ['Weighted value', money(weighted), `of ${money(openValue)} open, by stage reached`, ''],
    ['Win rate', F.winRate === null ? '—' : `${F.winRate} %`, `${won.length} won · ${lost.length} lost`, ''],
    ['Cycle', F.cycleDays === null ? '—' : `${F.cycleDays} d`, 'first sign to signature, average', ''],
    ['Won, ever', money(wonValue), `${won.length} agreement${won.length === 1 ? '' : 's'}`, ''],
  ] : [
    ['Records', R.length, 'public, nobody\'s name', ''],
    ['Open', open.length, `${money(openValue)} before tax`, ''],
    ['Won', won.length, money(wonValue), ''],
    ['Lost', lost.length, lost.length ? `most often: ${topReason()}` : '—', ''],
  ];
  $('#pq-kpis').innerHTML = cards.map(([k, v, s, c]) => `<div class="cq-kpi ${c}"><span class="cq-k">${k}</span><span class="cq-v">${v}</span><span class="cq-s">${esc(s)}</span></div>`).join('');
}
function topReason() { const e = Object.entries(F.reasons).sort((a, b) => b[1] - a[1])[0]; return e ? e[0] : '—'; }

/* ---- needs a move ---- */
function openTable() {
  const open = R.filter(r => !REG.closed.includes(r.state)).map(r => {
    const held = days(lastMove(r), TODAY), limit = REG.staleDays[r.state];
    const overdue = r.next_date && r.next_date < TODAY, stale = limit !== null && held > limit;
    return { r, held, limit, overdue, stale, rank: overdue ? 0 : stale ? 1 : 2 };
  }).sort((a, b) => a.rank - b.rank || (a.r.next_date || '9').localeCompare(b.r.next_date || '9'));
  $('#pq-open tbody').innerHTML = open.map(({ r, held, limit, overdue, stale }) =>
    `<tr class="${overdue ? 'cq-overdue' : stale ? 'cq-stale' : ''}"><td>${link(r)}</td><td class="cq-l">${esc(r.organisation)}</td><td>${stageOf(r)}</td><td>${money(r.value)}</td><td>${r.next_date || '—'}${overdue ? ' · overdue' : ''}</td><td class="cq-l">${esc(r.next_action)}</td><td>${held}${limit !== null ? ` / ${limit}` : ''}${stale ? ' · stale' : ''}</td></tr>`).join('');
  $('#pq-open-empty').hidden = open.length > 0;
}

/* ---- svg helpers ---- */
function hbars(el, rows, opts = {}) {
  // rows: [{label, value, sub}] → horizontal bars, label left, value right.
  const W = Math.max(320, el.clientWidth || 600), rh = 26, pad = 4, lw = opts.labelWidth || 110, vw = 70;
  const max = Math.max(1, ...rows.map(r => r.value));
  const H = rows.length * (rh + pad) + 4;
  let s = `<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" role="img" aria-label="${esc(opts.aria || '')}">`;
  rows.forEach((r, i) => {
    const y = i * (rh + pad), bw = (W - lw - vw) * (r.value / max);
    s += `<text class="cq-lab" x="0" y="${y + rh * .68}">${esc(r.label)}</text>`;
    s += `<rect x="${lw}" y="${y + 4}" width="${Math.max(0, bw)}" height="${rh - 8}" rx="3" style="fill:${r.fill || 'rgb(var(--accent))'}"/>`;
    s += `<text class="cq-ax" x="${lw + Math.max(0, bw) + 6}" y="${y + rh * .68}">${esc(r.text ?? r.value)}</text>`;
  });
  el.innerHTML = s + '</svg>';
}
function funnel() {
  const rows = F.funnel.map(f => ({ label: f.stage, value: f.reached, text: String(f.reached) }));
  hbars($('#pq-funnel'), rows, { aria: 'Opportunities that reached each stage' });
}
function stageDays() {
  const rows = OPEN_STAGES.map(s => ({ label: s, value: F.timePerStage[s] ?? 0, text: F.timePerStage[s] === null || F.timePerStage[s] === undefined ? '—' : `${F.timePerStage[s]} d`, fill: REG.staleDays[s] !== null && (F.timePerStage[s] ?? 0) > REG.staleDays[s] ? 'rgb(var(--yellow))' : 'rgb(var(--accent))' }));
  hbars($('#pq-stagedays'), rows, { aria: 'Average days per stage' });
}
function reasons() {
  const e = Object.entries(F.reasons).sort((a, b) => b[1] - a[1]);
  $('#pq-reasons tbody').innerHTML = e.map(([r, n]) => `<tr><td class="cq-l">${esc(r)}</td><td>${n}</td></tr>`).join('');
  $('#pq-reasons-empty').hidden = e.length > 0;
}

/* ---- by period ---- */
let gran = 'month';
const keyOf = (d, g) => {
  const dt = new Date(d + 'T00:00:00Z'), y = dt.getUTCFullYear(), m = dt.getUTCMonth();
  if (g === 'year') return String(y);
  if (g === 'quarter') return `${y}-Q${Math.floor(m / 3) + 1}`;
  if (g === 'month') return `${y}-${String(m + 1).padStart(2, '0')}`;
  // ISO week
  const t = new Date(Date.UTC(y, m, dt.getUTCDate())); const day = t.getUTCDay() || 7; t.setUTCDate(t.getUTCDate() + 4 - day);
  const wy = t.getUTCFullYear(); const w = Math.ceil(((t - Date.UTC(wy, 0, 1)) / 864e5 + 1) / 7);
  return `${wy}-W${String(w).padStart(2, '0')}`;
};
function periods() {
  const P = {};
  const at = k => (P[k] ??= { opened: 0, forward: 0, sent: 0, won: 0, lost: 0, wonValue: 0 });
  for (const r of R) for (const t of r.transitions) {
    const p = at(keyOf(t.date, gran));
    if (t.to === 'lead') p.opened++;
    else if (t.to === 'lost') p.lost++;
    else if (t.to === 'won') { p.won++; p.wonValue += r.value; p.forward++; }
    else { p.forward++; if (t.to === 'proposed') p.sent++; }
  }
  const keys = Object.keys(P).sort();
  $('#pq-ptable tbody').innerHTML = keys.slice().reverse().map(k => { const p = P[k]; return `<tr><td>${k}</td><td>${p.opened}</td><td>${p.forward}</td><td>${p.sent}</td><td>${p.won}</td><td>${p.lost}</td><td>${money(p.wonValue)}</td></tr>`; }).join('')
    || '<tr><td colspan="7" class="cq-l">Nothing yet.</td></tr>';
  // chart: stacked opened / won / lost per period, last 12 periods
  const last = keys.slice(-12), el = $('#pq-periods');
  const W = Math.max(320, el.clientWidth || 600), H = 160, padL = 28, padB = 24, bw = Math.max(6, Math.min(40, (W - padL) / Math.max(1, last.length) * .6));
  const max = Math.max(1, ...last.map(k => P[k].opened + P[k].won + P[k].lost));
  const y = v => (H - padB) - (H - padB - 8) * (v / max), x = i => padL + (W - padL) * ((i + .5) / Math.max(1, last.length));
  let s = `<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" role="img" aria-label="Opened, won and lost per ${gran}">`;
  for (let g = 0; g <= 4; g++) { const v = max * g / 4; s += `<line class="cq-grid" x1="${padL}" x2="${W}" y1="${y(v)}" y2="${y(v)}"/><text class="cq-ax" x="0" y="${y(v) + 3}">${Math.round(v)}</text>`; }
  last.forEach((k, i) => {
    const p = P[k]; let acc = 0;
    for (const [key, fill] of [['opened', 'rgb(var(--accent))'], ['won', 'rgb(var(--green))'], ['lost', 'rgb(var(--red))']]) {
      const v = p[key]; if (!v) continue;
      s += `<rect x="${x(i) - bw / 2}" y="${y(acc + v)}" width="${bw}" height="${Math.max(0, y(acc) - y(acc + v))}" style="fill:${fill}"/>`; acc += v;
    }
    s += `<text class="cq-ax" x="${x(i)}" y="${H - 6}" text-anchor="middle">${k.slice(gran === 'year' ? 0 : 5)}</text>`;
  });
  el.innerHTML = s + '</svg>';
}
$$('#pq-gran .cq-tab').forEach(b => b.addEventListener('click', () => { gran = b.dataset.g; $$('#pq-gran .cq-tab').forEach(x => x.setAttribute('aria-selected', String(x === b))); periods(); }));

/* ---- every record ---- */
function allTable() {
  $('#pq-all tbody').innerHTML = R.slice().sort((a, b) => a.id.localeCompare(b.id)).map(r =>
    `<tr><td>${link(r)}${r.proposalUrl ? ` · <a href="${r.proposalUrl}">proposal</a>` : ''}</td><td class="cq-l">${esc(r.organisation)}</td><td>${esc(r.sector)}</td><td>${esc(r.source)}</td><td>${stageOf(r)}</td><td>${money(r.value)}</td><td>${r.opened}</td><td>${r.closed || '—'}</td><td class="cq-l">${esc(r.reason || '')}</td></tr>`).join('');
}

applyLens(); openTable(); funnel(); stageDays(); reasons(); periods(); allTable();
addEventListener('resize', () => { funnel(); stageDays(); periods(); });
})();
</script>
