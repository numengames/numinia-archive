---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// The pipeline — sales, tenders, grants, collaborations and partners, one
// kind of record (STD-038, STD-039, OPS-018). THIS PAGE STATES NO FIGURE OF
// ITS OWN: the records in opportunities/ are read at build time through the
// sales kit's own tool (src/lib/pipeline.ts), the same tool CI runs on every
// change, so the page and the check cannot disagree. Overdue, stale, the
// stage, the chance, the funnel's counts and conversions, the card's counts
// and which requirements decide most calls are the tool's verdicts (the last
// one marked in the card itself); the page only lays them out.
//
// The funnel sits on top, one per kind. Under it two rows of pill buttons —
// Kind and View — choose ONE panel. Every funnel and panel is real HTML
// rendered here; the inline script only says which ones show, and composes
// no address (every record's `url` is made in src/lib/pipeline.ts). Without
// JavaScript the default — All, Timeline — is what a reader sees.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { pipeline, decidingRows, CARD_URL, TEMPLATE_URL, KIND_LABEL, KIND_PLURAL, STEP_LABEL, type PRecord } from "@/lib/pipeline";
import { repoFileUrl } from "@/lib/build-info";
import { radarFeed, FEED_REPO } from "@/lib/feed";

const F = pipeline();
const TODAY = F.today;
const KINDS = F.kinds.map((k) => k.kind);
const KEYS = ["all", ...KINDS] as const;
const byId = Object.fromEntries(F.records.map((r) => [r.id, r]));
const of = (key: string) => (key === "all" ? F.records : F.records.filter((r) => r.kind === key));
const hasAny = (key: string) => of(key).length > 0;

// presentation only
const money = (n: number) => new Intl.NumberFormat("en-GB", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(n);
const value = (r: PRecord) => (r.value ? money(r.value) : "no money");
const PAYS: Record<string, string> = {
  advance: "paid in advance", milestones: "paid in milestones", "on-delivery": "paid on delivery",
  "on-justification": "paid after justification", "in-kind": "paid in kind", "to-ask": "how it pays: to ask",
};
const pays = (r: PRecord) => {
  const p = r.pays ? (PAYS[r.pays] ?? r.pays.replace(/-/g, " ")) : "how it pays: to ask";
  return (r.pays === "advance" || r.pays === "milestones") && r.advance !== null ? `${p}, ${r.advance} % before the work` : p;
};
const dayMs = 864e5;
const t = (d: string) => Date.parse(`${d}T00:00:00Z`);
const in7 = new Date(t(TODAY) + 7 * dayMs).toISOString().slice(0, 10);
const keyLabel = (k: string) => (k === "all" ? "All" : KIND_PLURAL[k as keyof typeof KIND_PLURAL]);
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? "" : "s"}`;

// The funnel: the tool's counts and conversions; the bar is drawn against the first step.
const POSITIVE = F.steps.findIndex((s) => s.step === "positive");
const funnelOf = (key: string) => F.funnel[key] ?? { counts: F.steps.map(() => 0), conversion: F.steps.map(() => null) };

// Secondary figures per kind, from the tool's figures: one quiet line under the funnel.
const kpis = (key: string) => {
  const rs = of(key), open = rs.filter((r) => r.open);
  const due = F.due.filter((d) => (key === "all" || d.kind === key) && !d.overdue && d.date >= TODAY && d.date <= in7);
  const overdue = F.overdue.filter((id) => key === "all" || byId[id]?.kind === key);
  const adv = open.filter((r) => r.pays === "advance");
  return [
    { k: "Open value", v: money(open.reduce((a, r) => a + r.value, 0)), s: `${open.length} open`, c: "" },
    { k: "Due in 7 days", v: String(due.length), s: "", c: due.length ? "pq-kpi--today" : "" },
    { k: "Overdue", v: String(overdue.length), s: "", c: overdue.length ? "pq-kpi--warn" : "" },
    { k: "Paid in advance", v: money(adv.reduce((a, r) => a + r.value, 0)), s: plural(adv.length, "record"), c: "" },
  ];
};

// What's due: the tool's due list (overdue first, then by date)
const dueOf = (key: string) => F.due.filter((d) => key === "all" || d.kind === key)
  .slice().sort((a, b) => Number(b.overdue) - Number(a.overdue) || a.date.localeCompare(b.date))
  .map((d) => ({ d, r: byId[d.id] as PRecord }));

// Timeline: open first (by next date), then closed (newest first)
const rowsOf = (key: string) => {
  const rs = of(key);
  const open = rs.filter((r) => r.open).sort((a, b) => (a.next?.date ?? "9").localeCompare(b.next?.date ?? "9"));
  const closed = rs.filter((r) => !r.open).sort((a, b) => (b.closed ?? "").localeCompare(a.closed ?? ""));
  return [...open, ...closed];
};
const axisOf = (key: string) => {
  const dates = of(key).flatMap((r) => r.events.map((e) => e.date)).concat(TODAY).sort();
  let a = t(dates[0]), b = t(dates[dates.length - 1]);
  if (b - a < 30 * dayMs) b = a + 30 * dayMs;
  const pad = (b - a) * 0.03; a -= pad; b += pad;
  const x = (d: string) => Math.round(((t(d) - a) / (b - a)) * 1000) / 10;
  const months: string[] = [];
  const s = new Date(a); let y = s.getUTCFullYear(), m = s.getUTCMonth() + 1;
  if (m > 11) { m = 0; y++; }
  while (Date.UTC(y, m, 1) <= b) { months.push(new Date(Date.UTC(y, m, 1)).toISOString().slice(0, 10)); m++; if (m > 11) { m = 0; y++; } }
  const step = Math.max(1, Math.ceil(months.length / 7));
  return { x, ticks: months.filter((_, i) => i % step === 0) };
};
const EV_LABEL: Record<string, string> = { found: "found", out: "the house did", pos: "positive answer", neg: "negative answer", won: "won", lost: "lost", next: "next" };

// Reasons lost and days per stage, under the timeline
const reasonsOf = (key: string): [string, number][] => {
  if (key === "all") return Object.entries(F.reasons);
  const c: Record<string, number> = {};
  for (const r of of(key)) if (r.stage === "lost" && r.reason) c[r.reason] = (c[r.reason] ?? 0) + 1;
  return Object.entries(c).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
};
const daysOf = (key: string) => (key === "all" ? KINDS : [key])
  .flatMap((k) => Object.entries(F.daysPerStage[k] ?? {}).filter(([, d]) => d !== null).map(([stage, d]) => ({ k, stage, d: d as number })));

// Asked / we have: only the rows the card marks as deciding, in the card's order
const DECIDING = decidingRows(F.card);
const COUNT_WORD: Record<number, string> = { 3: "three", 4: "four", 5: "five", 6: "six", 7: "seven", 8: "eight", 9: "nine", 10: "ten", 11: "eleven", 12: "twelve" };
const STATE: Record<string, { mark: string; text: string; cls: string }> = {
  yes: { mark: "✓", text: "yes", cls: "pq-yes" },
  no: { mark: "✗", text: "no", cls: "pq-no" },
  check: { mark: "?", text: "check", cls: "pq-check" },
};
const VIEWS = [["timeline", "Timeline"], ["due", "What's due"], ["card", "Asked / we have"]] as const;
// The automation's feed (AUT-069): what the tender radar found, unreviewed,
// read from its own repository and checked again here. Never in the funnel.
const FEED = await radarFeed();
const CHANCE_WORD: Record<string, string> = { alta: "high", media: "medium", baja: "low" };
---
<Layout
  title="The pipeline — Numinia"
  description="Sales, tenders, grants, collaborations and partners in one pipeline: the funnel from detected to won, each record's timeline, what is due next, and the requirements that decide most calls against what the house holds. Computed from public records; nobody's name in them."
  canonicalPath="/system/pipeline"
  activeNav="system/"
>
  <PageHero
    label="System — The pipeline"
    title="Every opportunity, in one pipeline"
    description="Sales, tenders, grants, collaborations and partners. Only what the house can win is kept. Read from the public records: nobody's name in them, the organisation a sector until it agrees."
  />
  <div class="mx-auto max-w-[1100px] px-6 pb-8">
    <DocToolbar
      mdUrl="/system/pipeline.md"
      filename="numinia-pipeline.md"
      repoUrl={repoFileUrl("opportunities")}
      lang="en"
    />
  </div>
  <section class="pb-20" id="pq"><div class="mx-auto max-w-[1100px] px-6">
    <noscript><p class="cq-note">Without JavaScript this page shows every kind and its timeline. The records themselves are plain text: <a href="/opportunities/">/opportunities/</a>; the same figures as tables: <a href="/system/pipeline.md">pipeline.md</a>.</p></noscript>

    <!-- The funnel: on top, always visible, one per kind -->
    {KEYS.map((key) => {
      const f = funnelOf(key);
      const max = Math.max(1, f.counts[0] ?? 0);
      const noPositive = (f.counts[0] ?? 0) > 0 && POSITIVE >= 0 && f.counts[POSITIVE] === 0;
      return (
        <div class="pq-fun" data-kind={key} hidden={key !== "all"}>
          <p class="pq-et">The funnel — {keyLabel(key)} · {plural(of(key).length, "record")}</p>
          <div class="pq-steps">
            {F.steps.map((s, i) => {
              const n = f.counts[i] ?? 0, cv = f.conversion[i] ?? null;
              return (
                <div class={`pq-step${n ? "" : " pq-step--zero"}`} data-step={s.step} data-n={n} data-cv={cv === null ? "" : cv} title={s.means}>
                  <span class="pq-step-name">{i + 1} · {STEP_LABEL[s.step] ?? s.step}</span>
                  <span class="pq-step-n">{n}</span>
                  <span class="pq-step-track"><span class="pq-step-bar" style={`width:${n ? Math.max(3, Math.round((n / max) * 1000) / 10) : 0}%`}></span></span>
                  <span class="pq-step-cv">{cv === null ? (i === 0 ? "where every record starts" : "nothing to carry from the step before") : `${cv} % of the step before`}</span>
                </div>
              );
            })}
          </div>
          {noPositive && <p class="pq-funnote">No positive answer is on record yet: from now on every reply goes into its record's timeline.</p>}
        </div>
      );
    })}

    <!-- Secondary figures, one quiet row per kind -->
    <div id="pq-figures">
      {KEYS.map((key) => (
        <div class="pq-kpis" data-kind={key} hidden={key !== "all"}>
          {kpis(key).map((c) => <span class={`pq-kpi ${c.c}`}><span class="pq-kpi-k">{c.k}</span> <b class="pq-kpi-v">{c.v}</b>{c.s && <span class="pq-kpi-s"> · {c.s}</span>}</span>)}
          <span class="pq-kpi pq-kpi-s">values before tax</span>
        </div>
      ))}
    </div>

    <!-- The switches -->
    <div class="pq-sw" role="group" aria-label="Kind" id="pq-kind">
      {KEYS.map((k) => <button type="button" class="pq-pill" data-k={k} aria-pressed={k === "all" ? "true" : "false"}>{keyLabel(k)}<span class="pq-n">{of(k).length}</span></button>)}
    </div>
    <div class="pq-sw pq-sw--view" role="group" aria-label="View" id="pq-view">
      {VIEWS.map(([v, label]) => <button type="button" class="pq-pill" data-v={v} aria-pressed={v === "timeline" ? "true" : "false"}>{label}</button>)}
    </div>

    <!-- Timeline (default), with reasons lost and days per stage under it -->
    {KEYS.map((key) => {
      const ax = hasAny(key) ? axisOf(key) : null;
      const rs = reasonsOf(key);
      const ds = daysOf(key);
      return (
        <div class="pq-panel" data-view="timeline" data-kind={key} hidden={key !== "all"}>
          {!ax ? <p class="cq-note">Nothing of this kind yet.</p> : (
            <>
              <p class="pq-legend"><span class="pq-lg pq-ev-out"></span> the house did something · <span class="pq-lg pq-ev-pos"></span> yes · <span class="pq-lg pq-ev-neg"></span> no · <span class="pq-lg pq-ev-won"></span> won · <span class="pq-lg pq-ev-lost"></span> lost · <span class="pq-lg pq-ev-next"></span> next step · the upright line is today, {TODAY}. Open records first; the name opens the record, a dot tells its line.</p>
              <div class="pq-gantt">
                <div class="pq-g-axis"><span></span><span class="pq-g-track">{ax.ticks.map((m) => <span class="pq-tick" style={`left:${ax.x(m)}%`}>{m.slice(0, 7)}</span>)}</span></div>
                {rowsOf(key).map((r) => (
                  <div class={`pq-g-row${r.open ? "" : " pq-g-row--closed"}`} data-id={r.id}>
                    <span class="pq-g-label">
                      <a class="pq-g-name" href={r.url} title={r.id}><span class={`pq-tag pq-k-${r.kind}`}>{KIND_LABEL[r.kind]}</span> {r.organisation ?? r.id}</a>
                      <span class="pq-g-sub">{value(r)} · {pays(r)}{!r.open && ` · ${r.stage}`}</span>
                    </span>
                    <span class="pq-g-track">
                      <span class="pq-today" style={`left:${ax.x(TODAY)}%`}></span>
                      <span class="pq-span" style={`left:${ax.x(r.events[0].date)}%;width:${ax.x(r.events[r.events.length - 1].date) - ax.x(r.events[0].date)}%`}></span>
                      {r.events.map((e) => <span class={`pq-dot pq-ev-${e.event}`} style={`left:${ax.x(e.date)}%`} title={`${e.date} · ${EV_LABEL[e.event] ?? e.event}${e.reason ? ` (${e.reason})` : ""} · ${e.text}`} aria-label={`${e.date} · ${e.event} · ${e.text}`} tabindex="0"></span>)}
                    </span>
                  </div>
                ))}
              </div>
              <div class="pq-two">
                <div>
                  <p class="pq-et">Reasons lost</p>
                  {rs.length ? (
                    <table class="pq-mini"><tbody>{rs.map(([reason, count]) => <tr><td>{reason}</td><td class="pq-num">{count}</td></tr>)}</tbody></table>
                  ) : <p class="cq-note">Nothing lost yet.</p>}
                </div>
                <div>
                  <p class="pq-et">Days per stage, on average</p>
                  {ds.length ? (
                    <table class="pq-mini"><tbody>{ds.map((x) => <tr><td>{key === "all" && <span class={`pq-k-${x.k}`}>{KIND_LABEL[x.k as keyof typeof KIND_LABEL]}</span>} <span class="cq-stage">{x.stage}</span></td><td class="pq-num">{x.d} d</td></tr>)}</tbody></table>
                  ) : <p class="cq-note">No record has moved past a stage yet, so there are no days to count.</p>}
                </div>
              </div>
            </>
          )}
        </div>
      );
    })}

    <!-- What's due -->
    {KEYS.map((key) => (
      <div class="pq-panel" data-view="due" data-kind={key} hidden>
        {!hasAny(key) ? <p class="cq-note">Nothing of this kind yet.</p> : dueOf(key).length === 0 ? <p class="cq-note">Nothing open of this kind: every record is closed.</p> : (
          <>
            <p class="pq-legend">Every open record by its next step, overdue first. Each card opens its record.</p>
            <div class="pq-cards">
              {dueOf(key).map(({ d, r }) => (
                <a class={`pq-card${d.overdue ? " pq-card--overdue" : ""}`} href={r.url} data-id={r.id}>
                  <span class="pq-card-top">
                    <span><span class={`pq-tag pq-k-${r.kind}`}>{KIND_LABEL[r.kind]}</span> <span class="pq-org">{r.organisation}</span></span>
                    <span class="pq-when">{d.date}{d.overdue && " · overdue"}</span>
                  </span>
                  <span class="pq-next">→ {d.action}</span>
                  <span class="pq-money"><b>{value(r)}</b> · {pays(r)}{r.chance && <> · chance <span class={`cq-ch cq-ch--${r.chance}`}>{r.chance}</span></>}</span>
                </a>
              ))}
            </div>
          </>
        )}
      </div>
    ))}

    <!-- Asked / we have: the requirements the card marks as deciding most calls -->
    <div class="pq-panel" data-view="card" data-kind="any" hidden>
      <p class="pq-legend">What sinks a call most often, what the house holds today, and what would unlock it. Every tender and grant is read against it before it is kept.</p>
      <div class="pq-cardwrap"><table class="pq-cardt"><thead><tr><th>Requirement</th><th>Calls usually ask</th><th>We hold</th><th></th><th>What unlocks it</th><th class="pq-num">Open at check</th></tr></thead><tbody>
        {DECIDING.map((c) => {
          const s = STATE[c.state] ?? { mark: "?", text: c.state, cls: "pq-check" };
          return <tr data-req={c.requirement}><td><b>{c.requirement}</b></td><td>{c.asks}</td><td>{c.house}</td><td class={`pq-mark ${s.cls}`}><span aria-hidden="true">{s.mark}</span> {s.text}</td><td>{c.unlocks}</td><td class="pq-num">{c.check}</td></tr>;
        })}
      </tbody></table></div>
      <p class="pq-funnote">The {COUNT_WORD[DECIDING.length] ?? DECIDING.length} that decide most calls. The full card — every requirement, with sources — is <a href={CARD_URL}>The house's card</a>.</p>
    </div>

    <section class="pq-feed" data-feed data-feed-state={FEED.state} aria-labelledby="pq-feed-h">
      <h2 id="pq-feed-h" class="pq-et">Unreviewed — what the radar found</h2>
      <p class="pq-funnote">
        The tender radar reads public calls every half hour and writes what passes its filter to
        <a href={FEED_REPO}>its own repository</a>, without review. Shown here as it is, in the radar's Spanish,
        apart from the records and never counted in the funnel. A call becomes a record only through a reviewed pull request.
        {FEED.state === "read" && FEED.published && <> Last written {FEED.published.replace("T", " ")}.</>}
        {FEED.held > 0 && <> {FEED.held} held back here: they read as a person's name.</>}
      </p>
      {FEED.state === "unreachable" ? (
        <p class="pq-funnote">The feed could not be read when this page was built.</p>
      ) : FEED.items.length === 0 ? (
        <p class="pq-funnote">Nothing open passes the filter today.</p>
      ) : (
        <ul class="pq-feed-list">
          {FEED.items.map((i) => (
            <li class="pq-feed-item" data-feed-item={i.id} data-in-archive={i.in_archive}>
              <div class="pq-feed-top">
                <a href={i.url} rel="noopener" class="pq-feed-title">{i.title}</a>
                <span class="pq-feed-meta">{CHANCE_WORD[i.chance ?? ""] ?? i.chance} chance{i.closes && <> · closes {i.closes}</>}</span>
              </div>
              <p class="pq-feed-line">{[i.buyer, i.amount].filter(Boolean).join(" · ")}</p>
              {i.blocker && <p class="pq-feed-line"><b>Blocker:</b> {i.blocker}</p>}
              {i.next && <p class="pq-feed-line"><b>Next:</b> {i.next}</p>}
              {i.in_archive && <p class="pq-feed-line">Already a record: <a href={`/opportunities/${i.in_archive.toLowerCase()}`}>{i.in_archive}</a></p>}
            </li>
          ))}
        </ul>
      )}
    </section>

    <div class="pq-newrow">
      <a id="pq-new" class="pq-new" href={TEMPLATE_URL}>+ Open a new opportunity — the template</a>
      <span class="pq-newnote">One file per opportunity, one line per thing that happens.</span>
    </div>

    <div class="cq-sec">
      <h2>How this page is made</h2>
      <ul class="cq-list">
        <li>Every figure is computed from the records in <a href="/opportunities/">/opportunities/</a> by <code>machine/packages/sales-kit/pipeline.mjs</code>, the same tool that checks them in CI. No number on this page is typed — the funnel's percentages included.</li>
        <li>The kinds, the stages, the events and the five steps come from the register <a href="/standards/std-038-the-stages-of-an-opportunity">The stages of an opportunity</a>; what a record contains is <a href="/standards/std-039-an-opportunity-has-a-record">An opportunity has a record</a>.</li>
        <li>Each record's stage, next step, overdue and stale are read from its timeline; a tender or a grant's chance from its criteria, read against <a href={CARD_URL}>The house's card</a>. Which requirements decide most calls is marked in the card too.</li>
        <li>A call that fails a requirement is not recorded: what it taught goes into the card.</li>
        <li>The records are public and carry nobody's name; the organisation is a sector and a size until it agrees to be named. A public funder or contracting authority is named, as it publishes its own call.</li>
        <li>A record breaking a rule fails the build of this page, as it fails the CI step: what is shown here has passed.</li>
        <li>The <em>Unreviewed</em> list is the tender radar's, read from its own repository when the page is built (AUT-069 in <a href="/standards/std-017-who-may-change-what">Who may change what</a>). The archive checks it again for names and closed calls; nothing in it is counted above.</li>
      </ul>
    </div>
  </div></section>
</Layout>

<script is:inline id="pq-data" type="application/json" set:html={JSON.stringify(F)} />

<style is:global>
.pq-feed{margin-top:48px}
.pq-feed-list{list-style:none;padding:0;margin:12px 0 0;display:grid;gap:10px}
.pq-feed-item{border:1px dashed var(--border, currentColor);border-radius:8px;padding:12px 14px}
.pq-feed-top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 14px;align-items:baseline}
.pq-feed-title{font-weight:500}
.pq-feed-meta{font-family:var(--font-mono, monospace);font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;opacity:.75}
.pq-feed-line{font-size:.85rem;margin:4px 0 0;opacity:.85}
.cq-sec{margin-top:48px}
.cq-sec h2{font-family:var(--font-display);font-size:1.5rem;line-height:1.25;margin:0 0 6px;color:rgb(var(--text))}
.cq-note{font-size:.875rem;color:rgb(var(--text-muted));margin:0;line-height:1.55}
.cq-list{color:rgb(var(--text-muted));line-height:1.6;padding-left:20px}
.cq-list li{margin:6px 0}
.cq-list a{color:rgb(var(--accent));text-decoration:none}
.cq-list code{font-family:var(--font-mono);font-size:.85em}
.cq-stage{display:inline-block;padding:1px 8px;border-radius:999px;border:1px solid rgb(var(--border));font-family:var(--font-mono);font-size:.7rem}
.cq-ch{display:inline-block;padding:1px 8px;border-radius:999px;border:1px solid rgb(var(--border));font-size:.7rem}
.cq-ch--high{border-color:rgb(var(--green)/.6);color:rgb(var(--green))}
.cq-ch--medium{border-color:rgb(var(--accent)/.6);color:rgb(var(--accent))}
#pq a{color:rgb(var(--accent))}
.pq-et{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:rgb(var(--accent));margin:0 0 10px}
/* the funnel: the headline */
.pq-steps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
@media (max-width:860px){.pq-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
.pq-step{display:flex;flex-direction:column;gap:6px;background:rgb(var(--bg-card));border:1px solid rgb(var(--border));border-radius:var(--radius);padding:14px 16px 12px;min-width:0}
.pq-step-name{display:block;min-height:2.9em;font-family:var(--font-mono);font-size:.68rem;line-height:1.45;letter-spacing:.1em;text-transform:uppercase;color:rgb(var(--text-muted))}
.pq-step-n{font-family:var(--font-display);font-size:2.4rem;line-height:1;font-weight:500;font-variant-numeric:tabular-nums;color:rgb(var(--text))}
.pq-step--zero .pq-step-n{color:rgb(var(--text-dim))}
.pq-step-track{display:block;height:6px;border-radius:999px;background:rgb(var(--border)/.45)}
.pq-step-bar{display:block;height:100%;border-radius:999px;background:rgb(var(--accent))}
.pq-step-cv{font-family:var(--font-mono);font-size:.72rem;color:rgb(var(--text-dim));line-height:1.4}
.pq-funnote{font-size:.875rem;color:rgb(var(--text-muted));margin:10px 0 0;line-height:1.55}
.pq-funnote a{text-decoration:none}
/* the secondary figures: one quiet row */
.pq-kpis{display:flex;flex-wrap:wrap;gap:6px 22px;margin-top:14px;padding:10px 0 0;border-top:1px dashed rgb(var(--border))}
.pq-kpi{font-size:.8125rem;color:rgb(var(--text-dim));white-space:nowrap}
.pq-kpi-k{font-family:var(--font-mono);font-size:.65rem;letter-spacing:.12em;text-transform:uppercase}
.pq-kpi-v{font-family:var(--font-mono);font-weight:500;color:rgb(var(--text));font-variant-numeric:tabular-nums}
.pq-kpi--warn .pq-kpi-v{color:rgb(var(--red))}
.pq-kpi--today .pq-kpi-v{color:rgb(var(--accent))}
/* the switches: big pills, the pressed one filled with the accent */
.pq-sw{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}
.pq-sw--view{margin-top:10px}
.pq-pill{display:inline-flex;align-items:center;gap:8px;min-height:42px;padding:0 18px;border-radius:999px;border:1.5px solid rgb(var(--border));background:rgb(var(--bg-card));color:rgb(var(--text));font-family:var(--font-sans);font-size:.9375rem;cursor:pointer;transition:border-color .15s,background .15s,color .15s}
.pq-sw--view .pq-pill{border-radius:8px}
.pq-pill:hover{border-color:rgb(var(--accent)/.7)}
.pq-pill:focus-visible{outline:2px solid rgb(var(--accent));outline-offset:2px}
.pq-pill[aria-pressed="true"]{background:rgb(var(--accent));border-color:rgb(var(--accent));color:rgb(var(--bg));font-weight:600}
.pq-n{font-family:var(--font-mono);font-size:.72rem;color:rgb(var(--text-dim))}
.pq-pill[aria-pressed="true"] .pq-n{color:rgb(var(--bg)/.8)}
/* the panels */
.pq-panel{margin-top:22px}
.pq-legend{font-size:.8125rem;color:rgb(var(--text-muted));margin:0 0 10px;line-height:1.6}
.pq-tag{display:inline-block;padding:0 8px;border-radius:999px;border:1px solid currentColor;font-family:var(--font-mono);font-size:.65rem;letter-spacing:.04em;line-height:1.6;vertical-align:1px}
.pq-k-sale{color:rgb(var(--green))}.pq-k-tender{color:rgb(var(--yellow))}.pq-k-grant{color:rgb(var(--blue))}.pq-k-collaboration{color:rgb(var(--purple))}.pq-k-partner{color:rgb(var(--teal))}
/* timeline */
.pq-gantt{background:rgb(var(--bg-card));border:1px solid rgb(var(--border));border-radius:var(--radius);padding:6px 14px;overflow-x:auto}
.pq-g-row,.pq-g-axis{display:grid;grid-template-columns:minmax(260px,380px) minmax(360px,1fr);align-items:center}
.pq-g-row{border-top:1px solid rgb(var(--border));min-height:54px}
.pq-g-label{display:flex;flex-direction:column;gap:2px;padding:8px 14px 8px 0;min-width:0}
.pq-g-name{font-size:.875rem;line-height:1.35;color:rgb(var(--text))!important;text-decoration:none}
.pq-g-name:hover{text-decoration:underline}
.pq-g-sub{font-size:.75rem;color:rgb(var(--text-dim));line-height:1.35}
.pq-g-row--closed .pq-g-name{color:rgb(var(--text-muted))!important}
.pq-g-track{position:relative;height:54px;display:block}
.pq-g-axis .pq-g-track{height:24px}
.pq-tick{position:absolute;top:6px;transform:translateX(-50%);font-family:var(--font-mono);font-size:.65rem;color:rgb(var(--text-dim));white-space:nowrap}
.pq-today{position:absolute;top:0;bottom:0;width:2px;margin-left:-1px;background:rgb(var(--accent)/.55)}
.pq-span{position:absolute;top:26px;height:2px;background:rgb(var(--border))}
.pq-dot{position:absolute;top:20px;width:14px;height:14px;margin-left:-7px;border-radius:50%;border:2px solid rgb(var(--text-dim));background:rgb(var(--bg-card));cursor:help}
.pq-dot:focus-visible{outline:2px solid rgb(var(--accent));outline-offset:2px}
.pq-lg{display:inline-block;width:11px;height:11px;border-radius:50%;border:2px solid rgb(var(--text-dim));vertical-align:-1px}
.pq-ev-found{border-color:rgb(var(--text-dim))}
.pq-ev-out{background:rgb(var(--bg-card));border-color:rgb(var(--text-muted))}
.pq-ev-pos{background:rgb(var(--green));border-color:rgb(var(--green))}
.pq-ev-neg{background:rgb(var(--red));border-color:rgb(var(--red))}
.pq-ev-won{background:rgb(var(--accent));border-color:rgb(var(--accent))}
.pq-ev-lost{background:rgb(var(--bg-card));border-color:rgb(var(--red))}
.pq-ev-next{background:transparent;border-style:dashed;border-color:rgb(var(--accent))}
.pq-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 28px;margin-top:18px}
@media (max-width:760px){.pq-two{grid-template-columns:minmax(0,1fr)}}
.pq-mini{width:100%;border-collapse:collapse;font-size:.8125rem}
.pq-mini td{padding:5px 0;border-bottom:1px solid rgb(var(--border));color:rgb(var(--text-muted))}
.pq-mini td:first-child{color:rgb(var(--text))}
.pq-num{text-align:right;font-family:var(--font-mono);font-variant-numeric:tabular-nums}
/* what's due */
.pq-cards{display:grid;gap:10px}
.pq-card{display:grid;gap:6px;background:rgb(var(--bg-card));border:1px solid rgb(var(--border));border-radius:var(--radius);padding:12px 16px;color:rgb(var(--text))!important;text-decoration:none;transition:border-color .15s,background .15s}
.pq-card:hover,.pq-card:focus-visible{border-color:rgb(var(--accent)/.6);background:rgb(var(--bg-card-hover))}
.pq-card--overdue{border-color:rgb(var(--red)/.6)}
.pq-card--overdue .pq-when{color:rgb(var(--red))}
.pq-card-top{display:flex;justify-content:space-between;gap:6px 16px;flex-wrap:wrap}
.pq-when{font-family:var(--font-mono);font-size:.8rem;color:rgb(var(--text))}
.pq-org{font-weight:500}
.pq-money{font-size:.8125rem;color:rgb(var(--text-muted))}
.pq-money b{color:rgb(var(--text));font-family:var(--font-mono);font-weight:500}
.pq-next{font-size:.9rem;line-height:1.5}
/* asked / we have */
.pq-cardwrap{overflow-x:auto;background:rgb(var(--bg-card));border:1px solid rgb(var(--border));border-radius:var(--radius);padding:4px 8px}
.pq-cardt{width:100%;border-collapse:collapse;font-size:.84rem;line-height:1.45}
.pq-cardt th,.pq-cardt td{padding:9px 10px;border-bottom:1px solid rgb(var(--border));text-align:left;vertical-align:top}
.pq-cardt tr:last-child td{border-bottom:0}
.pq-cardt th{font-family:var(--font-mono);font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;font-weight:400;color:rgb(var(--text-dim))}
.pq-cardt td{color:rgb(var(--text-muted))}
.pq-cardt td:first-child{color:rgb(var(--text));min-width:120px}
.pq-mark{font-weight:600;white-space:nowrap}
.pq-yes{color:rgb(var(--green))!important}.pq-no{color:rgb(var(--red))!important}.pq-check{color:rgb(var(--yellow))!important}
/* the template link */
.pq-newrow{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 20px;margin-top:28px}
.pq-new{display:inline-block;padding:10px 18px;border:1.5px dashed rgb(var(--accent));border-radius:8px;text-decoration:none;font-weight:500;transition:background .15s}
.pq-new:hover,.pq-new:focus-visible{background:rgb(var(--accent)/.08)}
.pq-newnote{font-size:.8125rem;color:rgb(var(--text-dim))}
@media (prefers-reduced-motion:reduce){.pq-pill,.pq-card,.pq-new{transition:none}}
</style>

<script is:inline>
(() => {
const $$ = (s) => [...document.querySelectorAll(s)];
let kind = 'all', view = 'timeline';
function show() {
  $$('#pq-kind button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.k === kind)));
  $$('#pq-view button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === view)));
  $$('.pq-fun').forEach((el) => { el.hidden = el.dataset.kind !== kind; });
  $$('.pq-kpis').forEach((el) => { el.hidden = el.dataset.kind !== kind; });
  $$('.pq-panel').forEach((el) => { el.hidden = !(el.dataset.view === view && (el.dataset.kind === kind || el.dataset.kind === 'any')); });
}
$$('#pq-kind button').forEach((b) => b.addEventListener('click', () => { kind = b.dataset.k; show(); }));
$$('#pq-view button').forEach((b) => b.addEventListener('click', () => { view = b.dataset.v; show(); }));
show();
})();
</script>
