---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// The pipeline — sales, tenders, grants, collaborations and partners, one
// kind of record (STD-038, STD-039, OPS-018). THIS PAGE STATES NO FIGURE OF
// ITS OWN: the records in opportunities/ are read at build time through the
// sales kit's own tool (src/lib/pipeline.ts), the same tool CI runs on every
// change, so the page and the check cannot disagree. Overdue, stale, the
// stage, the chance, the funnel and the card's counts are the tool's
// verdicts; the page only lays them out.
//
// Two button rows — Kind and View — choose ONE panel. Every panel is real
// HTML rendered here, one per kind and view; the inline script only says
// which one shows, and composes no address (every record's `url` is made in
// src/lib/pipeline.ts). Without JavaScript the default panel — All, What's
// due — is what a reader sees.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { pipeline, CARD_URL, KIND_LABEL, KIND_PLURAL, STEP_LABEL, type PRecord } from "@/lib/pipeline";
import { repoFileUrl } from "@/lib/build-info";

const F = pipeline();
const TODAY = F.today;
const KINDS = F.kinds.map((k) => k.kind);
const KEYS = ["all", ...KINDS] as const;
const byId = Object.fromEntries(F.records.map((r) => [r.id, r]));
const of = (key: string) => (key === "all" ? F.records : F.records.filter((r) => r.kind === key));
const hasAny = (key: string) => of(key).length > 0;

// presentation only
const money = (n: number) => new Intl.NumberFormat("en-GB", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(n);
const value = (r: PRecord) => (r.value ? money(r.value) : "no money");
const PAYS: Record<string, string> = {
  advance: "paid in advance", milestones: "paid in milestones", "on-delivery": "paid on delivery",
  "on-justification": "paid after justification", "in-kind": "paid in kind", unknown: "how it pays: to ask", "to-ask": "how it pays: to ask",
};
const pays = (r: PRecord) => {
  const p = r.pays ? (PAYS[r.pays] ?? r.pays.replace(/-/g, " ")) : "how it pays: to ask";
  return (r.pays === "advance" || r.pays === "milestones") && r.advance !== null ? `${p}, ${r.advance} % before the work` : p;
};
const dayMs = 864e5;
const t = (d: string) => Date.parse(`${d}T00:00:00Z`);
const in7 = new Date(t(TODAY) + 7 * dayMs).toISOString().slice(0, 10);

// KPIs per kind key, from the tool's figures
const kpis = (key: string) => {
  const rs = of(key), open = rs.filter((r) => r.open);
  const due = F.due.filter((d) => (key === "all" || d.kind === key) && !d.overdue && d.date >= TODAY && d.date <= in7);
  const overdue = F.overdue.filter((id) => key === "all" || byId[id]?.kind === key);
  const adv = open.filter((r) => r.pays === "advance");
  return [
    { k: "Open value", v: money(open.reduce((a, r) => a + r.value, 0)), s: `${open.length} open record${open.length === 1 ? "" : "s"}, before tax`, c: "" },
    { k: "Due in 7 days", v: String(due.length), s: `next steps up to ${in7}`, c: due.length ? "cq-kpi--today" : "" },
    { k: "Overdue", v: String(overdue.length), s: "next date already past", c: overdue.length ? "cq-kpi--warn" : "" },
    { k: "Paid in advance", v: money(adv.reduce((a, r) => a + r.value, 0)), s: `open value that pays before the work, ${adv.length} record${adv.length === 1 ? "" : "s"}`, c: "" },
  ];
};

// What's due: the tool's due list (overdue first, then by date)
const dueOf = (key: string) => F.due.filter((d) => key === "all" || d.kind === key)
  .slice().sort((a, b) => Number(b.overdue) - Number(a.overdue) || a.date.localeCompare(b.date))
  .map((d) => ({ d, r: byId[d.id] as PRecord }));

// Timeline: open first (by next date), then closed (newest first)
const rowsOf = (key: string) => {
  const rs = of(key);
  const open = rs.filter((r) => r.open).sort((a, b) => (a.next?.date ?? "9").localeCompare(b.next?.date ?? "9"));
  const closed = rs.filter((r) => !r.open).sort((a, b) => (b.closed ?? "").localeCompare(a.closed ?? ""));
  return [...open, ...closed];
};
const axisOf = (key: string) => {
  const dates = of(key).flatMap((r) => r.events.map((e) => e.date)).concat(TODAY).sort();
  let a = t(dates[0]), b = t(dates[dates.length - 1]);
  if (b - a < 30 * dayMs) b = a + 30 * dayMs;
  const pad = (b - a) * 0.03; a -= pad; b += pad;
  const x = (d: string) => Math.round(((t(d) - a) / (b - a)) * 1000) / 10;
  const months: string[] = [];
  const s = new Date(a); let y = s.getUTCFullYear(), m = s.getUTCMonth() + 1;
  if (m > 11) { m = 0; y++; }
  while (Date.UTC(y, m, 1) <= b) { months.push(new Date(Date.UTC(y, m, 1)).toISOString().slice(0, 10)); m++; if (m > 11) { m = 0; y++; } }
  const step = Math.max(1, Math.ceil(months.length / 7));
  return { x, ticks: months.filter((_, i) => i % step === 0) };
};
const EV_LABEL: Record<string, string> = { found: "found", out: "the house did", pos: "positive answer", neg: "negative answer", won: "won", lost: "lost", next: "next" };

// Funnel, reasons, days per stage
const reasonsOf = (key: string): [string, number][] => {
  if (key === "all") return Object.entries(F.reasons);
  const c: Record<string, number> = {};
  for (const r of of(key)) if (r.stage === "lost" && r.reason) c[r.reason] = (c[r.reason] ?? 0) + 1;
  return Object.entries(c).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
};
const daysKinds = (key: string) => (key === "all" ? KINDS : [key]).filter((k) => Object.values(F.daysPerStage[k] ?? {}).some((d) => d !== null));

const STATE: Record<string, { mark: string; text: string; cls: string }> = {
  yes: { mark: "✓", text: "held", cls: "pq-yes" },
  no: { mark: "✗", text: "not held", cls: "pq-no" },
  check: { mark: "?", text: "to check", cls: "pq-check" },
};
const keyLabel = (k: string) => (k === "all" ? "All" : KIND_PLURAL[k as keyof typeof KIND_PLURAL]);
const VIEWS = [["due", "What's due"], ["timeline", "Timeline"], ["funnel", "Funnel"], ["card", "Asked / we have"]] as const;
---
<Layout
  title="The pipeline — Numinia"
  description="Sales, tenders, grants, collaborations and partners in one pipeline: what is due next, each record's timeline, the funnel from detected to won, and what calls ask against what the house holds. Computed from public records; nobody's name in them."
  canonicalPath="/system/pipeline"
  activeNav="system/"
>
  <PageHero
    label="System — The pipeline"
    title="Every opportunity, in one pipeline"
    description="Sales, tenders, grants, collaborations and partners: what is due next, what has happened to each, how far each kind gets, and what calls ask against what the house holds. Read from the public records, nobody's name in them, the organisation a sector until it agrees."
  />
  <div class="mx-auto max-w-[1100px] px-6 pb-8">
    <DocToolbar
      mdUrl="/system/pipeline.md"
      filename="numinia-pipeline.md"
      repoUrl={repoFileUrl("opportunities")}
      lang="en"
    />
  </div>
  <section class="pb-20" id="pq"><div class="mx-auto max-w-[1100px] px-6">
    <noscript><p class="cq-note">Without JavaScript this page shows every kind and what is due. The records themselves are plain text: <a href="/opportunities/">/opportunities/</a>; the same figures as tables: <a href="/system/pipeline.md">pipeline.md</a>.</p></noscript>

    <div class="pq-bar">
      <div class="cq-tabs" role="group" aria-label="Kind" id="pq-kind">
        {KEYS.map((k) => <button type="button" class="cq-tab" data-k={k} aria-pressed={k === "all" ? "true" : "false"}>{keyLabel(k)}</button>)}
      </div>
      <div class="cq-tabs" role="group" aria-label="View" id="pq-view">
        {VIEWS.map(([v, label]) => <button type="button" class="cq-tab" data-v={v} aria-pressed={v === "due" ? "true" : "false"}>{label}</button>)}
      </div>
    </div>

    <!-- KPIs, one block per kind -->
    {KEYS.map((key) => (
      <div class="cq-kpis pq-kpis" data-kind={key} hidden={key !== "all"}>
        {kpis(key).map((c) => <div class={`cq-kpi ${c.c}`}><span class="cq-k">{c.k}</span><span class="cq-v">{c.v}</span><span class="cq-s">{c.s}</span></div>)}
      </div>
    ))}

    <!-- What's due -->
    {KEYS.map((key) => (
      <div class="cq-sec pq-panel" data-view="due" data-kind={key} hidden={key !== "all"}>
        <h2>What's due{key !== "all" && ` — ${keyLabel(key)}`}</h2>
        {!hasAny(key) ? <p class="cq-note">Nothing of this kind yet.</p> : dueOf(key).length === 0 ? <p class="cq-note">Nothing open of this kind: every record is closed.</p> : (
          <>
            <p class="cq-sub">Every open record by its next step, overdue first. Each card opens its record.</p>
            <div class="pq-cards">
              {dueOf(key).map(({ d, r }) => (
                <a class={`pq-card${d.overdue ? " pq-card--overdue" : ""}`} href={r.url} data-id={r.id}>
                  <span class="pq-card-top">
                    <span><span class={`pq-tag pq-k-${r.kind}`}>{KIND_LABEL[r.kind]}</span> <span class="pq-id">{r.id}</span></span>
                    <span class="pq-when">{d.date}{d.overdue && " · overdue"}</span>
                  </span>
                  <span class="pq-org">{r.organisation}</span>
                  <span class="pq-money"><b>{value(r)}</b> · {pays(r)}{r.chance && <> · chance <span class={`cq-ch cq-ch--${r.chance}`}>{r.chance}</span></>}</span>
                  <span class="pq-next">→ {d.action}</span>
                  <span class="pq-stage">at <span class="cq-stage">{r.stage}</span></span>
                </a>
              ))}
            </div>
          </>
        )}
      </div>
    ))}

    <!-- Timeline -->
    {KEYS.map((key) => {
      const ax = hasAny(key) ? axisOf(key) : null;
      return (
        <div class="cq-sec pq-panel" data-view="timeline" data-kind={key} hidden>
          <h2>Timeline{key !== "all" && ` — ${keyLabel(key)}`}</h2>
          {!ax ? <p class="cq-note">Nothing of this kind yet.</p> : (
            <>
              <p class="cq-sub">One row per record, open first. A dot per line of its timeline: <span class="pq-lg pq-ev-out"></span> the house did something, <span class="pq-lg pq-ev-pos"></span> a positive answer, <span class="pq-lg pq-ev-neg"></span> a negative one, <span class="pq-lg pq-ev-won"></span> won, <span class="pq-lg pq-ev-lost"></span> lost, <span class="pq-lg pq-ev-next"></span> the next step. The upright line is today, {TODAY}. Point at a dot to read it; the name opens the record.</p>
              <div class="cq-card pq-gantt">
                <div class="pq-g-row pq-g-axis"><span></span><span class="pq-g-track">{ax.ticks.map((m) => <span class="pq-tick" style={`left:${ax.x(m)}%`}>{m.slice(0, 7)}</span>)}</span></div>
                {rowsOf(key).map((r) => (
                  <div class="pq-g-row" data-id={r.id}>
                    <a class="pq-g-name" href={r.url} title={r.organisation ?? r.id}><span class={`pq-tag pq-k-${r.kind}`}>{KIND_LABEL[r.kind]}</span> {r.id} <span class="pq-g-org">{r.organisation}</span></a>
                    <span class="pq-g-track">
                      <span class="pq-today" style={`left:${ax.x(TODAY)}%`}></span>
                      <span class="pq-span" style={`left:${ax.x(r.events[0].date)}%;width:${ax.x(r.events[r.events.length - 1].date) - ax.x(r.events[0].date)}%`}></span>
                      {r.events.map((e) => <span class={`pq-dot pq-ev-${e.event}`} style={`left:${ax.x(e.date)}%`} title={`${e.date} · ${EV_LABEL[e.event] ?? e.event}${e.reason ? ` (${e.reason})` : ""} · ${e.text}`} aria-label={`${e.date} · ${e.event} · ${e.text}`} tabindex="0"></span>)}
                    </span>
                  </div>
                ))}
              </div>
            </>
          )}
        </div>
      );
    })}

    <!-- Funnel -->
    {KEYS.map((key) => {
      const n = F.funnel[key] ?? [];
      const max = Math.max(1, n[0] ?? 0);
      const rs = reasonsOf(key);
      const dk = daysKinds(key);
      return (
        <div class="cq-sec pq-panel" data-view="funnel" data-kind={key} hidden>
          <h2>Funnel{key !== "all" && ` — ${keyLabel(key)}`}</h2>
          {!hasAny(key) ? <p class="cq-note">Nothing of this kind yet.</p> : (
            <>
              <p class="cq-sub">How many records reached each step, ever, read from their timelines. A later step counts the earlier ones too; the fifth counts records another record names as the one it came from.</p>
              <div class="cq-card pq-funnel">
                {F.steps.map((s, i) => (
                  <div class="pq-f-row" data-step={s.step} title={s.means}>
                    <span class="pq-f-label">{STEP_LABEL[s.step] ?? s.step}</span>
                    <span class="pq-f-track"><span class="pq-f-bar" style={`width:${Math.round(((n[i] ?? 0) / max) * 1000) / 10}%`}></span></span>
                    <span class="pq-f-n">{n[i] ?? 0}</span>
                  </div>
                ))}
              </div>
              <div class="cq-two" style="margin-top:12px">
                <div class="cq-card">
                  <h3 class="cq-h3" style="margin-top:0">Reasons lost</h3>
                  {rs.length ? (
                    <div class="cq-tablewrap"><table class="cq-t"><thead><tr><th class="cq-l">Reason</th><th>Records</th></tr></thead><tbody>
                      {rs.map(([reason, count]) => <tr><td class="cq-l">{reason}</td><td>{count}</td></tr>)}
                    </tbody></table></div>
                  ) : <p class="cq-note">Nothing lost yet.</p>}
                </div>
                <div class="cq-card">
                  <h3 class="cq-h3" style="margin-top:0">Days per stage</h3>
                  {dk.length ? dk.map((k) => (
                    <div class="cq-tablewrap pq-days"><table class="cq-t"><thead><tr><th class="cq-l">{key === "all" ? KIND_LABEL[k as keyof typeof KIND_LABEL] : "Stage"}</th><th>Average days</th></tr></thead><tbody>
                      {Object.entries(F.daysPerStage[k]).map(([stage, d]) => <tr><td class="cq-l"><span class="cq-stage">{stage}</span></td><td>{d === null ? "—" : `${d} d`}</td></tr>)}
                    </tbody></table></div>
                  )) : <p class="cq-note">No record has moved past a stage yet, so there are no days to count.</p>}
                </div>
              </div>
            </>
          )}
        </div>
      );
    })}

    <!-- Asked / we have: one card for every kind -->
    <div class="cq-sec pq-panel" data-view="card" data-kind="any" hidden>
      <h2>Asked / we have</h2>
      <p class="cq-sub">What calls usually ask, what the house holds today, and what would unlock each gap — every tender and grant is read against it. The card itself is <a href={CARD_URL}>The house's card</a>.</p>
      <div class="cq-tablewrap"><table class="cq-t pq-cardt"><thead><tr><th class="cq-l">Requirement</th><th class="cq-l">What calls usually ask</th><th class="cq-l">What we hold</th><th class="cq-l">State</th><th class="cq-l">What unlocks it</th><th>Open records at check</th></tr></thead><tbody>
        {F.card.map((c) => {
          const s = STATE[c.state] ?? { mark: "?", text: c.state, cls: "pq-check" };
          return <tr data-req={c.requirement}><td class="cq-l"><b>{c.requirement}</b></td><td class="cq-l">{c.asks}</td><td class="cq-l">{c.house}</td><td class={`cq-l ${s.cls}`}><span aria-hidden="true">{s.mark}</span> {s.text}</td><td class="cq-l">{c.unlocks}</td><td>{c.check}</td></tr>;
        })}
      </tbody></table></div>
    </div>

    <div class="cq-sec">
      <h2>How this page is made</h2>
      <ul class="cq-list">
        <li>Every figure is computed from the records in <a href="/opportunities/">/opportunities/</a> by <code>machine/packages/sales-kit/pipeline.mjs</code>, the same tool that checks them in CI. No number on this page is typed.</li>
        <li>The kinds, the stages, the events and the five steps come from the register <a href="/standards/std-038-the-stages-of-an-opportunity">The stages of an opportunity</a>; what a record contains is <a href="/standards/std-039-an-opportunity-has-a-record">An opportunity has a record</a>.</li>
        <li>Each record's stage, next step, overdue and stale are read from its timeline; a tender or a grant's chance from its criteria, read against <a href={CARD_URL}>The house's card</a>.</li>
        <li>A call that fails a requirement is not recorded: what it taught goes into the card.</li>
        <li>The records are public and carry nobody's name; the organisation is a sector and a size until it agrees to be named. A public funder or contracting authority is named, as it publishes its own call.</li>
        <li>A record breaking a rule fails the build of this page, as it fails the CI step: what is shown here has passed.</li>
      </ul>
    </div>
  </div></section>
</Layout>

<script is:inline id="pq-data" type="application/json" set:html={JSON.stringify(F)} />

<style is:global>
.cq-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:20px}
@media (max-width:860px){.cq-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
.cq-kpi{background:rgb(var(--bg-card));border:1px solid rgb(var(--border));border-radius:var(--radius);padding:14px 16px;min-width:0}
.cq-k{display:block;font-family:var(--font-mono);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;color:rgb(var(--text-dim))}
.cq-v{display:block;font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-weight:500;font-size:clamp(1.1rem,4.2vw,1.6rem);line-height:1.2;margin:6px 0 4px;color:rgb(var(--text));white-space:nowrap}
.cq-s{display:block;font-size:.8125rem;line-height:1.45;color:rgb(var(--text-dim))}
.cq-kpi--warn .cq-v{color:rgb(var(--yellow))}
.cq-kpi--today .cq-v{color:rgb(var(--accent))}
.cq-sec{margin-top:40px}
.cq-sec h2{font-family:var(--font-display);font-size:1.5rem;line-height:1.25;margin:0 0 6px;color:rgb(var(--text))}
.cq-sub{color:rgb(var(--text-muted));margin:0 0 16px;max-width:72ch;line-height:1.6}
.cq-sub a{color:rgb(var(--accent));text-decoration:none}
.cq-card{background:rgb(var(--bg-card));border:1px solid rgb(var(--border));border-radius:var(--radius);padding:16px}
.cq-tabs{display:inline-flex;flex-wrap:wrap;gap:4px;padding:3px;border:1px solid rgb(var(--border));border-radius:8px;background:rgb(var(--bg-card))}
.cq-tab{min-height:32px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:rgb(var(--text-muted));font-family:var(--font-mono);font-size:.8125rem;cursor:pointer;transition:background .15s,color .15s}
.cq-tab[aria-pressed="true"]{background:rgb(var(--accent)/.15);color:rgb(var(--text))}
@media (max-width:1023px){.cq-tab{min-height:44px}}
.cq-note{font-size:.875rem;color:rgb(var(--text-muted));margin:0;line-height:1.55}
.cq-tablewrap{overflow-x:auto}
.cq-t{width:100%;border-collapse:collapse;font-family:var(--font-mono);font-size:.8125rem;font-variant-numeric:tabular-nums}
.cq-t th,.cq-t td{padding:8px 10px;text-align:right;border-bottom:1px solid rgb(var(--border));white-space:nowrap;vertical-align:top}
.cq-t th{color:rgb(var(--text-dim));font-weight:500;font-size:.7rem;letter-spacing:.08em;text-transform:uppercase}
.cq-t th.cq-l,.cq-t td.cq-l{text-align:left;white-space:normal}
.cq-t td:first-child,.cq-t th:first-child{text-align:left}
.cq-t a{color:rgb(var(--accent));text-decoration:none}
.cq-h3{font-family:var(--font-display);font-size:1.125rem;margin:28px 0 10px;color:rgb(var(--text))}
.cq-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
@media (max-width:860px){.cq-two{grid-template-columns:minmax(0,1fr)}}
.cq-list{color:rgb(var(--text-muted));line-height:1.6;padding-left:20px}
.cq-list li{margin:6px 0}
.cq-list a{color:rgb(var(--accent));text-decoration:none}
.cq-list code{font-family:var(--font-mono);font-size:.85em}
.cq-stage{display:inline-block;padding:1px 8px;border-radius:999px;border:1px solid rgb(var(--border));font-family:var(--font-mono);font-size:.7rem}
.cq-ch{display:inline-block;padding:1px 8px;border-radius:999px;border:1px solid rgb(var(--border));font-size:.7rem}
.cq-ch--high{border-color:rgb(var(--green)/.6);color:rgb(var(--green))}
.cq-ch--medium{border-color:rgb(var(--accent)/.6);color:rgb(var(--accent))}
.pq-bar{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.pq-tag{display:inline-block;padding:0 8px;border-radius:999px;border:1px solid currentColor;font-family:var(--font-mono);font-size:.65rem;letter-spacing:.04em;line-height:1.6}
.pq-k-sale{color:rgb(var(--green))}.pq-k-tender{color:rgb(var(--yellow))}.pq-k-grant{color:rgb(var(--blue))}.pq-k-collaboration{color:rgb(var(--purple))}.pq-k-partner{color:rgb(var(--teal))}
.pq-cards{display:grid;gap:10px}
.pq-card{display:grid;gap:4px;background:rgb(var(--bg-card));border:1px solid rgb(var(--border));border-radius:var(--radius);padding:12px 16px;color:rgb(var(--text));text-decoration:none;transition:border-color .15s,background .15s}
.pq-card:hover,.pq-card:focus-visible{border-color:rgb(var(--accent)/.6);background:rgb(var(--bg-card-hover))}
.pq-card--overdue{border-color:rgb(var(--red)/.6)}
.pq-card--overdue .pq-when{color:rgb(var(--red))}
.pq-card-top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.pq-id,.pq-when{font-family:var(--font-mono);font-size:.75rem;color:rgb(var(--text-dim))}
.pq-when{color:rgb(var(--text))}
.pq-org{font-weight:500}
.pq-money,.pq-stage{font-size:.875rem;color:rgb(var(--text-muted))}
.pq-money b{color:rgb(var(--text));font-family:var(--font-mono);font-weight:500}
.pq-next{font-size:.9rem;line-height:1.5}
.pq-gantt{display:grid;gap:0;padding:8px 12px;overflow-x:auto}
.pq-g-row{display:grid;grid-template-columns:minmax(180px,260px) minmax(360px,1fr);align-items:center;border-bottom:1px solid rgb(var(--border));min-height:36px}
.pq-g-row:last-child{border-bottom:0}
.pq-g-axis{min-height:22px}
.pq-g-name{font-family:var(--font-mono);font-size:.75rem;color:rgb(var(--text));text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:10px}
.pq-g-name:hover .pq-g-org{text-decoration:underline}
.pq-g-org{color:rgb(var(--text-muted));font-family:var(--font-sans)}
.pq-g-track{position:relative;height:36px;display:block}
.pq-g-axis .pq-g-track{height:22px}
.pq-tick{position:absolute;top:4px;transform:translateX(-50%);font-family:var(--font-mono);font-size:.65rem;color:rgb(var(--text-dim));white-space:nowrap}
.pq-today{position:absolute;top:0;bottom:0;width:2px;margin-left:-1px;background:rgb(var(--accent)/.5)}
.pq-span{position:absolute;top:17px;height:2px;background:rgb(var(--border))}
.pq-dot{position:absolute;top:12px;width:12px;height:12px;margin-left:-6px;border-radius:50%;border:2px solid rgb(var(--text-dim));background:rgb(var(--bg-card));cursor:help}
.pq-dot:focus-visible{outline:2px solid rgb(var(--accent));outline-offset:2px}
.pq-lg{display:inline-block;width:10px;height:10px;border-radius:50%;border:2px solid rgb(var(--text-dim));vertical-align:-1px}
.pq-ev-found{border-color:rgb(var(--text-dim))}
.pq-ev-out{background:rgb(var(--bg-card));border-color:rgb(var(--text-muted))}
.pq-ev-pos{background:rgb(var(--green));border-color:rgb(var(--green))}
.pq-ev-neg{background:rgb(var(--red));border-color:rgb(var(--red))}
.pq-ev-won{background:rgb(var(--accent));border-color:rgb(var(--accent))}
.pq-ev-lost{background:rgb(var(--bg-card));border-color:rgb(var(--red))}
.pq-ev-next{background:transparent;border-style:dashed;border-color:rgb(var(--accent))}
.pq-funnel{display:grid;gap:8px}
.pq-f-row{display:grid;grid-template-columns:170px 1fr 48px;gap:10px;align-items:center}
.pq-f-label{font-family:var(--font-mono);font-size:.8125rem;color:rgb(var(--text))}
.pq-f-track{display:block;height:20px;border-radius:6px;background:rgb(var(--border)/.4)}
.pq-f-bar{display:block;height:100%;border-radius:6px;background:rgb(var(--accent))}
.pq-f-n{font-family:var(--font-mono);font-variant-numeric:tabular-nums;text-align:right;color:rgb(var(--text))}
.pq-days+.pq-days{margin-top:12px}
.pq-yes{color:rgb(var(--green))}.pq-no{color:rgb(var(--red))}.pq-check{color:rgb(var(--yellow))}
.pq-cardt td{min-width:120px}
@media (prefers-reduced-motion:reduce){.cq-tab,.pq-card{transition:none}}
</style>

<script is:inline>
(() => {
const $$ = (s) => [...document.querySelectorAll(s)];
let kind = 'all', view = 'due';
function show() {
  $$('#pq-kind .cq-tab').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.k === kind)));
  $$('#pq-view .cq-tab').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === view)));
  $$('.pq-kpis').forEach((el) => { el.hidden = el.dataset.kind !== kind; });
  $$('.pq-panel').forEach((el) => { el.hidden = !(el.dataset.view === view && (el.dataset.kind === kind || el.dataset.kind === 'any')); });
}
$$('#pq-kind .cq-tab').forEach((b) => b.addEventListener('click', () => { kind = b.dataset.k; show(); }));
$$('#pq-view .cq-tab').forEach((b) => b.addEventListener('click', () => { view = b.dataset.v; show(); }));
show();
})();
</script>
