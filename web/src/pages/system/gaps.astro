---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// MIS-071 phase 4 — this page renders from the archive.
//
// Until now it carried its own hardcoded copy of the 19 gaps while
// reports/RPT-008-gaps-capability-map.md (extracted from this very
// file in phase 2) sat unread beside it: two archives, one silent. The
// arrays are gone. The report is the source; this file is the lens.
//
// The synthesis cards below name the three gaps that rank highest, and
// they now derive from the data rather than repeating it — if the report's
// scores change, the synthesis follows.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import HighlightBox from "@/components/HighlightBox.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { getGaps } from "@/lib/gaps";
import { repoFileUrl } from "@/lib/build-info";

const doc = await getGaps();

// The blurb under each perspective heading — page furniture, not archive
// content: it frames the section rather than restating what the report says.
const blurbs: Record<string, string> = {
  Business: "Who buys this, how, and why now?",
  Product: "What makes this fail when it meets the real world?",
  "Organizational Theory":
    "Which philosophical or psychological assumptions are untested?",
};

// Highest-ranking gaps, by the worse of the two scores, ties broken by
// impact. Derived, not restated — the synthesis cannot drift from the data.
const top3 = [...doc.all]
  .sort(
    (a, b) =>
      Math.max(b.impact, b.urgency) - Math.max(a.impact, a.urgency) ||
      b.impact - a.impact
  )
  .slice(0, 3);

const scoreColor = (n: number) =>
  n >= 9 ? "text-red" : n >= 7 ? "text-yellow" : "text-muted-foreground";
const bgColor = (n: number) =>
  n >= 9 ? "border-red/30 bg-red/5" : n >= 7 ? "border-yellow/30 bg-yellow/5" : "border-border bg-card";
---

<Layout
  title="NWOS — Gaps Analysis — Pablo FM"
  description="Critical analysis of the Narrative Work OS blind spots. Business, product and organizational theory perspectives."
  canonicalPath="/system/gaps"
  activeNav="system/"
>
  <PageHero
    label="NWOS — Gaps"
    title="The blind spots to see before the market points them out"
    description="Critical analysis of the Narrative Work OS from three perspectives: business, product, organizational theory. Unfiltered."
  />

  <!-- Intro — read from the report -->
  <section class="pb-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <div class="max-w-[720px] space-y-5 text-base leading-relaxed text-muted-foreground">
        <p>{doc.introduction}</p>
      </div>
      <div class="mt-8 max-w-[720px]">
        <DocToolbar
          mdUrl={doc.mdUrl}
          filename="RPT-008-gaps-capability-map.md"
          repoUrl={repoFileUrl("reports/RPT-008-gaps-capability-map.md")}
          lang="en"
        />
        <p class="mt-3 font-mono text-[0.7rem] text-dim">
          This page renders <a href={doc.sourceUrl} class="text-accent underline underline-offset-2">{doc.title}</a>.
          The archive is the source; nothing here is written twice.
        </p>
      </div>
    </div>
  </section>

  <!-- Legend -->
  <section class="border-t border-border py-10">
    <div class="mx-auto max-w-[1100px] px-6">
      <div class="flex flex-wrap gap-6 text-sm text-muted-foreground">
        <div class="flex items-center gap-2"><span class="font-bold text-red">■</span> Critical (9-10)</div>
        <div class="flex items-center gap-2"><span class="font-bold text-yellow">■</span> High (7-8)</div>
        <div class="flex items-center gap-2"><span class="font-bold text-muted-foreground">■</span> Medium (≤6)</div>
        <div class="ml-auto text-xs">Impact = severity if unresolved · Urgency = how soon it must be answered</div>
      </div>
    </div>
  </section>

  <!-- One section per perspective, in document order -->
  {doc.perspectives.map((p) => (
    <section class="border-t border-border py-16">
      <div class="mx-auto max-w-[1100px] px-6">
        <SectionHeader label={`Perspective ${p.index}`} title={p.name} />
        {blurbs[p.name] && (
          <p class="mt-2 max-w-[720px] text-sm text-muted-foreground">{blurbs[p.name]}</p>
        )}
        <div class="mt-8 space-y-6">
          {p.gaps.map((gap) => (
            <div class={`rounded-lg border p-6 space-y-4 ${bgColor(Math.max(gap.impact, gap.urgency))}`}>
              <div class="flex flex-wrap items-start justify-between gap-4">
                <h3 class="font-display text-lg text-foreground">{gap.name}</h3>
                <div class="flex gap-4 text-sm font-mono shrink-0">
                  <span>Impact: <strong class={scoreColor(gap.impact)}>{gap.impact}/10</strong></span>
                  <span>Urgency: <strong class={scoreColor(gap.urgency)}>{gap.urgency}/10</strong></span>
                </div>
              </div>
              <p class="text-sm text-muted-foreground">{gap.description}</p>
              <div class="border-l-2 border-accent/40 pl-4">
                <p class="text-xs text-muted-foreground/70 uppercase tracking-wider mb-1">Blind spot</p>
                <p class="text-sm text-muted-foreground italic">{gap.blindSpot}</p>
              </div>
              <div class="rounded bg-accent/5 border border-accent/20 px-4 py-3">
                <p class="text-xs text-accent uppercase tracking-wider mb-1">Question for the Oracles</p>
                <p class="text-sm text-foreground">"{gap.question}"</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Synthesis — derived from the scores, not restated -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="Synthesis" title="The gaps that rank above all the others" />
      <p class="mt-2 max-w-[720px] text-sm text-muted-foreground">
        Ranked by the higher of impact and urgency — computed from the report, so this
        section cannot drift from the document it summarizes.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {top3.map((gap, i) => (
          <div class="rounded-lg border border-red/30 bg-red/5 p-6 space-y-3">
            <div class="text-xs font-semibold uppercase tracking-wider text-red">
              Critical gap #{i + 1}
            </div>
            <h3 class="font-display text-base text-foreground">{gap.name}</h3>
            <p class="text-sm text-muted-foreground">{gap.blindSpot}</p>
            <div class="font-mono text-[0.7rem] text-dim">
              impact {gap.impact}/10 · urgency {gap.urgency}/10
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing note -->
  <section class="border-t border-border py-20">
    <div class="mx-auto max-w-[1100px] px-6">
      <HighlightBox>
        <p class="text-sm leading-relaxed text-muted-foreground">
          <strong class="text-accent">Methodological note:</strong> this analysis was produced by
          three digital agents with distinct perspectives — business critic, product critic and
          organizational theory academic — applying critical thinking without complacency. The gaps
          identified are not a verdict on the project. They are the map of work needed to turn a
          powerful idea into something the world can use. The difference between projects that
          survive and those that do not usually lies in whether the founders saw these blind spots
          in time.
        </p>
      </HighlightBox>
    </div>
  </section>
</Layout>
