---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import HighlightBox from "@/components/HighlightBox.astro";

// ── ICP RANKING ──
const icpRanking = [
  {
    rank: 1,
    label: "Technical startup 5–15p",
    score: 92,
    adoptionRate: 85,
    timeToValue: "2–4 wks",
    buyerProfile: "CEO / CTO",
    budget: "€500–2.000/month",
    painPoint: "Team culture breaks when going from 5 to 10 people",
    signal: "Looking for alternatives to Notion + Linear + alignment meetings",
    verdict: "Ideal ICP now",
    color: "teal",
  },
  {
    rank: 2,
    label: "Mixed startup 15–50p",
    score: 74,
    adoptionRate: 75,
    timeToValue: "4–8 wks",
    buyerProfile: "CEO / Head of People",
    budget: "€1.500–5.000/month",
    painPoint: "Technical and non-technical profiles speak different languages",
    signal: "Has tried OKRs and they did not work. Looking for something more alive.",
    verdict: "Expansion ICP",
    color: "blue",
  },
  {
    rank: 3,
    label: "Creative agency 10–30p",
    score: 68,
    adoptionRate: 75,
    timeToValue: "3–6 wks",
    buyerProfile: "CEO / Creative Director",
    budget: "€800–3.000/month",
    painPoint: "Every new project restarts the culture from scratch",
    signal: "Mentions 'company identity' or 'how we do things here'",
    verdict: "Opportunity ICP",
    color: "purple",
  },
  {
    rank: 4,
    label: "Traditional SME 50–150p",
    score: 31,
    adoptionRate: 35,
    timeToValue: "6–12 mo",
    buyerProfile: "CHRO / Managing Director",
    budget: "€3.000–8.000/month",
    painPoint: "High turnover, disconnection from company values",
    signal: "Has invested in leadership training with no results",
    verdict: "Avoid for now",
    color: "orange",
  },
  {
    rank: 5,
    label: "Corporate team 100–500p",
    score: 18,
    adoptionRate: 30,
    timeToValue: "9–18 mo",
    buyerProfile: "CHRO / VP People",
    budget: "€10.000–40.000/month",
    painPoint: "Post-merger or remote-first cultural transformation",
    signal: "Active RFP, annual culture budget approved",
    verdict: "Avoid until Series A",
    color: "red",
  },
];

// ── FUNNEL ──
const funnelStages = [
  { label: "Awareness", n: 1000, desc: "Contacts who know NWOS exists", color: "#a6dad5" },
  { label: "Interest", n: 180, desc: "Have read the one-pager or visited /nwos", color: "#5d9bd6" },
  { label: "Qualified", n: 54, desc: "Right ICP + active pain + decision-maker identified", color: "#a98be0" },
  { label: "Pilot", n: 18, desc: "Agree to an 8-week pilot", color: "#efa517" },
  { label: "Customer", n: 9, desc: "Renew after the pilot", color: "#8fc46b" },
];

// ── BLOQUEADORES ──
const blockers = [
  {
    id: "B1",
    titulo: "There is no external proof",
    urgencia: 10,
    desc: "Nobody can buy what they have not seen working outside the founders. As long as no real case exists, the sales cycle begins with an unanswered question.",
    accion: "Blind exposure protocol: 2 external people, 48h, no prior context. This week.",
    dot: "bg-red",
  },
  {
    id: "B2",
    titulo: "No operational ICP",
    urgencia: 9,
    desc: "Without knowing who signs the cheque, which metric justifies the purchase and from which budget line, there is no go-to-market. Only hope.",
    accion: "Bet on ONE profile: CEO of a technical startup 5–15p. Design the whole message for them.",
    dot: "bg-red",
  },
  {
    id: "B3",
    titulo: "No sales format",
    urgencia: 9,
    desc: "If a company says 'I want it' tomorrow, there is nothing to send, nothing to charge for, nobody free to implement it.",
    accion: "Define the minimum sellable product: an 8-week pilot with a fixed price, deliverables and a success criterion.",
    dot: "bg-red",
  },
  {
    id: "B4",
    titulo: "Cognitive cost of entry",
    urgencia: 7,
    desc: "The full NWOS vocabulary in the first meeting closes doors. The adoption barrier appears before the client has felt any value.",
    accion: "Create the sales deck with 5 concepts maximum. Numinia is layer 3, not layer 1.",
    dot: "bg-yellow",
  },
  {
    id: "B5",
    titulo: "No ROI metrics for the decision-maker",
    urgencia: 7,
    desc: "A CHRO or CEO cannot approve a spend without knowing which number improves. 'More meaning' is not a business metric.",
    accion: "Define 3 pre-pilot KPIs the client agrees to measure. Retention, decision speed, internal NPS.",
    dot: "bg-yellow",
  },
];

// ── PILOT PLAN ──
const pilotWeeks = [
  { week: "W1–W2", label: "Diagnosis", tasks: ["Organisational Maslach", "Map of current roles", "3 agreed KPIs"], color: "teal" },
  { week: "W3–W4", label: "MVV", tasks: ["5 concepts installed", "First live mission", "Weekly ritual (30 min)"], color: "blue" },
  { week: "W5–W6", label: "Expansion", tasks: ["Guild assigned", "First digital agent", "First Stone of the Path"], color: "purple" },
  { week: "W7–W8", label: "Evaluation", tasks: ["Measurement vs. KPIs", "Adoption report", "Renewal decision"], color: "orange" },
];

// ── VALUE PROP POR BUYER ──
const valueProps = [
  {
    buyer: "CEO of a technical startup",
    pain: "The team grows and the culture breaks",
    message: "NWOS is the culture infrastructure that scales with the team. It is not one more tool — it is the common grammar that connects people with what they build.",
    metric: "Cultural onboarding time: from 3 months to 3 weeks",
  },
  {
    buyer: "Head of People of a mixed startup",
    pain: "The OKRs do not work and the team is disconnected",
    message: "NWOS replaces motivation by metrics with motivation by purpose. Missions have context. Decisions have memory. People know why what they do matters.",
    metric: "eNPS: target +20 points in 6 months",
  },
  {
    buyer: "Creative Director of an agency",
    pain: "Every new client restarts the team's identity",
    message: "NWOS gives the team a permanent identity beyond each project. The Archive is the institutional memory that survives every delivery.",
    metric: "Senior creative talent retention: target -50% turnover",
  },
];

const colorMap: Record<string, string> = {
  teal: "text-accent border-teal/30 bg-teal/10",
  blue: "text-blue border-blue/30 bg-blue/10",
  purple: "text-purple border-purple/30 bg-purple/10",
  orange: "text-yellow border-yellow/30 bg-yellow/10",
  red: "text-red border-red/30 bg-red/10",
};
---

<Layout
  title="NWOS — Sales Strategy — Pablo FM"
  description="Sales guide for the Narrative Work OS for the Oracles of Numen Games. ICP, funnel, blockers and pilot plan."
  canonicalPath="/system/sales"
  activeNav="system/"
>
  <PageHero
    label="NWOS — Sales"
    title="How to win the first clients"
    description="Operational guide for the Oracles. Defined ICP, sales funnel, current blockers and the 8-week pilot plan."
  />

  <!-- Estado actual -->
  <section class="pb-10">
    <div class="mx-auto max-w-[1100px] px-6">
      <HighlightBox>
        <p class="text-sm leading-relaxed text-muted-foreground">
          <strong class="text-accent">Honest diagnosis (April 2026):</strong> NWOS has solid theoretical coherence, internal validation from 4 Oracles and 0 external clients. The gap between those two ends is not a product gap — it is a sequence gap. First external validation, then ICP, then a sellable product. This document is the map for covering that distance.
        </p>
      </HighlightBox>
    </div>
  </section>

  <!-- BLOQUEADORES -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="The blockers" title="What prevents selling today" />
      <div class="mt-8 space-y-4">
        {blockers.map((b) => (
          <div class="rounded-xl border border-border bg-card p-5 flex gap-4">
            <div class="shrink-0 pt-1.5"><span class={"inline-block h-2.5 w-2.5 rounded-full " + b.dot} title={"urgency " + b.urgencia + "/10"}></span></div>
            <div class="flex-1 space-y-2">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs text-muted-foreground/50">{b.id}</span>
                <h3 class="font-display text-base text-foreground">{b.titulo}</h3>
                <span class="ml-auto font-mono text-xs text-muted-foreground">urgency {b.urgencia}/10</span>
              </div>
              <p class="text-sm text-muted-foreground">{b.desc}</p>
              <div class="rounded-lg bg-accent/5 border border-accent/20 px-4 py-2.5">
                <span class="text-xs text-accent font-mono uppercase tracking-wider">Concrete action → </span>
                <span class="text-sm text-foreground">{b.accion}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ICP RANKING -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="ICP — Who to sell to" title="Ranking of target profiles" />
      <p class="mt-2 max-w-[640px] text-sm text-muted-foreground">Based on the 100 simulations and the gap analysis. Combined score: adoption rate + speed to value + accessibility of the decision-maker.</p>

      <!-- Gráfico barras horizontal -->
      <div class="mt-8 space-y-3 max-w-[680px]">
        {icpRanking.map((icp) => {
          const classes = colorMap[icp.color];
          return (
            <div class="space-y-1">
              <div class="flex justify-between items-center text-sm">
                <span class="text-foreground font-medium">#{icp.rank} {icp.label}</span>
                <span class={`text-xs font-mono rounded-full border px-2.5 py-0.5 ${classes}`}>{icp.verdict}</span>
              </div>
              <div class="h-8 rounded-lg bg-border/20 overflow-hidden relative">
                <div
                  class={`h-full rounded-lg transition-all flex items-center px-3`}
                  style={`width:${icp.score}%; background: var(--bar-bg)`}
                  data-color={icp.color}
                >
                </div>
                <div class="absolute inset-0 flex items-center px-3 justify-between">
                  <span class="text-xs font-mono text-foreground/80">Adoption {icp.adoptionRate}%</span>
                  <span class="text-xs font-mono text-foreground/80">{icp.timeToValue} to value</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Detalle ICP top 3 -->
      <div class="mt-10 grid gap-5 sm:grid-cols-3">
        {icpRanking.slice(0, 3).map((icp) => {
          const classes = colorMap[icp.color];
          return (
            <div class={`rounded-xl border p-5 space-y-4 ${classes}`}>
              <div>
                <div class="text-xs font-mono uppercase tracking-wider opacity-70 mb-1">#{icp.rank} — {icp.verdict}</div>
                <h3 class="font-display text-base text-foreground">{icp.label}</h3>
              </div>
              <div class="space-y-2 text-sm text-muted-foreground">
                <div><span class="text-foreground font-medium">Decision-maker:</span> {icp.buyerProfile}</div>
                <div><span class="text-foreground font-medium">Budget:</span> {icp.budget}</div>
                <div><span class="text-foreground font-medium">Pain:</span> {icp.painPoint}</div>
                <div><span class="text-foreground font-medium">Buying signal:</span> {icp.signal}</div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- PROPUESTA DE VALOR POR BUYER -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="Sales message" title="What to say to each decision-maker" />
      <div class="mt-8 space-y-5">
        {valueProps.map((vp, i) => (
          <div class="rounded-xl border border-border bg-card p-6 grid sm:grid-cols-[200px_1fr] gap-6">
            <div>
              <div class="text-xs font-mono text-muted-foreground/60 uppercase tracking-wider mb-1">Decision-maker</div>
              <div class="font-display text-base text-accent">{vp.buyer}</div>
              <div class="mt-3 text-xs font-mono text-muted-foreground/60 uppercase tracking-wider mb-1">Their pain</div>
              <div class="text-sm text-muted-foreground italic">"{vp.pain}"</div>
            </div>
            <div class="space-y-3">
              <div>
                <div class="text-xs font-mono text-muted-foreground/60 uppercase tracking-wider mb-1">Your message</div>
                <p class="text-sm text-foreground leading-relaxed">{vp.message}</p>
              </div>
              <div class="rounded-lg bg-teal/10 border border-teal/20 px-4 py-2.5">
                <span class="text-xs text-accent font-mono uppercase tracking-wider">Promised KPI → </span>
                <span class="text-sm text-foreground">{vp.metric}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FUNNEL -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="Sales funnel" title="The target funnel" />
      <p class="mt-2 max-w-[640px] text-sm text-muted-foreground">Conservative projection for the first 12 months. Awareness → customer conversion: ~0.9%.</p>

      <div class="mt-8 max-w-[560px] space-y-2">
        {funnelStages.map((stage, i) => {
          const maxN = funnelStages[0].n;
          const pct = Math.round((stage.n / maxN) * 100);
          return (
            <div class="space-y-1">
              <div class="flex justify-between text-sm">
                <span class="text-foreground font-medium">{stage.label}</span>
                <span class="font-mono text-muted-foreground">{stage.n.toLocaleString()}</span>
              </div>
              <div class="h-9 rounded-lg bg-border/20 overflow-hidden">
                <div
                  class="h-full rounded-lg flex items-center px-4"
                  style={`width:${pct}%; background-color:${stage.color}25; border: 1px solid ${stage.color}50`}
                >
                  <span class="text-xs text-muted-foreground">{stage.desc}</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Conversion rates -->
      <div class="mt-6 flex flex-wrap gap-4 text-xs text-muted-foreground max-w-[560px]">
        <span>Awareness → Interest: <strong class="text-foreground">18%</strong></span>
        <span>Interest → Qualified: <strong class="text-foreground">30%</strong></span>
        <span>Qualified → Pilot: <strong class="text-foreground">33%</strong></span>
        <span>Pilot → Customer: <strong class="text-foreground">50%</strong></span>
      </div>
    </div>
  </section>

  <!-- PILOTO 8 SEMANAS -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="The sellable product" title="8-week pilot" />
      <p class="mt-2 max-w-[640px] text-sm text-muted-foreground">The entry format. Fixed price, defined deliverables, success criterion agreed before starting. Without this format, there is nothing to sell.</p>

      <div class="mt-8 grid gap-4 sm:grid-cols-4">
        {pilotWeeks.map((phase) => {
          const c = colorMap[phase.color];
          return (
            <div class={`rounded-xl border p-5 space-y-3 ${c}`}>
              <div>
                <div class="text-xs font-mono opacity-70">{phase.week}</div>
                <h3 class="font-display text-base text-foreground mt-0.5">{phase.label}</h3>
              </div>
              <ul class="space-y-1.5">
                {phase.tasks.map(t => (
                  <li class="flex gap-2 text-sm text-muted-foreground">
                    <span class="shrink-0 opacity-50">·</span>
                    {t}
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>

      <!-- Pricing -->
      <div class="mt-8 grid gap-4 sm:grid-cols-3 max-w-[720px]">
        <div class="rounded-xl border border-border bg-card p-5 space-y-2">
          <div class="text-xs font-mono text-muted-foreground/60 uppercase tracking-wider">Startup (&lt;15p)</div>
          <div class="text-2xl font-display font-bold text-foreground">€1.500</div>
          <div class="text-xs text-muted-foreground">8-week pilot · everything included</div>
        </div>
        <div class="rounded-xl border border-accent/40 bg-accent/5 p-5 space-y-2 relative">
          <div class="absolute -top-2.5 left-4 text-[0.6rem] font-mono uppercase tracking-wider bg-accent text-background px-2 py-0.5 rounded-full">Recommended</div>
          <div class="text-xs font-mono text-accent/70 uppercase tracking-wider">Startup (15–50p)</div>
          <div class="text-2xl font-display font-bold text-foreground">€3.500</div>
          <div class="text-xs text-muted-foreground">8-week pilot · with digital agent</div>
        </div>
        <div class="rounded-xl border border-border bg-card p-5 space-y-2">
          <div class="text-xs font-mono text-muted-foreground/60 uppercase tracking-wider">Agency / SME</div>
          <div class="text-2xl font-display font-bold text-foreground">€6.000</div>
          <div class="text-xs text-muted-foreground">8-week pilot · 2 agents + corp. mode</div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRÓXIMOS PASOS -->
  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-[1100px] px-6">
      <SectionHeader label="Action plan" title="The next 30 days" />
      <div class="mt-8 space-y-3 max-w-[720px]">
        {[
          { n: "01", plazo: "This week", accion: "Blind exposure protocol: 2 external people, 48h with no context. Observe without intervening.", owner: "Pablo + free Oracle" },
          { n: "02", plazo: "This week", accion: "Confirm ICP #1: CEO of a technical startup 5–15p. List 10 concrete contacts that fit.", owner: "Dark Council" },
          { n: "03", plazo: "Week 2", accion: "Create the sales deck with 5 concepts maximum. No Numinia in layer 1.", owner: "Alchemist-01" },
          { n: "04", plazo: "Week 2", accion: "Define the 3 pilot KPIs the client is going to measure. Without these there is no success criterion.", owner: "Dark Council" },
          { n: "05", plazo: "Week 3", accion: "First exploratory conversation with 3 contacts from ICP #1. It is not a demo — it is listening.", owner: "Pablo" },
          { n: "06", plazo: "Week 4", accion: "If there is a positive signal: formalised pilot proposal. Price, deliverables, criterion. Signature.", owner: "Pablo + legal Oracle" },
        ].map((step) => (
          <div class="flex gap-4 rounded-xl border border-border bg-card p-4">
            <div class="font-mono text-2xl font-bold text-accent/30 shrink-0 w-8 text-center">{step.n}</div>
            <div class="flex-1 space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-medium text-foreground">{step.accion}</span>
              </div>
              <div class="flex flex-wrap gap-4 text-xs text-muted-foreground">
                <span class="inline-flex items-center gap-1.5"><Icon name="calendar-blank" size={11} /> {step.plazo}</span>
                <span class="inline-flex items-center gap-1.5"><Icon name="user" size={11} /> {step.owner}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cierre -->
  <section class="border-t border-border py-20">
    <div class="mx-auto max-w-[1100px] px-6">
      <HighlightBox>
        <div class="space-y-3 text-sm leading-relaxed text-muted-foreground">
          <p>
            <strong class="text-accent">The only number that matters right now:</strong> 1. One real external client that has gone through the 8-week pilot and renewed. That case turns everything else — the one-pager, the deck, the simulations, the gap analysis — from theory into evidence. With evidence, the sales cycle is divided by three.
          </p>
          <p>
            The sequence is: blind validation → confirmed ICP → pilot sold → case documented → scale. There is no shortcut.
          </p>
        </div>
      </HighlightBox>
    </div>
  </section>
</Layout>

<style>
  [data-color="teal"] { background-color: rgb(45 212 191 / 0.2); border-left: 3px solid rgb(45 212 191 / 0.6); }
  [data-color="blue"] { background-color: rgb(96 165 250 / 0.2); border-left: 3px solid rgb(96 165 250 / 0.6); }
  [data-color="purple"] { background-color: rgb(167 139 250 / 0.2); border-left: 3px solid rgb(167 139 250 / 0.6); }
  [data-color="orange"] { background-color: rgb(251 146 60 / 0.15); border-left: 3px solid rgb(251 146 60 / 0.4); }
  [data-color="red"] { background-color: rgb(248 113 113 / 0.15); border-left: 3px solid rgb(248 113 113 / 0.4); }
</style>
