---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// Report detail rendered at build from reports/ (MIS-066 pattern). One
// route for every subtype — daily, audit, analysis, proposal — since the
// folder is flat and the subtype lives in frontmatter (ADR-005 v1.2.0).
// /audits/<id> (the historic address of the audits) redirects here since
// 2026-09-01: one folder, one collection, one head.
import { wordAttrs } from "@/lib/narrative-words.mjs";
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { repoFileUrl } from "@/lib/build-info";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const reports = await getCollection("reports");
  return reports.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const f = entry.data as Record<string, any>;
const mdFilename = (entry.filePath as string).split("/").pop()!;
const repoUrl = repoFileUrl(entry.filePath as string);
const mdUrl = `/reports/${entry.id}.md`;
const subtype = typeof f.subtype === "string" ? f.subtype : "report";
---

<Layout
  title={`${f.id} — Numen Games CAO`}
  description={f.title}
  canonicalPath={`/reports/${entry.id}`}
>
  <section class="pb-20 pt-16">
    <div class="mx-auto max-w-[800px] px-6">

      <a href="/reports" class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-dim hover:text-accent transition-colors mb-8">
        <Icon name="caret-left" size={12} />
        <span {...wordAttrs("Reports")}>Reports</span>
      </a>

      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="font-mono text-[0.65rem] text-accent">{f.id}</span>
        <span class="font-mono text-[0.6rem] text-dim">{String(f.created).slice(0, 10)}</span>
        <span class="inline-flex rounded-full border border-border bg-card px-2.5 py-0.5 font-mono text-[0.6rem] text-muted-foreground">{f.status}</span>
        <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim">{subtype}</span>
        {f.author && <span class="font-mono text-[0.6rem] text-dim">by {f.author}</span>}
      </div>

      <h1 class="font-display text-3xl sm:text-4xl text-foreground mb-8">{f.title}</h1>

      <DocToolbar mdUrl={mdUrl} filename={mdFilename} repoUrl={repoUrl} />
      <article class="mission-md rounded-[8px] border border-border bg-card p-6 sm:p-8">
        <Content />
      </article>

    </div>
  </section>
</Layout>

<style is:global>
  /* Same prose styling as mission detail pages (shared .mission-md class) */
  .mission-md > h1:first-child { display: none; }
  .mission-md h2 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgb(var(--accent));
    margin: 2rem 0 0.75rem;
  }
  .mission-md h2:first-of-type { margin-top: 0.5rem; }
  .mission-md h3 { font-size: 0.95rem; color: rgb(var(--text)); margin: 1.25rem 0 0.5rem; }
  .mission-md p { font-size: 0.875rem; line-height: 1.7; color: rgb(var(--text-muted)); margin: 0.5rem 0; }
  .mission-md ul, .mission-md ol { margin: 0.5rem 0 0.75rem; padding-left: 1.25rem; }
  .mission-md li { font-size: 0.875rem; line-height: 1.65; color: rgb(var(--text-muted)); margin: 0.35rem 0; }
  .mission-md ul { list-style: disc; }
  .mission-md ol { list-style: decimal; }
  .mission-md li > ul, .mission-md li > ol { margin: 0.25rem 0; }
  .mission-md input[type="checkbox"] { margin-right: 0.5rem; accent-color: rgb(var(--accent)); }
  .mission-md hr { border: 0; border-top: 1px solid rgb(var(--border)); margin: 1.5rem 0; }
  .mission-md blockquote {
    border-left: 2px solid rgb(var(--accent) / 0.35);
    padding-left: 1rem;
    margin: 0.75rem 0;
    font-style: italic;
  }
  .mission-md blockquote p { color: rgb(var(--text-muted)); }
  .mission-md code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background: rgb(var(--border) / 0.5);
    padding: 0.1em 0.35em;
    border-radius: 6px;
  }
  .mission-md pre { overflow-x: auto; padding: 1rem; border-radius: 8px; margin: 0.75rem 0; background: rgb(var(--bg-card-hover)); }
  .mission-md pre code { background: none; padding: 0; }
  .mission-md table { display: block; overflow-x: auto; font-size: 0.8rem; margin: 0.75rem 0; border-collapse: collapse; }
  .mission-md th, .mission-md td { border: 1px solid rgb(var(--border)); padding: 0.4rem 0.6rem; text-align: left; color: rgb(var(--text-muted)); }
  .mission-md th { font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgb(var(--text)); }
  .mission-md a { color: rgb(var(--accent)); text-decoration: underline; text-underline-offset: 2px; }
  .mission-md strong { color: rgb(var(--text)); }
</style>
