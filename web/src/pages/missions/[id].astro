---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// Mission detail rendered at build from the repo's flat missions/ folder
// (MIS-066). The full markdown body is the page — no client-side fetching.
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { repoFileUrl } from "@/lib/build-info";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("missions")).sort((a, b) =>
    (a.data.id as string).localeCompare(b.data.id as string)
  );
  return entries.map((entry, i) => ({
    params: { id: (entry.data.id as string).toLowerCase() },
    props: {
      entry,
      prevId: i > 0 ? (entries[i - 1].data.id as string) : null,
      nextId: i < entries.length - 1 ? (entries[i + 1].data.id as string) : null,
    },
  }));
}

const { entry, prevId, nextId } = Astro.props;
const { Content } = await render(entry);
const f = entry.data as Record<string, any>;
const missionId = (f.id as string).toUpperCase();
const mdFilename = (entry.filePath as string).split("/").pop()!;
const repoUrl = repoFileUrl(entry.filePath as string);
const mdUrl = `/missions/${missionId.toLowerCase()}.md`;

const PRIORITY_COLOR: Record<string, string> = {
  critical: "bg-red/10 text-red border border-red/20",
  high: "bg-accent/10 text-accent border border-accent/20",
  medium: "bg-yellow/10 text-yellow border border-yellow/20",
  low: "bg-green/10 text-green border border-green/20",
};
// Priority reads as a colored dot; type/status as house Phosphor glyphs (§7.3).
const PRIORITY_DOT: Record<string, string> = { critical: "bg-red", high: "bg-accent", medium: "bg-yellow", low: "bg-green" };
const TYPE_ICON: Record<string, string> = { biological: "dna", digital: "robot", hybrid: "git-branch" };
const TYPE_LABEL: Record<string, string> = { biological: "Biological", digital: "Digital", hybrid: "Hybrid" };
const STATUS_CLASS: Record<string, string> = {
  "backlog": "text-dim", "draft": "text-dim", "in-progress": "text-accent",
  "in-review": "text-yellow", "done": "text-green", "frozen": "text-dim", "cancelled": "text-dim",
};
const STATUS_ICON: Record<string, string> = {
  "backlog": "clipboard-text", "draft": "note-pencil", "in-progress": "lightning", "in-review": "eye",
  "done": "check", "frozen": "snowflake", "cancelled": "prohibit",
};
const STATUS_LABEL: Record<string, string> = {
  "backlog": "Backlog", "draft": "Draft", "in-progress": "In Progress",
  "in-review": "In Review", "done": "Done", "frozen": "Frozen", "cancelled": "Cancelled",
};

const status = (f.status as string) || "backlog";
const completed = f.completed ? String(f.completed).slice(0, 10) : null;
---

<Layout
  title={`${missionId} — Numen Games CAO`}
  description={`${missionId} — ${f.title}`}
  canonicalPath={`/missions/${missionId.toLowerCase()}`}
>
  <section class="pb-20 pt-16">
    <div class="mx-auto max-w-[800px] px-6">

      <a href="/missions" class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-dim hover:text-accent transition-colors mb-8">
        <Icon name="caret-left" size={12} />
        Mission Board
      </a>

      <!-- Header badges -->
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="font-mono text-[0.65rem] text-dim">{missionId}</span>
        <span class={"inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-[0.6rem] font-medium " + (PRIORITY_COLOR[f.priority] || "")}>
          <span class={"inline-block h-1.5 w-1.5 rounded-full " + (PRIORITY_DOT[f.priority] || "bg-border")}></span> {f.priority}
        </span>
        {f.type_execution && (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-2.5 py-0.5 font-mono text-[0.6rem] text-muted-foreground">
            <Icon name={TYPE_ICON[f.type_execution] || "git-branch"} size={10} /> {TYPE_LABEL[f.type_execution] || f.type_execution}
          </span>
        )}
        <span class="inline-flex rounded-full border border-border bg-card px-2.5 py-0.5 font-mono text-[0.6rem] text-muted-foreground">
          {f.effort}
        </span>
      </div>

      <!-- Title -->
      <h1 class="font-display text-3xl sm:text-4xl text-foreground mb-3">{f.title}</h1>

      <!-- Meta row -->
      <div class="flex flex-wrap gap-4 font-mono text-[0.7rem] text-dim mb-8">
        {(f.territory ?? f.area) && <span>Territory <span class="text-muted-foreground">{f.territory ?? f.area}</span></span>}
        {f.guild && <span>Guild <span class="text-muted-foreground">{f.guild}</span></span>}
        <span>Status <span class={"inline-flex items-center gap-1 " + (STATUS_CLASS[status] || "text-dim")}><Icon name={STATUS_ICON[status] || "clipboard-text"} size={11} /> {STATUS_LABEL[status] || status}</span></span>
        {f.assigned_to && f.assigned_to !== "null" && <span>Agent <span class="inline-flex items-center gap-1 text-muted-foreground"><Icon name="sword" size={11} /> {f.assigned_to}</span></span>}
        {completed && <span>Completed <span class="text-muted-foreground">{completed}</span></span>}
      </div>

      <!-- Full mission document -->
      <DocToolbar mdUrl={mdUrl} filename={mdFilename} repoUrl={repoUrl} />
      <article class="mission-md rounded-xl border border-border bg-card p-6 sm:p-8">
        <Content />
      </article>

      <!-- Nav -->
      <div class="flex justify-between border-t border-border pt-6 mt-8">
        {prevId
          ? <a href={"/missions/" + prevId.toLowerCase()} class="font-mono text-[0.7rem] text-dim hover:text-accent transition-colors">← {prevId}</a>
          : <span />}
        {nextId
          ? <a href={"/missions/" + nextId.toLowerCase()} class="font-mono text-[0.7rem] text-dim hover:text-accent transition-colors">{nextId} →</a>
          : <span />}
      </div>

    </div>
  </section>
</Layout>

<style is:global>
  /* Prose styling for the rendered mission markdown, matching the design system (STD-023) */
  .mission-md > h1:first-child { display: none; } /* page already renders the title */
  .mission-md h2 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgb(var(--accent));
    margin: 2rem 0 0.75rem;
  }
  .mission-md h2:first-of-type { margin-top: 0.5rem; }
  .mission-md h3 { font-size: 0.95rem; color: rgb(var(--text)); margin: 1.25rem 0 0.5rem; }
  .mission-md p { font-size: 0.875rem; line-height: 1.7; color: rgb(var(--text-muted)); margin: 0.5rem 0; }
  .mission-md ul, .mission-md ol { margin: 0.5rem 0 0.75rem; padding-left: 1.25rem; }
  .mission-md li { font-size: 0.875rem; line-height: 1.65; color: rgb(var(--text-muted)); margin: 0.35rem 0; }
  .mission-md ul { list-style: disc; }
  .mission-md ol { list-style: decimal; }
  .mission-md li > ul, .mission-md li > ol { margin: 0.25rem 0; }
  .mission-md input[type="checkbox"] { margin-right: 0.5rem; accent-color: rgb(var(--accent)); }
  .mission-md hr { border: 0; border-top: 1px solid rgb(var(--border)); margin: 1.5rem 0; }
  .mission-md blockquote {
    border-left: 2px solid rgb(var(--accent) / 0.35);
    padding-left: 1rem;
    margin: 0.75rem 0;
    font-style: italic;
  }
  .mission-md blockquote p { color: rgb(var(--text-muted)); }
  .mission-md code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background: rgb(var(--border) / 0.5);
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
  }
  .mission-md pre { overflow-x: auto; padding: 1rem; border-radius: 0.5rem; margin: 0.75rem 0; background: rgb(var(--bg-card-hover)); }
  .mission-md pre code { background: none; padding: 0; }
  .mission-md table { display: block; overflow-x: auto; font-size: 0.8rem; margin: 0.75rem 0; border-collapse: collapse; }
  .mission-md th, .mission-md td { border: 1px solid rgb(var(--border)); padding: 0.4rem 0.6rem; text-align: left; color: rgb(var(--text-muted)); }
  .mission-md th { font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgb(var(--text)); }
  .mission-md a { color: rgb(var(--accent)); text-decoration: underline; text-underline-offset: 2px; }
  .mission-md strong { color: rgb(var(--text)); }
</style>
