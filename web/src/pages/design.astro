---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// /design — the Numinia Design System, whole, on one page.
//
// WHY THIS PAGE EXISTS
// The system was one long guide and was cut into small documents so each
// could be read and changed alone. This page puts it back together for the
// reader who needs to see it whole — without writing it again. Every card is
// a row of SYS-009; every colour, size, font and duration drawn below is read
// from the kit's tokens; the animation list is STD-023's own table. Nothing
// here is typed by hand except the page's frame, so the page cannot drift from
// the documents: change them and it changes (@/lib/design-system).
//
// The parts not written yet — sound, most of play, how we write — are shown as
// gaps on purpose. A design system that hides its holes is a brochure.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import Icon from "@/components/Icon.astro";
import { repoFileUrl } from "@/lib/build-info";
import {
  entries, chapters, values, animations, PARTS, REGISTER, OPENING_QUOTE, DEFINITION,
} from "@/lib/design-system";
import { ZIP_NAME } from "@/lib/design-download";
import MotionCatalogue from "@/components/design/MotionCatalogue.astro";
import scarab from "@/brand/Khepri_Logo.svg?raw";

const all = entries();
const v = values();
const anim = animations().filter((a) => !a.retired);
const PIXEL = "/design/assets/pixel";
const PIXEL_REFS = [
  ["khepri-sprite-24@8x.png", "The scarab, 24 × 24"],
  ["cartografo-24@8x.png", "The Cartographer, 24 × 24"],
  ["moneda-12@8x.png", "The coin, 12 × 12"],
];
const PIXEL_PAIRS = ["contorno", "cluster", "diagonal", "luz", "tramado"].map((k) => ({
  k,
  yes: `${PIXEL}/guia/${k}-bien@8x.png`,
  no: `${PIXEL}/guia/${k}-mal@8x.png`,
}));
const PAIR_NAME: Record<string, string> = {
  contorno: "Outline", cluster: "Clusters", diagonal: "Diagonals", luz: "Light", tramado: "Dithering",
};
const gaps = all.filter((e) => e.path === null);
const docCount = all.filter((e) => e.document).length;

const PART_LINE: Record<string, string> = {
  Core: "What holds in every medium: why we exist, the three forces, the mix, the eras. A logo and a mission start here.",
  Languages: "The core translated to one sense each — image, word, sound, motion, play.",
  Recipes: "The languages applied to one medium: a web page, an invoice, a deck, a scene.",
  Toolkit: "What a maker installs or downloads.",
};

const fontCss: Record<string, string> = {
  sans: "var(--font-sans)",
  mono: "var(--font-mono)",
  serif: "'Alegreya DS', Georgia, serif",
  pixel: "'Pixelify DS', var(--font-sans)",
};
const fontUse: Record<string, string> = {
  sans: "Affirms. Every heading and body in the Umbral.",
  mono: "Measures. Labels, figures, code — tabular.",
  serif: "Narrates. Only the book and the codex.",
  pixel: "Speaks in scene. Only the pixel register.",
};
const px = (s: string) => (s.endsWith("rem") ? parseFloat(s) * 16 : parseFloat(s));
---

<Layout
  title="The Numinia Design System — NWOS"
  description={DEFINITION}
  canonicalPath="/design"
>
  <PageHero
    label="Design system"
    title="The Numinia Design System"
    description="Everything a piece of ours is made of — core, languages, recipes and tools — on one page, and in one download."
  />

  <section class="pb-24">
    <div class="mx-auto max-w-[1100px] px-6">

      <!-- His words open the page, signed (STD-021 CIT-055) -->
      <figure class="mb-10 max-w-[780px] border-l-2 border-accent pl-6">
        <blockquote class="font-display text-2xl leading-snug text-foreground sm:text-3xl">
          “{OPENING_QUOTE.text}”
        </blockquote>
        <figcaption class="mt-3 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-dim">
          — {OPENING_QUOTE.author}
          <span class="normal-case tracking-normal" title={OPENING_QUOTE.original}> · translated from the Spanish</span>
        </figcaption>
      </figure>

      <p class="mb-8 max-w-[780px] text-base leading-relaxed text-muted-foreground">
        {DEFINITION} It lives in {docCount} small documents so each can be read and changed alone; this page and the
        download join them, and are rebuilt from them every time one changes.
      </p>

      <!-- Who this page is for, in plain words -->
      <div class="mb-10 grid max-w-[900px] gap-3 sm:grid-cols-3">
        <div class="rounded-[8px] border border-border bg-card p-4">
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">If you design something</p>
          <p class="mt-1 text-xs leading-relaxed text-muted-foreground">Start here. Pick the recipe of your medium below; it tells you which colours, letters and motion to use and in what order.</p>
        </div>
        <div class="rounded-[8px] border border-border bg-card p-4">
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">If you are an AI</p>
          <p class="mt-1 text-xs leading-relaxed text-muted-foreground">Download the system: one document with every rule, plus the values in a file a machine reads (the <em>tokens</em>).</p>
        </div>
        <div class="rounded-[8px] border border-border bg-card p-4">
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">If you check a site</p>
          <p class="mt-1 text-xs leading-relaxed text-muted-foreground">The yes-or-no rules are in <a href="/standards/std-008-design-tokens" class="text-accent hover:underline">Design tokens</a>: every web has day and night, one footer, a closed palette.</p>
        </div>
      </div>

      <!-- The three words the page uses without stopping -->
      <dl class="mb-10 grid max-w-[900px] gap-x-6 gap-y-2 text-xs sm:grid-cols-2">
        <div><dt class="inline text-foreground">Umbral, Velo, Prisma</dt> <dd class="inline text-muted-foreground">— the three forces: the everyday surface (a page, an invoice), the deep one (the archive, glass and fog), and the world's own body (pixel and low-poly).</dd></div>
        <div><dt class="inline text-foreground">Nocturno, Diurno</dt> <dd class="inline text-muted-foreground">— night mode and day mode. Every web has both, with the moon and sun switch.</dd></div>
        <div><dt class="inline text-foreground">Tokens</dt> <dd class="inline text-muted-foreground">— each value (a colour, a size, a duration) with a name, in a file tools and AIs read.</dd></div>
        <div><dt class="inline text-foreground">Read alongside</dt> <dd class="inline text-muted-foreground">— a document linked from here but not part of the system, like the game manual.</dd></div>
      </dl>

      <div class="mb-12 flex flex-wrap items-center gap-4">
        <a
          href={`/design/${ZIP_NAME}`}
          download
          class="inline-flex min-h-[44px] items-center gap-2 rounded-[6px] bg-accent px-5 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-background transition-colors hover:bg-accent/85"
        >
          <Icon name="download-simple" size={14} />
          Download the system
        </a>
        <span class="font-mono text-[0.65rem] text-dim">
          .zip — the whole system as one document, every document on its own, tokens, kit, fonts, icons, brand, templates
        </span>
      </div>

      <div class="mb-12">
        <DocToolbar
          mdUrl="/design.md"
          filename="numinia-design-system.md"
          repoUrl={repoFileUrl(REGISTER)}
          lang="en"
        />
      </div>

      <!-- The map: four parts, one line each -->
      <nav aria-label="The parts of the system" class="mb-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {PARTS.map((p, i) => (
          <a href={`#${p.toLowerCase()}`} class="group rounded-[8px] border border-border bg-card p-5 transition-colors hover:border-accent/50">
            <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">{["I", "II", "III", "IV"][i]}</p>
            <p class="mt-1 font-display text-xl text-foreground group-hover:text-accent">{p}</p>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{PART_LINE[p]}</p>
          </a>
        ))}
      </nav>

      {PARTS.map((part, pi) => (
        <section id={part.toLowerCase()} class="mb-16 scroll-mt-24">
          <div class="mb-6 flex items-center gap-3">
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-accent">{["I", "II", "III", "IV"][pi]} · {part}</span>
            <span class="h-px flex-1 bg-border"></span>
          </div>
          <p class="mb-6 max-w-[780px] text-sm text-muted-foreground">{PART_LINE[part]}</p>

          <!-- What the page can DRAW of each part, before its documents -->
          {part === "Core" && (
            <div class="mb-8 grid gap-4 md:grid-cols-3">
              {[
                ["Solarpunk", "40 %", "2120 · the garden. The light, the whole day mode, the serenity."],
                ["Steampunk", "40 %", "1920 · the machine. Bronze, measure, the monospaced letter."],
                ["Cyberpunk", "20 %", "2020 · the signal. Accent, never ambience."],
              ].map(([n, pct, line]) => (
                <div class="rounded-[8px] border border-border bg-card p-5">
                  <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">{n}</p>
                  <p class="mt-1 font-display text-3xl text-foreground">{pct}</p>
                  <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{line}</p>
                </div>
              ))}
              <p class="md:col-span-3 font-mono text-[0.65rem] text-dim">
                Light dominates, the machine structures, the signal blinks. Three forces — the Umbral manifests, the Velo keeps, the Prisma unfolds.
                <a href="/canon/can-008-visual-identity" class="text-accent hover:underline">Read the identity →</a>
              </p>
            </div>
          )}

          {part === "Languages" && (
            <div class="mb-8 space-y-8">
              <!-- Colour -->
              <div>
                <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · the six colours</p>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
                  {v.brand.map((s) => (
                    <div class="overflow-hidden rounded-[8px] border border-border bg-card">
                      <div class="h-20" style={`background:${s.hex}`}></div>
                      <div class="p-3">
                        <p class="text-sm capitalize text-foreground">{s.name}</p>
                        <p class="font-mono text-[0.65rem] text-dim">{s.hex}</p>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="mt-3 grid gap-3 md:grid-cols-2">
                  {[["Nocturno", v.night], ["Diurno", v.day]].map(([label, list]) => (
                    <div class="rounded-[8px] border border-border bg-card p-4">
                      <p class="mb-2 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">{label as string}</p>
                      <div class="flex flex-wrap gap-2">
                        {(list as typeof v.night).map((s) => (
                          <span class="inline-flex items-center gap-2 font-mono text-[0.6rem] text-muted-foreground" title={s.name}>
                            <span class="inline-block h-5 w-5 rounded-[6px] border border-border" style={`background:${s.hex}`}></span>
                            {s.hex}
                          </span>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
                <div class="siempre-noche mt-3 rounded-[8px] border border-border bg-card p-4">
                  <p class="mb-2 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Rarity — never colour alone: the border grows and the name is written</p>
                  <div class="flex flex-wrap gap-2">
                    {v.rarity.map((s, i) => (
                      <span
                        class="inline-flex items-center rounded-[6px] px-3 py-1 font-mono text-[0.65rem] capitalize"
                        style={`color:${s.hex};border:1px solid ${i < 2 ? "rgb(var(--border))" : i < 4 ? s.hex + "66" : s.hex};${i === 5 ? "box-shadow:0 0 12px rgba(239,165,23,.25)" : ""}`}
                      >{s.name}</span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Type -->
              <div>
                <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · four voices</p>
                <div class="grid gap-3 md:grid-cols-2">
                  {v.fonts.map((f) => (
                    <div class="rounded-[8px] border border-border bg-card p-5">
                      <p class="text-3xl text-foreground" style={`font-family:${fontCss[f.name] ?? "inherit"}`}>{f.family}</p>
                      <p class="mt-1 text-lg text-muted-foreground" style={`font-family:${fontCss[f.name] ?? "inherit"}`}>Leave things better than you found them.</p>
                      <p class="mt-3 font-mono text-[0.6rem] text-dim">{f.name} · {fontUse[f.name] ?? f.stack}</p>
                    </div>
                  ))}
                </div>
                <div class="mt-3 rounded-[8px] border border-border bg-card p-5">
                  <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">The scale · 1.200 over 16 px</p>
                  <div class="space-y-1 overflow-hidden">
                    {v.sizes.slice(0, 7).map((s) => (
                      <p class="flex items-baseline gap-4 whitespace-nowrap">
                        <span class="w-24 shrink-0 font-mono text-[0.6rem] text-dim">{s.name}</span>
                        <span class="ds-scale text-foreground" style={`--size:${s.value}`}>Numinia</span>
                      </p>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Space and shape -->
              <div class="grid gap-3 md:grid-cols-2">
                <div class="rounded-[8px] border border-border bg-card p-5">
                  <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · space, on a 4 px scale</p>
                  <div class="flex flex-wrap items-end gap-2">
                    {v.space.map((s) => (
                      <div class="flex flex-col items-center gap-1">
                        <span class="block bg-accent/60" style={`width:${Math.min(px(s.value), 64) / 2}px;height:${Math.min(px(s.value), 128) / 2}px`}></span>
                        <span class="font-mono text-[0.55rem] text-dim">{parseInt(s.value)}</span>
                      </div>
                    ))}
                  </div>
                </div>
                <div class="rounded-[8px] border border-border bg-card p-5">
                  <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · two radii, the capsule, and square for the pixel</p>
                  <div class="flex flex-wrap items-end gap-6">
                    {v.radii.map((r) => (
                      <div class="flex flex-col items-center gap-2">
                        <span class="block h-14 w-20 border border-accent/70 bg-accent/10" style={`border-radius:${r.value}`}></span>
                        <span class="font-mono text-[0.6rem] text-dim">{r.name} · {parseInt(r.value) > 999 ? "capsule" : r.value}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Icons -->
              <div class="rounded-[8px] border border-border bg-card p-5">
                <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · the house icons — Phosphor, one family; thin and duotone never</p>
                <div class="flex flex-wrap gap-4 text-foreground">
                  {v.icons.map((name) => (
                    <span class="inline-flex flex-col items-center gap-1" title={name}>
                      <Icon name={name} size={24} />
                      <span class="font-mono text-[0.5rem] text-dim">{name}</span>
                    </span>
                  ))}
                </div>
              </div>

              <!-- Colour, continued: over light, data, pixel -->
              <div class="grid gap-3 md:grid-cols-3">
                <div class="rounded-[8px] border border-border p-4" style="background:#F9EBDC">
                  <p class="mb-2 font-mono text-[0.6rem] uppercase tracking-[0.2em]" style="color:#6E6259">Image · text over light</p>
                  {v.textOnLight.map((s) => (
                    <p class="text-sm" style={`color:${s.hex}`}><span class="capitalize">{s.name}</span> <span class="font-mono text-[0.6rem]">{s.hex}</span></p>
                  ))}
                  <p class="mt-2 text-[0.65rem] leading-relaxed" style="color:#4A423B">Coral has no text colour, on purpose: it would be a twin of grana.</p>
                </div>
                <div class="rounded-[8px] border border-border bg-card p-4">
                  <p class="mb-2 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · data — six series at most</p>
                  <div class="flex items-end gap-1.5 h-16">
                    {v.data.categorical.map((h, i) => <span class="flex-1 rounded-t-[2px]" style={`background:${h};height:${[90, 70, 55, 45, 35, 25][i]}%`}></span>)}
                  </div>
                  <div class="mt-3 flex h-3 overflow-hidden rounded-[2px]">{v.data.sequential.map((h) => <span class="flex-1" style={`background:${h}`}></span>)}</div>
                  <p class="mt-1 font-mono text-[0.55rem] text-dim">sequential</p>
                  <div class="mt-2 flex h-3 overflow-hidden rounded-[2px]">{v.data.divergent.map((h) => <span class="flex-1" style={`background:${h}`}></span>)}</div>
                  <p class="mt-1 font-mono text-[0.55rem] text-dim">divergent</p>
                </div>
                <div class="rounded-[8px] border border-border bg-card p-4">
                  <p class="mb-2 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · the Píxel-16 palette</p>
                  <div class="grid grid-cols-8 gap-1">
                    {v.pixel16.map((h, i) => <span class="aspect-square" style={`background:${h}`} title={`${String(i + 1).padStart(2, "0")} ${h}`}></span>)}
                  </div>
                  <p class="mt-2 text-[0.65rem] leading-relaxed text-muted-foreground">Sixteen colours and not one new hex: every sprite stays inside this index.</p>
                </div>
              </div>

              <!-- The brand -->
              <div class="grid gap-3 md:grid-cols-[1fr_2fr]">
                <div class="rounded-[8px] border border-border bg-card p-5">
                  <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · the scarab</p>
                  <div class="flex items-center gap-6">
                    <span class="ds-mark text-accent" set:html={scarab} />
                    <span class="ds-mark ds-mark-s text-foreground" set:html={scarab} />
                    <span class="rounded-[8px] p-3" style="background:#F9EBDC;color:#14110F"><span class="ds-mark ds-mark-s block" set:html={scarab} /></span>
                  </div>
                  <p class="mt-3 text-[0.65rem] leading-relaxed text-muted-foreground">Closing, favicon, avatar, seal. One colour, any colour of the palette — never a gradient.</p>
                </div>
                <div class="rounded-[8px] border border-border bg-card p-5">
                  <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · the binary speaks</p>
                  <p class="break-all font-mono text-[0.6rem] leading-relaxed tracking-[0.12em] text-dim"><span class="text-accent">{v.binary.bits.slice(0, 8 * 5)}</span>{v.binary.bits.slice(8 * 5)}</p>
                  <p class="mt-3 text-sm text-foreground">“{v.binary.phrase}”</p>
                  <p class="mt-1 text-[0.65rem] text-muted-foreground">The zeros and ones of the backgrounds are not noise: they spell the sentence every piece closes on, in 8-bit ASCII. The first word is lit.</p>
                </div>
              </div>

              <!-- The three forces, seen -->
              <div>
                <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · the three forces, as a surface</p>
                <div class="grid gap-3 md:grid-cols-3">
                  <div class="rounded-[8px] border border-border bg-card p-5">
                    <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Umbral — manifests</p>
                    <p class="mt-3 text-lg text-foreground">An invoice, a page, a deck.</p>
                    <button type="button" class="mt-4 inline-flex min-h-[36px] items-center rounded-[6px] px-4 font-mono text-[0.65rem] uppercase tracking-[0.15em] text-foreground" style="background:#017C8D">Action</button>
                    <p class="mt-3 text-[0.65rem] text-muted-foreground">Flat surfaces, hairlines, no shadows at night. The force that invoices.</p>
                  </div>
                  <div class="ds-velo relative overflow-hidden rounded-[8px] border border-border p-5" style={`--grid:${v.velo.grid};--fog:${v.velo.fog}`}>
                    <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Velo — keeps</p>
                    <div class="mt-3 rounded-[8px] p-4" style={`background:${v.velo.glass};border:1px solid ${v.velo.glassEdge};backdrop-filter:blur(12px)`}>
                      <p class="font-[Alegreya_DS,Georgia,serif] text-lg text-foreground" style="font-family:'Alegreya DS',Georgia,serif">What the archive kept.</p>
                    </div>
                    <p class="mt-3 text-[0.65rem] text-muted-foreground">No new colour, only transparency: a grid at 2.5 %, a fog at 6 %, glass.</p>
                  </div>
                  <div class="rounded-[8px] border border-border bg-card p-5">
                    <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Prisma — unfolds</p>
                    <div class="mt-3 flex items-end gap-4">
                      <img src={`${PIXEL}/cartografo-24@8x.png`} width="72" height="72" alt="The Cartographer, a 24-pixel character" class="ds-px" loading="lazy" />
                      <svg viewBox="0 0 60 60" width="72" height="72" aria-label="A low-poly facet" role="img">
                        <polygon points="30,4 56,22 46,54 14,54 4,22" fill="#292420" stroke="#3A332D"/>
                        <polygon points="30,4 56,22 30,30" fill="#A6DAD5"/><polygon points="30,4 4,22 30,30" fill="#018EA1"/>
                        <polygon points="4,22 14,54 30,30" fill="#016E7D"/><polygon points="56,22 46,54 30,30" fill="#EFA517"/>
                        <polygon points="14,54 46,54 30,30" fill="#7A5100"/>
                      </svg>
                    </div>
                    <p class="mt-3 text-[0.65rem] text-muted-foreground">Píxel in 2D, low-poly in 3D. You enter and leave it whole; the facets are shown, not hidden.</p>
                  </div>
                </div>
              </div>

              <!-- Pixel: references and how-yes / how-no -->
              <div class="rounded-[8px] border border-border bg-card p-5">
                <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · the pixel register — drawn at ×1, shown at ×8</p>
                <div class="flex flex-wrap items-end gap-6">
                  {PIXEL_REFS.map(([f, label]) => (
                    <figure class="text-center">
                      <img src={`${PIXEL}/${f}`} alt={label} class="ds-px mx-auto" style="height:96px;width:auto" loading="lazy" />
                      <figcaption class="mt-1 font-mono text-[0.55rem] text-dim">{label}</figcaption>
                    </figure>
                  ))}
                  <figure class="text-center">
                    <span class="ds-coin" role="img" aria-label="The coin turning, four frames at 200 ms"></span>
                    <figcaption class="mt-1 font-mono text-[0.55rem] text-dim">The turn · 4 frames · 200 ms</figcaption>
                  </figure>
                </div>
                <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-5">
                  {PIXEL_PAIRS.map((pp) => (
                    <div>
                      <p class="mb-1 font-mono text-[0.55rem] uppercase tracking-[0.15em] text-dim">{PAIR_NAME[pp.k]}</p>
                      <div class="flex gap-1">
                        <figure class="flex-1"><img src={pp.yes} alt={`${PAIR_NAME[pp.k]}, done right`} class="ds-px w-full" loading="lazy" /><figcaption class="font-mono text-[0.55rem] text-green">yes</figcaption></figure>
                        <figure class="flex-1"><img src={pp.no} alt={`${PAIR_NAME[pp.k]}, done wrong`} class="ds-px w-full" loading="lazy" /><figcaption class="font-mono text-[0.55rem] text-red">no</figcaption></figure>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- The mode switch, live (STD-037 SIT-003) -->
              <div class="rounded-[8px] border border-border bg-card p-5">
                <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · day and night — every web has both</p>
                <div class="grid gap-4 md:grid-cols-[auto_1fr] md:items-center">
                  <div class="ds-modes" data-modo-demo="nocturno">
                    <div class="ds-mode-bar">
                      <span class="ds-mode-name">numinia</span>
                      <button type="button" class="ds-mode-btn" aria-label="Switch to day mode">
                        <span class="ds-to-day"><Icon name="sun" size={20} /></span>
                        <span class="ds-to-night"><Icon name="moon-stars" size={20} /></span>
                      </button>
                    </div>
                    <p class="ds-mode-h">Leave things better than you found them.</p>
                    <p class="ds-mode-b">A page in the mode you chose. The button shows where a tap takes you.</p>
                    <span class="ds-mode-link">Read the recipe →</span>
                  </div>
                  <ul class="space-y-2 text-xs leading-relaxed text-muted-foreground">
                    <li><span class="text-foreground">The icon shows where you go, not where you are:</span> the sun takes you to the day, the moon with stars to the night. Try it.</li>
                    <li><span class="text-foreground">Until you choose, the page follows your device</span> — it turns to night when your phone does.</li>
                    <li><span class="text-foreground">Once you choose, it remembers</span>, and paints the right mode from the first instant, with no flash.</li>
                    <li><span class="text-foreground">Pixel scenes and the Velo keep their night</span> inside a day page, framed.</li>
                    <li><a href="/blueprints/web-pieces" class="text-accent hover:underline">The switch in the web recipe →</a></li>
                  </ul>
                </div>
              </div>

              <!-- Focus and elevation -->
              <div class="grid gap-3 md:grid-cols-2">
                <div class="rounded-[8px] border border-border bg-card p-5">
                  <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · focus — always visible, never animated</p>
                  <span class="inline-flex min-h-[36px] items-center rounded-[6px] border border-border px-4 text-sm text-foreground" style="outline:2px solid #018EA1;outline-offset:2px">Focused control</span>
                  <p class="mt-3 text-[0.65rem] text-muted-foreground">2 px of Turquesa, 2 px away. Non-negotiable.</p>
                </div>
                <div class="rounded-[8px] border border-border bg-card p-5">
                  <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Image · elevation — by step, not by shadow</p>
                  <div class="flex gap-2">
                    {v.night.slice(0, 3).map((s) => <span class="siempre-noche flex h-14 flex-1 items-end rounded-[8px] border border-border p-2 font-mono text-[0.55rem] text-dim" style={`background:${s.hex}`}>{s.name.replace("fondo ", "")}</span>)}
                  </div>
                  <p class="mt-3 text-[0.65rem] text-muted-foreground">At night a surface rises one step lighter; the legendary halo is the only glow.</p>
                </div>
              </div>

              <!-- Motion, running -->
              <div>
                <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">Motion · the catalogue, running — {anim.length} in use, and no more</p>
                <MotionCatalogue />
                <p class="mt-3 text-[0.65rem] text-dim">
                  Every duration above is the kit's own token. With reduced motion set on your device, every card shows its end state and nothing moves.
                </p>
              </div>
            </div>
          )}

          <!-- The documents of the part, chapter by chapter -->
          <div class="grid gap-4 md:grid-cols-2">
            {chapters(all, part).map(({ chapter, entries: es }) => (
              <div class={`rounded-[8px] border p-5 ${es.every((e) => e.path === null) ? "border-dashed border-border/70" : "border-border bg-card"}`}>
                <p class="mb-3 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim">{chapter}</p>
                <ul class="space-y-3">
                  {es.map((e) => (
                    <li>
                      {e.path === null ? (
                        <p class="text-sm text-dim"><span class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-yellow">Not written yet</span> — {e.gives.replace(/^Not written yet:\s*/, "")}</p>
                      ) : (
                        <>
                          <a href={e.href!} class="text-sm text-foreground hover:text-accent" {...(e.href!.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                            {e.title}
                          </a>
                          <p class="text-xs leading-relaxed text-muted-foreground">{e.linked ? <span class="font-mono text-[0.55rem] uppercase tracking-[0.15em] text-dim">Read alongside · linked, not in the download</span> : e.gives}</p>
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      ))}

      {gaps.length > 0 && (
        <div class="rounded-[8px] border border-border bg-card p-6 max-w-[780px]">
          <p class="mb-3 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">What the system does not cover yet</p>
          <ul class="space-y-2 text-sm text-muted-foreground">
            {gaps.map((g) => <li><span class="text-foreground">{g.part} · {g.chapter}</span> — {g.gives.replace(/^Not written yet:\s*/, "")}</li>)}
          </ul>
          <p class="mt-4 text-xs text-dim">
            This page is drawn from <a href="/system/sys-009-the-design-system" class="text-accent hover:underline">the design system register</a>;
            the values from the kit's tokens. A gap closes when its document is written and its row names it.
          </p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  @font-face { font-family: "Alegreya DS"; src: url("/design/assets/fonts/Alegreya-Variable.woff2") format("woff2"); font-display: swap; }
  @font-face { font-family: "Pixelify DS"; src: url("/design/assets/fonts/PixelifySans-Variable.woff2") format("woff2"); font-display: swap; }
  .ds-mark :global(svg) { width: 56px; height: 56px; display: block; }
  .ds-mark-s :global(svg) { width: 32px; height: 32px; }
  /* Pixels stay pixels: nearest-neighbour, never smoothed (STD-023 §16). */
  .ds-px { image-rendering: pixelated; image-rendering: crisp-edges; }
  .ds-velo {
    background:
      radial-gradient(circle at 0% 100%, var(--fog), transparent 70%),
      repeating-linear-gradient(0deg, var(--grid) 0 1px, transparent 1px 40px),
      repeating-linear-gradient(90deg, var(--grid) 0 1px, transparent 1px 40px),
      #14110F;
  }
  /* The coin's turn: the sheet is 4 frames of 12 px; shown at ×8. */
  .ds-coin {
    display: block; width: 96px; height: 96px; margin: 0 auto;
    background: url("/design/assets/pixel/moneda-giro-12x4.png") 0 0 / 384px 96px no-repeat;
    image-rendering: pixelated; animation: ds-coin 800ms steps(4) infinite;
  }
  @keyframes ds-coin { to { background-position: -384px 0; } }
  /* The scale at its true size, shrunk only where the phone cannot hold it. */
  .ds-scale { font-size: min(var(--size), 11vw); line-height: 1.15; }
  @media (prefers-reduced-motion: reduce) {
    .ds-coin { animation: none; }
  }
  /* The mode switch specimen: Nocturno and Diurno from STD-023 §2. */
  .ds-modes {
    --m-bg: #14110F; --m-surf: #1E1A17; --m-line: #3A332D; --m-ink: #F9EBDC; --m-ink2: #C4B5A6; --m-link: #A6DAD5;
    width: min(360px, 100%); border: 1px solid var(--m-line); border-radius: 8px; background: var(--m-bg); color: var(--m-ink);
    padding: 0 0 18px; transition: background 320ms linear, color 320ms linear, border-color 320ms linear;
  }
  .ds-modes[data-modo-demo="diurno"] {
    --m-bg: #F9EBDC; --m-surf: #FDF6EE; --m-line: #E2D3C2; --m-ink: #14110F; --m-ink2: #4A423B; --m-link: #016E7D;
  }
  .ds-mode-bar { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid var(--m-line); background: var(--m-surf); border-radius: 8px 8px 0 0; }
  .ds-mode-name { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .15em; text-transform: uppercase; }
  .ds-mode-btn { display: inline-flex; width: 36px; height: 36px; align-items: center; justify-content: center; border-radius: 6px; color: var(--m-ink); }
  .ds-mode-btn:focus-visible { outline: 2px solid #018EA1; outline-offset: 2px; }
  .ds-to-night { display: none; }
  .ds-modes[data-modo-demo="diurno"] .ds-to-day { display: none; }
  .ds-modes[data-modo-demo="diurno"] .ds-to-night { display: inline-flex; }
  .ds-mode-h { padding: 16px 16px 0; font-size: 1.05rem; }
  .ds-mode-b { padding: 6px 16px 0; font-size: .75rem; color: var(--m-ink2); }
  .ds-mode-link { display: inline-block; padding: 10px 16px 0; font-size: .75rem; color: var(--m-link); }
  @media (prefers-reduced-motion: reduce) { .ds-modes { transition: none; } }
</style>

<script>
  // The specimen switches itself only; the page stays in the site's mode.
  document.querySelectorAll<HTMLElement>("[data-modo-demo]").forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>(".ds-mode-btn")!;
    btn.addEventListener("click", () => {
      const day = box.dataset.modoDemo !== "diurno";
      box.dataset.modoDemo = day ? "diurno" : "nocturno";
      btn.setAttribute("aria-label", day ? "Switch to night mode" : "Switch to day mode");
    });
  });
</script>
