---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// / — the threshold: what this place is, why it exists, and the six doors in.
//
// WHAT THIS PAGE USED TO BE, AND WHY IT CHANGED
// Until today the home opened with "One producer, one fonds, six functions"
// and spent its next two screens on the filing vocabulary and a table of all
// eighteen series. Every word of it was true and generated from the
// standards, and it taught the plumbing before the house: a reader who does
// not already know what a fonds is met the word in the first line.
//
// `PRI-002` → Verbal Identity settles the register this page owes: the voice
// is "cultivated, plain and clear", technicisms are avoided where possible,
// and there are three declared levels of language — colloquial, literary,
// technical. So the page DESCENDS: it opens literary (the threshold), lands
// colloquial (the pain, the doors), and leaves the technical level where it
// belongs, inside the documents.
//
// Two things it now says that it never said, both principles and both the reason
// anyone stays past the first screen:
//   - THE PAIN. Documents scattered, interests in keeping some unfindable,
//     an organisation that stops knowing itself. Without it the archive reads
//     as bureaucracy; with it, as the answer to something the reader has
//     lived.
//   - HOW A DOCUMENT ANNOUNCES ITSELF. Every file opens with Epistemic and
//     Pragmatic — what you learn, what you can do with it (`STD-004`). The
//     home now shows one real header, read from the file at build time
//     (@/lib/doc-header), instead of describing the corpus in the abstract.
//
// WHAT STAYED. The six functions as a first sweep and the relation graph: a
// reader who thinks in structures enters through them, and the Oracle keeps
// them deliberately. WHAT LEFT. The vocabulary block, the table of eighteen
// rows and the second-fonds note now live at /scheme — the same page, nothing
// deleted, one click away, for the reader who has decided to evaluate rather
// than to arrive.
//
// Nothing about the classification is written on this page: the functions,
// their activities and their series all come from STD-027 and STD-001 via
// @/lib/classification, as before. The figures come from the instrument.
import Layout from "@/layouts/Layout.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import SummaColumns from "@/components/SummaColumns.astro";
import { headerOf } from "@/lib/doc-header";
import { dataset } from "@/lib/telemetry";
import { VERSION, repoFileUrl } from "@/lib/build-info";
import { BOOKS, LENSES } from "@/lib/summa";

// 2026-09-28 — THE ARCHIVE PAGE. The Archive button in the bar opens this
// page; since the drop-down left the bar, the four blocks, the books and the
// sister sites live only here (@/components/SummaColumns). What left: the six-function
// cards and the relation graph, a second map of the same archive in an older
// vocabulary that disagreed with the rings; they live on at /scheme and
// /archive/<function>. What left too: the welcome, which the home already
// says. What stayed is what only this page says.

const SHOWN = {
  path: "standards/STD-027-the-classification-scheme.md",
  title: "The classification scheme",
  id: "STD-027",
  href: "/standards/std-027-the-classification-scheme",
  series: "standards/",
};
const shown = headerOf(SHOWN.path);

const figure = (k: string) => dataset.figures.find((f) => f.key === k);
const docsTotal = figure("corpus.docs_total")?.value as number | undefined;
const missionsTotal = figure("missions.total")?.value as number | undefined;
const measuredAt = dataset.measured_at?.slice(0, 10);
import { wordAttrs, textAttrs } from "@/lib/narrative-words.mjs";
---

<Layout
  title="The archive — every series of Numen Games"
  description="The archive where Numinia's source of truth lives: the rules, the work, the world and the offer, as files, open to read."
  canonicalPath="/about"
>
  <section class="pb-8 pt-14 sm:pt-20">
    <div class="mx-auto max-w-[1100px] px-6">
      <span class="mb-3 inline-block font-mono text-[0.7rem] font-medium uppercase tracking-[0.25em] text-accent" {...wordAttrs("The archive")}>The archive</span>
      <h1 id="thesis" data-tecleo class="font-display text-4xl tracking-tight text-foreground sm:text-5xl" {...textAttrs("about.thesis")}>
        Every series, in <span class="text-yellow">four</span> blocks.
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground" data-nw-lead {...textAttrs("about.lead")}>
        One of two ways to move through the archive. The <a href="/" class="text-accent hover:underline">map</a>{" "}
        lets you explore it; this page takes you straight to a series.
      </p>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">
        Every framed name below is a button: rest on it to read what it is, click to go in. Dashed
        ones are not written yet.
      </p>
      <div class="mt-6">
        <DocToolbar mdUrl="/about.md" filename="about.md" repoUrl={repoFileUrl(SHOWN.path)} lang="en" />
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="mx-auto max-w-[1100px] px-6">
      <div class="mb-10"><SummaColumns /></div>

      <!-- What the old drop-down carried and the page did not: the books and
           the sister sites (2026-09-28). Buttons, like the blocks above. -->
      <div class="mb-16 grid gap-6 lg:grid-cols-2">
        <div class="rounded-[8px] border border-border bg-card/60 p-5">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-1">Books</p>
          <p class="text-sm text-muted-foreground mb-3">Documents from several series gathered to read or hear end to end.</p>
          <div class="flex flex-wrap gap-2">
            {BOOKS.map((b) => b.href
              ? <a href={b.href} class="pill" title={b.line}>{b.label} →</a>
              : <span class="pill todo" title={b.pending}>{b.label} · soon</span>)}
          </div>
        </div>
        <div class="rounded-[8px] border border-border bg-card/60 p-5">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-1">Our other sites</p>
          <p class="text-sm text-muted-foreground mb-3">Each one shows a part of this archive to the people it is for.</p>
          <div class="flex flex-wrap gap-2">
            {LENSES.map((l) => <a href={l.href} rel="noopener" class="pill" title={`${l.who}. ${l.line}`}>{l.site} ↗</a>)}
          </div>
        </div>
      </div>

      <div class="mb-4 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Before you open a door</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 mb-16">
        <div class="rounded-[8px] border border-border bg-card p-6">
          <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.15em] text-accent mb-2">Who writes this?</h2>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Numen Games S.L., a studio in Spain building a narrative operating system for the way
            organisations work. We are the first organisation running on it, so this archive is our
            documentation and our evidence at once: if it does not work for us, it does not work.
          </p>
        </div>
        <div class="rounded-[8px] border border-border bg-card p-6">
          <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.15em] text-accent mb-2">Numinia and NWOS?</h2>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Two names for one thing. NWOS is the machine: files in a git repository, one
            classification, checks that refuse a change breaking the rules. Numinia is the story it is
            told through — a city where tasks are missions and roles are characters.
          </p>
        </div>
        <div class="rounded-[8px] border border-border bg-card p-6">
          <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.15em] text-accent mb-2">What state is it in?</h2>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Early, and openly so. Most documents say <code class="font-mono text-xs text-foreground">draft</code>:
            rules on trial during the alpha, followed but never blocking. <a href="/binding" class="text-accent hover:underline">What binds today</a>{" "}
            lists the few that do; what is broken is in <a href="/debt/" class="text-accent hover:underline">the debt register</a>,
            what changed in <a href="/updates/" class="text-accent hover:underline">Updates</a>.
          </p>
        </div>
        <div class="rounded-[8px] border border-border bg-card p-6">
          <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.15em] text-accent mb-2">What can you do with it?</h2>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Read all of it, and take it: every page hands you its file to copy or download, and each
            file states its own licence. Would you rather talk first? Write to{" "}
            <a href="mailto:hola@numengames.com" class="text-accent hover:underline">hola@numengames.com</a> — a person answers.
          </p>
        </div>
      </div>

      <div class="mb-4 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">How a document announces itself</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px] mb-16 items-start">
        <a href={SHOWN.href} class="rounded-[8px] border border-border bg-card p-6 block hover:border-accent/50 transition-colors group">
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim mb-2">{SHOWN.series}</p>
          <h3 class="font-display text-xl text-foreground mb-4 group-hover:text-accent transition-colors">
            {SHOWN.title} <span class="font-mono text-sm text-dim">({SHOWN.id})</span>
          </h3>
          <dl class="space-y-3 border-l-2 border-accent/30 pl-4">
            <div><dt class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-accent mb-1">What it is</dt><dd class="text-sm text-muted-foreground leading-relaxed">{shown.summary}</dd></div>
            <div><dt class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-accent mb-1">What you learn</dt><dd class="text-sm text-muted-foreground leading-relaxed">{shown.epistemic}</dd></div>
            <div><dt class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-accent mb-1">What you can do with it</dt><dd class="text-sm text-muted-foreground leading-relaxed">{shown.pragmatic}</dd></div>
          </dl>
        </a>
        <div class="text-sm text-muted-foreground leading-relaxed">
          <p>Every document tells you, before you start, what you will learn from it and what it lets you do. Nothing asks to be read on faith.</p>
          <p class="mt-3">Not everything is here: what is under someone else's licence or would expose a person stays out, and where a document is withheld the archive says so instead of leaving a gap.</p>
        </div>
      </div>

      <div class="rounded-[8px] border border-yellow/20 bg-yellow/5 p-6 max-w-[780px]">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-yellow mb-3">Under construction</p>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Khepri pushes the sun up every morning and raises it again: nothing here is taken as finished,
          it is written again. Leave things better than we found them.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-yellow/20 pt-4 font-mono text-[0.65rem] text-dim">
          {docsTotal !== undefined && <span><span class="text-foreground">{docsTotal.toLocaleString("en-US")}</span> documents</span>}
          {missionsTotal !== undefined && <span><span class="text-foreground">{missionsTotal.toLocaleString("en-US")}</span> missions</span>}
          {measuredAt && <span>measured <span class="text-foreground">{measuredAt}</span></span>}
          <span class="text-foreground">{VERSION}</span>
          <a href="/telemetry" class="text-accent hover:underline">every figure →</a>
          <a href="/scheme" class="text-accent hover:underline">how it is classified →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Typing (catalogue 01): 22 ms per character, block cursor in Ámbar. The
  // full sentence is in the DOM before this runs and stays readable to
  // assistive tech through aria-label while the characters appear. Reduced
  // motion: the text simply is.
  const el = document.querySelector<HTMLElement>("[data-tecleo]");
  const rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (el && !rm) {
    el.setAttribute("aria-label", el.textContent ?? "");
    const nodes: { node: Text; text: string }[] = [];
    (function walk(n: Node) {
      n.childNodes.forEach((c) => {
        if (c.nodeType === Node.TEXT_NODE) { nodes.push({ node: c as Text, text: c.nodeValue ?? "" }); c.nodeValue = ""; }
        else walk(c);
      });
    })(el);
    const cur = document.createElement("span");
    cur.className = "inline-block w-[0.55em] h-[1em] align-[-0.1em] bg-yellow animate-cursor";
    cur.setAttribute("aria-hidden", "true");
    el.appendChild(cur);
    let i = 0, j = 0;
    (function step() {
      if (i >= nodes.length) { setTimeout(() => { cur.remove(); el.removeAttribute("aria-label"); }, 900); return; }
      const n = nodes[i];
      if (j < n.text.length) { n.node.nodeValue += n.text[j++]; n.node.parentNode?.appendChild(cur); setTimeout(step, 22); }
      else { i++; j = 0; step(); }
    })();
  }
</script>

<style>
  /* Block cursor (catalogue 08): 1 s, steps(2). */
  @keyframes cursor { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
  .animate-cursor { animation: cursor 1s steps(2, start) infinite; }
  .pill { display: inline-flex; align-items: center; min-height: 40px; padding: 6px 14px; border: 1px solid rgb(var(--border)); border-radius: 6px; background: rgb(var(--bg)); color: rgb(var(--text)); font-size: .9375rem; transition: border-color .15s, background-color .15s, color .15s; }
  a.pill:hover, a.pill:focus-visible { border-color: rgb(var(--accent)); background: rgb(var(--accent) / .08); color: rgb(var(--accent)); }
  .pill.todo { border-style: dashed; background: transparent; color: rgb(var(--text-muted)); }
  @media (prefers-reduced-motion: reduce) { .animate-cursor { animation: none; } }
</style>
