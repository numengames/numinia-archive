---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// MIS-111 — a real index per corpus section.
//
// Before this, /canon/ existed with a <title> reading "Canon — Index"
// and ZERO links to its 12 documents: an artefact of the catch-all detail
// route, not a written page. /protocols/ did not exist at all — the
// asymmetry that proved these were never indexes.
//
// Every row is derived from the corpus at build time. Nothing is listed by
// hand: a hand-written index is D-031 again, and it goes stale the first time
// a document is added.
//
// WHAT THIS PAGE GAINED ON 2026-09-21
// Two things the registry at /decisions already had and these six did not:
//
//   1. THE ROW CARRIES ITS METADATA. `getSectionDocs` has always returned
//      `docId`, `status` and `updated`; the template rendered only the title
//      and threw the rest away. So a reader could see that STD-014 exists but
//      not whether it is active, draft or withdrawn — the single most useful
//      fact about a governing document, sitting one property away, unprinted.
//
//   2. THE SECTION SAYS WHAT QUESTION IT ANSWERS, and what its own silence
//      means. Every document here opens with its purpose; the folder had no
//      equivalent, which is why an empty /debt/ read as a broken page rather
//      than as good news.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { repoFileUrl } from "@/lib/build-info";
import { SECTIONS, getSectionDocs, countWithheld, READING_NOTE, READING_GROUPS, SECTION_VIEWS } from "@/lib/corpus";
import { placeOf, functions } from "@/lib/classification";

// The site's own pages under a section, checked against the folder that
// holds them — see SECTION_VIEWS in @/lib/corpus. `import.meta.glob` is
// resolved at build time: the keys are the files that exist.
const builtViews = new Set(
  Object.keys(import.meta.glob("/src/pages/*/*.astro")).map((f) => f.replace(/^\/src\/pages/, "").replace(/\.astro$/, "")),
);
for (const [slug, views] of Object.entries(SECTION_VIEWS)) {
  const listed = new Set(views.map((v) => v.href));
  const onDisk = [...builtViews].filter((f) => f.startsWith(`/${slug}/`) && !/\/\[/.test(f) && !f.endsWith("/index"));
  const missing = onDisk.filter((f) => !listed.has(f));
  const dead = [...listed].filter((f) => !builtViews.has(f));
  if (missing.length || dead.length) {
    throw new Error(
      `SECTION_VIEWS["${slug}"] disagrees with web/src/pages/${slug}/: ` +
        (missing.length ? `pages with no row (unreachable again): ${missing.join(", ")}. ` : "") +
        (dead.length ? `rows with no page: ${dead.join(", ")}. ` : "") +
        `Update the table in web/src/lib/corpus.ts.`,
    );
  }
}

export async function getStaticPaths() {
  return Promise.all(
    SECTIONS.map(async (section) => ({
      params: { section: section.slug },
      props: {
        section,
        docs: await getSectionDocs(section.slug),
        withheld: await countWithheld(section.slug),
      },
    })),
  );
}

// WHERE THIS DRAWER SITS (2026-09-21). The label above the title used to
// read "CAO · NWOS" on every index — the same words on every drawer, saying
// nothing about which one is open. Now it is the place in the scheme:
// "Governance · Standardising". Read from the classification, so a section
// whose folder the scheme does not classify fails the build rather than
// printing a label from memory.
function place(prefix: string): { label: string; fnSlug: string; fnHref: string } {
  const p = placeOf(prefix);
  if (!p) {
    throw new Error(
      `[section].astro: the section "${prefix}" is not a series of STD-027 and the index cannot say ` +
        `where it sits. Add it to the scheme or take it out of SECTIONS (web/src/lib/corpus.ts).`,
    );
  }
  return { label: `${p.fn.name} · ${p.activity.name}`, fnSlug: p.fn.slug, fnHref: p.fn.href };
}

// The same three colours the decision registry uses, and for the same reason:
// a status is a traffic light, not a word to read. `active` and `done` are the
// green of "this governs / this happened"; `draft` and `proposed` the amber of
// "not yet"; `withdrawn` and `superseded` the grey of "no longer".
const STATUS_COLOR: Record<string, string> = {
  active: "text-green",
  done: "text-green",
  accepted: "text-green",
  draft: "text-yellow",
  proposed: "text-yellow",
  review: "text-yellow",
  withdrawn: "text-dim",
  superseded: "text-dim",
  deprecated: "text-dim",
  retired: "text-dim",
};

const { section, docs, withheld } = Astro.props;
const note = READING_NOTE[section.slug];

// READING GROUPS (2026-09-24). A section that declares groups renders its
// rows under a numeral, a label and one line — the shelf a stranger needs
// before the titles mean anything. The groups are the source of the reading
// order for that section (see READING_GROUPS in @/lib/corpus), so every doc
// the order knows lands in exactly one group; anything the story does not
// mention yet falls to a last, unlabelled run, visible rather than absorbed.
const groups = READING_GROUPS[section.slug];
const byHref = new Map(docs.map((d) => [d.href.replace(/\/$/, ""), d]));
const shelves = groups
  ? [
      ...groups.map((g) => ({ ...g, docs: g.hrefs.map((h) => byHref.get(h)).filter(Boolean) as typeof docs })),
      ...(() => {
        const placed = new Set(groups.flatMap((g) => g.hrefs));
        const rest = docs.filter((d) => !placed.has(d.href.replace(/\/$/, "")));
        return rest.length ? [{ numeral: "", label: "", line: "", hrefs: [], docs: rest }] : [];
      })(),
    ]
  : [{ numeral: "", label: "", line: "", hrefs: [], docs }];
const here = place(section.prefix);
const views = SECTION_VIEWS[section.slug] ?? [];
// The strip at the foot groups every section by function, in the scheme's
// order — the same six drawers the bar shows, so a reader who came in
// through one door sees the others from any index.
const strip = functions().map((fn) => ({
  fn,
  sections: fn.activities.flatMap((a) => a.series).map((s) => SECTIONS.find((sec) => sec.prefix === s.folder)).filter(Boolean),
})).filter((g) => g.sections.length > 0);
---

<Layout
  title={`${section.label} — NWOS, the archive of Numen Games`}
  description={section.blurb}
  canonicalPath={`/${section.slug}/`}
  activeNav={section.prefix}
>
  <PageHero
    label={here.label}
    title={section.label}
    description={section.blurb}
  />

  <section class="pb-24">
    <div class="mx-auto max-w-[800px] px-6 space-y-10">
      {/*
        The same four affordances every document detail view offers: listen,
        copy, download, source. This page has no file behind it — it is
        composed from the registers — so the .md is generated by
        @/lib/composed-md and `Source` points at the register that governs
        the content, not at the template that draws it (STD-001, the series).
      */}
      <DocToolbar
        mdUrl={`/${section.slug}.md`}
        filename={`${section.slug}.md`}
        repoUrl={repoFileUrl("standards/STD-001-the-series.md")}
        lang="en"
      />

      {/*
        The question the folder answers, in the reader's words. It sits above
        everything else because it is what decides whether the reader is in the
        right folder at all — including when the list below is empty.
      */}
      <div class="rounded-xl border border-accent/20 bg-accent/5 px-5 py-4">
        <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-accent mb-1.5">
          The question this answers
        </p>
        <p class="text-base leading-snug text-foreground">{section.question}</p>
      </div>

      {/*
        What the reader understands after this folder, and what they can then
        do with it — the same pair every document in the archive opens with.
        A folder that only states its question tells you whether you are in
        the right place; this tells you what you are leaving with.
      */}
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-muted-foreground mb-1.5">
            Epistemic
          </p>
          <p class="text-sm leading-relaxed text-muted-foreground">{section.epistemic}</p>
        </div>
        <div>
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-muted-foreground mb-1.5">
            Pragmatic
          </p>
          <p class="text-sm leading-relaxed text-muted-foreground">{section.pragmatic}</p>
        </div>
      </div>

      {/*
        The axis note — canon, standards and protocols only.

        `STD-024` SER-001 and SER-002 draw the line that decides whether a
        sentence in this archive can put a reader in breach, and it cannot be
        learnt from any single folder: it exists only in the comparison. So
        the three that oblige carry it, and the eight that record stay quiet.

        The middle sentence is SER-002 verbatim. It is a binding rule quoted
        on a page, not a paraphrase — if the rule changes, this changes with
        it.
      */}
      {section.axis && (
        <div class="rounded-xl border border-border bg-card px-5 py-4 space-y-2">
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-muted-foreground">
            These three bind; the rest record
          </p>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Canon says <em>why</em>, standards say <em>what</em>, protocols say <em>how</em>.
          </p>
          <p class="text-sm leading-relaxed text-foreground">
            A standard is complied with by an artifact; a protocol is executed
            by an actor. The boundary is the mechanism, not the topic.
          </p>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Everywhere else in this archive records what happened, what was
            decided or what exists — and a record cannot put you in breach.
          </p>
        </div>
      )}

      {/*
        The rights regime, when it is not the archive's default. It sits
        directly under the question and above the rows, because it changes what
        a reader may DO with what follows and is worthless after they have read
        it. Amber, not green: this is a limit, not a permission.
      */}
      {section.rights && (
        <div class="rounded-xl border border-yellow/30 bg-yellow/5 px-5 py-4">
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-yellow mb-1.5">
            Rights
          </p>
          <p class="text-sm leading-relaxed text-muted-foreground">{section.rights}</p>
        </div>
      )}

      {/*
        The rows below are NOT in identifier order (see READING_ORDER in
        lib/corpus.ts). Without this line a reader assumes the list is
        arbitrary, or worse, broken. One sentence turns a reordering into
        an invitation.
      */}
      {note && (
        <p class="text-sm leading-relaxed text-muted-foreground border-l-2 border-accent/40 pl-4">
          {note}
        </p>
      )}

      {docs.length > 0 && shelves.map((shelf) => (
        <div class="space-y-2">
          {shelf.label && (
            <div class="pt-4 pb-1">
              <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-accent">
                <span class="mr-3">{shelf.numeral}</span>{shelf.label}
              </p>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{shelf.line}</p>
            </div>
          )}
          {shelf.docs.map((item) => (
            <a
              href={item.href}
              class="block rounded-lg border border-border bg-card px-4 py-3 hover:bg-card-hover transition-colors"
            >
              <span class="block text-sm text-foreground leading-snug">{item.title}</span>
              {item.question && (
                <span class="block mt-1 text-sm leading-snug text-muted-foreground">{item.question}</span>
              )}
              {/*
                Identifier, date and status on one quiet line under the title and
                its question: a newcomer reads what a document is for before
                its code, date or status. Each cell is
                omitted when the document does not carry the field rather than
                rendered empty: a blank slot reads as missing data, and most
                of these documents simply have no status to report.
              */}
              {(item.docId || item.updated || item.status) && (
                <div class="flex flex-wrap items-center gap-3 mt-1.5">
                  {item.docId && (
                    <span class="font-mono text-[0.65rem] text-accent">{item.docId}</span>
                  )}
                  {item.updated && (
                    <span class="font-mono text-[0.6rem] text-dim">{item.updated}</span>
                  )}
                  {item.status && (
                    <span
                      class={
                        "font-mono text-[0.6rem] uppercase tracking-widest " +
                        (STATUS_COLOR[item.status.toLowerCase()] || "text-dim")
                      }
                    >
                      {item.status}
                    </span>
                  )}
                </div>
              )}
            </a>
          ))}
        </div>
      ))}

      {/*
        AN EMPTY SECTION IS TWO DIFFERENT FACTS, and they must not be printed
        with the same words.

        `withheld > 0`  the documents exist and are not published. Saying
                        "nothing is outstanding" here would be false.
        `withheld = 0`  the folder is genuinely empty. For debt and blueprints
                        that is a legitimate, even good, state — so the section
                        says so in its own words instead of looking broken.
      */}
      {/*
        The site's own pages about this drawer — views it draws, not documents
        of the series. Listed after the documents and said to be what they are,
        so a reader does not take a dashboard for a record. See SECTION_VIEWS.
      */}
      {views.length > 0 && (
        <div class="space-y-3 border-t border-border/50 pt-8">
          <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-dim">
            Views the site draws about this — not documents of the series
          </h2>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Pages rendered by the site, some from reports, some written by hand. Filed in this drawer on
            2026-09-21 so they can be reached; what to keep of each is still to be decided.
          </p>
          <div class="space-y-2">
            {views.map((v) => (
              <a
                href={v.href}
                hreflang={v.lang}
                class="block rounded-lg border border-border/60 bg-card/60 px-4 py-3 hover:bg-card-hover transition-colors"
              >
                <div class="flex flex-wrap items-center gap-3 mb-1">
                  <span class="font-mono text-[0.65rem] text-dim">{v.href}</span>
                  {v.lang && <span class="font-mono text-[0.6rem] uppercase tracking-widest text-yellow">{v.lang}</span>}
                </div>
                <span class="text-sm text-foreground leading-snug">{v.title}</span>
                <span class="block text-xs text-muted-foreground mt-1">{v.what}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      {docs.length === 0 && withheld > 0 && (
        <p class="font-mono text-[0.7rem] text-dim leading-relaxed">
          This section holds {withheld} document{withheld === 1 ? "" : "s"} that this
          site does not publish: they exist in the repository and do not declare
          <code>visibility: public</code>, so the build does not serve them (MIS-114).
          Nothing here is missing — it is withheld, and this line is the record of that.
        </p>
      )}

      {docs.length === 0 && withheld === 0 && (
        <div class="rounded-xl border border-green/20 bg-green/5 px-5 py-4">
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-green mb-1.5">
            Empty, and that is the answer
          </p>
          <p class="text-sm leading-relaxed text-muted-foreground">
            {section.emptyMeans ??
              "This section publishes nothing yet. The folder exists and the page is built from it, so the day a document lands here it appears on its own."}
          </p>
        </div>
      )}

      <nav class="border-t border-border/50 pt-6 space-y-4" aria-label="Sections by function">
        <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-accent">
          The other drawers
        </h2>
        {strip.map((g) => (
          <div class="flex flex-wrap items-center gap-2">
            <a
              href={g.fn.href}
              class={
                "inline-flex min-h-[44px] items-center font-mono text-[0.6rem] uppercase tracking-[0.15em] mr-1 transition-colors " +
                (g.fn.slug === here.fnSlug ? "text-foreground border-b-2 border-yellow" : "text-dim hover:text-foreground")
              }
            >
              {g.fn.name}
            </a>
            {g.sections.map((s) => (
              <a
                href={`/${s!.slug}/`}
                class={
                  "inline-flex min-h-[44px] items-center rounded-[6px] border px-3 font-mono text-[0.7rem] transition-colors " +
                  (s!.slug === section.slug
                    ? "border-accent/40 bg-accent/10 text-accent"
                    : "border-border bg-card text-dim hover:bg-card-hover")
                }
              >
                {s!.label}
              </a>
            ))}
          </div>
        ))}
        <a
          href="/"
          class="inline-flex min-h-[44px] items-center font-mono text-[0.65rem] uppercase tracking-[0.15em] text-dim hover:text-foreground transition-colors"
        >
          ← How the archive is classified
        </a>
      </nav>
    </div>
  </section>
</Layout>
