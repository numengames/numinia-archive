---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";

// External scale is 1–5 (MIS-055 v1.2.0): five named levels per dial.
// Internally each level maps to the 1–10 config scale: 1·3·5·7·10.
const levels = [
  {
    n: 1,
    name: "Business",
    subtitle: "Pure operational language. No metaphors.",
    color: "#8a7d72",
    bg: "bg-[#8a7d72]/8",
    border: "border-[#8a7d72]/25",
    dot: "bg-[#8a7d72]",
    who: "Traditional companies, corporate teams, skeptical C-suites.",
    feel: "\"This is a work management system with structured documentation and AI agents.\"",
  },
  {
    n: 2,
    name: "Functional",
    subtitle: "Light metaphors. Familiar structure with a distinct voice.",
    color: "#efa517",
    bg: "bg-[#efa517]/8",
    border: "border-[#efa517]/25",
    dot: "bg-[#efa517]",
    who: "Agencies, creative studios, scale-ups with culture already.",
    feel: "\"We run initiatives through guilds, with agents that keep institutional memory alive.\"",
  },
  {
    n: 3,
    name: "Mixed",
    subtitle: "Half-narrative. Familiar enough to onboard fast, interesting enough to retain.",
    color: "#8fc46b",
    bg: "bg-[#8fc46b]/8",
    border: "border-[#8fc46b]/25",
    dot: "bg-[#8fc46b]",
    who: "Tech startups, DAOs, companies building culture intentionally.",
    feel: "\"Our missions run through Knowledge Leads and Innovation Leads, tracked in the Archive.\"",
  },
  {
    n: 4,
    name: "Narrative",
    subtitle: "Rich vocabulary. The system has character.",
    color: "#a98be0",
    bg: "bg-[#a98be0]/8",
    border: "border-[#a98be0]/25",
    dot: "bg-[#a98be0]",
    who: "Gaming companies, Web3 teams, organizations that want meaning at work.",
    feel: "\"Exégetas and Alquimistas run missions together, reporting to the Council.\"",
  },
  {
    n: 5,
    name: "Numinia",
    subtitle: "Full immersion. The city is the system.",
    color: "#a6dad5",
    bg: "bg-[#a6dad5]/8",
    border: "border-[#a6dad5]/25",
    dot: "bg-[#a6dad5]",
    who: "Numen Games. Organizations ready for a complete narrative operating system.",
    feel: "\"The Guardián de las Puertas runs the Dark Council. The Oráculos govern from the Archive Summa.\"",
  },
];

const gamifLevels = [
  { n: 1, name: "None", desc: "Just the OS. No mechanics of any kind.", color: "#8a7d72" },
  { n: 2, name: "Visibility", desc: "Dashboards, streaks, progress %", color: "#8fc46b" },
  { n: 3, name: "Achievement", desc: "Badges, milestones, celebration", color: "#efa517" },
  { n: 4, name: "Progression", desc: "Ranks, reputation, history", color: "#efa517" },
  { n: 5, name: "Full Economy", desc: "Tokens, Prism Cells, real weight", color: "#a6dad5" },
];

// Mechanics unlock cumulatively with the gamification dial.
const mechanics = [
  { from: 2, label: "Dashboards · progress % · streaks" },
  { from: 3, label: "Badges · milestones · the system celebrates" },
  { from: 4, label: "Ranks · reputation · the system remembers" },
  { from: 5, label: "Tokens · Prism Cells · real economic weight" },
];

const vocab = [
  {
    category: "Agents & Roles",
    rows: [
      { concept: "Executive", l1: "Executive", l2: "Founder", l3: "Council Lead", l4: "Arconte", l5: "Oráculo" },
      { concept: "Operations Lead", l1: "Head of Operations", l2: "Operations Lead", l3: "Operations Lead", l4: "Centinela", l5: "Centinela" },
      { concept: "CTO / Innovation", l1: "CTO / Head of Product", l2: "Innovation Lead", l3: "Innovation Lead", l4: "Alquimista", l5: "Alquimista" },
      { concept: "Chief of Staff / Knowledge", l1: "Chief of Staff", l2: "Knowledge Lead", l3: "Knowledge Lead", l4: "Exégeta", l5: "Exégeta" },
      { concept: "COO / Business", l1: "Head of Business", l2: "Business Lead", l3: "Business Lead", l4: "Procurador", l5: "Procurador" },
      { concept: "AI Orchestration", l1: "AI Orchestration Layer", l2: "System Intelligence", l3: "System Intelligence", l4: "Procyon", l5: "Procyon" },
      { concept: "AI Agent", l1: "AI Agent", l2: "Digital Coworker", l3: "Digital Agent", l4: "Agente Digital", l5: "Agente Digital" },
      { concept: "New member", l1: "Onboarding", l2: "New member", l3: "Explorer", l4: "Nómada", l5: "Nómada" },
      { concept: "Team member", l1: "Team Member", l2: "Member", l3: "Citizen", l4: "Ciudadano", l5: "Ciudadano" },
      { concept: "Senior", l1: "Senior / Principal", l2: "Senior Member", l3: "Pilgrim", l4: "Peregrino", l5: "Peregrino" },
      { concept: "Expert", l1: "Expert / Principal", l2: "Expert", l3: "Expert", l4: "Vernáculo", l5: "Vernáculo" },
      { concept: "Director / Lead", l1: "Director / Lead", l2: "Lead", l3: "Archon", l4: "Arconte", l5: "Arconte" },
    ],
  },
  {
    category: "Structures",
    rows: [
      { concept: "Department / Team", l1: "Department", l2: "Team", l3: "Guild", l4: "Gremio", l5: "Gremio" },
      { concept: "Division / Area", l1: "Division", l2: "Area", l3: "Faction", l4: "Facción", l5: "Facción" },
      { concept: "Operations Center", l1: "Operations Center", l2: "Ops Center", l3: "CAO", l4: "CAO", l5: "CAO" },
      { concept: "System Blueprint", l1: "System Blueprint", l2: "System Map", l3: "Blueprint", l4: "Plano", l5: "Plano" },
      { concept: "Knowledge Base", l1: "Knowledge Base", l2: "Knowledge Base", l3: "Archive", l4: "Archivo", l5: "Archive Summa" },
      { concept: "Decision Record", l1: "Decision Record", l2: "Decision Record", l3: "Decision Stone", l4: "Decisión", l5: "Piedra del Camino" },
      { concept: "Report", l1: "Report", l2: "Report", l3: "Dispatch", l4: "Reporte", l5: "Reporte" },
      { concept: "Process / SOP", l1: "Process / SOP", l2: "Protocol", l3: "Protocol", l4: "Protocolo", l5: "Protocolo" },
    ],
  },
  {
    category: "Actions & Rituals",
    rows: [
      { concept: "Project / Initiative", l1: "Project", l2: "Initiative", l3: "Mission", l4: "Misión", l5: "Misión" },
      { concept: "Daily Standup", l1: "Daily Standup", l2: "Daily", l3: "Daily", l4: "Daily", l5: "Daily" },
      { concept: "Weekly Strategy", l1: "Weekly Strategy Meeting", l2: "Strategy Session", l3: "Council", l4: "Dark Council", l5: "Dark Council" },
      { concept: "Creative Session", l1: "Creative Session", l2: "Creative Session", l3: "Coven", l4: "Lunar Coven", l5: "Lunar Coven" },
      { concept: "Onboarding Workshop", l1: "Onboarding", l2: "Onboarding Workshop", l3: "Session Zero", l4: "Session Zero", l5: "Session Zero" },
      { concept: "Campaign / Program", l1: "Program", l2: "Campaign", l3: "Adventure", l4: "Aventura", l5: "Aventura" },
      { concept: "Quarter / Cycle", l1: "Quarter", l2: "Cycle", l3: "Season", l4: "Temporada", l5: "Temporada" },
    ],
  },
  {
    category: "System & Product",
    rows: [
      { concept: "Work Operating System", l1: "Work Operating System", l2: "Work OS", l3: "Narrative Work OS", l4: "Narrative Work OS", l5: "Narrative Work OS" },
      { concept: "The Organization", l1: "The Organization", l2: "The System", l3: "The City", l4: "Numinia", l5: "Numinia" },
      { concept: "Membership Token", l1: "Membership Token", l2: "Access Token", l3: "Prism Cell", l4: "Prism Cell", l5: "Prism Cell" },
      { concept: "Badge / Certificate", l1: "Badge", l2: "Achievement", l3: "Seal", l4: "Sello", l5: "Sello" },
    ],
  },
];

const colColors = levels.map((l) => l.color);
const colNames = levels.map((l) => `${l.n} · ${l.name}`);

// Data handed to the configurator script.
const narrData = levels.map(({ n, name, color, feel }) => ({ n, name, color, feel }));
const gamifData = gamifLevels.map(({ n, name, color, desc }) => ({ n, name, color, desc }));
const mechData = mechanics;
---

<Layout
  title="Narrative Dial — Language System · Numen Games"
  description="Two dials, five levels each. Organizations choose their level of narrative and gamification. The NWOS speaks any language."
  canonicalPath="/idioma"
  activeNav="idioma"
>

  <!-- Hero -->
  <section class="pt-16 pb-12 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Numen Games · NWOS · Adaptability</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl text-foreground mb-4">Two Dials. One System.</h1>
      <p class="text-lg text-muted-foreground leading-relaxed">
        The Narrative Work OS speaks any language. Each organization sets two dials from 1 to 5 — how much narrative, how much gamification. The system is the same — the vocabulary and the mechanics adapt.
      </p>
    </div>
  </section>

  <!-- Configurator -->
  <section class="py-16 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="mb-8 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Try it — set your dials</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 mb-6">
        <!-- Narrative selector -->
        <div class="rounded-2xl border border-accent/30 bg-accent/5 p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-accent"><Icon name="mask-happy" size={20} /></span>
              <h2 class="font-display text-lg text-foreground">Narrative</h2>
            </div>
            <span id="narr-readout" class="font-mono text-[0.7rem]"></span>
          </div>
          <div id="narr-buttons" class="flex gap-2" role="radiogroup" aria-label="Narrative level (1 to 5)">
            {levels.map((l) => (
              <button
                type="button"
                role="radio"
                data-dial="narr"
                data-level={l.n}
                aria-checked="false"
                class="dial-btn flex-1 rounded-lg border border-border py-2 font-mono text-sm text-muted-foreground transition-colors"
                style={`--lvl-color: ${l.color}`}
                title={l.name}
              >{l.n}</button>
            ))}
          </div>
        </div>

        <!-- Gamification selector -->
        <div class="rounded-2xl border border-[#efa517]/25 bg-[#efa517]/5 p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="text-[#efa517]"><Icon name="game-controller" size={20} /></span>
              <h2 class="font-display text-lg text-foreground">Gamification</h2>
            </div>
            <span id="gamif-readout" class="font-mono text-[0.7rem]"></span>
          </div>
          <div id="gamif-buttons" class="flex gap-2" role="radiogroup" aria-label="Gamification level (1 to 5)">
            {gamifLevels.map((l) => (
              <button
                type="button"
                role="radio"
                data-dial="gamif"
                data-level={l.n}
                aria-checked="false"
                class="dial-btn flex-1 rounded-lg border border-border py-2 font-mono text-sm text-muted-foreground transition-colors"
                style={`--lvl-color: ${l.color}`}
                title={l.name}
              >{l.n}</button>
            ))}
          </div>
        </div>
      </div>

      <!-- Live preview -->
      <div id="config-preview" class="rounded-xl border p-6 transition-colors" aria-live="polite">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-1">Your configuration</p>
        <p class="font-display text-xl mb-4"><span id="preview-title" class="text-foreground"></span></p>
        <p id="preview-feel" class="text-sm italic text-muted-foreground border-l-2 pl-3 mb-5"></p>
        <div id="preview-mechanics" class="grid sm:grid-cols-2 gap-x-6 gap-y-1.5"></div>
        <p class="font-mono text-[0.55rem] text-dim mt-5">Internal config scale (1–10): narrative <span id="preview-internal-narr"></span> · gamification <span id="preview-internal-gamif"></span></p>
      </div>
    </div>
  </section>

  <!-- The two dials -->
  <section class="py-16 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="mb-8 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">The two dials</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <!-- Narrative dial -->
        <div class="rounded-2xl border border-accent/30 bg-accent/5 p-7">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-accent"><Icon name="mask-happy" size={24} /></span>
            <div>
              <h2 class="font-display text-xl text-foreground">Narrative Dial</h2>
              <p class="font-mono text-[0.6rem] text-dim">1 → 5</p>
            </div>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed mb-5">
            Controls vocabulary and semantic identity. At 1, it's a business tool. At 5, you're inside a living world.
          </p>
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[0.6rem] text-[#8a7d72]">1 — Business</span>
              <span class="font-mono text-[0.6rem] text-[#8a7d72]">"Project Management"</span>
            </div>
            <div class="h-2 rounded-full bg-gradient-to-r from-[#8a7d72] via-[#8fc46b] to-[#a6dad5]"></div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-[0.6rem] text-[#a6dad5]">5 — Numinia</span>
              <span class="font-mono text-[0.6rem] text-[#a6dad5]">"Misiones del Oráculo"</span>
            </div>
          </div>
        </div>

        <!-- Gamification dial -->
        <div class="rounded-2xl border border-[#efa517]/25 bg-[#efa517]/5 p-7">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-[#efa517]"><Icon name="game-controller" size={24} /></span>
            <div>
              <h2 class="font-display text-xl text-foreground">Gamification Dial</h2>
              <p class="font-mono text-[0.6rem] text-dim">1 → 5 · five named thresholds</p>
            </div>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed mb-5">
            Gamification has qualitative jumps, not a smooth curve. Five named thresholds. Independent from the narrative dial.
          </p>
          <div class="space-y-2 mb-4">
            {gamifLevels.map((t) => (
              <div class="flex items-center gap-3" data-gamif-row={t.n}>
                <span class="font-mono text-[0.6rem] w-4 text-right flex-shrink-0" style={`color: ${t.color}`}>{t.n}</span>
                <div class="h-1.5 flex-1 rounded-full" style={`background: ${t.color}30`}>
                  <div class="h-full rounded-full" style={`width: ${(t.n / 5) * 100}%; background: ${t.color}80`}></div>
                </div>
                <span class="font-mono text-[0.6rem] w-24 flex-shrink-0" style={`color: ${t.color}`}>{t.name}</span>
                <span class="font-mono text-[0.55rem] text-dim hidden sm:block">{t.desc}</span>
              </div>
            ))}
          </div>
          <p class="font-mono text-[0.55rem] text-dim italic">Externally 1–5; internally each level maps to the 1–10 config scale (1·3·5·7·10)</p>
        </div>
      </div>

      <!-- Both dials are independent -->
      <div class="mt-6 rounded-xl border border-border bg-card/50 p-5">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-3">The dials are independent</p>
        <div class="grid sm:grid-cols-3 gap-4 text-sm text-muted-foreground">
          <div><Icon name="buildings" size={14} class="inline-block align-[-2px]" /> <strong class="text-foreground">Corp standard</strong><br/>Narrative 1 · Gamification 1<br/><span class="text-xs">Pure business tool</span></div>
          <div><Icon name="game-controller" size={14} class="inline-block align-[-2px]" /> <strong class="text-foreground">Gaming company</strong><br/>Narrative 2 · Gamification 5<br/><span class="text-xs">Gamified but business language</span></div>
          <div><Icon name="moon" size={14} class="inline-block align-[-2px]" /> <strong class="text-foreground">Numinia</strong><br/>Narrative 5 · Gamification TBD<br/><span class="text-xs">Full immersion</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- The 5 narrative levels -->
  <section class="py-16 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="mb-8 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Narrative Dial — 5 levels</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <div class="space-y-4">
        {levels.map((level) => (
          <div class={`rounded-xl border ${level.border} ${level.bg} p-5 transition-shadow`} data-narr-card={level.n}>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 text-center w-10">
                <div class={`w-8 h-8 rounded-full ${level.dot} mx-auto mb-1 flex items-center justify-center`}>
                  <span class="font-display text-sm text-background font-bold">{level.n}</span>
                </div>
              </div>
              <div class="flex-1">
                <div class="flex flex-wrap items-baseline gap-2 mb-2">
                  <h3 class="font-display text-lg" style={`color: ${level.color}`}>{level.name}</h3>
                  <span class="font-mono text-[0.6rem] text-muted-foreground">{level.subtitle}</span>
                </div>
                <p class="text-xs text-muted-foreground mb-2"><strong class="text-foreground/70">Who:</strong> {level.who}</p>
                <p class="text-xs italic text-muted-foreground border-l-2 pl-3" style={`border-color: ${level.color}40`}>{level.feel}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Full vocabulary table -->
  <section class="py-16 border-b border-border">
    <div class="mx-auto max-w-[1100px] px-6">
      <div class="mb-8 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Vocabulary map</span>
        <span class="h-px flex-1 bg-border"></span>
        <span class="font-mono text-[0.6rem] text-dim">Same concept · 5 languages</span>
      </div>

      <div class="space-y-10">
        {vocab.map((section) => (
          <div>
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.15em] text-dim mb-3">{section.category}</p>
            <div class="rounded-xl border border-border overflow-hidden">
              <!-- Header -->
              <div class="grid bg-card/80 border-b border-border" style="grid-template-columns: 1.4fr repeat(5, 1fr)">
                <div class="px-4 py-2.5">
                  <span class="font-mono text-[0.55rem] uppercase tracking-[0.15em] text-dim">Concept</span>
                </div>
                {colNames.map((name, i) => (
                  <div class="px-3 py-2.5 text-center vocab-cell" data-vocab-level={i + 1}>
                    <span class="font-mono text-[0.55rem] font-medium" style={`color: ${colColors[i]}`}>{name}</span>
                  </div>
                ))}
              </div>
              <!-- Rows -->
              {section.rows.map((row, ri) => (
                <div
                  class={`grid border-b border-border/50 last:border-0 ${ri % 2 === 0 ? "" : "bg-card/30"}`}
                  style="grid-template-columns: 1.4fr repeat(5, 1fr)"
                >
                  <div class="px-4 py-2.5">
                    <span class="text-xs text-foreground/60">{row.concept}</span>
                  </div>
                  {[row.l1, row.l2, row.l3, row.l4, row.l5].map((val, i) => (
                    <div class="px-3 py-2.5 text-center vocab-cell" data-vocab-level={i + 1}>
                      <span class="font-mono text-[0.6rem]" style={`color: ${colColors[i]}cc`}>{val}</span>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why this matters -->
  <section class="py-16 border-b border-border">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="mb-6 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Why this changes everything</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {[
          {
            title: "Narrative is a feature, not a requirement",
            desc: "The system works at dial 1. No lore needed. Organizations that want the narrative can unlock it — organizations that don't can ignore it completely.",
          },
          {
            title: "Solves the first-impression problem",
            desc: "A traditional C-suite sees a structured work OS with AI agents. A gaming studio sees a living narrative world. Same system. Different entry points.",
          },
          {
            title: "Gamification is independent",
            desc: "A company can have full gamification (ranks, achievements, tokens) at narrative level 1. The mechanics don't require the metaphors.",
          },
          {
            title: "Numinia is the reference, not the constraint",
            desc: "Numinia (5/5) is what full adoption looks like. It's the vision, not the requirement. Every organization starts wherever they are.",
          },
        ].map((item) => (
          <div class="rounded-xl border border-border bg-card p-5">
            <p class="font-semibold text-sm text-foreground mb-2">{item.title}</p>
            <p class="text-xs text-muted-foreground leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Status -->
  <section class="py-12">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="rounded-xl border border-yellow/20 bg-yellow/5 p-6">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-yellow mb-3 flex items-center gap-1.5"><Icon name="lightning" size={11} /> Work in progress — MIS-055</p>
        <p class="text-sm text-muted-foreground leading-relaxed mb-3">
          This page documents a system design proposal that emerged from the Dark Council on 2026-04-06. On 2026-08-18 the external scale was fixed at 1–5 per dial (five named levels), mapped internally to the 1–10 config scale. The vocabulary table above is a first proposal — it will evolve.
        </p>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Once validated, this becomes <strong class="text-foreground">DEC-006</strong> — a decision that modifies the NWOS architecture to include the two-dial system as a standard configuration parameter.
        </p>
        <div class="flex flex-wrap gap-3 mt-4">
          <!-- MIS-055 was deleted in the alpha-focus cut (RPT-017 v0.4.0) and
               its redirect led to that report, which says nothing about the
               two-dial system. ADR-047 removed such redirects, so this link
               had nowhere left to go. -->
          <a href="/decisions" class="font-mono text-[0.65rem] text-dim hover:text-foreground transition-colors">Decision Registry →</a>
          <a href="/blueprints/nwos-system" class="font-mono text-[0.65rem] text-dim hover:text-foreground transition-colors">NWOS overview →</a>
          <a href="https://nwos.numen.games/workspace/faro-austral" target="_blank" rel="noopener noreferrer" class="font-mono text-[0.65rem] text-dim hover:text-foreground transition-colors">See a demo workspace →</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .dial-btn[aria-checked="true"] {
    border-color: var(--lvl-color);
    background: color-mix(in srgb, var(--lvl-color) 15%, transparent);
    color: var(--lvl-color);
    font-weight: 700;
  }
  .vocab-cell.vocab-active {
    background: color-mix(in srgb, var(--vocab-color, #a6dad5) 10%, transparent);
    box-shadow: inset 2px 0 0 color-mix(in srgb, var(--vocab-color, #a6dad5) 45%, transparent),
      inset -2px 0 0 color-mix(in srgb, var(--vocab-color, #a6dad5) 45%, transparent);
  }
  [data-narr-card].narr-active {
    box-shadow: 0 0 0 2px var(--narr-ring, #a6dad5);
  }
  [data-gamif-row].gamif-active {
    background: color-mix(in srgb, var(--gamif-color, #efa517) 10%, transparent);
    border-radius: 0.375rem;
  }
</style>

<script define:vars={{ narrData, gamifData, mechData }}>
  const INTERNAL = { 1: 1, 2: 3, 3: 5, 4: 7, 5: 10 };
  const state = { narr: 3, gamif: 2 };

  const $ = (sel) => document.querySelector(sel);
  const $$ = (sel) => Array.from(document.querySelectorAll(sel));

  function render() {
    const narr = narrData.find((l) => l.n === state.narr);
    const gamif = gamifData.find((l) => l.n === state.gamif);

    // Selector buttons
    for (const btn of $$(".dial-btn")) {
      const active = Number(btn.dataset.level) === state[btn.dataset.dial];
      btn.setAttribute("aria-checked", String(active));
    }

    // Readouts
    const narrReadout = $("#narr-readout");
    narrReadout.textContent = `${narr.n} · ${narr.name}`;
    narrReadout.style.color = narr.color;
    const gamifReadout = $("#gamif-readout");
    gamifReadout.textContent = `${gamif.n} · ${gamif.name}`;
    gamifReadout.style.color = gamif.color;

    // Preview panel
    const panel = $("#config-preview");
    panel.style.borderColor = `${narr.color}55`;
    panel.style.background = `color-mix(in srgb, ${narr.color} 4%, transparent)`;
    const title = $("#preview-title");
    title.innerHTML = "";
    const narrSpan = document.createElement("span");
    narrSpan.textContent = narr.name;
    narrSpan.style.color = narr.color;
    const gamifSpan = document.createElement("span");
    gamifSpan.textContent = gamif.name;
    gamifSpan.style.color = gamif.color;
    title.append(narrSpan, " · ", gamifSpan);
    $("#preview-feel").textContent = narr.feel;
    $("#preview-feel").style.borderColor = `${narr.color}40`;

    const mech = $("#preview-mechanics");
    mech.innerHTML = "";
    if (state.gamif === 1) {
      const p = document.createElement("p");
      p.className = "font-mono text-[0.65rem] text-dim sm:col-span-2";
      p.textContent = "— No game mechanics. Just the operating system.";
      mech.appendChild(p);
    } else {
      for (const m of mechData) {
        const on = state.gamif >= m.from;
        const p = document.createElement("p");
        p.className = "font-mono text-[0.65rem]";
        p.style.color = on ? gamif.color : "";
        if (!on) p.classList.add("text-dim", "line-through", "opacity-50");
        p.textContent = `${on ? "+" : "–"} ${m.label}`;
        mech.appendChild(p);
      }
    }
    $("#preview-internal-narr").textContent = String(INTERNAL[state.narr]);
    $("#preview-internal-gamif").textContent = String(INTERNAL[state.gamif]);

    // Highlights across the page
    for (const cell of $$("[data-vocab-level]")) {
      const active = Number(cell.dataset.vocabLevel) === state.narr;
      cell.classList.toggle("vocab-active", active);
      if (active) cell.style.setProperty("--vocab-color", narr.color);
    }
    for (const card of $$("[data-narr-card]")) {
      const active = Number(card.dataset.narrCard) === state.narr;
      card.classList.toggle("narr-active", active);
      if (active) card.style.setProperty("--narr-ring", `${narr.color}66`);
    }
    for (const row of $$("[data-gamif-row]")) {
      const active = Number(row.dataset.gamifRow) === state.gamif;
      row.classList.toggle("gamif-active", active);
      if (active) row.style.setProperty("--gamif-color", gamif.color);
    }
  }

  for (const btn of document.querySelectorAll(".dial-btn")) {
    btn.addEventListener("click", () => {
      state[btn.dataset.dial] = Number(btn.dataset.level);
      render();
    });
  }
  render();
</script>
