---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// Generic canon document rendered at build from the repo root (MIS-087:
// the full mirror — every .md gets a page, the folder is the source).
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { getCollection, render } from "astro:content";
import { getPublicCorpus } from "@/lib/corpus";
import { repoFileUrl } from "@/lib/build-info";

export async function getStaticPaths() {
  const entries = await getPublicCorpus();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const raw = entry.data as Record<string, unknown>;
// Frontmatter varies wildly across the repo — display only string values.
const str = (v: unknown) => (typeof v === "string" ? v : undefined);
const f = {
  id: str(raw.id),
  status: str(raw.status),
  version: str(raw.version),
  license: str(raw.license),
  created: raw.created,
  updated: raw.updated,
};
const rel = (entry.filePath as string).replace(/\\/g, "/");
const mdFilename = rel.split("/").pop()!;
const mdUrl = `/${entry.id}.md`;
const repoUrl = repoFileUrl(rel);
// Group from filePath, not id: the loader maps INDEX.md to the bare
// directory id, which would mislabel section indexes as root files.
const m = rel.match(
  /(?:^|\/)(agents|blueprints|canon|decisions|guilds|missions|operations|protocols|reports|standards)\/(.+)$/
);
const dir = m ? [m[1], ...m[2].split("/").slice(0, -1)].join("/") : "raíz";
const title = str(raw.title) ?? mdFilename;
// A draft document binds nobody (STD-004), and the corpus mirror renders the
// canon, the standards and the protocols — the three folders where that fact
// changes what a reader should do. Printing the bare word as a chip left them
// to infer it; the band says it, and points at the rule that applies instead.
const isDraft = f.status === "draft";
// MIS-119 — the speech voice follows the document's language. The corpus is
// mid-migration (ADR-024): honor an explicit declaration, else default to
// the site language. "es-ES until…" style annotations reduce to their tag.
const docLang = (str(raw.lang) ?? str(raw.idioma_canonico) ?? "en")
  .trim()
  .split(/[\s#]/)[0];
const fmtDate = (v: unknown) => {
  if (!v) return null;
  const d = v instanceof Date ? v : new Date(String(v));
  return Number.isNaN(d.getTime()) ? String(v) : d.toISOString().slice(0, 10);
};
const updated = fmtDate(f.updated) ?? fmtDate(f.created);
---

<Layout
  title={`${title} — Corpus NWOS`}
  description={title}
  canonicalPath={`/${entry.id}`}
>
  <section class="pb-20 pt-16">
    <div class="mx-auto max-w-[800px] px-6">


      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="font-mono text-[0.65rem] text-accent">{dir}</span>
        {f.id && <span class="font-mono text-[0.65rem] text-dim">{f.id}</span>}
        {f.status && <span class="inline-flex rounded-full border border-border bg-card px-2.5 py-0.5 font-mono text-[0.6rem] text-muted-foreground">{f.status}</span>}
        {f.version && <span class="font-mono text-[0.6rem] text-dim">v{f.version}</span>}
        {updated && <span class="font-mono text-[0.6rem] text-dim">{updated}</span>}
        {f.license && <span class="font-mono text-[0.6rem] text-dim">{f.license}</span>}
      </div>

      <h1 class="font-display text-3xl sm:text-4xl text-foreground mb-8">{title}</h1>

      {isDraft && (
        <aside class="mb-6 rounded-xl border border-accent/30 bg-accent/5 p-4">
          <p class="text-sm leading-relaxed text-muted-foreground">
            <strong class="text-foreground">This document is <code>draft</code>: written, not yet in force — it binds nobody</strong>
            (<a href="/standards/std-004-the-header" class="text-accent underline underline-offset-2">STD-004</a>).
            It describes a practice; it does not impose one. What is in force
            right now is at <a href="/binding" class="text-accent underline underline-offset-2">what binds today</a>.
          </p>
        </aside>
      )}

      <DocToolbar mdUrl={mdUrl} filename={mdFilename} lang={docLang} repoUrl={repoUrl} />
      <article class="mission-md rounded-xl border border-border bg-card p-6 sm:p-8">
        <Content />
      </article>

    </div>
  </section>
</Layout>

<style is:global>
  /* Same prose styling as mission detail pages (shared .mission-md class) */
  .mission-md > h1:first-child { display: none; }
  .mission-md h2 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgb(var(--accent));
    margin: 2rem 0 0.75rem;
  }
  .mission-md h2:first-of-type { margin-top: 0.5rem; }
  .mission-md h3 { font-size: 0.95rem; color: rgb(var(--text)); margin: 1.25rem 0 0.5rem; }
  .mission-md h4 { font-size: 0.85rem; color: rgb(var(--text)); margin: 1rem 0 0.5rem; }
  .mission-md p { font-size: 0.875rem; line-height: 1.7; color: rgb(var(--text-muted)); margin: 0.5rem 0; }
  .mission-md ul, .mission-md ol { margin: 0.5rem 0 0.75rem; padding-left: 1.25rem; }
  .mission-md li { font-size: 0.875rem; line-height: 1.65; color: rgb(var(--text-muted)); margin: 0.35rem 0; }
  .mission-md ul { list-style: disc; }
  .mission-md ol { list-style: decimal; }
  .mission-md li > ul, .mission-md li > ol { margin: 0.25rem 0; }
  .mission-md input[type="checkbox"] { margin-right: 0.5rem; accent-color: rgb(var(--accent)); }
  .mission-md hr { border: 0; border-top: 1px solid rgb(var(--border)); margin: 1.5rem 0; }
  .mission-md blockquote {
    border-left: 2px solid rgb(var(--accent) / 0.35);
    padding-left: 1rem;
    margin: 0.75rem 0;
    font-style: italic;
  }
  .mission-md blockquote p { color: rgb(var(--text-muted)); }
  .mission-md code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background: rgb(var(--border) / 0.5);
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
  }
  .mission-md pre { overflow-x: auto; padding: 1rem; border-radius: 0.5rem; margin: 0.75rem 0; background: rgb(var(--bg-card-hover)); }
  .mission-md pre code { background: none; padding: 0; }
  .mission-md table { display: block; overflow-x: auto; font-size: 0.8rem; margin: 0.75rem 0; border-collapse: collapse; }
  .mission-md th, .mission-md td { border: 1px solid rgb(var(--border)); padding: 0.4rem 0.6rem; text-align: left; color: rgb(var(--text-muted)); }
  .mission-md th { font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgb(var(--text)); }
  .mission-md a { color: rgb(var(--accent)); text-decoration: underline; text-underline-offset: 2px; }
  .mission-md strong { color: rgb(var(--text)); }
</style>
