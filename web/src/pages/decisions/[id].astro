---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// Decision detail rendered at build from the repo's decisions/ folder
// (MIS-065). The full markdown document is the page.
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { repoFileUrl } from "@/lib/build-info";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("decisions")).sort((a, b) =>
    (a.data.id as string).localeCompare(b.data.id as string)
  );
  return entries.map((entry, i) => ({
    params: { id: (entry.data.id as string).toLowerCase() },
    props: {
      entry,
      prevId: i > 0 ? (entries[i - 1].data.id as string) : null,
      nextId: i < entries.length - 1 ? (entries[i + 1].data.id as string) : null,
    },
  }));
}

const { entry, prevId, nextId } = Astro.props;
const { Content } = await render(entry);
const f = entry.data as Record<string, any>;
const decId = (f.id as string).toUpperCase();
const mdFilename = (entry.filePath as string).split("/").pop()!;
const repoUrl = repoFileUrl(entry.filePath as string);
const mdUrl = `/decisions/${decId.toLowerCase()}.md`;

const STATUS_COLOR: Record<string, string> = {
  active: "text-green",
  draft: "text-yellow",
  withdrawn: "text-dim",
};
---

<Layout
  title={`${decId} — Numen Games CAO`}
  description={`${decId} — ${f.title}`}
  canonicalPath={`/decisions/${decId.toLowerCase()}`}
>
  <section class="pb-20 pt-16">
    <div class="mx-auto max-w-[800px] px-6">

      <a href="/decisions" class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-dim hover:text-accent transition-colors mb-8">
        <Icon name="caret-left" size={12} />
        Decisions
      </a>

      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="font-mono text-[0.65rem] text-accent">{decId}</span>
        <span class="font-mono text-[0.6rem] text-dim">{String(f.created).slice(0, 10)}</span>
        <span class={"font-mono text-[0.6rem] uppercase tracking-widest " + (STATUS_COLOR[f.status] || "text-dim")}>{f.status}</span>
        {(f.territory ?? f.area) && <span class="font-mono text-[0.6rem] text-dim">{f.territory ?? f.area}</span>}
      </div>

      <h1 class="font-display text-3xl sm:text-4xl text-foreground mb-8">{f.title}</h1>

      <DocToolbar mdUrl={mdUrl} filename={mdFilename} repoUrl={repoUrl} />
      <article class="mission-md rounded-xl border border-border bg-card p-6 sm:p-8">
        <Content />
      </article>

      <div class="flex justify-between border-t border-border pt-6 mt-8">
        {prevId
          ? <a href={"/decisions/" + prevId.toLowerCase()} class="font-mono text-[0.7rem] text-dim hover:text-accent transition-colors">← {prevId}</a>
          : <span />}
        {nextId
          ? <a href={"/decisions/" + nextId.toLowerCase()} class="font-mono text-[0.7rem] text-dim hover:text-accent transition-colors">{nextId} →</a>
          : <span />}
      </div>

    </div>
  </section>
</Layout>

<style is:global>
  .mission-md > h1:first-child { display: none; }
  .mission-md h2 { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.2em; color: rgb(var(--accent)); margin: 2rem 0 0.75rem; }
  .mission-md h2:first-of-type { margin-top: 0.5rem; }
  .mission-md h3 { font-size: 0.95rem; color: rgb(var(--text)); margin: 1.25rem 0 0.5rem; }
  .mission-md p { font-size: 0.875rem; line-height: 1.7; color: rgb(var(--text-muted)); margin: 0.5rem 0; }
  .mission-md ul, .mission-md ol { margin: 0.5rem 0 0.75rem; padding-left: 1.25rem; }
  .mission-md li { font-size: 0.875rem; line-height: 1.65; color: rgb(var(--text-muted)); margin: 0.35rem 0; }
  .mission-md ul { list-style: disc; }
  .mission-md ol { list-style: decimal; }
  .mission-md input[type="checkbox"] { margin-right: 0.5rem; accent-color: rgb(var(--accent)); }
  .mission-md hr { border: 0; border-top: 1px solid rgb(var(--border)); margin: 1.5rem 0; }
  .mission-md blockquote { border-left: 2px solid rgb(var(--accent) / 0.35); padding-left: 1rem; margin: 0.75rem 0; font-style: italic; }
  .mission-md blockquote p { color: rgb(var(--text-muted)); }
  .mission-md code { font-family: var(--font-mono); font-size: 0.8em; background: rgb(var(--border) / 0.5); padding: 0.1em 0.35em; border-radius: 0.25rem; }
  .mission-md pre { overflow-x: auto; padding: 1rem; border-radius: 0.5rem; margin: 0.75rem 0; background: rgb(var(--bg-card-hover)); }
  .mission-md pre code { background: none; padding: 0; }
  .mission-md table { display: block; overflow-x: auto; font-size: 0.8rem; margin: 0.75rem 0; border-collapse: collapse; }
  .mission-md th, .mission-md td { border: 1px solid rgb(var(--border)); padding: 0.4rem 0.6rem; text-align: left; color: rgb(var(--text-muted)); }
  .mission-md th { font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgb(var(--text)); }
  .mission-md a { color: rgb(var(--accent)); text-decoration: underline; text-underline-offset: 2px; }
  .mission-md strong { color: rgb(var(--text)); }
</style>
