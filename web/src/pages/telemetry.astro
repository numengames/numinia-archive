---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// MIS-141 — the telemetry dataset, rendered.
//
// THIS PAGE STATES NOTHING. Every figure below is read from
// telemetry/latest.json at build time; the prose around them describes what
// the instrument does, never what the corpus contains. If a number here is
// wrong, the instrument is wrong, and the fix is to run it.
//
// READING ORDER, and why it is this one
//   1. Identity   — which corpus these figures are true of, and whether this
//                   build can verify it. The only thing latest.md cannot say.
//   2. What moved — the diff against the previous measurement. A reader who
//                   comes back twice wants this, not the census.
//   3. The census — all published figures by family, each with its predicate.
//
// The four "headline" figures are an array on one line. Changing which
// figures are prominent is then a one-line PR rather than a redesign, and a
// new family from the instrument appears in the census on its own.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import {
  dataset,
  byFamily,
  history,
  whatChanged,
  freshness,
  seriesFor,
  deltaFor,
  scalarOf,
  entriesOf,
  fmt,
  signed,
  confidenceOf,
  cadenceOf,
  excludedCount,
  totalMeasured,
  EXCLUDED_FAMILIES,
} from "@/lib/telemetry";
import { REPO_URL } from "@/lib/build-info";

// The figures given prominence. One line — see header.
const HEADLINE = ["corpus.docs_total", "missions.total", "tokens.total", "contradictions.claims_open"];

const find = (k: string) => dataset.figures.find((f) => f.key === k);
const headline = HEADLINE.map(find).filter((f): f is NonNullable<typeof f> => Boolean(f));

const { from, to, changes } = whatChanged();

const measuredAt = new Date(dataset.measured_at);
const measuredLabel = measuredAt.toISOString().replace("T", " ").slice(0, 16) + " UTC";

const commitUrl = (sha: string) =>
  `${REPO_URL}/commit/${sha.replace(/\+index$/, "")}`;

const FAMILY_BLURB: Record<string, string> = {
  corpus: "What the corpus is made of: tracked files, by kind.",
  missions: "The mission series, counted from the files themselves.",
  contradictions: "Where the corpus disagrees with itself, or with its own rules.",
  figures: "Figures the corpus states in prose, and whether they carry a commit.",
  headers: "Frontmatter: what is declared, and what is missing.",
  provenance: "Declared dates against git history.",
  series: "Filename conformance per series.",
  tokens: "Size in cl100k tokens — the unit a model reads in.",
};
---

<Layout
  title="NWOS — Telemetry — Pablo FM"
  description="The Narrative Work OS measured: figures produced by scripts/telemetry.mjs, each with the predicate it is true of and the commit it was measured at."
  canonicalPath="/telemetry"
  activeNav="machine/telemetry/"
>
  <PageHero
    label="NWOS — Telemetry"
    title="The corpus, measured"
    description="Every figure here was produced by one instrument, at one commit, with the predicate it is true of printed beside it. This page computes nothing."
  />

  <div class="mx-auto max-w-[1100px] px-6 pb-24">

    <!-- ── 1 · Identity ─────────────────────────────────────────────────
         The block that justifies the page existing. telemetry/latest.md
         renders the same figures; it cannot say which build is showing
         them, so it cannot say whether they still apply. -->
    <section aria-labelledby="identity" class="mb-16">
      <h2 id="identity" class="sr-only">Dataset identity</h2>
      <div class="rounded-lg border border-border bg-card p-5 sm:p-6">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span
            class={`inline-flex items-center gap-2 rounded-md px-2.5 py-1 font-mono text-[0.65rem] font-medium uppercase tracking-[0.15em] ${
              freshness.state === "current"
                ? "bg-green/10 text-green"
                : "bg-yellow/10 text-yellow"
            }`}
          >
            <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
            {freshness.state === "current" ? "Verified against this build" : "Not verifiable from this page"}
          </span>
          <span class="font-mono text-xs text-muted-foreground">measured {measuredLabel}</span>
        </div>

        <dl class="mt-5 grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
          <div>
            <dt class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-muted-foreground">Measured at commit</dt>
            <dd class="mt-1.5 font-mono text-sm text-foreground">
              <a href={commitUrl(dataset.head)} class="underline decoration-border underline-offset-4 hover:text-accent hover:decoration-accent" target="_blank" rel="noopener noreferrer">
                {dataset.head}
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-muted-foreground">This build</dt>
            <dd class="mt-1.5 font-mono text-sm text-foreground">{freshness.buildSha}</dd>
          </div>
          <div class="sm:col-span-2 lg:col-span-1">
            <dt class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-muted-foreground">Corpus hash</dt>
            <dd class="mt-1.5 break-all font-mono text-sm text-muted-foreground">{dataset.corpus_hash.slice(0, 32)}<span class="text-muted-foreground">…</span></dd>
          </div>
        </dl>

        <p class="mt-5 max-w-[70ch] border-t border-border pt-4 text-sm leading-relaxed text-muted-foreground">
          {freshness.state === "current" ? (
            <>The dataset was measured at the commit this build came from. The figures below describe the tree you are looking at.</>
          ) : (
            <>The dataset names a different commit than this build, or this build has no commit label. That is normal and usually harmless — the instrument runs, then its output is committed, so <span class="font-mono text-foreground">head</span> can trail the build by one. The page compares labels; it does not re-measure, so it reports what it can see rather than guessing.</>
          )}
        </p>
      </div>
    </section>

    <!-- ── 2 · Headline figures ───────────────────────────────────────── -->
    <section aria-labelledby="headline" class="mb-16">
      <h2 id="headline" class="sr-only">Headline figures</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {headline.map((f) => {
          const d = deltaFor(f.key);
          const pts = seriesFor(f.key).length;
          const cad = cadenceOf(f.key);
          const scalar = scalarOf(f.value);
          const entries = entriesOf(f.value);
          return (
            <article class="flex flex-col rounded-lg border border-border bg-card p-5 transition-colors hover:bg-card-hover">
              <div class="flex items-start justify-between gap-2">
                <span class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-muted-foreground">{f.key}</span>
                <span
                  class={`shrink-0 rounded-md px-1.5 py-0.5 font-mono text-[0.55rem] uppercase tracking-[0.1em] ${
                    cad === "mechanical" ? "bg-blue/10 text-blue" : "bg-purple/10 text-purple"
                  }`}
                  title={cad === "mechanical" ? "Moves on any commit that touches a document" : "Moves only when a human edits the register"}
                >{cad}</span>
              </div>

              {scalar !== null ? (
                <p class="mt-3 font-mono text-3xl font-medium leading-none tabular-nums text-foreground sm:text-[2.25rem]">
                  {fmt(scalar)}
                </p>
              ) : (
                <dl class="mt-3 space-y-1">
                  {entries?.slice(0, 5).map(([k, v]) => (
                    <div class="flex items-baseline justify-between gap-3">
                      <dt class="truncate text-xs text-muted-foreground">{k}</dt>
                      <dd class="font-mono text-sm tabular-nums text-foreground">{fmt(v)}</dd>
                    </div>
                  ))}
                </dl>
              )}

              <p class="mt-1 font-mono text-[0.65rem] text-muted-foreground">{f.unit}</p>

              <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[0.65rem]">
                {d && d.delta !== 0 ? (
                  <span class={d.delta > 0 ? "text-green" : "text-yellow"}>{signed(d.delta)} since {d.from}</span>
                ) : d ? (
                  <span class="text-muted-foreground">unchanged since {d.from}</span>
                ) : null}
                <span class="text-muted-foreground">{pts} measurement{pts === 1 ? "" : "s"}</span>
              </div>

              <p class="mt-3 border-t border-border pt-3 text-xs leading-relaxed text-muted-foreground">
                {f.definition}
              </p>
            </article>
          );
        })}
      </div>
    </section>

    <!-- ── 3 · What moved ─────────────────────────────────────────────── -->
    <section aria-labelledby="moved" class="mb-16">
      <SectionHeader
        label="Between measurements"
        title="What moved"
        description="The difference between the last two runs of the instrument. A figure absent from the older run is not listed: appearing for the first time is a change in the instrument, not in the corpus."
      />

      {from && to ? (
        <div class="rounded-lg border border-border bg-card">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 border-b border-border px-5 py-3 font-mono text-xs text-muted-foreground">
            <a href={commitUrl(from.head)} class="hover:text-accent" target="_blank" rel="noopener noreferrer">{from.head}</a>
            <span aria-hidden="true">→</span>
            <a href={commitUrl(to.head)} class="text-foreground hover:text-accent" target="_blank" rel="noopener noreferrer">{to.head}</a>
            <span class="ml-auto">{changes.length} figure{changes.length === 1 ? "" : "s"} moved</span>
          </div>

          {changes.length === 0 ? (
            <p class="px-5 py-6 text-sm text-muted-foreground">
              Nothing moved between these two measurements. The corpus changed in ways no published figure counts, or it did not change at all.
            </p>
          ) : (
            <ul class="divide-y divide-border">
              {changes.map((c) => (
                <li class="px-5 py-4">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="font-mono text-sm text-foreground">{c.key}</span>
                    {c.confidence === "heuristic" && (
                      <span class="rounded-md bg-yellow/10 px-1.5 py-0.5 font-mono text-[0.55rem] uppercase tracking-[0.1em] text-yellow">heuristic</span>
                    )}
                    <span class="ml-auto font-mono text-sm tabular-nums">
                      <span class="text-muted-foreground">{fmt(scalarOf(c.before) ?? "table")}</span>
                      <span class="mx-1.5 text-muted-foreground" aria-hidden="true">→</span>
                      <span class="text-foreground">{fmt(scalarOf(c.after) ?? "table")}</span>
                      {c.delta !== null && c.delta !== 0 && (
                        <span class={c.delta > 0 ? "ml-2 text-green" : "ml-2 text-yellow"}>{signed(c.delta)}</span>
                      )}
                    </span>
                  </div>
                  <p class="mt-1.5 max-w-[70ch] text-xs leading-relaxed text-muted-foreground">{c.definition}</p>
                </li>
              ))}
            </ul>
          )}
        </div>
      ) : (
        <p class="rounded-lg border border-border bg-card px-5 py-6 text-sm text-muted-foreground">
          Only one measurement exists. There is nothing to compare it against.
        </p>
      )}
    </section>

    <!-- ── 4 · The census ─────────────────────────────────────────────── -->
    <section aria-labelledby="census">
      <SectionHeader
        label="Every published figure"
        title="The census"
        description="All figures, by family, each with the predicate it is true of. Composite figures fold; open one to see its rows."
      />

      <div class="space-y-10">
        {byFamily.map((group) => (
          <div>
            <div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-border pb-2">
              <h3 class="font-mono text-sm font-medium uppercase tracking-[0.15em] text-accent">{group.family}</h3>
              <span class="font-mono text-xs text-dim">{group.figures.length}</span>
              <p class="w-full text-xs text-muted-foreground sm:ml-auto sm:w-auto">{FAMILY_BLURB[group.family] ?? ""}</p>
            </div>

            <ul class="divide-y divide-border">
              {group.figures.map((f) => {
                const scalar = scalarOf(f.value);
                const entries = entriesOf(f.value);
                const conf = confidenceOf(f.key);
                return (
                  <li class="py-3.5" data-figure-key={f.key}>
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <span class="font-mono text-sm text-foreground">{f.key.split(".")[1]}</span>
                      {conf === "heuristic" && (
                        <span class="rounded-md bg-yellow/10 px-1.5 py-0.5 font-mono text-[0.55rem] uppercase tracking-[0.1em] text-yellow" title="A detector over free prose, not an exact count over a defined set">heuristic</span>
                      )}
                      {scalar !== null && (
                        <span class="ml-auto font-mono text-base tabular-nums text-foreground">
                          {fmt(scalar)} <span class="text-[0.7rem] text-dim">{f.unit}</span>
                        </span>
                      )}
                    </div>

                    <p class="mt-1 max-w-[70ch] text-xs leading-relaxed text-muted-foreground">{f.definition}</p>

                    {entries && entries.length > 0 && (
                      <details class="mt-2 group">
                        <summary class="inline-flex min-h-[44px] cursor-pointer items-center font-mono text-[0.65rem] uppercase tracking-[0.15em] text-dim hover:text-accent sm:min-h-0">
                          {entries.length} row{entries.length === 1 ? "" : "s"}
                        </summary>
                        <dl class="mt-2 space-y-1 border-l border-border pl-4">
                          {entries.map(([k, v]) => (
                            <div class="flex items-baseline justify-between gap-4">
                              <dt class="min-w-0 break-all text-xs text-muted-foreground">{k}</dt>
                              <dd class="shrink-0 font-mono text-xs tabular-nums text-foreground">{fmt(v)}</dd>
                            </div>
                          ))}
                        </dl>
                      </details>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ── 5 · What this page does not show ───────────────────────────── -->
    <section aria-labelledby="omitted" class="mt-16">
      <h2 id="omitted" class="sr-only">What is omitted</h2>
      <div class="rounded-lg border border-border bg-card p-5 sm:p-6">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-muted-foreground">Not shown</p>
        <p class="mt-3 max-w-[70ch] text-sm leading-relaxed text-muted-foreground">
          The instrument measures <span class="font-mono text-foreground">{totalMeasured}</span> figures; this page publishes <span class="font-mono text-foreground">{dataset.figures.length}</span>.{excludedCount > 0 && (<> The {excludedCount} omitted belong to families kept out of the view: {Object.entries(EXCLUDED_FAMILIES).map(([f, why]) => `${f} — ${why}`).join(" · ")}</>)}
        </p>
        <p class="mt-3 max-w-[70ch] text-sm leading-relaxed text-muted-foreground">
          There is no chart. The ledger holds <span class="font-mono text-foreground">{history.length}</span> measurements taken over a period too short to carry a trend, and a line drawn through them would assert a slope the data does not support. It appears when the ledger earns it.
        </p>
        <p class="mt-4 border-t border-border pt-4 font-mono text-xs text-muted-foreground">
          Produced by <a href={`${REPO_URL}/blob/main/scripts/telemetry.mjs`} class="underline decoration-border underline-offset-4 hover:text-accent" target="_blank" rel="noopener noreferrer">scripts/telemetry.mjs</a> · dataset at <a href={`${REPO_URL}/tree/main/telemetry`} class="underline decoration-border underline-offset-4 hover:text-accent" target="_blank" rel="noopener noreferrer">telemetry/</a> · CC0
        </p>
      </div>
    </section>
  </div>
</Layout>
