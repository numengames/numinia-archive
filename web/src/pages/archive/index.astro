---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// /archive — the classification of the archive, read from the archive.
//
// WHAT THIS PAGE USED TO BE
// Until 2026-09-20 this file held a hardcoded Spanish array of seven "fondos"
// naming agents/guilds/, missions/active/done/backlog/ and
// canon/platform-role-system.md — folders that had not existed for months —
// plus twelve "operating principles" and five "critical failure patterns"
// traced to a hundred mental simulations no document in this repository
// records. It published a model the archive had abandoned, from memory.
//
// Now every row comes from STD-027 (the scheme) and STD-001 (the series), via
// @/lib/classification. Nothing about the classification is written on this
// page: if a function is added to the standard, it appears here; if a series
// moves, this page moves with it or the build fails.
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import PageHero from "@/components/PageHero.astro";
import { functions, counts, graphNodes, RELATIONS } from "@/lib/classification";

const fns = functions();
const n = counts();
const nodes = graphNodes();
const edges = RELATIONS.map((e) => [e[0], e[1]]);

// One glyph per function. Presentation, not classification — which is why it
// lives here and not in the standard.
const FN_ICON: Record<string, string> = {
  governance: "bank",
  production: "lightning",
  assurance: "shield-check",
  agency: "robot",
  creation: "sparkle",
  administration: "gear",
};

const FN_ACCENT: Record<string, { border: string; bg: string; text: string }> = {
  governance:     { border: "border-green/20",  bg: "bg-green/5",  text: "text-green" },
  production:     { border: "border-yellow/20", bg: "bg-yellow/5", text: "text-yellow" },
  assurance:      { border: "border-blue/20",   bg: "bg-blue/5",   text: "text-blue" },
  agency:         { border: "border-accent/20", bg: "bg-accent/5", text: "text-accent" },
  creation:       { border: "border-purple/20", bg: "bg-purple/5", text: "text-purple" },
  administration: { border: "border-orange/20", bg: "bg-orange/5", text: "text-yellow" },
};
---

<Layout
  title="How the archive is classified — Numen Games"
  description={`One fond, ${n.functions} functions, ${n.activities} activities and the ${n.series} series they produce. Read from STD-027 and STD-001 at build time.`}
  canonicalPath="/archive"
  activeNav="archive"
>
  <PageHero
    label="Archive · classification"
    title="How the archive is classified"
    description="One producer, one fond. The series are grouped by the activity that produced them, not by who produced them — so a reorganisation does not move a single file."
  />

  <section class="pb-24">
    <div class="mx-auto max-w-[1100px] px-6">

      <!-- The figures, counted from the scheme, never typed -->
      <div class="grid gap-4 grid-cols-2 sm:grid-cols-4 mb-12">
        <div class="rounded-xl border border-border bg-card p-5 text-center">
          <p class="font-display text-4xl text-foreground">1</p>
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mt-1">Fond</p>
        </div>
        <div class="rounded-xl border border-accent/20 bg-accent/5 p-5 text-center">
          <p class="font-display text-4xl text-accent">{n.functions}</p>
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mt-1">Functions</p>
        </div>
        <div class="rounded-xl border border-border bg-card p-5 text-center">
          <p class="font-display text-4xl text-foreground">{n.activities}</p>
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mt-1">Activities</p>
        </div>
        <div class="rounded-xl border border-green/20 bg-green/5 p-5 text-center">
          <p class="font-display text-4xl text-green">{n.series}</p>
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mt-1">Series</p>
        </div>
      </div>

      <div class="rounded-xl border border-border bg-card p-6 mb-12 max-w-[780px]">
        <p class="text-sm text-muted-foreground leading-relaxed">
          A <strong class="text-foreground">fond</strong> is everything one producer generates — here,
          Numen Games S.L. A <strong class="text-foreground">function</strong> is something the
          organisation does, named with a noun; an <strong class="text-foreground">activity</strong> is
          the verb under it; a <strong class="text-foreground">series</strong> is the folder of documents
          that activity produces. The identifier of a document names its series and never its function,
          so functions can be regrouped without moving a file or breaking a citation.
        </p>
        <p class="text-sm text-muted-foreground leading-relaxed mt-3">
          This page is generated from the two documents that own the scheme:
          <a href="/corpus/standards/std-027-the-classification-scheme" class="text-accent hover:underline">STD-027</a>
          holds the functions and their activities,
          <a href="/corpus/standards/std-001-the-series" class="text-accent hover:underline">STD-001</a>
          holds what each series contains. The decision that cut them is
          <a href="/decisions/adr-046" class="text-accent hover:underline">ADR-046</a>.
        </p>
      </div>

      <!-- Relations between the functions -->
      <div class="mb-4 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">How the functions relate</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="rounded-xl border border-border bg-card p-6 mb-12 relative">
        <p class="text-xs text-muted-foreground mb-4">
          Governance feeds agency and production; administration sustains them; production is observed by
          assurance and born from planning; creation supplies what production builds with.
        </p>
        <div id="archive-3d" style="width:100%;height:320px;"></div>
      </div>

      <!-- The six functions -->
      <div class="mb-4 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">The {n.functions} functions</span>
        <span class="h-px flex-1 bg-border"></span>
        <span class="font-mono text-[0.6rem] text-dim">{n.published} of {n.series} series published here</span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-16">
        {fns.map((f) => {
          const a = FN_ACCENT[f.slug] ?? FN_ACCENT.governance;
          return (
            <a href={`/archive/${f.slug}`} class={`rounded-xl border p-5 ${a.border} ${a.bg} hover:border-accent/50 transition-all group block`}>
              <div class="flex items-start justify-between mb-3">
                <span class={a.text}><Icon name={FN_ICON[f.slug] ?? "archive"} size={22} /></span>
                <span class={`font-mono text-[0.55rem] uppercase tracking-[0.15em] ${a.text} opacity-70`}>
                  {f.activities.length} {f.activities.length === 1 ? "activity" : "activities"}
                </span>
              </div>
              <h3 class={`font-display text-xl mb-2 ${a.text}`}>{f.name}</h3>
              <p class="font-mono text-[0.65rem] text-dim leading-relaxed mb-3">
                {f.activities.map((act) => act.name).join(" · ")}
              </p>
              <div class="flex flex-wrap gap-1 border-t border-border/50 pt-3">
                {f.activities.flatMap((act) => act.series).map((s) => (
                  <span class="font-mono text-[0.5rem] bg-background/50 border border-border/50 rounded px-1.5 py-0.5 text-dim">{s.folder}</span>
                ))}
              </div>
              <p class="mt-3 font-mono text-[0.55rem] text-accent opacity-0 group-hover:opacity-100 transition-opacity">See the function →</p>
            </a>
          );
        })}
      </div>

      <!-- The whole scheme, one row per series -->
      <div class="mb-4 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">The scheme in full</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="rounded-xl border border-border bg-card overflow-x-auto mb-8">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-border">
              <th class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim px-4 py-3">Function</th>
              <th class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim px-4 py-3">Activity</th>
              <th class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim px-4 py-3">Series</th>
              <th class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim px-4 py-3">Holds</th>
            </tr>
          </thead>
          <tbody>
            {fns.flatMap((f) =>
              f.activities.flatMap((act, ai) =>
                act.series.map((s, si) => (
                  <tr class="border-b border-border/40 last:border-0">
                    <td class="px-4 py-3 align-top font-mono text-[0.65rem] text-accent whitespace-nowrap">
                      {ai === 0 && si === 0 ? f.name : ""}
                    </td>
                    <td class="px-4 py-3 align-top font-mono text-[0.65rem] text-foreground whitespace-nowrap">
                      {si === 0 ? act.name : ""}
                    </td>
                    <td class="px-4 py-3 align-top whitespace-nowrap">
                      {s.href
                        ? <a href={s.href} class="font-mono text-[0.65rem] text-accent hover:underline">{s.folder}</a>
                        : <span class="font-mono text-[0.65rem] text-dim">{s.folder}</span>}
                    </td>
                    <td class="px-4 py-3 align-top text-xs text-muted-foreground leading-relaxed">
                      {s.holds || s.unpublished}
                    </td>
                  </tr>
                )),
              ),
            )}
          </tbody>
        </table>
      </div>

      <!-- The second fond -->
      <div class="rounded-xl border border-purple/20 bg-purple/5 p-6 max-w-[780px]">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-purple mb-3">The second fond</p>
        <p class="text-sm text-muted-foreground leading-relaxed">
          <code class="font-mono text-xs text-foreground">lore/</code> is recognised as a fond of its own:
          a different producer relationship and a different licence regime from the administrative corpus.
          It is listed in the scheme because the two fonds are read together, not because it belongs to the
          first. Separating it physically moves published addresses, so it waits for the URL standard.
        </p>
      </div>

    </div>
  </section>
</Layout>

<script is:inline define:vars={{ nodes, edges }}>
(function () {
  function buildScene(THREE, el, w, h) {
    var scene = new THREE.Scene();
    var camera = new THREE.PerspectiveCamera(55, w / h, 0.1, 100);
    camera.position.set(0, 1, 7.5);

    var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(w, h);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x000000, 0);
    el.appendChild(renderer.domElement);

    var group = new THREE.Group();
    scene.add(group);
    scene.add(new THREE.AmbientLight(0xffffff, 0.3));

    var posMap = {};
    nodes.forEach(function (n) {
      var mesh = new THREE.Mesh(
        new THREE.SphereGeometry(0.18, 20, 20),
        new THREE.MeshStandardMaterial({ color: n.color, emissive: n.color, emissiveIntensity: 0.6 })
      );
      mesh.position.set(n.x, n.y, n.z);
      group.add(mesh);
      posMap[n.id] = new THREE.Vector3(n.x, n.y, n.z);
      var light = new THREE.PointLight(n.color, 0.4, 3);
      light.position.copy(mesh.position);
      group.add(light);
    });

    edges.forEach(function (e) {
      var a = posMap[e[0]], b = posMap[e[1]];
      if (!a || !b) return;
      group.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([a.clone(), b.clone()]),
        new THREE.LineBasicMaterial({ color: 0x334155, opacity: 0.5, transparent: true })
      ));
    });

    // Labels drawn in the DOM over the canvas — always legible, never occluded.
    var layer = document.createElement('div');
    layer.style.cssText = 'position:absolute;top:0;left:0;pointer-events:none;overflow:hidden;width:100%;height:100%;';
    el.style.position = 'relative';
    el.appendChild(layer);
    var labels = [];
    nodes.forEach(function (n) {
      var div = document.createElement('div');
      div.style.cssText = 'position:absolute;top:0;left:0;font-family:monospace;text-align:center;pointer-events:none;';
      div.innerHTML =
        '<span style="display:block;font-size:11px;font-weight:bold;color:#' + n.color.toString(16).padStart(6, '0') + ';text-shadow:0 0 6px #000,0 0 3px #000;white-space:nowrap;">' + n.label + '</span>' +
        '<span style="display:block;font-size:8px;color:#aaa;text-shadow:0 0 4px #000;white-space:nowrap;">' + n.subtitle + '</span>';
      layer.appendChild(div);
      labels.push({ el: div, pos: posMap[n.id].clone() });
    });

    function renderLabels() {
      labels.forEach(function (item) {
        var p = item.pos.clone();
        group.localToWorld(p);
        p.project(camera);
        item.el.style.transform = 'translate(-50%, -140%) translate(' +
          ((p.x * 0.5 + 0.5) * el.offsetWidth) + 'px,' + ((-p.y * 0.5 + 0.5) * el.offsetHeight) + 'px)';
        item.el.style.display = p.z < 1 ? 'block' : 'none';
      });
    }

    new ResizeObserver(function (entries) {
      var r = entries[0].contentRect;
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
      renderer.setSize(r.width, r.height);
    }).observe(el);

    var clock = new THREE.Clock();
    (function animate() {
      requestAnimationFrame(animate);
      var t = clock.getElapsedTime();
      group.rotation.y = t * 0.16;
      group.rotation.x = Math.sin(t * 0.07) * 0.12;
      renderer.render(scene, camera);
      renderLabels();
    })();
  }

  import('https://esm.sh/three@0.163.0').then(function (THREE) {
    var el = document.getElementById('archive-3d');
    if (el) buildScene(THREE, el, el.offsetWidth || 400, 320);
  });
})();
</script>
