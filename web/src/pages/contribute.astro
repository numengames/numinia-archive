---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// /contribute — the ways to support Numinia, modelled on Open Collective's
// Contribute page (opencollective.com/webpack/contribute): one card per way,
// each with its kind, name, one sentence, a starting price and the people
// in it; a short path to pay; the wall of contributors after. Their third
// card, Donation, is left out: Numinia takes no donations (CAN-011).
//
// THIS PAGE STATES NO PRICE OF ITS OWN. Every card is read from the `goods:`
// block of OPS-014 through @/lib/contribute (STD-033 PAY-003), and what a
// payment turns into comes from the same split() Open books uses.
//
// NOTHING IS ON SALE YET. A card is payable only when its record says
// "on sale" AND carries a payment link (onSale()). Until then the last step
// shows the pay button as "Coming soon" and says why: the consumer terms
// come with the legal book. No card field ever sits on this page: payment
// happens on the processor's own page (PAY-005).
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { repoFileUrl } from "@/lib/build-info";
import { goods, onSale, eur, turnsInto, OFFER_FILE, OFFER_ROUTE } from "@/lib/contribute";

const G = await goods();
const DATA = G.map((g) => ({ ...g, payable: onSale(g), splits: Object.fromEntries(g.amounts.flatMap((a) => [[`month-${a}`, turnsInto(a)], [`year-${a}`, turnsInto(a * g.year_months)]])) }));
---

<Layout
  title="Contribute — Numinia"
  description="All the ways to help keep Numinia going: Backer from €5 a month, Sponsor from €200. Each payment buys something named before you pay, and you choose how you appear."
  canonicalPath="/contribute"
>
  <PageHero
    label="Contribute"
    title="Become a contributor"
    description="These are all the ways you can help keep Numinia going. Every payment buys something named before you pay, the whole price is shown, and you choose how you are remembered."
  />

  <div class="mx-auto max-w-[1100px] px-6 pb-8">
    <DocToolbar mdUrl="/contribute.md" filename="numinia-contribute.md" repoUrl={repoFileUrl(OFFER_FILE)} lang="en" />
  </div>

  <section class="pb-20" id="ct"><div class="mx-auto max-w-[1100px] px-6">

    <div class="ct-soon" role="note">
      <span class="ct-flag">not on sale yet</span>
      <p>You can look at everything and walk the path to the last step. Payment opens when the terms for selling to people are published, and what each card gives is confirmed.</p>
    </div>

    <div class="ct-cards">
      {DATA.map((g) => (
        <article class="ct-card" data-good={g.id}>
          <span class="ct-kind">{g.kind}</span>
          <h2 class="ct-name">{g.name}</h2>
          <p class="ct-sentence">{g.sentence}</p>
          <p class="ct-delivers"><span class="ct-k">You receive</span>{g.delivers}</p>
          {g.levels && (
            <ul class="ct-levels">
              {g.levels.map((l, i) => <li><span>{l}</span><b>from {eur(g.amounts[i])} / month</b></li>)}
            </ul>
          )}
          <div class="ct-foot">
            <p class="ct-from"><span class="ct-k">Starts at</span><b>{eur(g.amounts[0])}</b> <span class="ct-per">EUR / month</span></p>
            <p class="ct-count">Nobody yet. Be the first.</p>
            <button type="button" class="ct-btn ct-btn--fill" data-open={g.id}>Contribute</button>
          </div>
        </article>
      ))}
    </div>

    <!-- The path: three steps, as on Open Collective (details, profile, payment) -->
    <div class="ct-flow ct-hidden" id="ct-flow" aria-live="polite">
      <div class="ct-flowhead">
        <p class="ct-k" id="ct-flowname"></p>
        <ol class="ct-steps" aria-label="Steps">
          <li data-step="1">Details</li><li data-step="2">How you appear</li><li data-step="3">Payment</li>
        </ol>
      </div>

      <div class="ct-step" data-panel="1">
        <p class="ct-legend">How often</p>
        <div class="ct-pills" role="radiogroup" aria-label="How often" id="ct-int"></div>
        <p class="ct-legend">Amount</p>
        <div class="ct-pills" role="radiogroup" aria-label="Amount" id="ct-amt"></div>
        <p class="ct-note" id="ct-split"></p>
      </div>

      <div class="ct-step ct-hidden" data-panel="2">
        <p class="ct-legend">On the wall of contributors, appear</p>
        <div class="ct-pills" role="radiogroup" aria-label="How to appear" id="ct-as">
          <button type="button" class="ct-pill" role="radio" data-as="none" aria-checked="true">Without a name</button>
          <button type="button" class="ct-pill" role="radio" data-as="alias" aria-checked="false">With an alias</button>
          <button type="button" class="ct-pill" role="radio" data-as="name" aria-checked="false">With my name</button>
        </div>
        <label class="ct-field ct-hidden" id="ct-namefield"><span class="ct-legend" id="ct-namelabel">Name</span><input id="ct-name" autocomplete="off" maxlength="40"></label>
        <p class="ct-legend">What you gave</p>
        <div class="ct-pills" role="radiogroup" aria-label="Show the amount" id="ct-show">
          <button type="button" class="ct-pill" role="radio" data-show="0" aria-checked="true">Keep it private</button>
          <button type="button" class="ct-pill" role="radio" data-show="1" aria-checked="false">Show it</button>
        </div>
        <p class="ct-note">Saying nothing means no name and no amount. You can change your mind or leave the wall whenever you like.</p>
        <p class="ct-preview"><span class="ct-k">You will appear as</span><span id="ct-preview"></span></p>
      </div>

      <div class="ct-step ct-hidden" data-panel="3">
        <table class="ct-sum" id="ct-sum"></table>
        <button type="button" class="ct-btn ct-btn--fill" id="ct-pay" disabled aria-describedby="ct-paynote">Coming soon</button>
        <p class="ct-note" id="ct-paynote">Payment opens with the terms for selling to people. It will happen on the payment company's own page: no card number is ever typed on numinia.org. Cancelling will take one step, from every receipt.</p>
      </div>

      <div class="ct-nav">
        <button type="button" class="ct-btn" id="ct-back">Back</button>
        <button type="button" class="ct-btn ct-btn--fill" id="ct-next">Next</button>
      </div>
    </div>

    <div class="ct-sec" id="ct-wall">
      <h2>Our contributors</h2>
      <p class="ct-sub">Thank you for supporting Numinia. Everyone who pays in a month, a quarter or a year appears here, as they chose.</p>
      <div class="ct-empty">Nobody yet: nothing is on sale. The first names will appear here.</div>
    </div>

    <div class="ct-sec">
      <h2>Where the money goes</h2>
      <p class="ct-sub">Every euro that comes in and goes out is a line of one public account: <a href="/system/open-books">Open books</a>. What each card gives, its prices and why is in <a href={OFFER_ROUTE}>the record of what is on sale</a>.</p>
    </div>
  </div></section>
</Layout>

<script is:inline id="ct-data" type="application/json" set:html={JSON.stringify(DATA)} />

<style is:global>
#ct .ct-hidden{display:none!important}
.ct-soon{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 12px;border:1px solid rgb(var(--yellow)/.4);background:rgb(var(--yellow)/.08);border-radius:var(--radius);padding:12px 16px;margin:0 0 24px}
.ct-soon p{margin:0;flex:1 1 40ch;font-size:.875rem;line-height:1.55;color:rgb(var(--text-muted))}
.ct-flag{display:inline-flex;border:1px solid rgb(var(--yellow)/.5);color:rgb(var(--yellow));border-radius:999px;padding:1px 10px;font-family:var(--font-mono);font-size:.6rem;letter-spacing:.04em;white-space:nowrap}
.ct-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.ct-card{display:flex;flex-direction:column;background:rgb(var(--bg-card));border:1px solid rgb(var(--border));border-radius:var(--radius);padding:20px}
.ct-kind,.ct-k,.ct-legend{display:block;font-family:var(--font-mono);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;color:rgb(var(--text-dim))}
.ct-name{font-family:var(--font-display);font-size:1.5rem;margin:6px 0 8px;color:rgb(var(--text))}
.ct-sentence{color:rgb(var(--text-muted));line-height:1.6;margin:0 0 14px}
.ct-delivers{font-size:.875rem;color:rgb(var(--text-muted));line-height:1.55;margin:0 0 14px}
.ct-delivers .ct-k{margin-bottom:4px}
.ct-levels{list-style:none;margin:0 0 14px;padding:0;display:grid;gap:4px;font-size:.8125rem}
.ct-levels li{display:flex;justify-content:space-between;gap:12px;border-bottom:1px dashed rgb(var(--border));padding:4px 0;color:rgb(var(--text-muted))}
.ct-levels b{font-family:var(--font-mono);font-weight:500;color:rgb(var(--text))}
.ct-foot{margin-top:auto;padding-top:14px;border-top:1px solid rgb(var(--border))}
.ct-from{margin:0}
.ct-from b{font-family:var(--font-mono);font-size:1.75rem;font-weight:500;color:rgb(var(--text))}
.ct-per{font-family:var(--font-mono);font-size:.75rem;color:rgb(var(--text-dim))}
.ct-count{font-size:.8125rem;color:rgb(var(--text-dim));margin:6px 0 14px}
.ct-btn{font-family:var(--font-sans);font-size:.875rem;min-height:40px;padding:0 16px;border-radius:6px;border:1px solid rgb(var(--border));background:transparent;color:rgb(var(--text-muted));cursor:pointer;transition:background-color .12s,color .12s}
.ct-btn:hover{color:rgb(var(--text))}
.ct-btn--fill{background:rgb(var(--accent));border-color:rgb(var(--accent));color:rgb(var(--bg));font-weight:500}
.ct-btn--fill:hover{color:rgb(var(--bg));filter:brightness(1.08)}
.ct-btn[disabled]{opacity:.55;cursor:not-allowed;filter:none}
.ct-card .ct-btn{width:100%}
.ct-card.is-open{border-color:rgb(var(--accent)/.6)}
.ct-flow{margin-top:24px;background:rgb(var(--bg-card));border:1px solid rgb(var(--accent)/.35);border-radius:var(--radius);padding:20px;max-width:640px}
.ct-flowhead{margin-bottom:16px}
.ct-steps{display:flex;gap:6px;list-style:none;padding:0;margin:8px 0 0;flex-wrap:wrap}
.ct-steps li{font-family:var(--font-mono);font-size:.7rem;padding:4px 10px;border-radius:999px;border:1px solid rgb(var(--border));color:rgb(var(--text-dim))}
.ct-steps li[aria-current="step"]{border-color:rgb(var(--accent));color:rgb(var(--accent))}
.ct-steps li.is-done{color:rgb(var(--text-muted))}
.ct-legend{margin:14px 0 8px}
.ct-pills{display:flex;flex-wrap:wrap;gap:6px}
.ct-pill{font-family:var(--font-sans);font-size:.875rem;color:rgb(var(--text-muted));background:transparent;border:1px solid rgb(var(--border));border-radius:6px;min-height:40px;padding:0 14px;cursor:pointer}
.ct-pill[aria-checked="true"]{background:rgb(var(--text));color:rgb(var(--bg));border-color:rgb(var(--text))}
.ct-pill:focus-visible,.ct-btn:focus-visible,#ct input:focus-visible{outline:2px solid rgb(var(--accent));outline-offset:2px}
.ct-field{display:grid;gap:0;max-width:320px}
.ct-field input{min-height:40px;padding:0 10px;border-radius:6px;border:1px solid rgb(var(--border));background:rgb(var(--bg));color:rgb(var(--text));font:inherit}
.ct-note{font-size:.8125rem;color:rgb(var(--text-dim));margin:12px 0 0;line-height:1.55}
.ct-preview{margin:14px 0 0;padding:10px 12px;border:1px dashed rgb(var(--border));border-radius:6px;color:rgb(var(--text))}
.ct-preview .ct-k{margin-bottom:4px}
.ct-sum{width:100%;border-collapse:collapse;font-size:.875rem;margin-bottom:16px}
.ct-sum td{padding:6px 0;border-bottom:1px solid rgb(var(--border));color:rgb(var(--text-muted))}
.ct-sum td:last-child{text-align:right;font-family:var(--font-mono);font-variant-numeric:tabular-nums;color:rgb(var(--text))}
.ct-sum tr.ct-tot td{font-weight:600;color:rgb(var(--text))}
.ct-nav{display:flex;justify-content:space-between;gap:10px;margin-top:20px}
.ct-sec{margin-top:56px}
.ct-sec h2{font-family:var(--font-display);font-size:1.5rem;margin:0 0 6px;color:rgb(var(--text))}
.ct-sub{color:rgb(var(--text-muted));margin:0 0 16px;max-width:72ch;line-height:1.6}
.ct-sub a{color:rgb(var(--accent));text-decoration:underline;text-underline-offset:2px}
.ct-empty{border:1px dashed rgb(var(--border));border-radius:var(--radius);padding:24px;text-align:center;color:rgb(var(--text-dim));font-size:.875rem}
@media (max-width:1023px){.ct-pill,.ct-btn{min-height:44px}.ct-field input{min-height:44px}}
@media (prefers-reduced-motion:reduce){.ct-btn{transition:none}}
</style>

<script is:inline>
(() => {
const G = JSON.parse(document.getElementById('ct-data').textContent);
const $ = s => document.querySelector(s), $$ = s => [...document.querySelectorAll(s)];
if (!$('#ct')) return;
const eur = (n, d = 2) => '€' + n.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d });
const eur0 = n => '€' + n.toLocaleString('en-GB', { maximumFractionDigits: 0 });
let g = null, step = 1, amt = 0, iv = 'month', as = 'none', show = false;
const price = () => iv === 'year' ? amt * g.year_months : amt;
function pills(el, items, cur, key) {
  el.innerHTML = items.map(([v, l]) => `<button type="button" class="ct-pill" role="radio" data-${key}="${v}" aria-checked="${String(v) === String(cur)}">${l}</button>`).join('');
}
function draw() {
  $('#ct-flowname').textContent = `${g.name} · ${g.kind}`;
  $$('.ct-steps li').forEach(li => { const n = +li.dataset.step; li.toggleAttribute('aria-current', n === step); if (n === step) li.setAttribute('aria-current', 'step'); li.classList.toggle('is-done', n < step); });
  $$('.ct-step').forEach(p => p.classList.toggle('ct-hidden', +p.dataset.panel !== step));
  pills($('#ct-int'), g.intervals.map(i => [i, i === 'year' ? `Yearly (${g.year_months} months' price)` : 'Monthly']), iv, 'iv');
  pills($('#ct-amt'), g.amounts.map((a, i) => [a, (g.levels ? g.levels[i] + ' · ' : '') + (iv === 'year' ? `${eur0(a * g.year_months)} / year` : `${eur0(a)} / month`)]), amt, 'a');
  const s = g.splits[`${iv}-${amt}`];
  $('#ct-split').innerHTML = `Of ${eur(s.price)}, ${eur(s.vat)} is VAT for the tax authority, ${eur(s.fee)} goes to the payment company, and <b>${eur(s.net)}</b> reaches Numinia.`;
  $$('#ct-as .ct-pill').forEach(b => b.setAttribute('aria-checked', String(b.dataset.as === as)));
  $$('#ct-show .ct-pill').forEach(b => b.setAttribute('aria-checked', String((b.dataset.show === '1') === show)));
  $('#ct-namefield').classList.toggle('ct-hidden', as === 'none');
  $('#ct-namelabel').textContent = as === 'alias' ? 'Alias' : 'Name';
  const who = as === 'none' ? 'Anonymous' : ($('#ct-name').value.trim() || (as === 'alias' ? 'your alias' : 'your name'));
  $('#ct-preview').textContent = who + (show ? ` · ${iv === 'year' ? eur0(price()) + ' a year' : eur0(amt) + ' a month'}` : '');
  $('#ct-sum').innerHTML = `<tr><td>${g.name}${g.levels ? ' · ' + g.levels[g.amounts.indexOf(amt)] : ''}</td><td>${iv === 'year' ? 'yearly' : 'monthly'}</td></tr>`
    + `<tr><td>You receive</td><td style="font-family:var(--font-sans);text-align:right;max-width:30ch">${g.delivers}</td></tr>`
    + `<tr><td>Appearing as</td><td>${$('#ct-preview').textContent}</td></tr>`
    + `<tr><td>VAT included</td><td>${eur(s.vat)}</td></tr>`
    + `<tr class="ct-tot"><td>Total ${iv === 'year' ? 'a year' : 'a month'}</td><td>${eur(s.price)}</td></tr>`;
  const pay = $('#ct-pay');
  if (g.payable) { pay.disabled = false; pay.textContent = `Pay ${eur(s.price)} — an obligation to pay`; } else { pay.disabled = true; pay.textContent = 'Coming soon'; }
  $('#ct-back').style.visibility = step > 1 ? 'visible' : 'hidden';
  $('#ct-next').classList.toggle('ct-hidden', step === 3);
}
function open(id) {
  g = G.find(x => x.id === id);
  $$('.ct-card').forEach(c => c.classList.toggle('is-open', c.dataset.good === id)); step = 1; amt = g.amounts[0]; iv = g.intervals[0]; as = 'none'; show = false; $('#ct-name').value = '';
  const f = $('#ct-flow'); f.classList.remove('ct-hidden');
  draw(); f.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
}
$$('[data-open]').forEach(b => b.addEventListener('click', () => open(b.dataset.open)));
$('#ct-flow').addEventListener('click', e => {
  const t = e.target.closest('button'); if (!t) return;
  if (t.dataset.iv) { iv = t.dataset.iv; draw(); }
  else if (t.dataset.a) { amt = +t.dataset.a; draw(); }
  else if (t.dataset.as) { as = t.dataset.as; draw(); }
  else if (t.dataset.show) { show = t.dataset.show === '1'; draw(); }
  else if (t.id === 'ct-next') { step = Math.min(3, step + 1); draw(); }
  else if (t.id === 'ct-back') { step = Math.max(1, step - 1); draw(); }
  else if (t.id === 'ct-pay' && g.payable) { location.href = g.link; }
});
$('#ct-name').addEventListener('input', draw);
if (location.hash.slice(1) && G.some(x => x.id === location.hash.slice(1))) open(location.hash.slice(1));
window.CT = { G, open, state: () => ({ step, amt, iv, as, show, payable: g && g.payable }) };
})();
</script>
