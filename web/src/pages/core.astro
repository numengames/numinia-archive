---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// /core — the core of the archive as a flow: each principle, the standards that
// make it concrete, the procedures that carry it out.
//
// WHY THIS PAGE EXISTS
// The Oracle reviews the core by listening to it (2026-09-27). The shelves
// give three lists; this page gives the chain a reviewer follows — this
// belief, these rules, these steps — and each principle opens its own page to be
// heard end to end with the site's reading player, like /design does for the
// design system.
//
// NOTHING HERE IS TYPED. The grouping is each document's `derived_from`
// header; titles, questions, summaries and states are read from the files at
// build time (web/src/lib/core.ts). A standard with no principle fails the build.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import { coreFlow } from "@/lib/core";

const flow = coreFlow();
const count = (s: string) =>
  flow.reduce((n, c) => n + [c, ...c.standards, ...c.procedures].filter((d) => d.status === s).length, 0);
const total = flow.reduce((n, c) => n + 1 + c.standards.length + c.procedures.length, 0);
const state = (s: string) => (s === "active" ? "in force" : s);
---

<Layout
  title="The core, as a flow — NWOS"
  description="Each principle of Numinia, the standards that make it concrete and the procedures that carry it out, one chain per principle, to read or to hear end to end."
  canonicalPath="/core"
>
  <PageHero
    label="The core"
    title="Belief, rule, step"
    description="Each principle, the standards that make it concrete, and the procedures that carry it out. Open a principle to read or hear its whole chain, end to end."
  />

  <section class="pb-24">
    <div class="mx-auto max-w-[800px] px-6">
      <div class="mb-8">
        <DocToolbar mdUrl="/core.md" filename="core.md" lang="en" />
      </div>

      <p class="text-sm leading-relaxed text-muted-foreground mb-10">
        {flow.length} principles, {total} documents: <span class="text-foreground">{count("active")} in force</span>,
        {count("draft")} draft. Every standard and procedure names the principle it comes from in its own
        header, and this page is built from that field alone. What binds right now is at
        <a href="/binding" class="text-accent underline underline-offset-2">what binds today</a>.
      </p>

      <ol class="space-y-6">
        {flow.map((c) => (
          <li class="rounded-[8px] border border-border bg-card p-5 sm:p-6">
            <a href={c.href} class="group block">
              <div class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim mb-1">
                Principle · {state(c.status)} · {c.standards.length} standards · {c.procedures.length} procedures
              </div>
              <h2 class="font-display text-2xl text-foreground group-hover:text-accent">{c.title}</h2>
              <p class="mt-1 text-sm italic text-muted-foreground">{c.question}</p>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{c.summary}</p>
            </a>
            {(c.standards.length > 0 || c.procedures.length > 0) && (
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {[["Standards", c.standards], ["Procedures", c.procedures]].map(([label, docs]) => (
                  (docs as typeof c.standards).length > 0 && (
                    <div>
                      <div class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-accent mb-2">{label as string}</div>
                      <ul class="space-y-1">
                        {(docs as typeof c.standards).map((d) => (
                          <li class="flex items-baseline gap-2 text-sm">
                            <a href={d.docHref} class="flex-1 text-muted-foreground hover:text-accent">{d.title}</a>
                            <span class:list={["font-mono text-[0.55rem] uppercase tracking-[0.1em] shrink-0", d.status === "active" ? "text-accent" : "text-dim"]}>{state(d.status)}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )
                ))}
              </div>
            )}
            <a href={c.href} class="mt-4 inline-block font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent hover:underline">Read or hear the whole chain →</a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>
