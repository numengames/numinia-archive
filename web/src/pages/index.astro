---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// / — the Summa: how the archive is classified, read from the archive.
//
// WHAT THIS PAGE USED TO BE
// Until 2026-09-21 the home was a hand-written product pitch ("Narrative
// Work OS", five layers, six features, six principles, requirements) that
// restated BLU-008 from memory; the classification of the archive — the one
// page that says what this place holds and how it is organised — was
// /archive, reachable from the tenth pill of the bar. The Oracle's call: the
// classification carries the weight of a home, and the pitch is a reference
// manual. So this is the old /archive page with a door on it, the pitch is
// system/SYS-006-nwos-system.md, and /archive redirects here.
//
// Before that, /archive itself had been a hardcoded Spanish array of seven
// "fondos" naming folders deleted months earlier. Every row here comes from
// STD-027 (the scheme) and STD-001 (the series) via @/lib/classification.
// Nothing about the classification is written on this page: if a function is
// added to the standard, it appears here; if a series moves, this page moves
// with it or the build fails.
//
// THE HERO is BLU-009 §12's skeleton: eyebrow, one typed sentence with one
// word in Ámbar (the piece's only orchestrated moment, catalogue 01), the
// site's own line, one primary action. The full text is in the DOM before
// the typing starts (DSN-008); reduced motion shows it at once.
//
// THE GRAPH is the one picture of how the six functions relate. Until today
// it loaded `three` from esm.sh at runtime and rotated forever — a
// third-party request in production (DSN-002) and an ambient loop outside
// the two the catalogue sanctions (DSN-012). Now: `three` is a dependency in
// the site's own bundle; the scene is still; the reader turns it by dragging;
// its entrance is one surfacing (catalogue 10) when it scrolls into view;
// under reduced motion it appears already placed.
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { functions, counts, graphNodes, RELATIONS } from "@/lib/classification";
import { HOUSE_LINKS, THIS_SITE } from "@/data/house-links";

const fns = functions();
const n = counts();
const nodes = graphNodes();
const edges = RELATIONS.map((e) => [e[0], e[1]]);
const site = HOUSE_LINKS.find((s) => s.id === THIS_SITE)!;

// One glyph per function. Presentation, not classification — which is why it
// lives here and not in the standard. Same table as /archive/[function].
const FN_ICON: Record<string, string> = {
  governance: "bank",
  production: "lightning",
  assurance: "shield-check",
  agency: "robot",
  creation: "sparkle",
  administration: "gear",
};

const FN_ACCENT: Record<string, { border: string; bg: string; text: string }> = {
  governance:     { border: "border-green/20",  bg: "bg-green/5",  text: "text-green" },
  production:     { border: "border-yellow/20", bg: "bg-yellow/5", text: "text-yellow" },
  assurance:      { border: "border-blue/20",   bg: "bg-blue/5",   text: "text-blue" },
  agency:         { border: "border-accent/20", bg: "bg-accent/5", text: "text-accent" },
  creation:       { border: "border-purple/20", bg: "bg-purple/5", text: "text-purple" },
  administration: { border: "border-yellow/20", bg: "bg-yellow/5", text: "text-yellow" },
};
---

<Layout
  title="NWOS — the archive of Numen Games"
  description={`The archive of Numen Games, built in public: one fond, ${n.functions} functions, ${n.activities} activities and the ${n.series} series they produce — canon, decisions, missions, how the work is done.`}
  canonicalPath=""
>
  <!-- The hero: the thesis, typed; one word in Ámbar; one primary action -->
  <section class="pb-12 pt-16 sm:pt-24">
    <div class="mx-auto max-w-[1100px] px-6">
      <span class="mb-4 inline-block font-mono text-[0.7rem] font-medium uppercase tracking-[0.25em] text-accent">
        Numen Games · the archive
      </span>
      <h1
        id="thesis"
        data-tecleo
        class="font-display text-4xl tracking-tight text-foreground sm:text-5xl lg:text-6xl"
      >
        One producer, one fond, <span class="text-yellow">six</span> functions.
      </h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted-foreground">
        {site.what.charAt(0).toUpperCase() + site.what.slice(1)}: what Numen Games is, what it has decided, what it is
        building and how the work is done — as files, classified by the activity that produced them, not by who did.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/canon/"
          class="inline-flex min-h-[44px] items-center gap-2 rounded-[6px] bg-accent px-5 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-background transition-colors hover:bg-accent/85"
        >
          Read the canon
          <Icon name="caret-left" size={12} class="rotate-180" />
        </a>
        <a
          href="/system/sys-003-archive-fondos"
          class="inline-flex min-h-[44px] items-center font-mono text-[0.7rem] uppercase tracking-[0.15em] text-dim transition-colors hover:text-foreground"
        >
          The manual behind this page →
        </a>
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="mx-auto max-w-[1100px] px-6">

      <!-- The figures, counted from the scheme, never typed -->
      <div class="grid gap-4 grid-cols-2 sm:grid-cols-4 mb-12">
        <div class="rounded-[8px] border border-border bg-card p-5 text-center">
          <p class="font-display text-4xl text-foreground">1</p>
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mt-1">Fond</p>
        </div>
        <div class="rounded-[8px] border border-accent/20 bg-accent/5 p-5 text-center">
          <p class="font-display text-4xl text-accent">{n.functions}</p>
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mt-1">Functions</p>
        </div>
        <div class="rounded-[8px] border border-border bg-card p-5 text-center">
          <p class="font-display text-4xl text-foreground">{n.activities}</p>
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mt-1">Activities</p>
        </div>
        <div class="rounded-[8px] border border-green/20 bg-green/5 p-5 text-center">
          <p class="font-display text-4xl text-green">{n.series}</p>
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mt-1">Series</p>
        </div>
      </div>

      <div class="rounded-[8px] border border-border bg-card p-6 mb-12 max-w-[780px]">
        <p class="text-sm text-muted-foreground leading-relaxed">
          A <strong class="text-foreground">fond</strong> is everything one producer generates — here,
          Numen Games S.L. A <strong class="text-foreground">function</strong> is something the
          organisation does, named with a noun; an <strong class="text-foreground">activity</strong> is
          the verb under it; a <strong class="text-foreground">series</strong> is the folder of documents
          that activity produces. The identifier of a document names its series and never its function,
          so functions can be regrouped without moving a file or breaking a citation.
        </p>
        <p class="text-sm text-muted-foreground leading-relaxed mt-3">
          This page is generated from the two documents that own the scheme:
          <a href="/standards/std-027-the-classification-scheme" class="text-accent hover:underline">the classification scheme</a>
          holds the functions and their activities,
          <a href="/standards/std-001-the-series" class="text-accent hover:underline">the series register</a>
          holds what each series contains. The decision that cut them is
          <a href="/decisions/adr-046" class="text-accent hover:underline">ADR-046</a>.
        </p>
      </div>

      <!-- Relations between the functions -->
      <div class="mb-4 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">How the functions relate</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="rounded-[8px] border border-border bg-card p-6 mb-12 relative" data-surface>
        <p class="text-xs text-muted-foreground mb-4">
          Governance feeds agency and production; administration sustains them; production is observed by
          assurance and born from planning; creation supplies what production builds with.
          <span class="text-dim"> Drag to turn.</span>
        </p>
        <div id="archive-3d" class="cursor-grab active:cursor-grabbing" style="width:100%;height:320px;" aria-hidden="true"></div>
        <!-- The same relations as text, for readers the canvas does not reach -->
        <ul class="sr-only">
          {RELATIONS.map(([a, b]) => <li>{a} → {b}</li>)}
        </ul>
      </div>

      <!-- The six functions -->
      <div class="mb-4 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">The {n.functions} functions</span>
        <span class="h-px flex-1 bg-border"></span>
        <span class="font-mono text-[0.6rem] text-dim">{n.published} of {n.series} series have an address here</span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-16">
        {fns.map((f) => {
          const a = FN_ACCENT[f.slug] ?? FN_ACCENT.governance;
          return (
            <a href={f.href} class={`rounded-[8px] border p-5 ${a.border} ${a.bg} hover:border-accent/50 transition-colors group block`}>
              <div class="flex items-start justify-between mb-3">
                <span class={a.text}><Icon name={FN_ICON[f.slug] ?? "archive"} size={22} /></span>
                <span class={`font-mono text-[0.55rem] uppercase tracking-[0.15em] ${a.text} opacity-70`}>
                  {f.activities.length} {f.activities.length === 1 ? "activity" : "activities"}
                </span>
              </div>
              <h2 class={`font-display text-xl mb-2 ${a.text}`}>{f.name}</h2>
              <p class="font-mono text-[0.65rem] text-dim leading-relaxed mb-3">
                {f.activities.map((act) => act.name).join(" · ")}
              </p>
              <div class="flex flex-wrap gap-1 border-t border-border/50 pt-3">
                {f.activities.flatMap((act) => act.series).map((s) => (
                  <span class="font-mono text-[0.5rem] bg-background/50 border border-border/50 rounded-[6px] px-1.5 py-0.5 text-dim">{s.folder}</span>
                ))}
              </div>
              <p class="mt-3 font-mono text-[0.55rem] text-accent opacity-0 group-hover:opacity-100 transition-opacity">See the function →</p>
            </a>
          );
        })}
      </div>

      <!-- The whole scheme, one row per series -->
      <div class="mb-4 flex items-center gap-3">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">The scheme in full</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="rounded-[8px] border border-border bg-card overflow-x-auto mb-8">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-border">
              <th scope="col" class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim px-4 py-3">Function</th>
              <th scope="col" class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim px-4 py-3">Activity</th>
              <th scope="col" class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim px-4 py-3">Series</th>
              <th scope="col" class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim px-4 py-3">Holds</th>
            </tr>
          </thead>
          <tbody>
            {fns.flatMap((f) =>
              f.activities.flatMap((act, ai) =>
                act.series.map((s, si) => (
                  <tr class="border-b border-border/40 last:border-0">
                    <td class="px-4 py-3 align-top font-mono text-[0.65rem] text-accent whitespace-nowrap">
                      {ai === 0 && si === 0 ? <a href={f.href} class="hover:underline">{f.name}</a> : ""}
                    </td>
                    <td class="px-4 py-3 align-top font-mono text-[0.65rem] text-foreground whitespace-nowrap">
                      {si === 0 ? act.name : ""}
                    </td>
                    <td class="px-4 py-3 align-top whitespace-nowrap">
                      {s.href
                        ? <a href={s.href} class="font-mono text-[0.65rem] text-accent hover:underline">{s.folder}</a>
                        : <span class="font-mono text-[0.65rem] text-dim">{s.folder}</span>}
                      {s.instrument && (
                        <span class="ml-2 font-mono text-[0.5rem] uppercase tracking-[0.12em] text-dim">instrument</span>
                      )}
                    </td>
                    <td class="px-4 py-3 align-top text-xs text-muted-foreground leading-relaxed">
                      {s.holds || s.note}
                    </td>
                  </tr>
                )),
              ),
            )}
          </tbody>
        </table>
      </div>

      <!-- The second fond -->
      <div class="rounded-[8px] border border-purple/20 bg-purple/5 p-6 max-w-[780px]">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-purple mb-3">The second fond</p>
        <p class="text-sm text-muted-foreground leading-relaxed">
          <a href="/lore/" class="font-mono text-xs text-foreground hover:text-accent">lore/</a> is recognised as a fond of its own:
          a different producer relationship and a different licence regime from the administrative corpus.
          It is listed in the scheme because the two fonds are read together, not because it belongs to the
          first. It is served here for reading, all rights reserved.
        </p>
      </div>

    </div>
  </section>
</Layout>

<script>
  // Typing (catalogue 01): 22 ms per character, block cursor in Ámbar. The
  // full sentence is in the DOM before this runs and stays readable to
  // assistive tech through aria-label while the characters appear. Reduced
  // motion: the text simply is.
  const el = document.querySelector<HTMLElement>("[data-tecleo]");
  const rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (el && !rm) {
    el.setAttribute("aria-label", el.textContent ?? "");
    const nodes: { node: Text; text: string }[] = [];
    (function walk(n: Node) {
      n.childNodes.forEach((c) => {
        if (c.nodeType === Node.TEXT_NODE) { nodes.push({ node: c as Text, text: c.nodeValue ?? "" }); c.nodeValue = ""; }
        else walk(c);
      });
    })(el);
    const cur = document.createElement("span");
    cur.className = "inline-block w-[0.55em] h-[1em] align-[-0.1em] bg-yellow animate-cursor";
    cur.setAttribute("aria-hidden", "true");
    el.appendChild(cur);
    let i = 0, j = 0;
    (function step() {
      if (i >= nodes.length) { setTimeout(() => { cur.remove(); el.removeAttribute("aria-label"); }, 900); return; }
      const n = nodes[i];
      if (j < n.text.length) { n.node.nodeValue += n.text[j++]; n.node.parentNode?.appendChild(cur); setTimeout(step, 22); }
      else { i++; j = 0; step(); }
    })();
  }
</script>

<script>
  // The relation graph. `three` from the site's own bundle (DSN-002); still by
  // default, turned by pointer drag; entrance = one surfacing when the panel
  // scrolls into view (catalogue 10, 560 ms); reduced motion = already placed.
  import * as THREE from "three";

  interface GNode { id: string; label: string; subtitle: string; color: number; x: number; y: number; z: number }
  const el = document.getElementById("archive-3d");
  const data = document.getElementById("archive-graph-data");
  if (el && data) {
    const { nodes, edges } = JSON.parse(data.textContent ?? "{}") as { nodes: GNode[]; edges: [string, string][] };
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const w = el.offsetWidth || 400, h = 320;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(55, w / h, 0.1, 100);
    camera.position.set(0, 1, 7.5);
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(w, h);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x000000, 0);
    el.appendChild(renderer.domElement);

    const group = new THREE.Group();
    scene.add(group);
    scene.add(new THREE.AmbientLight(0xffffff, 0.3));

    const pos: Record<string, THREE.Vector3> = {};
    for (const n of nodes) {
      const mesh = new THREE.Mesh(
        new THREE.SphereGeometry(0.18, 20, 20),
        new THREE.MeshStandardMaterial({ color: n.color, emissive: n.color, emissiveIntensity: 0.6 }),
      );
      mesh.position.set(n.x, n.y, n.z);
      group.add(mesh);
      pos[n.id] = new THREE.Vector3(n.x, n.y, n.z);
      const light = new THREE.PointLight(n.color, 0.4, 3);
      light.position.copy(mesh.position);
      group.add(light);
    }
    for (const [a, b] of edges) {
      if (!pos[a] || !pos[b]) continue;
      group.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([pos[a].clone(), pos[b].clone()]),
        new THREE.LineBasicMaterial({ color: 0x3a332d, opacity: 0.7, transparent: true }),
      ));
    }

    // Labels in the DOM over the canvas — legible, never occluded.
    const layer = document.createElement("div");
    layer.style.cssText = "position:absolute;top:0;left:0;pointer-events:none;overflow:hidden;width:100%;height:100%;";
    el.style.position = "relative";
    el.appendChild(layer);
    const labels: { el: HTMLElement; pos: THREE.Vector3 }[] = [];
    for (const n of nodes) {
      const div = document.createElement("div");
      div.style.cssText = "position:absolute;top:0;left:0;font-family:var(--font-mono);text-align:center;pointer-events:none;";
      const hex = "#" + n.color.toString(16).padStart(6, "0");
      div.innerHTML =
        `<span style="display:block;font-size:11px;font-weight:bold;color:${hex};text-shadow:0 0 6px #000,0 0 3px #000;white-space:nowrap;">${n.label}</span>` +
        `<span style="display:block;font-size:8px;color:#aaa;text-shadow:0 0 4px #000;white-space:nowrap;">${n.subtitle}</span>`;
      layer.appendChild(div);
      labels.push({ el: div, pos: pos[n.id].clone() });
    }

    function render() {
      renderer.render(scene, camera);
      for (const item of labels) {
        const p = item.pos.clone();
        group.localToWorld(p);
        p.project(camera);
        item.el.style.transform =
          `translate(-50%, -140%) translate(${(p.x * 0.5 + 0.5) * el!.offsetWidth}px, ${(-p.y * 0.5 + 0.5) * el!.offsetHeight}px)`;
        item.el.style.display = p.z < 1 ? "block" : "none";
      }
    }

    // A resting pose that shows every node; the reader turns it from here.
    group.rotation.y = 0.6;
    group.rotation.x = 0.12;

    new ResizeObserver((entries) => {
      const r = entries[0].contentRect;
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
      renderer.setSize(r.width, r.height);
      render();
    }).observe(el);

    // Drag to turn — pointer events cover mouse, touch and pen.
    let dragging = false, lastX = 0, lastY = 0;
    el.addEventListener("pointerdown", (e) => { dragging = true; lastX = e.clientX; lastY = e.clientY; el.setPointerCapture(e.pointerId); });
    el.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      group.rotation.y += (e.clientX - lastX) * 0.01;
      group.rotation.x = Math.max(-0.6, Math.min(0.6, group.rotation.x + (e.clientY - lastY) * 0.01));
      lastX = e.clientX; lastY = e.clientY;
      render();
    });
    const stop = () => { dragging = false; };
    el.addEventListener("pointerup", stop);
    el.addEventListener("pointercancel", stop);

    // Entrance: surfacing (10) — opacity 0→1, blur 8→0, 8 px rise, 560 ms, once.
    const surface = el.closest<HTMLElement>("[data-surface]") ?? el;
    if (reduced || !("IntersectionObserver" in window)) {
      render();
    } else {
      surface.style.opacity = "0";
      surface.style.filter = "blur(8px)";
      surface.style.transform = "translateY(8px)";
      surface.style.transition = "opacity 560ms ease-out, filter 560ms ease-out, transform 560ms ease-out";
      const io = new IntersectionObserver((es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        render();
        surface.style.opacity = "1";
        surface.style.filter = "none";
        surface.style.transform = "none";
        io.disconnect();
      }, { rootMargin: "0px 0px -10% 0px" });
      io.observe(surface);
    }
  }
</script>

<script is:inline id="archive-graph-data" type="application/json" set:html={JSON.stringify({ nodes, edges })} />

<style>
  /* Block cursor (catalogue 08): 1 s, steps(2). */
  @keyframes cursor { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
  .animate-cursor { animation: cursor 1s steps(2, start) infinite; }
  @media (prefers-reduced-motion: reduce) { .animate-cursor { animation: none; } }
</style>
