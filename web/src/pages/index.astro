---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// / — the front door: the archive, arranged by the ten business sections of
// STD-030 ("Sections of the front door").
//
// THE ORACLE'S WORD (2026-09-29 → 2026-10-03)
// The original language of the archive is the company's; Numinia enriches
// it. So numinia.org opens on the archive read the way a company reads
// itself — strategy, products, brand, sales, operations, people, finance,
// legal, technology, knowledge — and the map of the Summa, the home until
// today, lives at /map. Each section shows its title, its one line from the
// standard, how many records it holds and the records grouped by series.
// Gaps are shown, not hidden: a section with nothing in it says so, and the
// records no section claims yet are listed apart.
//
// THE THREE MOONS
// Every label the register holds is marked (wordAttrs / textAttrs /
// siteNameAttrs), so the dial in the bar changes the page without a reload.
// A section KEEPS its business name at every stop; at the full moon a line
// appears beneath it — "served by: <houses>" — from translator.servedBy, with
// the disciplines no house carries yet. No name is invented here: what the
// archive has no word for keeps today's word (narrative-words GAPS).
//
// What /about carried (the books, the sister sites, the alpha notice) moved
// here; /about redirects to /.
import Layout from "@/layouts/Layout.astro";
import DocToolbar from "@/components/DocToolbar.astro";
import Icon from "@/components/Icon.astro";
import { repoFileUrl } from "@/lib/build-info";
import { BOOKS, LENSES } from "@/lib/summa";
import { frontDoor } from "@/lib/front-door";
import { SOURCE as SECTIONS_SOURCE } from "@/lib/translator.mjs";
import { wordAttrs, textAttrs, siteNameAttrs, SITE_NAME } from "@/lib/narrative-words.mjs";

const { sections, unplaced, unplacedCount, total } = await frontDoor();
const THESIS = "The archive, by section.";
const WHAT = "The archive of Numen Games: everything we decide, build and offer, written down and open. Numinia is the story we tell it in — a city where work is a game.";
const EMPTY = "Nothing written yet.";
const brand = BOOKS.find((b) => b.href === "/brand")!;
---

<Layout title="" description="The archive of Numen Games, by section: strategy, products, brand, sales, operations, people, finance, legal, technology, knowledge. Every record, open to read." canonicalPath="/">
  <section class="pb-8 pt-14 sm:pt-20">
    <div class="mx-auto max-w-[1100px] px-6">
      <span class="mb-3 inline-block font-mono text-[0.7rem] font-medium uppercase tracking-[0.25em] text-accent" {...siteNameAttrs()}>{SITE_NAME.bridge.text}</span>
      <h1 class="font-display text-4xl tracking-tight text-foreground sm:text-5xl" {...textAttrs("home.thesis", THESIS)}>{THESIS}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground" data-nw-lead {...textAttrs("home.what", WHAT)}>{WHAT}</p>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">
        The system is in alpha: most documents are drafts, rules on trial — followed, they warn and never block.
        <a href="/binding" class="text-accent hover:underline">What binds today</a> lists the few in force; what is broken is in
        <a href="/debt/" class="text-accent hover:underline">the debt register</a>, what changed in
        <a href="/updates/" class="text-accent hover:underline">Updates</a>, what can be counted in
        <a href="/telemetry" class="text-accent hover:underline">Telemetry</a>.
        Reading as an agent? Start at <a href="/llms.txt" class="text-accent hover:underline">llms.txt</a>; any address plus <code class="font-mono text-sm text-foreground">.md</code> gives the file behind the page.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href={brand.href!} class="pill" title={brand.line}><Icon name="archive" size={14} /> Who we are — {brand.label.toLowerCase()} →</a>
        <a href="/map" class="pill" title="The Summa drawn as a map: the rules, the work, the world and the offer"><Icon name="crosshair" size={14} /> The map →</a>
      </div>
      <div class="mt-6">
        <DocToolbar mdUrl="/home.md" filename="home.md" repoUrl={repoFileUrl(SECTIONS_SOURCE)} lang="en" />
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="mx-auto max-w-[1100px] px-6">
      <!-- The ten sections at a glance: each a jump to its block. -->
      <nav class="mb-10 flex flex-wrap gap-2" aria-label="Sections">
        {sections.map((s) => <a href={`#${s.id}`} class="pill small">{s.name} <span class="text-dim">{s.count}</span></a>)}
        {unplacedCount > 0 && <a href="#without-a-section" class="pill small todo">Without a section <span class="text-dim">{unplacedCount}</span></a>}
      </nav>

      {sections.map((s) => (
        <section id={s.id} class="fd-section border-t border-border/60 py-10 grid gap-6 lg:grid-cols-[300px_minmax(0,1fr)]">
          <div>
            <h2 class="font-display text-2xl tracking-tight text-foreground sm:text-3xl"><a href={`#${s.id}`} class="hover:text-accent transition-colors">{s.name}</a></h2>
            <p class="mt-2 text-base leading-relaxed text-muted-foreground">{s.line}</p>
            <p class="mt-3 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim"><span class="text-foreground">{s.count}</span> records</p>
            {/* Full moon only: the houses that serve the section, and the disciplines no house carries. */}
            <div class="fd-served mt-3 text-sm leading-relaxed">
              {s.served.houses.length > 0
                ? <p class="text-muted-foreground">served by: <span class="text-foreground">{s.served.houses.join(" · ")}</span></p>
                : <p class="text-muted-foreground">served by: <span class="text-dim">no house yet</span></p>}
              {s.served.gaps.map((g) => <p class="text-dim">no house carries: {g}</p>)}
            </div>
          </div>
          <div>
            {s.count === 0 && <p class="text-sm text-muted-foreground" {...textAttrs("home.empty", EMPTY)}>{EMPTY}</p>}
            {s.groups.map((g) => (
              <div class="mb-6 last:mb-0">
                <h3 class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-accent" {...wordAttrs(g.label)}>{g.label}</h3>
                <ul class:list={["fd-records", g.records.length > 6 && "sm:columns-2"]}>
                  {g.records.map((r) => (
                    <li class="break-inside-avoid border-b border-border/40 py-1.5 text-sm leading-snug">
                      <a href={r.href} class="text-foreground hover:text-accent transition-colors">{r.title}</a>
                      {r.docId && <span class="ml-2 font-mono text-[0.65rem] text-dim">{r.docId}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      ))}

      {unplacedCount > 0 && (
        <section id="without-a-section" class="fd-section border-t border-border/60 py-10 grid gap-6 lg:grid-cols-[300px_minmax(0,1fr)]">
          <div>
            <h2 class="font-display text-2xl tracking-tight text-foreground sm:text-3xl"><a href="#without-a-section" class="hover:text-accent transition-colors">Without a section</a></h2>
            <p class="mt-2 text-base leading-relaxed text-muted-foreground">Records that declare no section of the standard yet. A gap, shown rather than hidden.</p>
            <p class="mt-3 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim"><span class="text-foreground">{unplacedCount}</span> records</p>
          </div>
          <div>
            {unplaced.map((g) => (
              <div class="mb-6 last:mb-0">
                <h3 class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-accent" {...wordAttrs(g.label)}>{g.label}</h3>
                <ul class:list={["fd-records", g.records.length > 6 && "sm:columns-2"]}>
                  {g.records.map((r) => (
                    <li class="break-inside-avoid border-b border-border/40 py-1.5 text-sm leading-snug">
                      <a href={r.href} class="text-foreground hover:text-accent transition-colors">{r.title}</a>
                      {r.docId && <span class="ml-2 font-mono text-[0.65rem] text-dim">{r.docId}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )}

      <p class="border-t border-border/60 pt-6 text-sm leading-relaxed text-muted-foreground">
        <span class="text-foreground">{total}</span> records. A section groups records for a reader; it does not file them —
        <a href="/scheme" class="text-accent hover:underline">the classification scheme</a> does. The sections follow the
        <a href="/standards/std-030-the-worlds-vocabulary" class="text-accent hover:underline">world's vocabulary</a> (STD-030).
      </p>

      <!-- What /about carried: the books and the sister sites (2026-10-03). -->
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <div class="rounded-[8px] border border-border bg-card/60 p-5">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-1">Books</p>
          <p class="text-sm text-muted-foreground mb-3">Documents from several series gathered to read or hear end to end.</p>
          <div class="flex flex-wrap gap-2">
            {BOOKS.map((b) => b.href
              ? <a href={b.href} class="pill" title={b.line}>{b.label} →</a>
              : <span class="pill todo" title={b.pending}>{b.label} · soon</span>)}
          </div>
        </div>
        <div class="rounded-[8px] border border-border bg-card/60 p-5">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-1">Our other sites</p>
          <p class="text-sm text-muted-foreground mb-3">Each one shows a part of this archive to the people it is for.</p>
          <div class="flex flex-wrap gap-2">
            {LENSES.map((l) => <a href={l.href} rel="noopener" class="pill" title={`${l.who}. ${l.line}`}>{l.site} ↗</a>)}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .pill { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 14px; border: 1px solid rgb(var(--border)); border-radius: 6px; background: rgb(var(--bg)); color: rgb(var(--text)); font-size: .9375rem; transition: border-color .15s, background-color .15s, color .15s; }
  .pill.small { min-height: 32px; padding: 2px 10px; font-size: .8125rem; gap: 6px; }
  a.pill:hover, a.pill:focus-visible { border-color: rgb(var(--accent)); background: rgb(var(--accent) / .08); color: rgb(var(--accent)); }
  .pill.todo { border-style: dashed; background: transparent; color: rgb(var(--text-muted)); }
  .fd-records { list-style: none; margin: 0; padding: 0; column-gap: 32px; }
  .fd-section { scroll-margin-top: 72px; }
  /* The served-by line belongs to the full moon: the city's houses, under the company's section. */
  .fd-served { display: none; }
  :global(html[data-narrative="numinia"]) .fd-served { display: block; }
</style>
