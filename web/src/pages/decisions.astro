---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// Decision registry, rendered from the repo's decisions/ folder (MIS-065:
// the folder is the source of truth — no hardcoded copy).
import Layout from "@/layouts/Layout.astro";
import { placeOf } from "@/lib/classification";
// The drawer this index opens, from the scheme: "Assurance · Observing".
const here = placeOf("decisions/")!;
import PageHero from "@/components/PageHero.astro";
import { getCollection } from "astro:content";

const STATUS_COLOR: Record<string, string> = {
  active: "text-green",
  draft: "text-yellow",
  withdrawn: "text-dim",
};

const decisions = (await getCollection("decisions")).sort((a, b) =>
  (a.data.id as string).localeCompare(b.data.id as string)
);
---

<Layout
  title="Decisiones — Numen Games CAO"
  description="Registro de decisiones arquitectónicas y estratégicas del NWOS, renderizado desde decisions/ en el repo canónico."
  canonicalPath="/decisions"
  activeNav="decisions/"
>
  <PageHero
    label={`${here.fn.name} · ${here.activity.name}`}
    title="Decisiones"
    description="Registro append-only de decisiones — cada una es un .md en el repo."
  />

  <section class="pb-24">
    <div class="mx-auto max-w-[800px] px-6 space-y-4">
      {decisions.map((d) => (
        <a
          href={"/decisions/" + (d.data.id as string).toLowerCase()}
          class="block rounded-xl border border-border bg-card p-6 hover:bg-card-hover transition-colors"
        >
          <div class="flex flex-wrap items-center gap-3 mb-2">
            <span class="font-mono text-[0.65rem] text-accent">{d.data.id}</span>
            <span class="font-mono text-[0.6rem] text-dim">{String(d.data.created).slice(0, 10)}</span>
            <span class={"font-mono text-[0.6rem] uppercase tracking-widest " + (STATUS_COLOR[d.data.status] || "text-dim")}>{d.data.status}</span>
            {(d.data.territory ?? d.data.area) && <span class="font-mono text-[0.6rem] text-dim">{d.data.territory ?? d.data.area}</span>}
          </div>
          <p class="text-base font-medium text-foreground leading-snug">{d.data.title}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
