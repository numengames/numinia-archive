  .auto .ring .w { fill: var(--t2); font: 500 12px var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .auto .ring.in .w, .auto .ring.sel .w { fill: var(--t1); }
  .auto .core-t { fill: var(--t1); font: 500 20px var(--font-sans); text-anchor: middle; pointer-events: none; }
  .auto .core-s { fill: var(--t2); font: 500 10px var(--font-mono); letter-spacing: .14em; text-transform: uppercase; text-anchor: middle; pointer-events: none; }
  .auto .floor-ring { fill: none; stroke: rgb(var(--red) / .55); stroke-dasharray: 2 5; }
  .auto .floor-l { fill: rgb(var(--red)); font: 500 10px var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .auto .marks[hidden] { display: none; }
  .auto .agent-dot { fill: var(--amb); stroke: rgb(var(--bg)); stroke-width: 2; }
  .auto .agent-dot.ghost { fill: var(--t3); }
  .auto .agent-l { fill: var(--t2); font: 500 10px var(--font-mono); letter-spacing: .10em; text-transform: uppercase; pointer-events: none; }
  @media (max-width: 600px) { .auto .ring .w { font-size: 18px; letter-spacing: .06em; } }
  .auto h2.sec { font: 500 1.728rem/1.15 var(--font-sans); letter-spacing: -.01em; margin: 64px 0 8px; color: var(--t1); }
  .auto p.lede { color: var(--t2); max-width: 720px; margin: 0 0 18px; }
  .auto .legend { display: flex; gap: 18px; flex-wrap: wrap; font-size: .8125rem; color: var(--t2); margin: 0 0 12px; align-items: center; }
  .auto .pill { display: inline-flex; align-items: center; gap: 6px; padding: 1px 9px; border-radius: 9999px; font: 500 .6875rem var(--font-mono); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; border: 1px solid; }
  .auto .pill.alone { color: rgb(var(--green)); border-color: rgb(var(--green) / .5); }
  .auto .pill.ask { color: var(--amb); border-color: rgb(var(--ambar) / .5); }
  .auto .pill.never { color: rgb(var(--red)); border-color: rgb(var(--red) / .5); }
  .auto table.matrix { width: 100%; border-collapse: collapse; font-size: .9375rem; }
  .auto .matrix th { font: 500 .6875rem var(--font-mono); letter-spacing: .10em; text-transform: uppercase; color: var(--t2); text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--lf); }
  .auto .matrix th.lvl { text-align: center; width: 11%; }
  .auto .matrix th.lvl button { background: none; border: 0; padding: 0; font: inherit; color: inherit; letter-spacing: inherit; text-transform: inherit; cursor: pointer; }
  .auto .matrix th.active { color: var(--int); }
  .auto .matrix td { padding: 10px; border-bottom: 1px solid rgb(var(--border) / .5); vertical-align: top; }
  .auto .matrix td.n { font: 500 .75rem var(--font-mono); color: var(--t2); width: 36px; }
  .auto .matrix td.lvl { text-align: center; }
  .auto .matrix td.lvl.active { background: rgb(var(--teal) / .07); }
  .auto .matrix td.undo { color: var(--t2); font-size: .875rem; }
  .auto .row-btn { background: none; border: 0; padding: 0; font: inherit; color: var(--t1); text-align: left; cursor: pointer; }
  .auto .row-btn:hover { color: rgb(var(--accent)); }
  .auto tr.perm.open td { background: rgb(var(--bg-card) / .55); }
  .auto tr.detail td { background: rgb(var(--bg-card) / .55); padding: 14px 16px 18px; border-bottom: 1px solid var(--lf); }
  .auto tr.detail[hidden] { display: none; }
  .auto .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px 24px; font-size: .9375rem; color: var(--t1); }
  .auto .grid b { display: block; font: 500 .6875rem var(--font-mono); letter-spacing: .10em; text-transform: uppercase; color: var(--t2); margin-bottom: 2px; }
  .auto .floor { margin-top: 14px; padding: 10px 12px; border-left: 2px solid rgb(var(--red)); background: rgb(var(--red) / .06); font-size: .9375rem; color: var(--t1); }
  .auto .floor b { color: rgb(var(--red)); font-weight: 600; }
  .auto .why { margin-top: 10px; font-size: .9375rem; color: var(--t2); }
  .auto .why b { color: var(--t1); font-weight: 500; }
  .auto .why span[hidden] { display: none; }
  .auto .dialogs { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 800px) { .auto .dialogs { grid-template-columns: 1fr; } }
  .auto .dlg { background: rgb(var(--bg-card) / .55); border: 1px solid rgb(var(--border) / .6); border-radius: 8px; padding: 18px; }
  .auto .dlg .et { margin-bottom: 10px; }
  .auto .dlg pre { white-space: pre-wrap; margin: 0; font: 400 .8125rem/1.45 var(--font-mono); color: var(--t2); }
  .auto .dlg.new pre { font: 400 .9375rem/1.5 var(--font-sans); color: var(--t1); }
  .auto .dlg.new pre .cmd { display: block; margin-top: 10px; font: 400 .75rem var(--font-mono); color: var(--t3); }
  .auto .btns { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .auto .btn { display: inline-flex; align-items: center; min-height: 40px; border: 1px solid var(--lf); color: var(--t1); border-radius: 6px; padding: 0 14px; font: 500 .75rem var(--font-mono); letter-spacing: .10em; text-transform: uppercase; }
  .auto .btn.enter { background: #016E7D; color: #F9EBDC; border-color: #016E7D; }
  .auto .btn.stop { border-color: rgb(var(--red) / .6); color: rgb(var(--red)); }
  .auto .sources { font-size: .875rem; color: var(--t2); padding-left: 18px; }
  .auto .sources li { margin-bottom: 6px; }
  .auto .sources a { color: rgb(var(--accent)); }
  .auto ~ .tip, .tip { position: fixed; pointer-events: none; z-index: 70; max-width: 280px; background: rgb(var(--text)); color: rgb(var(--bg)); font: 400 .8125rem/1.4 var(--font-sans); padding: 8px 10px; border-radius: 6px; opacity: 0; transition: opacity .2s; box-shadow: 0 6px 18px rgba(0,0,0,.2); }
  .tip b { display: block; font: 500 .625rem var(--font-mono); letter-spacing: .12em; text-transform: uppercase; opacity: .7; margin-bottom: 2px; }
  @media (prefers-reduced-motion: reduce) { .auto * { transition: none !important; } }
</style>

<script>
  // Every level is real HTML already on the page; the script only chooses
  // which one shows. Without it, the page shows Ursa's level today.
  const root = document.querySelector<HTMLElement>(".auto")!;
  const rings = [...root.querySelectorAll<SVGGElement>(".ring")];
  const tabs = [...root.querySelectorAll<HTMLButtonElement>(".depth button")];
  const panels = [...root.querySelectorAll<HTMLElement>(".lv")];
  const ths = [...root.querySelectorAll<HTMLElement>("th.lvl")];
  const tds = [...root.querySelectorAll<HTMLElement>("td.lvl")];
  const whys = [...root.querySelectorAll<HTMLElement>(".why span")];

  function setLevel(l: number) {
    rings.forEach((r) => { const i = +r.dataset.l!; r.classList.toggle("sel", i === l); r.classList.toggle("in", i < l); r.setAttribute("aria-pressed", String(i === l)); });
    tabs.forEach((t) => { const i = +t.dataset.l!; t.setAttribute("aria-selected", String(i === l)); t.classList.toggle("past", i < l); });
    panels.forEach((p) => (p.hidden = +p.dataset.l! !== l));
    ths.forEach((t) => t.classList.toggle("active", +t.dataset.l! === l));
    tds.forEach((t) => t.classList.toggle("active", +t.dataset.l! === l));
    whys.forEach((w) => (w.hidden = +w.dataset.l! !== l));
    history.replaceState(null, "", `#level-${l}`);
  }
  root.addEventListener("click", (e) => {
    const t = (e.target as Element).closest<HTMLElement>("[data-l]");
    if (t && (t.closest(".ring, .depth, th.lvl"))) { setLevel(+t.dataset.l!); return; }
    const row = (e.target as Element).closest<HTMLButtonElement>(".row-btn");
    if (row) {
      const tr = row.closest("tr")!; const d = document.getElementById(row.getAttribute("aria-controls")!)!;
      const open = d.hidden; d.hidden = !open; tr.classList.toggle("open", open); row.setAttribute("aria-expanded", String(open));
    }
    const v = (e.target as Element).closest<HTMLElement>("[data-view]");
    if (v) {
      root.querySelectorAll("[data-view]").forEach((b) => b.classList.toggle("on", b === v));
      root.querySelector<SVGGElement>(".marks")!.hidden = v.dataset.view !== "agents";
    }
  });
  rings.forEach((r) => r.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); setLevel(+r.dataset.l!); } }));

  const tip = document.getElementById("tip")!;
  const hover = matchMedia("(hover: hover)").matches;
  root.querySelectorAll<HTMLElement>("[data-tip]").forEach((el) => {
    const show = (x: number, y: number) => { const [l, t] = (el.dataset.tip ?? "").split("|"); tip.innerHTML = `<b>${l}</b>${t ?? ""}`; tip.style.left = Math.min(x + 14, innerWidth - 300) + "px"; tip.style.top = Math.min(y + 16, innerHeight - 90) + "px"; tip.style.opacity = "1"; };
    if (hover) el.addEventListener("mousemove", (e) => show((e as MouseEvent).clientX, (e as MouseEvent).clientY));
    el.addEventListener("mouseleave", () => (tip.style.opacity = "0"));
    el.addEventListener("focus", () => { const r = el.getBoundingClientRect(); show(r.left + r.width / 2, r.bottom); });
    el.addEventListener("blur", () => (tip.style.opacity = "0"));
  });

  const m = location.hash.match(/^#level-([0-4])$/);
  if (m) setLevel(+m[1]);
</script>
