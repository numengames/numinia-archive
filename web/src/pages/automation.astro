  .auto .today { display: inline-block; margin-left: 8px; font: 500 .625rem var(--font-mono); letter-spacing: .10em; text-transform: uppercase; border: 1px solid var(--amb); color: var(--amb); border-radius: 9999px; padding: 1px 8px; vertical-align: middle; }
  .auto .classic { font: 400 .8125rem var(--font-mono); color: var(--t2) !important; }
