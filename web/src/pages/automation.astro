  @media (max-width: 1000px) { .auto .stage { grid-template-columns: 1fr; gap: 20px; } .auto .mapcol { order: -1; } }
  .auto .et { font: 500 .75rem/1.3 var(--font-mono); letter-spacing: .10em; text-transform: uppercase; color: var(--t2); }
  .auto .et a { color: rgb(var(--accent)); }
  .auto .ctx { position: sticky; top: 76px; background: rgb(var(--bg-card) / .55); border: 1px solid rgb(var(--border) / .6); backdrop-filter: blur(14px); border-radius: 8px; padding: 24px; }
  @media (max-width: 1000px) { .auto .ctx { position: static; } }
  .auto .ctx h1 { font: 500 2.488rem/1.08 var(--font-sans); letter-spacing: -.02em; margin: 6px 0 14px; color: var(--t1); }
  .auto .ctx h2 { font: 600 1.2rem/1.3 var(--font-sans); margin: 0 0 6px; color: var(--t1); }
  .auto .ctx p { color: var(--t2); margin: 0 0 14px; }
  .auto .qa { border-top: 1px solid rgb(var(--border) / .6); padding-top: 14px; margin-top: 14px; }
  .auto .depth { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; margin: 0 0 16px; }
  .auto .depth button { text-align: center; background: none; border: 0; padding: 0; cursor: pointer; }
  .auto .depth span { display: block; height: 3px; border-radius: 2px; background: var(--lf); margin-bottom: 5px; transition: background .2s; }
  .auto .depth button[aria-selected="true"] span { background: var(--int); }
  .auto .depth button.past span { background: rgb(var(--teal) / .45); }
  .auto .depth i { font: 500 .625rem var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--t2); font-style: normal; }
