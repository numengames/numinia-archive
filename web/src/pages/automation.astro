  .auto .lenses { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; justify-content: flex-end; }
  .auto .ctl { min-height: 44px; font: 500 .75rem var(--font-mono); letter-spacing: .08em; color: var(--t2); background: transparent; border: 1px dashed var(--lf); border-radius: 6px; padding: 0 12px; cursor: pointer; }
  .auto .ctl:hover { border-color: var(--int); color: var(--t1); }
  .auto .ctl.on { border-style: solid; border-color: var(--int); color: var(--t1); background: rgb(var(--teal) / .12); }
  .auto svg.astro { width: 100%; max-width: 720px; height: auto; display: block; margin-left: auto; }
  .auto .rim { fill: none; stroke: var(--lf); }
  .auto .tick { stroke: var(--lf); } .auto .tick.l { stroke: var(--t3); }
