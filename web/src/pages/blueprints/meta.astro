---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// /blueprints/meta — the mapping protocol: how a blueprint is made, kept and
// versioned.
//
// ON THE LANGUAGE. This page was written in Spanish while the rest of the
// site moved to English, so a reader following "The mapping protocol →" from
// the blueprints index changed language mid-click. The words are translated
// here, nothing else: the same sections, the same claims, the same signature.
//
// ON THE CONTENT. Every sentence below lives in this template rather than in
// the corpus — that is DBT-021, and the reason the CC0 row still has to carry
// its own correction inline instead of being read from LICENSE. Translating
// it does not pay that debt; it stops the page changing language.
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
---

<Layout
  title="The CAO mapping protocol — Numen Games"
  description="How the blueprints of Numen Games are created, kept and versioned."
  canonicalPath="/blueprints/meta"
>
  <section class="pb-20 pt-16">
    <div class="mx-auto max-w-[800px] px-6">

      <a href="/blueprints" class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-dim hover:text-accent transition-colors mb-8">
        <Icon name="caret-left" size={12} />
        Blueprints
      </a>

      <div class="mb-8">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-accent">Meta-blueprint</span>
        <h1 class="font-display text-3xl sm:text-4xl text-foreground mt-2 mb-3">The CAO mapping protocol</h1>
        <p class="font-mono text-sm text-dim italic">"Before building Numinia, the Oracles drew its blueprints. A world without a map is a world walked blind."</p>
      </div>

      <div class="space-y-6">

        <div class="rounded-xl border border-border bg-card p-6">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-4">What is a blueprint?</p>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4">
            A blueprint is a living document that answers the <strong class="text-foreground">five W's of journalism</strong>, applied to architecture:
          </p>
          <div class="grid gap-3 sm:grid-cols-2">
            {[
              { w: "What", q: "What exists, and how does it work today?" },
              { w: "Why", q: "Why was it designed this way and not another?" },
              { w: "Who", q: "Who uses it, maintains it, needs it?" },
              { w: "When", q: "When was it created, when will it be reviewed?" },
              { w: "Where", q: "Where does it live in the system?" },
            ].map((item) => (
              <div class="flex items-start gap-3">
                <span class="font-mono text-xs text-accent flex-shrink-0 font-bold w-12">{item.w}</span>
                <span class="text-sm text-muted-foreground">{item.q}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-4">Blueprint, mission, report — the difference</p>
          <div class="space-y-3">
            {[
              { tipo: "Blueprint", desc: "Architecture — how the system works. Permanent; it lives as long as the system does.", color: "text-accent" },
              { tipo: "Mission", desc: "Action — what has to be done. Temporary; it has a beginning and an end.", color: "text-blue" },
              { tipo: "Report", desc: "Memory — what happened and what we learnt. Historical; not edited once published.", color: "text-purple" },
            ].map((item) => (
              <div class="flex items-start gap-4">
                <span class:list={["font-mono text-xs flex-shrink-0 w-16", item.color]}>{item.tipo}</span>
                <span class="text-sm text-muted-foreground">{item.desc}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-4">Adopted standards</p>
          <div class="space-y-2">
            {[
              { area: ".md (Markdown)", razon: "File over app — readable by agents and humans, versionable in git" },
              { area: "ASCII / Mermaid", razon: "Diagrams without proprietary tools" },
              { area: "SVG / WebP", razon: "Lossless images / optimised for the web" },
              { area: "OGG", razon: "Patent-free audio, CC0 compatible" },
              { area: "CC0", razon: "We build in public — no rights reserved. Superseded on 2026-08-16 by C-005: a per-path regime (CC0 now covers only the catalogue and the data), see LICENSE and LEGAL_DEBT.md" },
            ].map((item) => (
              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-accent flex-shrink-0 w-32">{item.area}</span>
                <span class="text-sm text-muted-foreground">{item.razon}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-4">Versioning</p>
          <div class="font-mono text-sm text-muted-foreground space-y-1">
            <p><span class="text-accent">v0.1.0</span> → First version (a structured draft)</p>
            <p><span class="text-accent">v0.2.0</span> → Reviewed with the team</p>
            <p><span class="text-accent">v0.X.0</span> → Incremental iterations</p>
            <p><span class="text-accent">v1.0.0</span> → Only with an Oracle's explicit approval</p>
          </div>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-4">Done criteria</p>
          <div class="space-y-2">
            {[
              "It answers the five W's clearly",
              "It carries at least one justified design decision (ADR-style)",
              "The delta is mapped to concrete missions",
              "It has been reviewed by at least one Oracle",
              "It is versioned in the repo as plano-[name]-v0.X.0.md",
            ].map((c) => (
              <div class="flex items-start gap-3">
                <span class="h-4 w-4 rounded border border-border flex-shrink-0 mt-0.5"></span>
                <span class="text-sm text-muted-foreground">{c}</span>
              </div>
            ))}
          </div>
        </div>

      </div>

      <div class="mt-8 border-t border-border pt-6">
        <p class="font-mono text-xs text-dim">Centinela-01 · Numen Games / Numinia · v0.1.0 · 2026-04-05</p>
      </div>

    </div>
  </section>
</Layout>
