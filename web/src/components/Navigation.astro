---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
import Icon from "@/components/Icon.astro";
import SiteSearch from "@/components/SiteSearch.astro";
import { navItems, barItems } from "@/data/navigation";
import { useT, type UIKey } from "@/i18n/ui";

interface Props {
  activeNav?: string;
}

const { activeNav } = Astro.props;

const numaniaIds = navItems
  .find((i) => i.id === "numinia")
  ?.children?.map((c) => c.id) ?? [];
const numaniaActive = numaniaIds.includes(activeNav ?? "");

// Section entries are plain links. They lead to the folder's index page, which
// is where a document gets chosen — one place to browse a folder, not two, and
// no count in the bar: the number belongs on the page that lists the documents.
const sectionIds = new Set(
  navItems.filter((i) => "section" in i && i.section).map((i) => i.id),
);

// MIS-120(e) — one corpus, in English. No locale prefix, no selector: the
// reader's browser offers the translation, and lang="en" is what triggers it.
// nav item ids are historical (Spanish); the map bridges id → dictionary key.
const t = useT("en");
const NAV_KEY: Record<string, UIKey> = {
  missions: "nav.missions",
  corpus: "nav.corpus",
  decisiones: "nav.decisions",
  planos: "nav.blueprints",
  reportes: "nav.reports",
};
const navLabel = (id: string, fallback: string) =>
  NAV_KEY[id] ? t(NAV_KEY[id]) : fallback;
const l = (href: string) => href;
const homeHref = "/";
---

<nav class="sticky top-0 z-50 border-b border-border/50 bg-background/85 backdrop-blur-xl">
  <div class="mx-auto flex h-14 max-w-[1100px] items-center justify-between px-6">
    <a href={homeHref} class="flex min-h-[44px] items-center font-display text-xl text-foreground transition-colors hover:text-accent">
      NW<em class="text-accent">OS</em>
    </a>

    <!--
      Desktop nav. The breakpoint is `lg`, not `sm`: measured at 768 px the
      seven entries plus the search field ran to 774 px inside a 683 px
      column and pushed the whole page 91 px wide. A bar that overflows is
      worse than a hamburger — it hides its own last entries with no
      affordance saying so.
    -->
    <div class="hidden items-center gap-1 lg:flex">
      <SiteSearch />
      {/*
        `barItems`, not `navItems`: the bar drops what does not fit (see
        `inBar` in @/data/navigation). The MOBILE menu below keeps the full
        list — it is a vertical stack and has no width to run out of.
      */}
      {barItems.map((item) => {
        if (sectionIds.has(item.id)) {
          return (
            <a
              href={item.href}
              class:list={[
                "rounded-full px-3.5 py-1.5 font-mono text-[0.7rem] uppercase tracking-[0.12em] transition-all",
                activeNav === item.id
                  ? "border border-accent bg-accent/10 text-accent"
                  : "border border-transparent text-muted-foreground hover:border-border hover:bg-card hover:text-foreground",
              ]}
            >
              {item.label}
            </a>
          );
        }
        if (item.children) {
          return (
            <div class="relative" data-dropdown>
              <button
                data-dropdown-btn
                class:list={[
                  "flex items-center gap-1 rounded-full px-4 py-1.5 font-mono text-[0.7rem] uppercase tracking-[0.15em] transition-all",
                  numaniaActive
                    ? "border border-accent bg-accent/10 text-accent"
                    : "border border-transparent text-muted-foreground hover:border-border hover:bg-card hover:text-foreground",
                ]}
              >
                {navLabel(item.id, item.label)}
                <span data-chevron class="inline-flex transition-transform duration-200">
                  <Icon name="caret-down" size={10} />
                </span>
              </button>
              <!-- invisible bridge to prevent gap-triggered close -->
              <div class="absolute right-0 top-full h-3 w-full" data-bridge></div>
              <!-- Dropdown panel -->
              <div
                data-dropdown-panel
                class="absolute right-0 top-full mt-3 hidden w-48 rounded-xl border border-border bg-background/95 py-2 shadow-xl backdrop-blur-xl"
              >
                {item.children.map((child) => (
                  <a
                    href={l(child.href)}
                    class:list={[
                      "block px-4 py-2 font-mono text-[0.7rem] uppercase tracking-[0.15em] transition-colors",
                      activeNav === child.id
                        ? "bg-accent/10 text-accent"
                        : "text-muted-foreground hover:bg-card hover:text-foreground",
                    ]}
                  >
                    {navLabel(child.id, child.label)}
                  </a>
                ))}
              </div>
            </div>
          );
        }
        return (
          <a
            href={l(item.href)}
            class:list={[
              "rounded-full px-4 py-1.5 font-mono text-[0.7rem] uppercase tracking-[0.15em] transition-all",
              activeNav === item.id
                ? "border border-accent bg-accent/10 text-accent"
                : "border border-transparent text-muted-foreground hover:border-border hover:bg-card hover:text-foreground",
            ]}
          >
            {navLabel(item.id, item.label)}
          </a>
        );
      })}
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="flex h-11 w-11 items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors hover:bg-card hover:text-foreground lg:hidden"
      aria-label={t("nav.openMenu")}
      aria-expanded="false"
    >
      <Icon name="list" size={18} />
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-border/50 bg-background/95 backdrop-blur-xl lg:hidden">
    <div class="flex flex-col gap-1 px-6 py-4">
      {navItems.map((item) => {
        if (sectionIds.has(item.id)) {
          return (
            <a
              href={item.href}
              class:list={[
                "flex min-h-[44px] items-center rounded-lg px-4 font-mono text-[0.7rem] uppercase tracking-[0.15em] transition-colors",
                activeNav === item.id
                  ? "bg-accent/10 text-accent"
                  : "text-muted-foreground hover:bg-card hover:text-foreground",
              ]}
            >
              {item.label}
            </a>
          );
        }
        if (item.children) {
          return (
            <div>
              <div class:list={[
                "rounded-lg px-4 py-2.5 font-mono text-[0.7rem] uppercase tracking-[0.15em]",
                numaniaActive ? "text-accent" : "text-muted-foreground",
              ]}>
                {navLabel(item.id, item.label)}
              </div>
              <div class="ml-4 flex flex-col gap-1 border-l border-border/50 pl-3">
                {item.children.map((child) => (
                  <a
                    href={l(child.href)}
                    class:list={[
                      "flex min-h-[44px] items-center rounded-lg px-3 font-mono text-[0.65rem] uppercase tracking-[0.15em] transition-colors",
                      activeNav === child.id
                        ? "bg-accent/10 text-accent"
                        : "text-muted-foreground hover:bg-card hover:text-foreground",
                    ]}
                  >
                    {navLabel(child.id, child.label)}
                  </a>
                ))}
              </div>
            </div>
          );
        }
        return (
          <a
            href={l(item.href)}
            class:list={[
              "flex min-h-[44px] items-center rounded-lg px-4 font-mono text-[0.7rem] uppercase tracking-[0.15em] transition-colors",
              activeNav === item.id
                ? "bg-accent/10 text-accent"
                : "text-muted-foreground hover:bg-card hover:text-foreground",
            ]}
          >
            {navLabel(item.id, item.label)}
          </a>
        );
      })}
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const open = !menu.classList.contains("hidden");
      menu.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", String(!open));
    });
  }

  // Desktop dropdowns
  document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dropdown) => {
    const dropBtn = dropdown.querySelector<HTMLElement>("[data-dropdown-btn]");
    const panel = dropdown.querySelector<HTMLElement>("[data-dropdown-panel]");
    const bridge = dropdown.querySelector<HTMLElement>("[data-bridge]");
    const chevron = dropdown.querySelector<HTMLElement>("[data-chevron]");

    if (!dropBtn || !panel) return;

    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    function openPanel() {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      panel!.classList.remove("hidden");
      if (bridge) bridge.classList.remove("hidden");
      chevron?.classList.add("rotate-180");
    }

    function scheduleClose() {
      closeTimer = setTimeout(() => {
        panel!.classList.add("hidden");
        if (bridge) bridge.classList.add("hidden");
        chevron?.classList.remove("rotate-180");
        closeTimer = null;
      }, 120);
    }

    // Click toggle
    dropBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      panel!.classList.contains("hidden") ? openPanel() : scheduleClose();
    });

    // Close on outside click
    document.addEventListener("click", () => {
      if (!panel!.classList.contains("hidden")) scheduleClose();
    });
    panel.addEventListener("click", (e) => e.stopPropagation());

    // Hover — button, bridge and panel all keep it open
    [dropdown, bridge, panel].forEach((el) => {
      if (!el) return;
      el.addEventListener("mouseenter", () => openPanel());
      el.addEventListener("mouseleave", () => scheduleClose());
    });
  });
</script>
