---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// The block at the foot of every document of the archive (variant B of the
// support prototype): one sentence, the entry price read from OPS-014, and a
// link to /contribute. It sells nothing itself and holds no payment link;
// the page it points to does the rest (STD-033 PAY-003, PAY-005).
import { goods, eur } from "@/lib/contribute";

const from = Math.min(...(await goods()).map((g) => g.amounts[0]));
---

<aside class="ct-after" aria-labelledby="ct-after-k">
  <span class="ct-after-k" id="ct-after-k">Keep Numinia going</span>
  <p>This archive is open and stays open. If it is worth something to you, you can hold it up from {eur(from)} a month, and choose how you are remembered.</p>
  <a href="/contribute" class="ct-after-a">Become a contributor</a>
</aside>

<style>
.ct-after{margin-top:24px;border:1px solid rgb(var(--border));border-left:2px solid rgb(var(--accent)/.6);border-radius:var(--radius);padding:16px 18px;display:grid;gap:8px}
.ct-after-k{font-family:var(--font-mono);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;color:rgb(var(--accent))}
.ct-after p{margin:0;font-size:.875rem;line-height:1.6;color:rgb(var(--text-muted));max-width:64ch}
.ct-after-a{justify-self:start;display:inline-flex;align-items:center;min-height:40px;padding:0 14px;border-radius:6px;border:1px solid rgb(var(--accent)/.5);color:rgb(var(--accent));font-size:.875rem;text-decoration:none;transition:background-color .12s}
.ct-after-a:hover{background:rgb(var(--accent)/.1)}
.ct-after-a:focus-visible{outline:2px solid rgb(var(--accent));outline-offset:2px}
@media (max-width:1023px){.ct-after-a{min-height:44px}}
</style>
