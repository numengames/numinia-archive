---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// The house footer, the same shape on the four sites (numinia.org,
// numinia.com, numen.games, nwos.numen.games — Oracle instruction,
// 2026-09-16). Its job is to reduce uncertainty: where am I, where else
// can I go, what is this thing, which build am I reading.
//
//   brand + one line     Navigation      Numen Games      Legal
//                        (two columns    (the four        Social
//                         when > 4)       sites)
//   ─────────────────────────────────────────────────────────────
//   scarab  by Numen Games — we build for a better future.
//           licence · telemetry · version · commit
//
// No copyright line and no "all rights reserved": licences are per file,
// declared inside each file — a blanket claim in the footer would contradict
// them (CAN-005). The link goes to LICENSE, which says how to read them. The signature is brand voice and is never
// translated.
import Icon from "@/components/Icon.astro";
import { navGroups, siteLinks } from "@/data/navigation";
import { socialLinks } from "@/data/social-links";
import { HOUSE_LINKS, THIS_SITE } from "@/data/house-links";
import { VERSION, COMMIT_SHA, COMMIT_URL, REPO_URL } from "@/lib/build-info";
import { useT } from "@/i18n/ui";
// The scarab closes every piece, never opens it — its one canonical home on
// the site is the foot of the page.
import scarab from "@/brand/Khepri_Logo.svg?raw";

const t = useT();
const LICENSE_URL = `${REPO_URL}/blob/main/LICENSE`;

// Navigation: the six functions of the archive (the same six doors the bar
// has, read from the classification — @/data/navigation), then the site's
// own pages. Two columns, filled top-to-bottom so the standard's order
// survives: down the first column, then the second. The series themselves
// are one click further, in the bar's menus and on each function's page;
// eighteen stacked links is a footer nobody scrolls to the end of.
const navLinks = [
  ...navGroups.map((g) => ({ label: g.label, href: g.href })),
  ...siteLinks,
];
const twoColumns = navLinks.length > 4;
const rows = Math.ceil(navLinks.length / 2);

const link =
  "flex min-h-[44px] items-center justify-center text-sm text-muted-foreground transition-colors hover:text-foreground sm:min-h-0 sm:justify-start sm:py-1";
const heading = "mb-1 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim";
---

<footer class="border-t border-border">
  <div class="mx-auto max-w-[1100px] px-6 py-12">
    <div class="grid grid-cols-1 gap-8 text-center sm:grid-cols-[1.4fr_1.2fr_1fr_1fr] sm:text-left">
      <!-- Brand: the site's name written, and one line saying what it is -->
      <div>
        <a href="/" class="inline-flex min-h-[44px] items-center font-display text-xl text-foreground">
          Narrative Work OS
        </a>
        <p class="mt-2 max-w-xs text-sm text-muted-foreground sm:mx-0 mx-auto">
          The archive of Numen Games, built in public: canon, decisions, missions, how the work is done.
        </p>
        <!-- STD-037 SIT-001: every house footer invites people to back
             Numinia, in plain sight. The archive sells nothing: the button
             leads to numinia.com/back (/support there is the help page). -->
        <a
          href="https://numinia.com/back/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex min-h-[44px] items-center gap-2 rounded-[6px] border border-accent px-3 text-sm font-medium text-foreground transition-colors hover:bg-accent/10 sm:min-h-[40px]"
        ><Icon name="coffee" size={18} /> Back Numinia</a>
      </div>

      <!-- Navigation -->
      <nav aria-label={t("footer.navigation")} class="flex flex-col gap-2">
        <span class={heading}>{t("footer.navigation")}</span>
        <div class:list={["grid gap-x-6", twoColumns ? "grid-cols-2 grid-flow-col" : "grid-cols-1"]} style={twoColumns ? `grid-template-rows: repeat(${rows}, auto)` : undefined}>
          {navLinks.map((item) => (
            <a href={item.href} class={link}>{item.label}</a>
          ))}
        </div>
      </nav>

      <!-- Numen Games: the four sites of the house, this one as text -->
      <nav aria-label={t("footer.house")} class="flex flex-col gap-2">
        <span class={heading}>{t("footer.house")}</span>
        {HOUSE_LINKS.map((site) =>
          site.id === THIS_SITE ? (
            <span class="flex items-center justify-center gap-2 text-sm text-foreground sm:justify-start sm:py-1" aria-current="page">
              {site.label}
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim">{t("footer.thisSite")}</span>
            </span>
          ) : (
            <a href={site.href} target="_blank" rel="noopener noreferrer" class={link} title={site.what}>
              {site.label}
            </a>
          )
        )}
      </nav>

      <!-- Legal, then Social -->
      <div class="flex flex-col gap-2">
        <nav aria-label={t("footer.legal")} class="flex flex-col gap-2">
          <span class={heading}>{t("footer.legal")}</span>
          <a href="/legal/notice" class={link}>{t("footer.notice")}</a>
          <a href="/legal/privacy" class={link}>{t("footer.privacy")}</a>
          <a href="/legal/cookies" class={link}>{t("footer.cookies")}</a>
          <a href="/legal/terms" class={link}>{t("footer.terms")}</a>
          <button type="button" data-cookie-choice class={`${link} text-left`}>{t("footer.cookieChoice")}</button>
        </nav>
        {socialLinks.length > 0 && (
          <nav aria-label={t("footer.social")} class="mt-4 flex flex-col gap-2">
            <span class={heading}>{t("footer.social")}</span>
            {socialLinks.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" class={link}>{s.label}</a>
            ))}
          </nav>
        )}
      </div>
    </div>

    <!-- The closing line: scarab, signature, build -->
    <div class="mt-12 flex flex-col items-center gap-4 border-t border-border/50 pt-6 text-center sm:flex-row sm:text-left">
      <span class="escarabajo inline-flex text-dim" aria-hidden="true" set:html={scarab} />
      <div>
        <p class="text-sm text-muted-foreground">
          by <a
            href="https://numen.games"
            target="_blank"
            rel="noopener noreferrer"
            class="text-foreground underline decoration-border underline-offset-4 transition-colors hover:text-accent"
          >Numen Games</a> — we build for a better future.
        </p>
        <p class="mt-1 font-mono text-[0.65rem] text-dim">
          <a href={LICENSE_URL} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent" title={t("footer.licenceTitle")}>{t("footer.licence")}</a>
          {" · "}
          <a href="/telemetry" class="transition-colors hover:text-accent" title={t("footer.telemetryTitle")}>{t("footer.telemetry")}</a>
          {" · "}
          <a href="/updates" class="transition-colors hover:text-accent" title={t("footer.versionTitle")}>{VERSION}</a>
          {" · "}
          {COMMIT_URL ? (
            <a href={COMMIT_URL} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent" title={t("footer.commitTitle")}>{COMMIT_SHA}</a>
          ) : (
            COMMIT_SHA
          )}
        </p>
      </div>
      <!-- STD-037 SIT-004: the epitaph that closes the manifesto (CAN-002),
           behind a small skull. Hover or focus shows it, a tap toggles it,
           Escape closes it. English on every site, like the signature;
           "did not let us alone" is literal on purpose. -->
      <div class="epitafio relative sm:ml-auto">
        <button
          type="button"
          class="calavera inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-[6px] text-dim transition-colors hover:text-foreground focus-visible:text-foreground sm:min-h-[32px] sm:min-w-[32px]"
          aria-label="Epitaph"
          aria-expanded="false"
          aria-controls="epitaph-text"
          data-epitaph
        ><Icon name="skull" size={20} /></button>
        <p
          id="epitaph-text"
          role="tooltip"
          class="epitaph-text absolute bottom-full left-1/2 z-10 -translate-x-1/2 sm:left-auto sm:right-0 sm:translate-x-0 mb-2 w-[min(32ch,80vw)] rounded-[8px] border border-border bg-card p-3 text-left text-sm italic text-muted-foreground shadow-lg"
        >
          They dreamed and experimented life, they imagined and took action. They were part of the fight to change the model, they did not let us alone, they built a game with which to create a better world.
        </p>
      </div>
    </div>
  </div>
</footer>

<script>
  // The skull: a tap or click toggles the epitaph; hover and focus show it
  // through CSS; Escape closes it and returns focus to the skull.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-epitaph]")) {
    const holder = button.parentElement!;
    const set = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      holder.classList.toggle("abierto", open);
    };
    button.addEventListener("click", () => set(button.getAttribute("aria-expanded") !== "true"));
    holder.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        set(false);
        button.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (!holder.contains(e.target as Node)) set(false);
    });
  }
</script>

<style>
  /* The epitaph stays hidden until the skull is hovered, focused or tapped. */
  .epitaph-text {
    visibility: hidden;
    opacity: 0;
    transition: opacity 150ms ease;
  }
  .epitafio:hover .epitaph-text,
  .epitafio:focus-within .epitaph-text,
  .epitafio.abierto .epitaph-text {
    visibility: visible;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .epitaph-text {
      transition: none;
    }
  }
  /* The mark in muted ink, 28px, never in colour. */
  .escarabajo :global(svg) {
    width: 28px;
    height: 28px;
  }
</style>
