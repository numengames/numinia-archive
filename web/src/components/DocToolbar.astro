---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// Toolbar for rendered .md detail pages: copy the raw markdown, download
// the canonical file (File over App — the document is the deliverable),
// listen to it through the browser's own voices (MIS-119), and open the
// file it was rendered from on GitHub.
//
// There is no .pdf button. There was one, and for 278 pages it linked a
// file that answered 404 in production: `build` never chained `build:pdf`,
// so the pipeline ran every step except the one that produces PDFs
// (`debt/D-035`). Retired 2026-08-31 by the Oracle's decision — the third
// option D-035 lists, "retire the links". Reversible: the day PDFs are
// generated by the build, the button comes back in six lines.
//
// Copy, .md and Source are icons, not words (2026-09-24, the Oracle: the
// labels added little next to glyphs everyone reads). Each keeps its full
// name for screen readers (aria-label) and says what it does in a tooltip
// on hover and keyboard focus — the tooltip speaks in the opposite mode
// (BLU-009 §8). On touch there is no hover; the glyphs are the house's.
import Icon from "@/components/Icon.astro";
import SpeechPlayer from "@/components/SpeechPlayer.astro";

interface Props {
  mdUrl: string;      // URL of the raw .md static endpoint
  filename: string;   // canonical repo filename for the download
  lang?: string;      // document language for the speech voice (MIS-119)
  repoUrl?: string | null; // the file this page was rendered from, on GitHub
}
const { mdUrl, filename, lang, repoUrl } = Astro.props;
import { useT } from "@/i18n/ui";
const t = useT();

---

<div class="doc-toolbar flex flex-wrap items-center justify-start sm:justify-end gap-2 mb-3" data-md-url={mdUrl}>
  <SpeechPlayer lang={lang} />
  <button
    type="button"
    class="copy-md doc-icon inline-flex items-center justify-center text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg w-[44px] h-[44px] lg:w-[34px] lg:h-[34px] transition-colors"
    aria-label={t("toolbar.copyAria")}
    data-tip={t("toolbar.copyTip")}
    data-t-copy={t("toolbar.copy")}
    data-t-copied={t("toolbar.copied")}
    data-t-error={t("toolbar.error")}
  >
    <Icon name="copy" size={15} />
    <span class="copy-label sr-only">{t("toolbar.copy")}</span>
  </button>
  <a
    href={mdUrl}
    download={filename}
    class="doc-icon inline-flex items-center justify-center text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg w-[44px] h-[44px] lg:w-[34px] lg:h-[34px] transition-colors"
    aria-label={t("toolbar.downloadAria", { file: filename })}
    data-tip={t("toolbar.downloadTip")}
  >
    <Icon name="download-simple" size={15} />
  </a>
  <!--
    The page is a rendering; the file is the document. Anyone who wants
    history, blame, or to open a PR needs the original, and guessing the
    path from the URL is not a navigation strategy.

    The comment sits outside the expression: the Astro 7 compiler does not
    accept an HTML comment as the first node of a `{cond && (...)}` block.
  -->
  {repoUrl && (
    <a
      href={repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="doc-icon inline-flex items-center justify-center text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg w-[44px] h-[44px] lg:w-[34px] lg:h-[34px] transition-colors"
      aria-label={t("toolbar.sourceAria", { file: filename })}
      data-tip={t("toolbar.sourceTip")}
    >
      <Icon name="github-logo" size={15} />
    </a>
  )}
</div>

<script>
  for (const bar of document.querySelectorAll<HTMLElement>(".doc-toolbar")) {
    const btn = bar.querySelector<HTMLButtonElement>(".copy-md");
    const label = bar.querySelector<HTMLElement>(".copy-label");
    btn?.addEventListener("click", async () => {
      try {
        const res = await fetch(bar.dataset.mdUrl!);
        await navigator.clipboard.writeText(await res.text());
        // Icon-only button: the feedback shows in its tip (and is spoken
        // through the label), then the tip returns to what the button does.
        const tip = btn.dataset.tip;
        if (label) label.textContent = btn.dataset.tCopied || "Copied";
        btn.dataset.tip = btn.dataset.tCopied || "Copied";
        btn.classList.add("is-told");
        setTimeout(() => {
          if (label) label.textContent = btn.dataset.tCopy || "Copy";
          if (tip) btn.dataset.tip = tip;
          btn.classList.remove("is-told");
        }, 1600);
      } catch {
        if (label) label.textContent = btn.dataset.tError || "Error";
        btn.dataset.tip = btn.dataset.tError || "Error";
      }
    });
  }
</script>

<style is:global>
  .doc-icon {
    position: relative;
  }
  .doc-icon[data-tip]:hover::after,
  .doc-icon[data-tip]:focus-visible::after,
  .doc-icon.is-told::after {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 70;
    white-space: nowrap;
    padding: 5px 8px;
    border-radius: 6px;
    background: rgb(var(--text));
    color: rgb(var(--bg));
    font: 500 0.72rem var(--font-sans);
    letter-spacing: 0;
    text-transform: none;
    pointer-events: none;
  }
</style>
