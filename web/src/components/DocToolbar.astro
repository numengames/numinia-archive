---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// Toolbar for rendered .md detail pages: copy the raw markdown, download
// the canonical file (File over App — the document is the deliverable),
// listen to it through the browser's own voices (MIS-119), and open the
// file it was rendered from on GitHub.
//
// There is no .pdf button. There was one, and for 278 pages it linked a
// file that answered 404 in production: `build` never chained `build:pdf`,
// so the pipeline ran every step except the one that produces PDFs
// (`debt/D-035`). Retired 2026-08-31 by the Oracle's decision — the third
// option D-035 lists, "retire the links". Reversible: the day PDFs are
// generated by the build, the button comes back in six lines.
import Icon from "@/components/Icon.astro";
import SpeechPlayer from "@/components/SpeechPlayer.astro";

interface Props {
  mdUrl: string;      // URL of the raw .md static endpoint
  filename: string;   // canonical repo filename for the download
  lang?: string;      // document language for the speech voice (MIS-119)
  repoUrl?: string | null; // the file this page was rendered from, on GitHub
}
const { mdUrl, filename, lang, repoUrl } = Astro.props;
import { useT } from "@/i18n/ui";
const t = useT();

---

<div class="doc-toolbar flex flex-wrap items-center justify-start sm:justify-end gap-2 mb-3" data-md-url={mdUrl}>
  <SpeechPlayer lang={lang} />
  <button
    type="button"
    class="copy-md inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-3 py-1.5 min-h-[44px] lg:min-h-0 transition-colors"
    aria-label={t("toolbar.copyAria")}
    data-t-copy={t("toolbar.copy")}
    data-t-copied={t("toolbar.copied")}
    data-t-error={t("toolbar.error")}
  >
    <Icon name="copy" size={12} />
    <span class="copy-label">{t("toolbar.copy")}</span>
  </button>
  <a
    href={mdUrl}
    download={filename}
    class="inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-3 py-1.5 min-h-[44px] lg:min-h-0 transition-colors"
    aria-label={t("toolbar.downloadAria", { file: filename })}
  >
    <Icon name="download-simple" size={12} />
    .md
  </a>
  <!--
    The page is a rendering; the file is the document. Anyone who wants
    history, blame, or to open a PR needs the original, and guessing the
    path from the URL is not a navigation strategy.

    The comment sits outside the expression: the Astro 7 compiler does not
    accept an HTML comment as the first node of a `{cond && (...)}` block.
  -->
  {repoUrl && (
    <a
      href={repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-3 py-1.5 min-h-[44px] lg:min-h-0 transition-colors"
      aria-label={t("toolbar.sourceAria", { file: filename })}
    >
      <Icon name="github-logo" size={12} />
      Source
    </a>
  )}
</div>

<script>
  for (const bar of document.querySelectorAll<HTMLElement>(".doc-toolbar")) {
    const btn = bar.querySelector<HTMLButtonElement>(".copy-md");
    const label = bar.querySelector<HTMLElement>(".copy-label");
    btn?.addEventListener("click", async () => {
      try {
        const res = await fetch(bar.dataset.mdUrl!);
        await navigator.clipboard.writeText(await res.text());
        if (label) {
          label.textContent = btn.dataset.tCopied || "Copied";
          setTimeout(() => (label.textContent = btn.dataset.tCopy || "Copy"), 1600);
        }
      } catch {
        if (label) label.textContent = btn.dataset.tError || "Error";
      }
    });
  }
</script>
