---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// The narrative dial: how the archive speaks to the reader.
//
// A moon in the bar, beside day and night, with three states turned by taps:
// new (L1, plain words) → half (L2, plain and Numinia's side by side) → full
// (L3, Numinia's own words) → new again (the Oracle, 2026-10-04). The moon
// shows the level you are in, as the day/night switch shows the mode you are
// in (DES-009); the tooltip names it: "Narrative level L1". The choice is kept
// in localStorage under `numinia-narrative` (the cookie policy lists it) and
// set on <html data-narrative> before paint by the boot script in Layout.
//
// What changes is every element marked `data-nw` (see @/lib/narrative-words):
// its text is swapped for the stop's word, which the register copies from an
// archive file. The change is a slow dissolve of the page (Surfacing, the
// catalogue's animation 10, run out and back in); nothing moves while reading.
import { STOPS, DEFAULT_STOP } from "@/lib/narrative-words.mjs";
interface Props { variant?: "bar" | "menu" }
const { variant = "bar" } = Astro.props;
// Painted at build as the default level; the script repaints from the reader's choice.
const first = STOPS.find((s) => s.id === DEFAULT_STOP)!;
const label = (s: typeof first) => `Narrative level ${s.level}`;
---
{variant === "bar" ? (
  <button type="button" class="nd-btn flex h-11 w-11 items-center justify-center rounded-[6px] text-muted-foreground transition-colors hover:bg-card hover:text-foreground" data-nd-cycle aria-label={label(first)} title={label(first)}>
    <svg viewBox="-12 -12 24 24" width="20" height="20" aria-hidden="true"><circle r="9" fill="none" stroke="currentColor" stroke-width="1.4"/><path class="nd-lit" fill="currentColor" d=""/></svg>
  </button>
) : (
  <button type="button" class="nd-btn flex min-h-[44px] items-center gap-2 border-b border-border/50 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-muted-foreground" data-nd-cycle data-nd-menu>
    <svg viewBox="-12 -12 24 24" width="14" height="14" aria-hidden="true"><circle r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path class="nd-lit" fill="currentColor" d=""/></svg>
    <span data-nd-name>{label(first)}</span>
  </button>
)}

{variant === "bar" && <p class="nd-sr" aria-live="polite" data-nd-say data-pagefind-ignore="all"></p>}

<style is:global>
  .nd-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* The change: the page dissolves out and surfaces back (animation 10). */
  main#main { transition: opacity 320ms cubic-bezier(.33,0,.15,1), filter 320ms cubic-bezier(.33,0,.15,1); }
  html.nd-out main#main { opacity: 0; filter: blur(6px); }

  /* New moon — plain documentation: no sky, no grid, labels in sentence case. */
  html[data-narrative="plain"] body::before, html[data-narrative="plain"] #starfield { display: none; }
  html[data-narrative="plain"] main .font-mono.uppercase, html[data-narrative="plain"] main .mhead,
  html[data-narrative="plain"] .crumbs { font-family: var(--font-sans) !important; text-transform: none !important; letter-spacing: 0 !important; font-size: .875rem !important; }
  html[data-narrative="plain"] main .mline, html[data-narrative="plain"] main .mdepth { display: none; }

  /* Full moon — Numinia: the book's voice (DES-011 §1), same colours and structure. */
  @font-face { font-family: "Alegreya"; src: url("/design/assets/fonts/Alegreya-Variable.woff2") format("woff2"); font-weight: 400 900; font-display: swap; }
  @font-face { font-family: "Alegreya"; font-style: italic; src: url("/design/assets/fonts/Alegreya-Italic-Variable.woff2") format("woff2"); font-weight: 400 900; font-display: swap; }
  @font-face { font-family: "Alegreya SC"; src: url("/design/assets/fonts/AlegreyaSC-Medium.woff2") format("woff2"); font-weight: 500; font-display: swap; }
  html[data-narrative="numinia"] main h1, html[data-narrative="numinia"] main h2, html[data-narrative="numinia"] main .mring { font-family: "Alegreya", Georgia, serif !important; font-weight: 500 !important; letter-spacing: 0 !important; }
  html[data-narrative="numinia"] main .mring { font-size: 1.45rem; }
  html[data-narrative="numinia"] main .mabout, html[data-narrative="numinia"] main [data-nw-lead] { font-family: "Alegreya", Georgia, serif; font-style: italic; font-size: 1.1em; }
  html[data-narrative="numinia"] main .font-mono.uppercase, html[data-narrative="numinia"] main .mline, html[data-narrative="numinia"] main .mhead,
  html[data-narrative="numinia"] .crumbs { font-family: "Alegreya SC", "Alegreya", Georgia, serif !important; text-transform: lowercase !important; letter-spacing: .14em !important; font-size: .95rem !important; }
  html[data-narrative="numinia"] main .mitem > span { font-family: "Alegreya", Georgia, serif; font-size: 1.05rem; }

  /* Full moon, calm motion: the columns surface one after another (animation 10,
     staggered as the orchestrated moment 09), and a link warms slowly. */
  @keyframes nd-surface { from { opacity: 0; filter: blur(8px); transform: translateY(8px); } to { opacity: 1; filter: none; transform: none; } }
  html[data-narrative="numinia"] main .mcol { animation: nd-surface 560ms cubic-bezier(.33,0,.15,1) both; }
  html[data-narrative="numinia"] main .mcol:nth-child(2) { animation-delay: 80ms; }
  html[data-narrative="numinia"] main .mcol:nth-child(3) { animation-delay: 160ms; }
  html[data-narrative="numinia"] main .mcol:nth-child(4) { animation-delay: 240ms; }
  html[data-narrative="numinia"] main a.mitem { transition: border-color 560ms, background-color 560ms, color 560ms, box-shadow 560ms; }
  html[data-narrative="numinia"] main a.mitem:hover { box-shadow: 0 0 0 1px rgb(var(--yellow) / .35), 0 6px 22px -10px rgb(var(--yellow) / .55); }

  @media (prefers-reduced-motion: reduce) {
    main#main { transition: none !important; }
    html.nd-out main#main { opacity: 1; filter: none; }
    html[data-narrative="numinia"] main .mcol { animation: none !important; }
  }
</style>

{variant === "bar" && (
<script>
  import { STOPS, DEFAULT_STOP, siteTitle } from "@/lib/narrative-words.mjs";
  const KEY = "numinia-narrative";
  const root = document.documentElement;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const LIT: Record<string, string> = { plain: "", bridge: "M0 -9 A9 9 0 0 1 0 9 Z", numinia: "M0 -9 A9 9 0 0 1 0 9 A9 9 0 0 1 0 -9 Z" };

  // Remember what each marked element says on the page as served.
  // Each marked element carries its served text in data-nw-bridge (set at
  // build); an element without it (a lead holding a link) is snapshotted here.
  const marked = [...document.querySelectorAll<HTMLElement>("[data-nw]")];
  const served = new Map<HTMLElement, string>();
  for (const el of marked) if (el.dataset.nwBridge === undefined) served.set(el, el.innerHTML);
  const apply = (stop: string) => {
    for (const el of marked) {
      const v = stop === "bridge" ? undefined : el.dataset[stop === "plain" ? "nwPlain" : "nwNuminia"];
      if (v !== undefined) el.textContent = v;
      else if (served.has(el)) el.innerHTML = served.get(el)!;
      else el.textContent = el.dataset.nwBridge ?? "";
    }
    // The tab: the page's own name, then the site's name at this level.
    const t = document.querySelector<HTMLTitleElement>("title[data-nw-page]");
    if (t) document.title = siteTitle(t.dataset.nwPage ?? "", stop);
    // Attributes that name a label (a tooltip, an aria-label): each listed in
    // data-nw-attrs keeps its served value in data-nw-bridge-<name>.
    for (const el of document.querySelectorAll<Element>("[data-nw-attrs]")) {
      for (const name of (el.getAttribute("data-nw-attrs") ?? "").split(" ").filter(Boolean)) {
        const v = el.getAttribute(`data-nw-${stop}-${name}`) ?? el.getAttribute(`data-nw-bridge-${name}`);
        if (v !== null) el.setAttribute(name, v);
      }
    }
  };

  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-nd-cycle]")];
  const say = document.querySelector<HTMLElement>("[data-nd-say]");
  let cur = STOPS.some((s) => s.id === root.dataset.narrative) ? root.dataset.narrative! : DEFAULT_STOP;
  const paint = () => {
    root.dataset.narrative = cur;
    const i = STOPS.findIndex((s) => s.id === cur);
    const s = STOPS[i], next = STOPS[(i + 1) % STOPS.length];
    const name = `Narrative level ${s.level}`;
    for (const b of buttons) {
      b.title = name;
      b.setAttribute("aria-label", `${name}. Tap for ${next.level}.`);
      const n = b.querySelector("[data-nd-name]"); if (n) n.textContent = name;
    }
    document.querySelectorAll(".nd-lit").forEach((p) => p.setAttribute("d", LIT[cur]));
    apply(cur);
  };
  const go = (id: string) => {
    cur = id;
    try { localStorage.setItem(KEY, id); } catch { /* private mode: this page only */ }
    if (say) say.textContent = STOPS.find((s) => s.id === id)!.say;
    if (reduce) { paint(); return; }
    root.classList.add("nd-out");
    setTimeout(() => {
      paint();
      document.querySelectorAll<HTMLElement>("main .mcol").forEach((c) => { c.style.animation = "none"; void c.offsetWidth; c.style.animation = ""; });
      root.classList.remove("nd-out");
    }, 340);
  };
  // One tap, the next level: L1 → L2 → L3 → L1.
  for (const b of buttons) b.addEventListener("click", () => {
    const i = STOPS.findIndex((s) => s.id === cur);
    go(STOPS[(i + 1) % STOPS.length].id);
  });

  paint();
</script>
)}
