---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// MIS-119 — Listen: speak the rendered document through the browser's own
// synthesis (Web Speech API). Sovereign by construction: the text never
// leaves the reader's machine. No React island — a plain script, like the
// rest of the toolbar.
//
// The one hard part is queue control. Engines (Chrome documented) cut a
// single utterance after ~15s, so the article is split on sentence
// boundaries and queued utterance by utterance. And cancel() is not silent:
// the engine fires the cancelled utterance's end/error events, which race
// whatever starts next. Every cancel therefore bumps a generation counter,
// and callbacks from an older generation are no-ops (see `gen`).
interface Props {
  /** CSS selector of the element whose text is spoken. */
  textSelector?: string;
  /** BCP-47 language of the document (from frontmatter when declared). */
  lang?: string;
}
const { textSelector = "article", lang = "en" } = Astro.props;
import { useT } from "@/i18n/ui";
const t = useT();

---

<div
  class="speech-player inline-flex flex-wrap items-center gap-2"
  data-text-selector={textSelector}
  data-lang={lang}
  data-t-listen={t("speech.listen")}
  data-t-pause={t("speech.pause")}
  data-t-resume={t("speech.resume")}
  data-t-listen-aria={t("speech.listenAria")}
  data-t-pause-aria={t("speech.pauseAria")}
  data-t-resume-aria={t("speech.resumeAria")}
  data-t-no-engine={t("speech.noEngine")}
  data-t-nothing={t("speech.nothing")}
  data-t-rate-aria={t("speech.rateAria", { rate: "{rate}" })}
  data-t-min={t("speech.min")}
>
  <button
    type="button"
    class="sp-toggle inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-3 py-2 sm:py-1.5 min-h-[44px] lg:min-h-0 transition-colors aria-pressed:border-accent/60 aria-pressed:text-accent"
    aria-pressed="false"
    aria-label={t("speech.listenAria")}
  >
    <span class="sp-icon" aria-hidden="true">▶</span>
    <span class="sp-label">Listen</span>
    <span class="sp-est text-dim"></span>
  </button>
  <button
    type="button"
    class="sp-stop hidden font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-2.5 py-2 sm:py-1.5 min-h-[44px] lg:min-h-0 transition-colors"
    aria-label={t("speech.stop")}
  >■</button>
  <button
    type="button"
    class="sp-rate font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-2.5 py-2 sm:py-1.5 min-h-[44px] min-w-[44px] lg:min-h-0 lg:min-w-0 transition-colors"
    aria-label={t("speech.rateAria", { rate: "1" })}
    data-rate="1"
  >1×</button>
</div>

<script>
  // One controller per toolbar instance; pages can mount several toolbars.
  const RATES = [1, 1.5, 2];
  const WPM = 180; // baseline speaking pace for the estimate

  for (const root of document.querySelectorAll<HTMLElement>(".speech-player")) {
    // UI strings come pre-translated from the server as data-t-* attributes
    // (MIS-120c); T reads them back. QA 2026-08-28, defect 4: the sweep
    // serialized the attributes but never defined this reader, so every
    // click threw `ReferenceError: T is not defined` and the player was
    // dead on arrival — the REAL cause of "pause doesn't work" on live.
    // The fallback string keeps the player alive even if an attribute
    // goes missing.
    const T = (key: string, fallback: string) =>
      root.dataset["t" + key] ?? fallback;
    const toggle = root.querySelector<HTMLButtonElement>(".sp-toggle")!;
    const stopBtn = root.querySelector<HTMLButtonElement>(".sp-stop")!;
    const rateBtn = root.querySelector<HTMLButtonElement>(".sp-rate")!;
    const label = root.querySelector<HTMLElement>(".sp-label")!;
    const icon = root.querySelector<HTMLElement>(".sp-icon")!;
    const est = root.querySelector<HTMLElement>(".sp-est")!;

    if (!("speechSynthesis" in window)) {
      toggle.disabled = true;
      rateBtn.disabled = true;
      toggle.title = T("NoEngine","This browser has no speech synthesis");
      toggle.classList.add("opacity-50");
      continue;
    }
    const synth = window.speechSynthesis;

    // ---- text extraction -------------------------------------------------
    // MIS-120(e): extracted from the LIVE DOM, and re-extracted on every
    // Play — not once at load. A reader who runs the browser's own
    // translation gets a page whose text nodes have been replaced in place;
    // reading a snapshot taken at load would speak the English original
    // while the screen shows Spanish. Reading the DOM at Play time needs no
    // detection and no API: whatever is on screen is what gets spoken, in
    // every browser that can translate at all.
    //
    // Reading marker: the walker also keeps, for every character
    // of the spoken text, which Text node it came from and at what offset.
    // That map is what lets the amber dot sit above the word the voice is
    // on. Whitespace runs collapse to one space (mapped to no node); a block
    // boundary counts as whitespace so "</p><p>" never glues two words.
    // MIS-119 assumed every page that can be listened to is a document, and
    // a document view wraps its prose in <article>. The composed pages — the
    // home, the function pages, the indexes — have no <article>: they are a
    // <main> full of sections. Play found nothing, spoke nothing, and said
    // nothing, because "no text" is a legitimate state for a page still
    // hydrating. So the selector falls back through what the page actually
    // has. `main` is the honest target: Layout gives every page one, and it
    // excludes the header, the nav and the footer by construction.
    const SELECTORS = [root.dataset.textSelector, "article", "main#main", "main"];
    let target: HTMLElement | null = null;
    for (const sel of SELECTORS) {
      if (!sel) continue;
      target = document.querySelector<HTMLElement>(sel);
      if (target) break;
    }
    const PRUNE = [".doc-toolbar", "nav", ".speech-player"];
    const SKIP_TAGS = new Set(["SCRIPT", "STYLE", "NOSCRIPT", "TEMPLATE", "svg", "SVG"]);
    type DocMap = { text: string; nodes: Text[]; nodeIdx: Int32Array; nodeOff: Int32Array };
    const EMPTY_MAP: DocMap = { text: "", nodes: [], nodeIdx: new Int32Array(0), nodeOff: new Int32Array(0) };
    const mapDocument = (): DocMap => {
      if (!target) return EMPTY_MAP;
      const nodes: Text[] = [];
      const idx: number[] = [];
      const off: number[] = [];
      let out = "";
      let pendingSpace = false;
      const walk = (el: Element) => {
        if (SKIP_TAGS.has(el.tagName)) return;
        if (PRUNE.some((s) => el.matches(s))) return;
        const cs = getComputedStyle(el);
        if (cs.display === "none" || cs.visibility === "hidden") return;
        const block = !cs.display.startsWith("inline");
        if (block) pendingSpace = true;
        for (const c of Array.from(el.childNodes)) {
          if (c.nodeType === Node.ELEMENT_NODE) {
            walk(c as Element);
            continue;
          }
          if (c.nodeType !== Node.TEXT_NODE) continue;
          const tn = c as Text;
          const s = tn.data;
          let ni = -1;
          for (let i = 0; i < s.length; i++) {
            const ch = s[i];
            if (/\s/.test(ch)) {
              pendingSpace = true;
              continue;
            }
            if (pendingSpace && out.length) {
              out += " ";
              idx.push(-1);
              off.push(0);
            }
            pendingSpace = false;
            if (ni < 0) ni = nodes.push(tn) - 1;
            out += ch;
            idx.push(ni);
            off.push(i);
          }
        }
        if (block) pendingSpace = true;
      };
      walk(target);
      return { text: out, nodes, nodeIdx: Int32Array.from(idx), nodeOff: Int32Array.from(off) };
    };
    let docMap = mapDocument();
    const readDocument = () => mapDocument().text;
    let text = docMap.text;
    let words = text ? text.split(" ").length : 0;
    if (!words) {
      toggle.disabled = true;
      toggle.title = T("Nothing","Nothing to read on this page");
      toggle.classList.add("opacity-50");
      continue;
    }

    // ---- chunking (sentence boundaries, ~280 chars) ----------------------
    // Short chunks defeat the engine's long-utterance cutoff, make pause and
    // stop feel immediate, and let rate changes land quickly.
    const chunkText = (src: string): string[] => {
      const out: string[] = [];
      const sentences = src.match(/[^.!?…]+[.!?…]+[\s]*|[^.!?…]+$/g) ?? [src];
      let buf = "";
      for (const s of sentences) {
        if (buf.length + s.length > 280 && buf) {
          out.push(buf.trim());
          buf = "";
        }
        buf += s;
      }
      if (buf.trim()) out.push(buf.trim());
      return out;
    };
    let chunks: string[] = chunkText(text);
    // Where each chunk starts in `text` — the bridge from an utterance's
    // charIndex back to a document position (reading marker).
    const chunkStarts = (src: string, cs: string[]): number[] => {
      const out: number[] = [];
      let cursor = 0;
      for (const c of cs) {
        const at = src.indexOf(c, cursor);
        out.push(at < 0 ? cursor : at);
        cursor = (at < 0 ? cursor : at) + c.length;
      }
      return out;
    };
    let chunkAt: number[] = chunkStarts(text, chunks);

    // ---- voice pick (async: engines populate voices late) ----------------
    // MIS-120(e): docLang is read from the LIVE <html lang>, not baked in at
    // build. Chrome, Edge and Safari rewrite that attribute when their own
    // translation runs (it is the documented way to detect machine
    // translation), so a translated page picks a voice in the language the
    // reader is actually looking at — Spanish, Japanese, any of them, with
    // no list to maintain. The build-time attribute is the fallback for
    // browsers that translate without relabelling.
    const liveLang = () =>
      (document.documentElement.lang || root.dataset.lang || "en").toLowerCase();
    let docLang = liveLang();
    let voice: SpeechSynthesisVoice | null = null;
    const pickVoice = () => {
      const vs = synth.getVoices();
      voice =
        vs.find((v) => v.lang.toLowerCase() === docLang) ??
        vs.find((v) => v.lang.toLowerCase().startsWith(docLang.slice(0, 2))) ??
        null; // engine default is an acceptable fallback
    };
    pickVoice();
    synth.addEventListener?.("voiceschanged", pickVoice);

    // ---- estimate --------------------------------------------------------
    let rate = 1;
    const renderEst = () => {
      const mins = words / (WPM * rate);
      est.textContent =
        mins < 1 ? "· <1 " + T("Min","min") : "· ~" + Math.round(mins) + " " + T("Min","min");
    };
    renderEst();

    // ---- state machine: idle → speaking ⇄ paused → idle ------------------
    // `gen` is the queue's epoch. cancel() makes the engine fire the
    // cancelled utterance's end/error asynchronously; without the epoch
    // check those stale events advance or corrupt the NEW queue (QA
    // 2026-08-28: rate change mid-play killed playback after one chunk).
    let state: "idle" | "speaking" | "paused" = "idle";
    let queueIndex = 0;
    let gen = 0;
    let keepalive: number | undefined;
    // Word-level position inside the current chunk (QA 2026-08-28, defect
    // 4: pausing early in a ~280-char chunk and resuming replayed the whole
    // chunk — within the FIRST chunk that is indistinguishable from
    // restarting the document). `charOffset` is where the current
    // utterance's text starts inside chunks[queueIndex]; `lastBoundary` is
    // the last word boundary the engine reported, relative to that
    // utterance. Boundary events are a progressive enhancement: engines
    // that never fire them leave lastBoundary at 0 and resume falls back
    // to the chunk start — never worse than before.
    let charOffset = 0;
    let lastBoundary = 0;
    // When the utterance started speaking, and at what rate. Some engines
    // (Chrome/Edge network voices, notably) never fire boundary events; for
    // those, elapsed time × speaking pace estimates how far the voice got
    // (QA 2026-08-28, defect 6: with such a voice, changing rate early in
    // the document restarted it from the top — lastBoundary was still 0).
    // The estimate is deliberately conservative (~85% of nominal pace):
    // repeating a couple of words beats skipping words never heard.
    let utterStart = 0;
    let utterRate = 1;
    const CPS = (WPM * 6) / 60; // chars/sec at 1×: ~5 letters + space per word
    const spokenInUtterance = () => {
      if (lastBoundary > 0) return lastBoundary; // exact, engine-reported
      if (!utterStart) return 0;
      const elapsed = (performance.now() - utterStart) / 1000;
      return Math.max(0, Math.floor(elapsed * CPS * utterRate * 0.85));
    };

    // ---- position persistence (QA 2026-08-28: pause + navigate away lost
    // the position). The chunk index and rate survive the page in
    // sessionStorage, keyed by route + selector. Only an explicit Stop or
    // the document's natural end clears it; leaving the page does not.
    // chunks.length is stored as a fingerprint: if a deploy re-chunks the
    // text, the stale index is discarded instead of resuming mid-nonsense.
    // Keyed by the selector that actually resolved, not the one asked for:
    // a page whose <article> appears later must not resume at an index
    // measured against <main>.
    const storeKey =
      "sp:" + location.pathname + ":" + (target?.tagName.toLowerCase() ?? "none");
    const saveProgress = () => {
      try {
        sessionStorage.setItem(
          storeKey,
          JSON.stringify({ i: queueIndex, o: charOffset, rate, n: chunks.length }),
        );
      } catch {
        /* storage full/blocked: degrade to the old session-only behavior */
      }
    };
    const clearProgress = () => {
      try {
        sessionStorage.removeItem(storeKey);
      } catch {
        /* ignore */
      }
    };
    // Restore a previous position before first render. Rate is restored
    // too — resuming at the pace the reader chose, not the default.
    try {
      const saved = JSON.parse(sessionStorage.getItem(storeKey) ?? "null");
      if (
        saved &&
        saved.n === chunks.length &&
        Number.isInteger(saved.i) &&
        (saved.i > 0 || (Number.isInteger(saved.o) && saved.o > 0)) &&
        saved.i < chunks.length
      ) {
        queueIndex = saved.i;
        if (Number.isInteger(saved.o) && saved.o > 0 && saved.o < chunks[saved.i].length)
          charOffset = saved.o;
        if (RATES.includes(saved.rate)) {
          rate = saved.rate;
          rateBtn.textContent = rate + "×";
          rateBtn.dataset.rate = String(rate);
          renderEst();
        }
      } else if (saved) {
        clearProgress(); // stale fingerprint: the text changed under it
      }
    } catch {
      /* unreadable entry: treat as no saved position */
    }

    const stopKeepalive = () => {
      if (keepalive !== undefined) {
        clearInterval(keepalive);
        keepalive = undefined;
      }
    };
    const startKeepalive = () => {
      stopKeepalive();
      // Chrome pauses synthesis on long runs / background tabs; a periodic
      // resume() is the documented workaround.
      keepalive = window.setInterval(() => {
        if (state === "speaking" && synth.paused) synth.resume();
      }, 5000);
    };

    // ---- reading marker ----------------------------------------
    // A small amber dot drifts above the word being spoken, karaoke-style,
    // and leaves a long, soft trail behind it. It rests where the voice
    // rests — the engine pauses at punctuation, so the dot does too —
    // brightens a little on a stop, glows briefly on an accented word, and
    // breathes slowly while the voice moves. The Oracle asked for wind,
    // not a mouse: every motion here is slow, eased, and translucent. Progressive: on engines that report
    // word boundaries the position is exact; on the ones that do not, it
    // follows the same elapsed-time estimate pause/resume already rely on.
    // Under prefers-reduced-motion the dot still moves, but jumps: no
    // trail, no bob, no twinkle.
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const TRAIL = reducedMotion ? 1 : 10;
    let marker: HTMLElement | null = null;
    let head: HTMLElement | null = null;
    let curWord = -1;
    let curRange: Range | null = null;
    let lastScroll = 0;
    let raf = 0;
    const ensureMarker = () => {
      if (marker) return;
      marker = document.createElement("div");
      marker.className = "sp-marker";
      marker.setAttribute("aria-hidden", "true");
      for (let i = TRAIL - 1; i >= 0; i--) {
        const d = document.createElement("i");
        d.className = "sp-marker-dot";
        d.style.setProperty("--i", String(i));
        d.appendChild(document.createElement("b"));
        marker.appendChild(d);
        if (i === 0) head = d.firstElementChild as HTMLElement;
      }
      document.body.appendChild(marker);
    };
    const dropMarker = () => {
      marker?.remove();
      marker = head = null;
      curWord = -1;
      curRange = null;
    };
    const wordAt = (a: number): [number, number] => {
      const s0 = docMap.text;
      let s = Math.max(0, Math.min(a, s0.length - 1));
      while (s < s0.length && s0[s] === " ") s++;
      if (s >= s0.length) return [-1, -1];
      let e = s0.indexOf(" ", s);
      if (e < 0) e = s0.length;
      return [s, e];
    };
    const rangeFor = (s: number, e: number): Range | null => {
      const { nodes, nodeIdx, nodeOff } = docMap;
      let i = s;
      while (i < e && nodeIdx[i] < 0) i++;
      let j = e - 1;
      while (j > i && nodeIdx[j] < 0) j--;
      if (i >= e || nodeIdx[i] < 0 || !nodes[nodeIdx[i]]?.isConnected) return null;
      const r = document.createRange();
      r.setStart(nodes[nodeIdx[i]], nodeOff[i]);
      r.setEnd(nodes[nodeIdx[j]], nodeOff[j] + 1);
      return r;
    };
    const placeAt = (rect: DOMRect) => {
      if (!marker) return;
      // Document coordinates. body positioned → relative to body; static →
      // relative to the initial containing block, i.e. add the scroll.
      const b = document.body;
      const positioned = getComputedStyle(b).position !== "static";
      const bb = positioned ? b.getBoundingClientRect() : null;
      const x = rect.left + rect.width / 2 - (bb ? bb.left : -scrollX);
      const y = rect.top - (bb ? bb.top : -scrollY);
      marker.style.setProperty("--x", x.toFixed(1) + "px");
      marker.style.setProperty("--y", y.toFixed(1) + "px");
    };
    const showWord = (s: number, e: number) => {
      ensureMarker();
      const r = rangeFor(s, e);
      if (!r) return;
      const rects = r.getClientRects();
      const rect = rects.length ? rects[0] : r.getBoundingClientRect();
      if (!rect.width && !rect.height) return;
      curRange = r;
      const prevY = parseFloat(marker!.style.getPropertyValue("--y")) || 0;
      placeAt(rect);
      const nowY = parseFloat(marker!.style.getPropertyValue("--y")) || 0;
      // Crossing to another line: let the dot glide there, not snap.
      marker!.classList.toggle("is-drift", Math.abs(nowY - prevY) > rect.height * 0.6);
      if (head && !reducedMotion) {
        const w = docMap.text.slice(s, e);
        head.classList.remove("is-rest", "is-twinkle");
        void head.offsetWidth; // restart the one-shot animations
        if (/[.,;:!?…)\]»”"']$/.test(w)) head.classList.add("is-rest");
        if (/[áéíóúàèìòùâêîôûäëïöüñçãõœæÁÉÍÓÚÑÜ]/.test(w)) head.classList.add("is-twinkle");
      }
      // Keep the reading in view: when the word leaves the comfortable band,
      // bring it to the upper third, at most once a second.
      const now = performance.now();
      if ((rect.top < 72 || rect.bottom > innerHeight - 96) && now - lastScroll > 1000) {
        lastScroll = now;
        scrollTo({
          top: rect.top + scrollY - innerHeight * 0.35,
          behavior: reducedMotion ? "auto" : "smooth",
        });
      }
    };
    const tick = () => {
      if (state !== "speaking") {
        raf = 0;
        return;
      }
      const start = chunkAt[queueIndex] ?? 0;
      const end = start + (chunks[queueIndex]?.length ?? 0) - 1;
      const abs = Math.min(start + charOffset + spokenInUtterance(), end);
      const [s, e] = wordAt(abs);
      if (s >= 0 && s !== curWord) {
        curWord = s;
        showWord(s, e);
      }
      raf = requestAnimationFrame(tick);
    };
    const markerSync = () => {
      ensureMarker();
      marker!.style.setProperty("--rate", String(rate));
      marker!.classList.toggle("is-on", state !== "idle");
      marker!.classList.toggle("is-paused", state === "paused");
      if (state === "speaking" && !raf) raf = requestAnimationFrame(tick);
      if (state === "idle") curWord = -1;
    };
    // Layout can move under a resting dot (resize, fonts, a paused reader
    // rotating the phone): re-place from the range we already hold.
    addEventListener("resize", () => {
      const rects = curRange?.getClientRects();
      if (rects && rects.length) placeAt(rects[0]);
    });

    const render = () => {
      markerSync();
      // Idle with a saved position (restored from a previous visit) is
      // presented as Resume: the reader left mid-document and comes back.
      const resumable =
        state === "paused" ||
        (state === "idle" && (queueIndex > 0 || charOffset > 0));
      toggle.setAttribute("aria-pressed", String(state === "speaking"));
      icon.textContent = state === "speaking" ? "❚❚" : "▶";
      label.textContent =
        state === "speaking" ? T("Pause","Pause") : resumable ? T("Resume","Resume") : T("Listen","Listen");
      toggle.setAttribute(
        "aria-label",
        state === "speaking"
          ? T("PauseAria","Pause listening")
          : resumable
            ? T("ResumeAria","Resume listening")
            : T("ListenAria","Listen to this document"),
      );
      stopBtn.classList.toggle("hidden", state === "idle" && queueIndex === 0);
    };

    const speakFrom = (i: number, offset = 0) => {
      if (i >= chunks.length) {
        // Natural end: also release the keepalive (QA: it leaked here and
        // stacked a second interval on the next play). The document is
        // finished — the saved position dies with it.
        state = "idle";
        queueIndex = 0;
        charOffset = 0;
        clearProgress();
        stopKeepalive();
        render();
        return;
      }
      queueIndex = i;
      // Snap the offset back to a word boundary so the utterance never
      // starts mid-word; a broken offset degrades to the chunk start.
      charOffset =
        offset > 0 && offset < chunks[i].length - 1
          ? chunks[i].lastIndexOf(" ", offset) + 1
          : 0;
      lastBoundary = 0;
      saveProgress();
      const g = gen;
      const u = new SpeechSynthesisUtterance(chunks[i].slice(charOffset));
      if (voice) u.voice = voice;
      u.lang = voice?.lang ?? docLang;
      u.rate = rate;
      utterStart = performance.now();
      utterRate = rate;
      u.onstart = () => {
        // Engines queue; the clock starts when sound actually starts.
        if (g === gen) utterStart = performance.now();
      };
      u.onboundary = (e) => {
        // Word boundaries mark where a pause can resume. Engines that never
        // fire this leave lastBoundary at 0 — resume from the chunk start.
        if (g === gen && typeof e.charIndex === "number" && e.charIndex > 0)
          lastBoundary = e.charIndex;
      };
      u.onend = () => {
        if (g !== gen) return; // stale: a cancel() superseded this queue
        if (state === "speaking") speakFrom(queueIndex + 1);
      };
      u.onerror = (e) => {
        if (g !== gen) return; // stale
        // Our own cancel() surfaces here as interrupted/canceled — not an
        // error. Anything else (voice vanished, engine died): stop cleanly
        // rather than leaving a button that lies about its state.
        if (e.error === "interrupted" || e.error === "canceled") return;
        state = "idle";
        stopKeepalive();
        render();
      };
      synth.speak(u);
    };

    const start = () => {
      // MIS-120(e): re-read the document before speaking. If the reader ran
      // the browser's translation since the page loaded, the DOM now holds
      // their language and the snapshot taken at load is stale English.
      // Re-chunking invalidates any saved position (the chunk boundaries
      // moved), so a language change restarts the document rather than
      // resuming at an index that no longer means the same thing.
      const freshMap = mapDocument();
      const fresh = freshMap.text;
      docMap = freshMap; // nodes may have been replaced in place (translation)
      if (fresh && fresh !== text) {
        text = fresh;
        words = text.split(" ").length;
        chunks = chunkText(text);
        chunkAt = chunkStarts(text, chunks);
        queueIndex = 0;
        charOffset = 0;
        lastBoundary = 0;
        clearProgress();
        renderEst();
      }
      const nowLang = liveLang();
      if (nowLang !== docLang) {
        docLang = nowLang;
        pickVoice();
      }
      gen++;
      synth.cancel(); // never stack on a previous run
      state = "speaking";
      render();
      startKeepalive();
      speakFrom(queueIndex, charOffset); // honor a restored mid-chunk position
    };

    const stopAll = () => {
      gen++;
      state = "idle";
      queueIndex = 0;
      charOffset = 0;
      lastBoundary = 0;
      clearProgress(); // Stop is the reader saying "from the top next time"
      stopKeepalive();
      synth.cancel();
      render();
    };

    // Page teardown is NOT Stop: the voice must not outlive the page, but
    // the position must (QA 2026-08-28 — pause, browse away, come back,
    // resume where you left off).
    const teardown = () => {
      if (state === "speaking") charOffset = charOffset + spokenInUtterance();
      if (state !== "idle" || queueIndex > 0 || charOffset > 0) saveProgress();
      gen++;
      stopKeepalive();
      synth.cancel();
      dropMarker();
    };

    toggle.addEventListener("click", () => {
      if (state === "idle") return start();
      if (state === "speaking") {
        // Pause is OURS, not the engine's. speechSynthesis.pause()/resume()
        // is unreliable across engines: Chrome drops a paused queue after
        // ~15s, Android ignores pause mid-utterance, and Linux
        // speech-dispatcher (Firefox) can end the utterance on pause so a
        // later resume() resumes nothing (QA 2026-08-28: pause+play went
        // silent or restarted from the top). So pausing cancels the engine
        // outright; the position lives in queueIndex + charOffset, which we
        // own. Resume re-speaks from the last word boundary the engine
        // reported — deterministic on every engine, worst case repeating a
        // few words (or the chunk, on engines without boundary events).
        state = "paused";
        // Freeze the word-level position BEFORE cancel() — the engine's
        // boundary counter dies with the utterance. Absolute offset in the
        // chunk = where this utterance started + how far the voice got
        // (engine-reported boundary, or the elapsed-time estimate).
        charOffset = charOffset + spokenInUtterance();
        lastBoundary = 0;
        gen++; // stale-out the cancelled utterance's end/error events
        synth.cancel();
        saveProgress();
        stopKeepalive();
        render();
        return;
      }
      // paused → resume: re-speak the current chunk from the last word
      // boundary heard (or its start, on engines without boundary events).
      // MIS-120(e): unless the document changed language under us while
      // paused — then the saved position points into text that no longer
      // exists, and start() re-reads, re-chunks and begins afresh.
      if (readDocument() !== text) return start();
      state = "speaking";
      render();
      startKeepalive();
      speakFrom(queueIndex, charOffset);
    });

    stopBtn.addEventListener("click", stopAll);

    rateBtn.addEventListener("click", () => {
      rate = RATES[(RATES.indexOf(rate) + 1) % RATES.length];
      rateBtn.textContent = rate + "×";
      rateBtn.dataset.rate = String(rate);
      rateBtn.setAttribute(
        "aria-label",
        T("RateAria","Playback rate: {rate}x. Press to change").replace("{rate}", String(rate)),
      );
      renderEst();
      // Apply mid-run: bump the epoch so the cancelled utterance's events
      // are stale, then continue from the same chunk at the new rate. While
      // paused, the new rate simply applies on resume.
      if (state === "speaking") {
        gen++;
        // Keep the word position across the rate change, same as pause:
        // the reading continues where it was, only faster or slower
        // (QA 2026-08-28, defect 6 — a rate change must never restart).
        charOffset = charOffset + spokenInUtterance();
        lastBoundary = 0;
        synth.cancel();
        speakFrom(queueIndex, charOffset);
      } else if (queueIndex > 0 || charOffset > 0) {
        saveProgress(); // keep the stored rate in step with the position
      }
    });

    // The voice must not outlive the page — but the position does.
    addEventListener("beforeunload", teardown);
    document.addEventListener("astro:before-swap", teardown);

    render(); // reflect a restored position (Resume) on first paint
  }
</script>

<style is:global>
  /* Reading marker: an amber dot above the word being spoken. Trail dots
     share the head's target position and lag behind it through staggered
     transition durations — the "estela" is just the difference between
     their clocks. Colour is the theme's amber token; everything is
     translucent and slow on purpose: wind, not a mouse. */
  .sp-marker {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 60;
    opacity: 0;
    transition: opacity 600ms ease;
  }
  .sp-marker.is-on {
    opacity: 1;
  }
  .sp-marker.is-paused {
    opacity: 0.4;
  }
  .sp-marker-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    transform: translate(var(--x, -100px), var(--y, -100px));
    transition: transform calc(420ms + var(--i) * 95ms) cubic-bezier(0.3, 0, 0.15, 1);
    will-change: transform;
  }
  .sp-marker.is-drift .sp-marker-dot {
    transition-duration: calc(720ms + var(--i) * 95ms);
  }
  .sp-marker-dot > b {
    --d: calc(6px - var(--i) * 0.4px);
    position: absolute;
    left: calc(var(--d) / -2);
    top: calc(var(--d) / -2 - 3px);
    width: var(--d);
    height: var(--d);
    border-radius: 50%;
    background: rgb(var(--yellow));
    opacity: calc(0.78 - var(--i) * 0.07);
    box-shadow: 0 0 calc(3px + 0.6px * (9 - var(--i))) rgb(var(--yellow) / 0.35);
    animation: sp-breathe calc(2.8s / var(--rate, 1)) ease-in-out infinite;
    animation-delay: calc(var(--i) * -140ms);
  }
  .sp-marker.is-paused .sp-marker-dot > b {
    animation-play-state: paused;
  }
  .sp-marker-dot > b.is-rest {
    animation:
      sp-rest 900ms ease-in-out 1,
      sp-breathe calc(2.8s / var(--rate, 1)) ease-in-out 900ms infinite;
  }
  .sp-marker-dot > b.is-twinkle {
    animation:
      sp-glow 800ms ease-in-out 1,
      sp-breathe calc(2.8s / var(--rate, 1)) ease-in-out 800ms infinite;
  }
  @keyframes sp-breathe {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -1.5px; }
  }
  @keyframes sp-rest {
    0% { scale: 1; filter: brightness(1); }
    45% { scale: 1.12; filter: brightness(1.25); }
    100% { scale: 1; filter: brightness(1); }
  }
  @keyframes sp-glow {
    0% { filter: brightness(1); box-shadow: 0 0 3px rgb(var(--yellow) / 0.35); }
    50% { filter: brightness(1.35); box-shadow: 0 0 9px 1px rgb(var(--yellow) / 0.5); }
    100% { filter: brightness(1); box-shadow: 0 0 3px rgb(var(--yellow) / 0.35); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sp-marker-dot { transition: none; }
    .sp-marker-dot > b { animation: none; }
  }
</style>
