---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// MIS-119 — Listen: speak the rendered document through the browser's own
// synthesis (Web Speech API). Sovereign by construction: the text never
// leaves the reader's machine. No React island — a plain script, like the
// rest of the toolbar.
//
// The one hard part is queue control. Engines (Chrome documented) cut a
// single utterance after ~15s, so the article is split on sentence
// boundaries and queued utterance by utterance. And cancel() is not silent:
// the engine fires the cancelled utterance's end/error events, which race
// whatever starts next. Every cancel therefore bumps a generation counter,
// and callbacks from an older generation are no-ops (see `gen`).
//
// 2026-09-24 — the dock and the ruler (the Oracle, three rounds of
// prototypes on the live canon page). What changed and why:
//
// - The page no longer drags the reader. The old player scrolled to the
//   word whenever it left the view, so reading ahead or going back while it
//   spoke was a fight. Now the page follows the voice only until the reader
//   scrolls; from then on the voice keeps going and a "Back to the reading"
//   button appears above the dock, pointing where the voice is. Reaching the
//   word again by hand resumes the following. One scroll only: the page's.
// - The controls live in a dock that surfaces at the bottom while the
//   voice is on: the document's own card, in the Velo's glass, the width of
//   the text column — so it reads as part of the page, not a widget on it.
// - The ruler replaces the idea of a progress bar: a hairline with fine
//   marks and a longer mark at each section, the heard part printed in a
//   halftone — a 1920 print ruler. Hover shows the section and the first
//   words of the sentence a drop would start; a drop starts the voice at
//   the head of that sentence (lib/speech-position.ts). Arrows step by
//   sentence.
// - What has been read dries like ink: it fades to translucent behind the
//   voice (CSS Custom Highlight API — no DOM is touched, so the text map and
//   the browser's own translation stay intact). The colour of the text is
//   never animated.
// - The reading marker keeps its behaviour (drift, trail, rest on a stop)
//   but is a diffuse light in Arena, not an amber dot, and it glides: a
//   critically damped spring moved every frame, and the target slides along
//   the word as the voice goes through it, so nothing hops word to word.
import { useT } from "@/i18n/ui";
import Icon from "@/components/Icon.astro";

interface Props {
  /** CSS selector of the element whose text is spoken. */
  textSelector?: string;
  /** BCP-47 language of the document (from frontmatter when declared). */
  lang?: string;
}
const { textSelector = "article", lang = "en" } = Astro.props;
const t = useT();
---

<div
  class="speech-player inline-flex flex-wrap items-center gap-2"
  data-text-selector={textSelector}
  data-lang={lang}
  data-t-listen={t("speech.listen")}
  data-t-pause={t("speech.pause")}
  data-t-resume={t("speech.resume")}
  data-t-listen-aria={t("speech.listenAria")}
  data-t-pause-aria={t("speech.pauseAria")}
  data-t-resume-aria={t("speech.resumeAria")}
  data-t-no-engine={t("speech.noEngine")}
  data-t-nothing={t("speech.nothing")}
  data-t-rate-aria={t("speech.rateAria", { rate: "{rate}" })}
  data-t-min={t("speech.min")}
  data-t-position-text={t("speech.positionText", { at: "{at}", total: "{total}" })}
  data-t-reading={t("speech.reading")}
  data-t-paused={t("speech.paused")}
  data-t-stopped={t("speech.stopped")}
>
  <button
    type="button"
    class="sp-toggle inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-3 py-2 sm:py-1.5 min-h-[44px] lg:min-h-0 transition-colors aria-pressed:border-accent/60 aria-pressed:text-accent"
    aria-pressed="false"
    aria-label={t("speech.listenAria")}
  >
    <span class="sp-icon" aria-hidden="true">▶</span>
    <span class="sp-label">Listen</span>
    <span class="sp-est text-dim"></span>
  </button>

  <!-- The dock: fixed to the viewport; the script moves it to <body>. -->
  <div class="sp-dock" role="region" aria-label={t("speech.player")}>
    <button type="button" class="sp-back">
      <i aria-hidden="true"></i>
      <span>{t("speech.back")}</span>
      <Icon name="arrow-down-bold" size={11} />
    </button>
    <div class="sp-card">
      <button type="button" class="sp-btn sp-play" aria-label={t("speech.pauseAria")}>
        <span class="sp-when-playing"><Icon name="pause-fill" size={13} /></span>
        <span class="sp-when-paused"><Icon name="play-fill" size={13} /></span>
      </button>
      <div class="sp-mid">
        <div class="sp-meta">
          <span class="sp-sec"></span>
          <span class="sp-time"></span>
        </div>
        <div
          class="sp-ruler"
          role="slider"
          tabindex="0"
          aria-label={t("speech.position")}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
        >
          <svg class="sp-ticks" aria-hidden="true"></svg>
          <div class="sp-halftone" aria-hidden="true"></div>
          <div class="sp-head" aria-hidden="true"></div>
          <div class="sp-peek" aria-hidden="true"><b></b><span></span></div>
        </div>
      </div>
      <button type="button" class="sp-btn sp-rate" data-rate="1" aria-label={t("speech.rateAria", { rate: "1" })}>1×</button>
      <button type="button" class="sp-btn sp-stop" aria-label={t("speech.stop")}>
        <Icon name="x" size={13} />
      </button>
    </div>
  </div>
  <div class="sp-live sr-only" aria-live="polite"></div>
</div>

<script>
  import {
    sentenceStart,
    locate,
    clock,
    duration,
    sectionAt,
    sentences,
    spokenWeight,
    charAtSpoken,
    RATES,
    nextRate,
    WPM,
    type Section,
  } from "@/lib/speech-position";

  // One controller per toolbar instance; pages can mount several toolbars.
  // The chosen speed follows the reader from document to document.
  const RATE_KEY = "sp:rate";
  const loadRate = (): number => {
    try {
      const r = Number(localStorage.getItem(RATE_KEY));
      return (RATES as readonly number[]).includes(r) ? r : 1;
    } catch {
      return 1;
    }
  };
  const storeRate = (r: number) => {
    try {
      localStorage.setItem(RATE_KEY, String(r));
    } catch {
      /* private mode: the speed lives for this page only */
    }
  };

  for (const root of document.querySelectorAll<HTMLElement>(".speech-player")) {
    // UI strings come pre-translated from the server as data-t-* attributes
    // (MIS-120c); T reads them back. QA 2026-08-28, defect 4: the sweep
    // serialized the attributes but never defined this reader, so every
    // click threw `ReferenceError: T is not defined` and the player was
    // dead on arrival. The fallback string keeps the player alive even if
    // an attribute goes missing.
    const T = (key: string, fallback: string) => root.dataset["t" + key] ?? fallback;
    const toggle = root.querySelector<HTMLButtonElement>(".sp-toggle")!;
    const label = root.querySelector<HTMLElement>(".sp-label")!;
    const icon = root.querySelector<HTMLElement>(".sp-icon")!;
    const est = root.querySelector<HTMLElement>(".sp-est")!;
    const dock = root.querySelector<HTMLElement>(".sp-dock")!;
    const playBtn = root.querySelector<HTMLButtonElement>(".sp-play")!;
    const stopBtn = root.querySelector<HTMLButtonElement>(".sp-stop")!;
    const rateBtn = root.querySelector<HTMLButtonElement>(".sp-rate")!;
    const backBtn = root.querySelector<HTMLButtonElement>(".sp-back")!;
    const secEl = root.querySelector<HTMLElement>(".sp-sec")!;
    const timeEl = root.querySelector<HTMLElement>(".sp-time")!;
    const ruler = root.querySelector<HTMLElement>(".sp-ruler")!;
    const ticks = root.querySelector<SVGSVGElement>(".sp-ticks")!;
    const peek = root.querySelector<HTMLElement>(".sp-peek")!;
    const live = root.querySelector<HTMLElement>(".sp-live")!;

    if (!("speechSynthesis" in window)) {
      toggle.disabled = true;
      toggle.title = T("NoEngine", "This browser has no speech synthesis");
      toggle.classList.add("opacity-50");
      dock.remove();
      continue;
    }
    // The dock is position: fixed, but an ancestor with a transform or a
    // filter would trap it; it belongs to the body.
    document.body.appendChild(dock);
    const synth = window.speechSynthesis;

    // ---- text extraction -------------------------------------------------
    // MIS-120(e): extracted from the LIVE DOM, and re-extracted on every
    // Play — not once at load. A reader who runs the browser's own
    // translation gets a page whose text nodes have been replaced in place;
    // reading a snapshot taken at load would speak the English original
    // while the screen shows Spanish. Whatever is on screen is what gets
    // spoken, in every browser that can translate at all.
    //
    // The walker also keeps, for every character of the spoken text, which
    // Text node it came from and at what offset. That map is what lets the
    // marker sit above the word the voice is on and the read text dry behind
    // it. Whitespace runs collapse to one space (mapped to no node); a block
    // boundary counts as whitespace so "</p><p>" never glues two words. It
    // also records where each heading starts: those are the sections the
    // dock names and the ruler marks.
    //
    // MIS-119 assumed every page that can be listened to wraps its prose in
    // <article>. The composed pages have no <article>: they are a <main>
    // full of sections. So the selector falls back through what the page
    // actually has; `main` excludes the header, nav and footer by
    // construction.
    const SELECTORS = [root.dataset.textSelector, "article", "main#main", "main"];
    let target: HTMLElement | null = null;
    for (const sel of SELECTORS) {
      if (!sel) continue;
      target = document.querySelector<HTMLElement>(sel);
      if (target) break;
    }
    const PRUNE = [".doc-toolbar", "nav", ".speech-player", ".sp-dock"];
    const SKIP_TAGS = new Set(["SCRIPT", "STYLE", "NOSCRIPT", "TEMPLATE", "svg", "SVG"]);
    type DocMap = {
      text: string;
      nodes: Text[];
      nodeIdx: Int32Array;
      nodeOff: Int32Array;
      /** First and last character of `text` each node holds. */
      nodeFirst: number[];
      nodeLast: number[];
      sections: Section[];
    };
    const pageTitle = () => (document.querySelector("h1")?.textContent ?? "").trim();
    const EMPTY_MAP: DocMap = {
      text: "",
      nodes: [],
      nodeIdx: new Int32Array(0),
      nodeOff: new Int32Array(0),
      nodeFirst: [],
      nodeLast: [],
      sections: [],
    };
    const mapDocument = (): DocMap => {
      if (!target) return EMPTY_MAP;
      const nodes: Text[] = [];
      const idx: number[] = [];
      const off: number[] = [];
      const sections: Section[] = [{ at: 0, title: pageTitle() }];
      let out = "";
      let pendingSpace = false;
      const walk = (el: Element) => {
        if (SKIP_TAGS.has(el.tagName)) return;
        if (PRUNE.some((s) => el.matches(s))) return;
        const cs = getComputedStyle(el);
        if (cs.display === "none" || cs.visibility === "hidden") return;
        const block = !cs.display.startsWith("inline");
        if (block) pendingSpace = true;
        if (/^H[2-4]$/.test(el.tagName)) {
          const title = (el.textContent ?? "").trim();
          const at = out.length ? out.length + 1 : 0;
          // A heading that opens the document renames the first section
          // instead of adding an empty one before it.
          if (title) {
            if (at === 0) sections[0] = { at: 0, title };
            else sections.push({ at, title });
          }
        }
        for (const c of Array.from(el.childNodes)) {
          if (c.nodeType === Node.ELEMENT_NODE) {
            walk(c as Element);
            continue;
          }
          if (c.nodeType !== Node.TEXT_NODE) continue;
          const tn = c as Text;
          const s = tn.data;
          let ni = -1;
          for (let i = 0; i < s.length; i++) {
            const ch = s[i];
            if (/\s/.test(ch)) {
              pendingSpace = true;
              continue;
            }
            if (pendingSpace && out.length) {
              out += " ";
              idx.push(-1);
              off.push(0);
            }
            pendingSpace = false;
            if (ni < 0) ni = nodes.push(tn) - 1;
            out += ch;
            idx.push(ni);
            off.push(i);
          }
        }
        if (block) pendingSpace = true;
      };
      walk(target);
      const nodeFirst: number[] = new Array(nodes.length).fill(-1);
      const nodeLast: number[] = new Array(nodes.length).fill(-1);
      for (let i = 0; i < idx.length; i++) {
        const n = idx[i];
        if (n < 0) continue;
        if (nodeFirst[n] < 0) nodeFirst[n] = i;
        nodeLast[n] = i;
      }
      return {
        text: out,
        nodes,
        nodeIdx: Int32Array.from(idx),
        nodeOff: Int32Array.from(off),
        nodeFirst,
        nodeLast,
        sections,
      };
    };
    let docMap = mapDocument();
    const readDocument = () => mapDocument().text;
    let text = docMap.text;
    let words = text ? text.split(" ").length : 0;
    if (!words) {
      toggle.disabled = true;
      toggle.title = T("Nothing", "Nothing to read on this page");
      toggle.classList.add("opacity-50");
      dock.remove();
      continue;
    }

    // ---- the queue: one sentence per utterance ----------------------------
    // Short utterances defeat the engine's long-utterance cutoff, make pause
    // and stop feel immediate, and let rate changes land quickly. One
    // sentence each (v4, 2026-09-24): every utterance's end is an exact,
    // engine-reported moment, so the light re-syncs at every sentence and an
    // estimate can never drift further than one (lib/speech-position.ts).
    const chunkText = sentences;
    let chunks: string[] = chunkText(text);
    // Where each chunk starts in `text` — the bridge from an utterance's
    // charIndex back to a document position (marker, ruler, drying ink).
    const chunkStarts = (src: string, cs: string[]): number[] => {
      const out: number[] = [];
      let cursor = 0;
      for (const c of cs) {
        const at = src.indexOf(c, cursor);
        out.push(at < 0 ? cursor : at);
        cursor = (at < 0 ? cursor : at) + c.length;
      }
      return out;
    };
    let chunkAt: number[] = chunkStarts(text, chunks);

    // ---- voice pick (async: engines populate voices late) ----------------
    // MIS-120(e): docLang is read from the LIVE <html lang>, which Chrome,
    // Edge and Safari rewrite when their own translation runs, so a
    // translated page picks a voice in the language the reader is looking
    // at. The build-time attribute is the fallback.
    const liveLang = () => (document.documentElement.lang || root.dataset.lang || "en").toLowerCase();
    let docLang = liveLang();
    let voice: SpeechSynthesisVoice | null = null;
    const pickVoice = () => {
      const vs = synth.getVoices();
      voice =
        vs.find((v) => v.lang.toLowerCase() === docLang) ??
        vs.find((v) => v.lang.toLowerCase().startsWith(docLang.slice(0, 2))) ??
        null; // engine default is an acceptable fallback
    };
    pickVoice();
    synth.addEventListener?.("voiceschanged", pickVoice);

    // ---- estimate --------------------------------------------------------
    let rate = loadRate();
    queueMicrotask(() => setRateLabel());
    const renderEst = () => {
      const mins = duration(words, rate) / 60;
      est.textContent = mins < 1 ? "· <1 " + T("Min", "min") : "· ~" + Math.round(mins) + " " + T("Min", "min");
    };
    renderEst();

    // ---- state machine: idle → speaking ⇄ paused → idle ------------------
    // `gen` is the queue's epoch. cancel() makes the engine fire the
    // cancelled utterance's end/error asynchronously; without the epoch
    // check those stale events advance or corrupt the NEW queue (QA
    // 2026-08-28: rate change mid-play killed playback after one chunk).
    let state: "idle" | "speaking" | "paused" = "idle";
    let queueIndex = 0;
    let gen = 0;
    let keepalive: number | undefined;
    // Word-level position inside the current chunk (QA 2026-08-28, defect
    // 4). `charOffset` is where the current utterance's text starts inside
    // chunks[queueIndex]; `lastBoundary` is the last word boundary the
    // engine reported, relative to that utterance. Engines that never fire
    // boundary events leave it at 0 and the elapsed-time estimate below
    // takes over (QA 2026-08-28, defect 6). The estimate is deliberately
    // conservative (~85% of nominal pace): repeating a couple of words beats
    // skipping words never heard.
    let charOffset = 0;
    let lastBoundary = 0;
    let utterStart = 0;
    let utterRate = 1;
    const CPS = (WPM * 6) / 60; // chars/sec at 1×: ~5 letters + space per word
    const spokenInUtterance = () => {
      if (lastBoundary > 0) return lastBoundary; // exact, engine-reported
      if (!utterStart) return 0;
      // Engines with no boundary events: walk the utterance by SPOKEN weight
      // — a date or a figure takes what it takes to say, not to write (the
      // light fell behind on numbers, v4). Slightly conservative: repeating
      // a word beats skipping one never heard; the sentence's end re-syncs.
      const elapsed = (performance.now() - utterStart) / 1000;
      const said = (chunks[queueIndex] ?? "").slice(charOffset);
      return charAtSpoken(said, elapsed * CPS * utterRate * 0.94);
    };
    /** Absolute position of the voice in `text`. */
    const position = () => {
      const start = chunkAt[queueIndex] ?? 0;
      const end = start + (chunks[queueIndex]?.length ?? 1) - 1;
      const extra = state === "speaking" ? spokenInUtterance() : 0;
      return Math.min(start + charOffset + extra, end);
    };

    // ---- position persistence (QA 2026-08-28: pause + navigate away lost
    // the position). The chunk index and rate survive the page in
    // sessionStorage, keyed by route + selector. Only an explicit Stop or
    // the document's natural end clears it. chunks.length is stored as a
    // fingerprint: if a deploy re-chunks the text, the stale index is
    // discarded instead of resuming mid-nonsense.
    const storeKey = "sp:" + location.pathname + ":" + (target?.tagName.toLowerCase() ?? "none");
    const saveProgress = () => {
      try {
        sessionStorage.setItem(storeKey, JSON.stringify({ i: queueIndex, o: charOffset, rate, n: chunks.length }));
      } catch {
        /* storage full/blocked: degrade to the old session-only behavior */
      }
    };
    const clearProgress = () => {
      try {
        sessionStorage.removeItem(storeKey);
      } catch {
        /* ignore */
      }
    };
    const setRateLabel = () => {
      rateBtn.textContent = rate + "×";
      rateBtn.dataset.rate = String(rate);
      rateBtn.setAttribute(
        "aria-label",
        T("RateAria", "Playback rate: {rate}x. Press to change").replace("{rate}", String(rate)),
      );
    };
    // Restore a previous position before first render, and the rate with it.
    try {
      const saved = JSON.parse(sessionStorage.getItem(storeKey) ?? "null");
      if (
        saved &&
        saved.n === chunks.length &&
        Number.isInteger(saved.i) &&
        (saved.i > 0 || (Number.isInteger(saved.o) && saved.o > 0)) &&
        saved.i < chunks.length
      ) {
        queueIndex = saved.i;
        if (Number.isInteger(saved.o) && saved.o > 0 && saved.o < chunks[saved.i].length) charOffset = saved.o;
        // The speed is the reader's, not the document's: it comes from
        // localStorage (loadRate), whatever this page last played at.
      } else if (saved) {
        clearProgress(); // stale fingerprint: the text changed under it
      }
    } catch {
      /* unreadable entry: treat as no saved position */
    }

    const stopKeepalive = () => {
      if (keepalive !== undefined) {
        clearInterval(keepalive);
        keepalive = undefined;
      }
    };
    const startKeepalive = () => {
      stopKeepalive();
      // Chrome pauses synthesis on long runs / background tabs; a periodic
      // resume() is the documented workaround.
      keepalive = window.setInterval(() => {
        if (state === "speaking" && synth.paused) synth.resume();
      }, 5000);
    };

    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ---- the text under the voice ---------------------------------------
    const wordAt = (a: number): [number, number] => {
      const s0 = docMap.text;
      let s = Math.max(0, Math.min(a, s0.length - 1));
      while (s > 0 && s0[s - 1] !== " ") s--; // back to the word's start
      while (s < s0.length && s0[s] === " ") s++;
      if (s >= s0.length) return [-1, -1];
      let e = s0.indexOf(" ", s);
      if (e < 0) e = s0.length;
      return [s, e];
    };
    const rangeFor = (s: number, e: number): Range | null => {
      const { nodes, nodeIdx, nodeOff } = docMap;
      let i = s;
      while (i < e && nodeIdx[i] < 0) i++;
      let j = e - 1;
      while (j > i && nodeIdx[j] < 0) j--;
      if (i >= e || nodeIdx[i] < 0 || nodeIdx[j] < 0) return null;
      if (!nodes[nodeIdx[i]]?.isConnected || !nodes[nodeIdx[j]]?.isConnected) return null;
      const r = document.createRange();
      r.setStart(nodes[nodeIdx[i]], nodeOff[i]);
      r.setEnd(nodes[nodeIdx[j]], nodeOff[j] + 1);
      return r;
    };

    // ---- drying ink --------------------------------------------------------
    // What the voice has passed fades to translucent, in three steps so the
    // last words are still drying while the older text has set. CSS Custom
    // Highlight API: ranges painted by the browser, not spans — the text map
    // above and a browser translation are never disturbed. Where the API is
    // missing, the text simply stays as it is.
    const HL = "highlights" in CSS && typeof Highlight === "function";
    // v4 (2026-09-24, the Oracle): ink dries, it does not turn grey. Each
    // ink keeps its own colour — a Verdemar link stays Verdemar, a bold in
    // Arena stays Arena — and only loses brightness: to 90 %, 82 %, then
    // 75 % for text that has set. One highlight per (colour, step), its rule
    // written once. The earlier version painted everything in one muted grey
    // at 50 %, and links stopped looking like links.
    // Readers who ask the system for more contrast get no drying at all.
    const DRY = [0.9, 0.82, 0.75]; // wet · drying · set
    const moreContrast = matchMedia("(prefers-contrast: more)");
    const inkRules = document.createElement("style");
    document.head.appendChild(inkRules);
    const inks = new Map<string, Highlight>();
    const inkOf = new WeakMap<Element, string>();
    const colourKey = (el: Element): string => {
      let k = inkOf.get(el);
      if (k) return k;
      const m = getComputedStyle(el).color.match(/[\d.]+/g) ?? ["196", "181", "166", "1"];
      k = m.slice(0, 3).join("-") + "-" + (m[3] ?? "1");
      inkOf.set(el, k);
      return k;
    };
    const inkFor = (key: string, step: number): Highlight => {
      const name = "sp-ink-" + step + "-" + key.replace(/\./g, "_");
      let h = inks.get(name);
      if (h) return h;
      h = new Highlight();
      inks.set(name, h);
      CSS.highlights.set(name, h);
      const [r, g, b, a] = key.split("-").map(Number);
      inkRules.sheet?.insertRule(
        `::highlight(${name}){color:rgb(${r} ${g} ${b} / ${+(a * DRY[step]).toFixed(3)})}`,
      );
      return h;
    };
    const wordsBack = (at: number, n: number): number => {
      let s = wordAt(at)[0];
      for (let k = 0; k < n && s > 1; k++) s = wordAt(s - 2)[0];
      return Math.max(0, s);
    };
    /** Paint text [s, e) with drying step `step`, node by node, each in its own ink. */
    const paint = (s: number, e: number, step: number) => {
      const { nodes, nodeOff, nodeFirst, nodeLast } = docMap;
      for (let n = 0; n < nodes.length; n++) {
        const f = nodeFirst[n];
        const l = nodeLast[n];
        if (f < 0 || l < s || f >= e) continue;
        const node = nodes[n];
        if (!node.isConnected || !node.parentElement) continue;
        let a = Math.max(s, f);
        let z = Math.min(e - 1, l);
        while (a <= z && docMap.nodeIdx[a] !== n) a++;
        while (z >= a && docMap.nodeIdx[z] !== n) z--;
        if (a > z) continue;
        const r = document.createRange();
        r.setStart(node, nodeOff[a]);
        r.setEnd(node, nodeOff[z] + 1);
        inkFor(colourKey(node.parentElement), step).add(r);
      }
    };
    const dry = (at: number) => {
      if (!HL) return;
      for (const h of inks.values()) h.clear();
      if (at <= 0 || state === "idle" || moreContrast.matches) return;
      const now = wordAt(at)[0];
      const wetFrom = wordsBack(at, 3);
      const midFrom = wordsBack(at, 9);
      paint(0, midFrom, 2);
      paint(midFrom, wetFrom, 1);
      paint(wetFrom, now, 0);
    };

    // ---- reading marker ----------------------------------------
    // A small diffuse light drifts above the word being spoken and leaves a
    // long, soft trail behind it. It rests where the voice rests — the
    // engine pauses at punctuation, so the light does too — and it glides:
    // every frame it moves toward its target on a critically damped spring
    // (arrives soft, never overshoots), and the target itself slides along
    // the word as the voice goes through it. The Oracle asked for wind, not
    // a mouse. Under prefers-reduced-motion the light still moves, but
    // jumps: no trail, no spring, no bob.
    const TRAIL = reducedMotion ? 1 : 12;
    let marker: HTMLElement | null = null;
    let dots: HTMLElement[] = [];
    let curWord = -1;
    let wordT0 = 0;
    let wordDur = 300;
    let curRange: Range | null = null;
    let lastScroll = 0;
    let raf = 0;
    let lastFrame = 0;
    let hx = 0;
    let hy = 0;
    let vx = 0;
    let vy = 0;
    let placed = false;
    const hist: [number, number][] = [];
    const ensureMarker = () => {
      if (marker) return;
      marker = document.createElement("div");
      marker.className = "sp-marker";
      marker.setAttribute("aria-hidden", "true");
      dots = [];
      for (let i = TRAIL - 1; i >= 0; i--) {
        const d = document.createElement("i");
        d.style.setProperty("--i", String(i));
        marker.appendChild(d);
        dots[i] = d;
      }
      document.body.appendChild(marker);
    };
    const dropMarker = () => {
      marker?.remove();
      marker = null;
      dots = [];
      curWord = -1;
      curRange = null;
      placed = false;
      hist.length = 0;
    };
    // Document coordinates of a viewport point. body positioned → relative
    // to body; static → relative to the initial containing block.
    const origin = () => {
      const b = document.body;
      if (getComputedStyle(b).position === "static") return { x: -scrollX, y: -scrollY };
      const bb = b.getBoundingClientRect();
      return { x: bb.left, y: bb.top };
    };
    const markerTarget = (): { x: number; y: number } | null => {
      if (!curRange) return null;
      const rects = curRange.getClientRects();
      const r = rects.length ? rects[0] : curRange.getBoundingClientRect();
      if (!r.width && !r.height) return null;
      const o = origin();
      const f = state === "speaking" ? Math.min(1, (performance.now() - wordT0) / Math.max(120, wordDur)) : 0.5;
      return { x: r.left + r.width * (0.15 + 0.7 * f) - o.x, y: r.top - 5 - o.y };
    };
    const setWord = (s: number, e: number) => {
      curWord = s;
      curRange = rangeFor(s, e);
      wordT0 = performance.now();
      wordDur = ((spokenWeight(docMap.text.slice(s, e)) + 1) / (CPS * rate)) * 1000;
      dry(s);
    };
    const frame = (now: number) => {
      raf = 0;
      if (state === "idle" || !marker) return;
      const dt = Math.min(0.05, lastFrame ? (now - lastFrame) / 1000 : 0.016);
      lastFrame = now;
      if (state === "speaking") {
        const [s, e] = wordAt(position());
        if (s >= 0 && s !== curWord) {
          setWord(s, e);
          renderPosition();
          if (follow) keepInView();
        }
      }
      const tg = markerTarget();
      if (tg) {
        if (!placed || reducedMotion || Math.abs(tg.y - hy) > 220) {
          // First placement, reduced motion, or a jump (a seek, a resize):
          // appear there instead of crossing the page.
          hx = tg.x;
          hy = tg.y;
          vx = vy = 0;
          placed = true;
          hist.length = 0;
        } else {
          const k = 90;
          const c = 2 * Math.sqrt(k); // critical damping
          vx += (k * (tg.x - hx) - c * vx) * dt;
          vy += (k * (tg.y - hy) - c * vy) * dt;
          hx += vx * dt;
          hy += vy * dt;
        }
      }
      const bob = reducedMotion || state !== "speaking" ? 0 : Math.sin(now / (900 / rate)) * 1.2;
      hist.unshift([hx, hy + bob]);
      if (hist.length > TRAIL * 3) hist.length = TRAIL * 3;
      for (let i = 0; i < dots.length; i++) {
        const p = hist[Math.min(hist.length - 1, i * 3)];
        if (p) dots[i].style.transform = `translate(${p[0].toFixed(1)}px,${p[1].toFixed(1)}px)`;
      }
      raf = requestAnimationFrame(frame);
    };
    const markerSync = () => {
      if (state === "idle") {
        marker?.classList.remove("is-on");
        return;
      }
      ensureMarker();
      marker!.classList.add("is-on");
      marker!.classList.toggle("is-paused", state === "paused");
      if (!raf) {
        lastFrame = 0;
        raf = requestAnimationFrame(frame);
      }
    };

    // ---- following the voice, and letting go ------------------------------
    // The page follows the voice until the reader scrolls. Then it lets go:
    // the voice keeps speaking and "Back to the reading" appears above the
    // dock, its arrow pointing where the voice is. Reaching the word again
    // by hand — or pressing that button — resumes the following.
    let follow = true;
    let programmatic = 0;
    const band = (): [number, number] => {
      const nav = document.querySelector("nav")?.getBoundingClientRect().height ?? 56;
      const dockH = dock.classList.contains("is-on") ? dock.getBoundingClientRect().height + 40 : 40;
      return [nav + 24, innerHeight - dockH];
    };
    const keepInView = (force = false) => {
      if (!curRange) return;
      const r = curRange.getBoundingClientRect();
      const [top, bottom] = band();
      const now = performance.now();
      if (force || ((r.top < top || r.bottom > bottom) && now - lastScroll > 1000)) {
        lastScroll = now;
        programmatic = now;
        scrollTo({ top: r.top + scrollY - top - (bottom - top) * 0.28, behavior: reducedMotion ? "auto" : "smooth" });
      }
    };
    const updateLost = () => {
      if (state === "idle" || !curRange) {
        document.body.classList.remove("sp-lost");
        return;
      }
      const r = curRange.getBoundingClientRect();
      const [top, bottom] = band();
      const visible = r.bottom > top && r.top < bottom;
      // Re-arm only once the reading had been lost and the reader brought it
      // back. While a swipe is still starting, the word is on screen; re-arming
      // then would drag the page back under the reader's finger.
      if (visible && !follow && document.body.classList.contains("sp-lost")) follow = true;
      document.body.classList.toggle("sp-lost", !follow && !visible);
      backBtn.classList.toggle("is-up", r.top < top);
    };
    const takeOver = (e: Event) => {
      if (state === "idle") return;
      if ((e.target as Element | null)?.closest?.(".sp-dock")) return;
      follow = false;
      setTimeout(updateLost, 80);
    };
    addEventListener("wheel", takeOver, { passive: true });
    addEventListener("touchmove", takeOver, { passive: true });
    addEventListener("keydown", (e) => {
      const keys = ["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "];
      const el = e.target as Element | null;
      if (keys.includes(e.key) && !el?.closest?.("button,input,textarea,select,[role=slider]")) takeOver(e);
    });
    addEventListener(
      "scroll",
      () => {
        if (!follow || performance.now() - programmatic > 900) updateLost();
      },
      { passive: true },
    );
    backBtn.addEventListener("click", () => {
      follow = true;
      document.body.classList.remove("sp-lost");
      keepInView(true);
    });

    // ---- the ruler ----------------------------------------------------------
    // A print ruler, not a loading bar: a hairline, a fine mark every few
    // pixels, a longer mark where each section starts. The heard part is
    // printed in halftone (CSS); the head is the same light as the marker.
    const drawRuler = () => {
      const w = ruler.clientWidth;
      const h = ruler.clientHeight;
      if (!w) return;
      const ns = "http://www.w3.org/2000/svg";
      ticks.replaceChildren();
      const line = (x1: number, y1: number, x2: number, y2: number, cls: string) => {
        const l = document.createElementNS(ns, "line");
        l.setAttribute("x1", String(x1));
        l.setAttribute("y1", String(y1));
        l.setAttribute("x2", String(x2));
        l.setAttribute("y2", String(y2));
        l.setAttribute("class", cls);
        ticks.appendChild(l);
      };
      const mid = Math.round(h / 2) + 0.5;
      line(0, mid, w, mid, "sp-hair");
      const step = Math.max(6, w / 90);
      for (let x = 0; x <= w; x += step) {
        const px = Math.round(x) + 0.5;
        line(px, mid - 2.5, px, mid + 2.5, "sp-mm");
      }
      const len = Math.max(1, text.length - 1);
      for (const s of docMap.sections.slice(1)) {
        const px = Math.round((s.at / len) * w) + 0.5;
        line(px, mid - 7, px, mid + 7, "sp-mark");
      }
    };
    const fromX = (clientX: number) => {
      const r = ruler.getBoundingClientRect();
      const f = Math.min(1, Math.max(0, (clientX - r.left) / r.width));
      return Math.round(f * (text.length - 1));
    };
    const setBar = (at: number) => {
      ruler.style.setProperty("--p", String(at / Math.max(1, text.length - 1)));
    };
    const showPeek = (at: number, clientX: number) => {
      const s = sentenceStart(text, at);
      const sec = sectionAt(docMap.sections, s);
      const when = clock((s / Math.max(1, text.length - 1)) * duration(words, rate));
      peek.querySelector("b")!.textContent = when + (sec.title ? " · " + sec.title : "");
      const snippet = text.slice(s, s + 64);
      const cut = snippet.lastIndexOf(" ");
      peek.querySelector("span")!.textContent = (cut > 20 ? snippet.slice(0, cut) : snippet) + "…";
      const r = ruler.getBoundingClientRect();
      const half = (peek.offsetWidth || 220) / 2;
      const x = Math.min(Math.max(clientX - r.left, half - r.left + 10), innerWidth - 10 - half - r.left);
      peek.style.left = x + "px";
      ruler.classList.add("is-peek");
    };
    let drag: number | null = null;
    ruler.addEventListener("pointermove", (e) => {
      if (e.pointerType === "mouse" || drag !== null) showPeek(fromX(e.clientX), e.clientX);
      if (drag !== null) {
        drag = fromX(e.clientX);
        setBar(drag);
      }
    });
    ruler.addEventListener("pointerleave", () => {
      if (drag === null) ruler.classList.remove("is-peek");
    });
    ruler.addEventListener("pointerdown", (e) => {
      ruler.setPointerCapture(e.pointerId);
      ruler.classList.add("is-drag");
      drag = fromX(e.clientX);
      setBar(drag);
      showPeek(drag, e.clientX);
    });
    ruler.addEventListener("pointerup", () => {
      if (drag === null) return;
      ruler.classList.remove("is-drag", "is-peek");
      const at = drag;
      drag = null;
      seek(at);
    });
    ruler.addEventListener("pointercancel", () => {
      drag = null;
      ruler.classList.remove("is-drag", "is-peek");
      renderPosition();
    });
    ruler.addEventListener("keydown", (e) => {
      const here = sentenceStart(text, position());
      if (e.key === "ArrowRight") {
        e.preventDefault();
        const m = /[.!?…] /.exec(text.slice(here));
        if (m) seek(here + m.index + 2);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        seek(here > 1 ? sentenceStart(text, here - 2) : 0);
      } else if (e.key === "Home") {
        e.preventDefault();
        seek(0);
      }
    });
    const seek = (at: number) => {
      const s = sentenceStart(text, at);
      const { index, offset } = locate(chunkAt, s);
      follow = true;
      document.body.classList.remove("sp-lost");
      curWord = -1;
      if (state === "speaking") {
        gen++;
        synth.cancel();
        speakFrom(index, offset);
        return;
      }
      queueIndex = index;
      charOffset = offset;
      lastBoundary = 0;
      saveProgress();
      if (state === "idle") return start();
      // Paused: move the reading there and stay paused.
      const [ws, we] = wordAt(position());
      if (ws >= 0) setWord(ws, we);
      keepInView(true);
      render();
    };

    // ---- rendering --------------------------------------------------------
    let lastSec = -1;
    const renderPosition = () => {
      const at = position();
      const len = Math.max(1, text.length - 1);
      const total = duration(words, rate);
      if (drag === null) setBar(at);
      const now = clock((at / len) * total);
      const all = clock(total);
      timeEl.textContent = now + " / " + all;
      ruler.setAttribute("aria-valuenow", String(Math.round((at / len) * 100)));
      ruler.setAttribute("aria-valuetext", T("PositionText", "{at} of {total}").replace("{at}", now).replace("{total}", all));
      const sec = sectionAt(docMap.sections, at);
      if (sec.index !== lastSec) {
        lastSec = sec.index;
        secEl.textContent = sec.title;
      }
    };
    const render = () => {
      markerSync();
      const on = state !== "idle";
      // Idle with a saved position (restored from a previous visit) is
      // presented as Resume: the reader left mid-document and comes back.
      const resumable = state === "paused" || (state === "idle" && (queueIndex > 0 || charOffset > 0));
      toggle.setAttribute("aria-pressed", String(state === "speaking"));
      icon.textContent = state === "speaking" ? "❚❚" : "▶";
      label.textContent =
        state === "speaking" ? T("Pause", "Pause") : resumable ? T("Resume", "Resume") : T("Listen", "Listen");
      toggle.setAttribute(
        "aria-label",
        state === "speaking"
          ? T("PauseAria", "Pause listening")
          : resumable
            ? T("ResumeAria", "Resume listening")
            : T("ListenAria", "Listen to this document"),
      );
      est.hidden = on;
      playBtn.classList.toggle("is-playing", state === "speaking");
      playBtn.setAttribute(
        "aria-label",
        state === "speaking" ? T("PauseAria", "Pause listening") : T("ResumeAria", "Resume listening"),
      );
      const wasOn = dock.classList.contains("is-on");
      dock.classList.toggle("is-on", on);
      document.body.classList.toggle("sp-on", on);
      if (on && !wasOn) requestAnimationFrame(drawRuler);
      document.body.style.paddingBottom = on ? dock.getBoundingClientRect().height + 34 + "px" : "";
      if (!on) {
        document.body.classList.remove("sp-lost");
        dry(0);
      }
      renderPosition();
    };
    const say = (msg: string) => {
      live.textContent = msg;
    };

    const speakFrom = (i: number, offset = 0) => {
      if (i >= chunks.length) {
        // Natural end: also release the keepalive (QA: it leaked here and
        // stacked a second interval on the next play). The document is
        // finished — the saved position dies with it.
        state = "idle";
        queueIndex = 0;
        charOffset = 0;
        clearProgress();
        stopKeepalive();
        render();
        say(T("Stopped", "Stopped"));
        return;
      }
      queueIndex = i;
      // Snap the offset back to a word boundary so the utterance never
      // starts mid-word; a broken offset degrades to the chunk start.
      charOffset = offset > 0 && offset < chunks[i].length - 1 ? chunks[i].lastIndexOf(" ", offset) + 1 : 0;
      lastBoundary = 0;
      saveProgress();
      const g = gen;
      const u = new SpeechSynthesisUtterance(chunks[i].slice(charOffset));
      if (voice) u.voice = voice;
      u.lang = voice?.lang ?? docLang;
      u.rate = rate;
      utterStart = performance.now();
      utterRate = rate;
      u.onstart = () => {
        // Engines queue; the clock starts when sound actually starts.
        if (g === gen) utterStart = performance.now();
      };
      u.onboundary = (e) => {
        if (g === gen && typeof e.charIndex === "number" && e.charIndex > 0) lastBoundary = e.charIndex;
      };
      u.onend = () => {
        if (g !== gen) return; // stale: a cancel() superseded this queue
        if (state === "speaking") speakFrom(queueIndex + 1);
      };
      u.onerror = (e) => {
        if (g !== gen) return; // stale
        // Our own cancel() surfaces here as interrupted/canceled — not an
        // error. Anything else (voice vanished, engine died): stop cleanly
        // rather than leaving a button that lies about its state.
        if (e.error === "interrupted" || e.error === "canceled") return;
        state = "idle";
        stopKeepalive();
        render();
      };
      synth.speak(u);
    };

    const start = () => {
      // MIS-120(e): re-read the document before speaking. If the reader ran
      // the browser's translation since the page loaded, the DOM now holds
      // their language. Re-chunking invalidates any saved position, so a
      // language change restarts the document.
      const freshMap = mapDocument();
      const fresh = freshMap.text;
      docMap = freshMap; // nodes may have been replaced in place (translation)
      if (fresh && fresh !== text) {
        text = fresh;
        words = text.split(" ").length;
        chunks = chunkText(text);
        chunkAt = chunkStarts(text, chunks);
        queueIndex = 0;
        charOffset = 0;
        lastBoundary = 0;
        clearProgress();
        renderEst();
      }
      const nowLang = liveLang();
      if (nowLang !== docLang) {
        docLang = nowLang;
        pickVoice();
      }
      gen++;
      synth.cancel(); // never stack on a previous run
      state = "speaking";
      follow = true;
      curWord = -1;
      render();
      startKeepalive();
      speakFrom(queueIndex, charOffset); // honor a restored mid-chunk position
      say(T("Reading", "Reading"));
    };

    // Pause is OURS, not the engine's. speechSynthesis.pause()/resume() is
    // unreliable across engines: Chrome drops a paused queue after ~15s,
    // Android ignores pause mid-utterance, and Linux speech-dispatcher
    // (Firefox) can end the utterance on pause so a later resume() resumes
    // nothing (QA 2026-08-28). So pausing cancels the engine outright; the
    // position lives in queueIndex + charOffset, which we own. It is frozen
    // BEFORE cancel() — the engine's boundary counter dies with the
    // utterance.
    const pause = () => {
      charOffset = charOffset + spokenInUtterance();
      state = "paused";
      lastBoundary = 0;
      gen++; // stale-out the cancelled utterance's end/error events
      synth.cancel();
      saveProgress();
      stopKeepalive();
      render();
      say(T("Paused", "Paused"));
    };
    const resume = () => {
      // MIS-120(e): unless the document changed language under us while
      // paused — then start() re-reads, re-chunks and begins afresh.
      if (readDocument() !== text) return start();
      state = "speaking";
      follow = true;
      render();
      startKeepalive();
      speakFrom(queueIndex, charOffset);
      say(T("Reading", "Reading"));
    };
    const stopAll = () => {
      gen++;
      state = "idle";
      queueIndex = 0;
      charOffset = 0;
      lastBoundary = 0;
      clearProgress(); // Stop is the reader saying "from the top next time"
      stopKeepalive();
      synth.cancel();
      render();
      say(T("Stopped", "Stopped"));
    };
    const toggleRun = () => {
      if (state === "idle") return start();
      if (state === "speaking") return pause();
      return resume();
    };

    // Page teardown is NOT Stop: the voice must not outlive the page, but
    // the position must (QA 2026-08-28 — pause, browse away, come back,
    // resume where you left off).
    const teardown = () => {
      if (state === "speaking") charOffset = charOffset + spokenInUtterance();
      if (state !== "idle" || queueIndex > 0 || charOffset > 0) saveProgress();
      gen++;
      stopKeepalive();
      synth.cancel();
      state = "idle";
      dropMarker();
      dry(0);
      dock.remove();
      document.body.classList.remove("sp-lost", "sp-on");
      document.body.style.paddingBottom = "";
    };

    // ---- touch a sentence to hear it (v4) ----------------------------------
    // While the player is on, a click (or tap) on the text starts the voice
    // at the head of that sentence. Links, buttons and a text selection keep
    // their own meaning: selecting to copy is never hijacked.
    const indexAt = (node: Node, offset: number): number => {
      const n = docMap.nodes.indexOf(node as Text);
      if (n < 0) return -1;
      for (let i = docMap.nodeFirst[n]; i >= 0 && i <= docMap.nodeLast[n]; i++)
        if (docMap.nodeIdx[i] === n && docMap.nodeOff[i] >= offset) return i;
      return docMap.nodeLast[n];
    };
    target?.addEventListener("click", (e) => {
      if (state === "idle") return;
      const el = e.target as Element;
      if (el.closest("a,button,input,textarea,select,summary,label,[role=button],.doc-toolbar")) return;
      if (String(getSelection() ?? "").trim()) return;
      const doc = document as Document & {
        caretPositionFromPoint?: (x: number, y: number) => { offsetNode: Node; offset: number } | null;
      };
      let node: Node | null = null;
      let off = 0;
      if (doc.caretPositionFromPoint) {
        const c = doc.caretPositionFromPoint(e.clientX, e.clientY);
        if (c) [node, off] = [c.offsetNode, c.offset];
      } else if (document.caretRangeFromPoint) {
        const c = document.caretRangeFromPoint(e.clientX, e.clientY);
        if (c) [node, off] = [c.startContainer, c.startOffset];
      }
      if (!node || node.nodeType !== Node.TEXT_NODE) return;
      const at = indexAt(node, off);
      if (at >= 0) seek(at);
    });

    toggle.addEventListener("click", toggleRun);
    playBtn.addEventListener("click", toggleRun);
    stopBtn.addEventListener("click", stopAll);

    rateBtn.addEventListener("click", () => {
      rate = nextRate(rate);
      storeRate(rate);
      setRateLabel();
      renderEst();
      // Apply mid-run, keeping the word position — the reading continues
      // where it was, only faster or slower (QA 2026-08-28, defect 6).
      if (state === "speaking") {
        gen++;
        charOffset = charOffset + spokenInUtterance();
        lastBoundary = 0;
        synth.cancel();
        speakFrom(queueIndex, charOffset);
      } else if (queueIndex > 0 || charOffset > 0) {
        saveProgress(); // keep the stored rate in step with the position
      }
      renderPosition();
    });

    // Layout can move under the reading (resize, fonts, a rotated phone):
    // redraw the ruler; the marker re-reads its range every frame.
    addEventListener("resize", () => {
      if (state !== "idle") drawRuler();
    });

    addEventListener("beforeunload", teardown);
    document.addEventListener("astro:before-swap", teardown);

    render(); // reflect a restored position (Resume) on first paint
  }
</script>

<style is:global>
  /* ---- drying ink: rules are written by the script, one per ink colour
     and drying step (each ink keeps its colour, only loses brightness). */

  /* While the voice is on, the text is a place you can touch to hear. */
  .sp-on :is(p, li, blockquote, td, dd, h2, h3, h4) {
    cursor: pointer;
  }
  .sp-on :is(a, button) {
    cursor: pointer;
  }

  /* ---- reading marker: a diffuse light in Arena, with a trail --------- */
  .sp-marker {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    z-index: 45;
    opacity: 0;
    transition: opacity 600ms ease;
  }
  .sp-marker.is-on {
    opacity: 1;
  }
  .sp-marker.is-paused {
    opacity: 0.45;
  }
  .sp-marker > i {
    --d: calc(14px - var(--i) * 0.55px);
    position: absolute;
    left: calc(var(--d) / -2);
    top: calc(var(--d) / -2);
    width: var(--d);
    height: var(--d);
    border-radius: 50%;
    opacity: calc(0.7 - var(--i) * 0.045);
    background: radial-gradient(circle, rgb(var(--text) / 0.55) 0, rgb(var(--text) / 0.22) 38%, transparent 70%);
    will-change: transform;
  }
