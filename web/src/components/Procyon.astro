---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// Procyon, the archive's host, as a chat bubble (experiment, October 2026).
// Bottom left, so it never covers the compass (Wayfinder, bottom right) or
// the reading dock (SpeechPlayer, bottom centre, above this). A visitor asks;
// /api/procyon (web/worker/index.mjs) answers in two or three sentences with
// links to pages that exist — the Worker strips any other — and this script
// draws them as text and anchors, never as HTML.
//
// Memory: the conversation lives in this tab's sessionStorage so it survives
// following a link; closing the tab forgets it. Nothing is stored anywhere else.
import Icon from "@/components/Icon.astro";
---

<div class="procyon" data-procyon>
  <button type="button" class="pc-open" data-pc-open aria-expanded="false" aria-controls="procyon-panel">
    <Icon name="sparkle" size={18} />
    <span>Ask Procyon</span>
  </button>

  <section id="procyon-panel" class="pc-panel" data-pc-panel hidden aria-label="Procyon, the archive's guide">
    <header class="pc-head">
      <div>
        <p class="pc-name"><Icon name="sparkle" size={14} /> Procyon</p>
        <p class="pc-sub">The archive's guide · experiment</p>
      </div>
      <button type="button" class="pc-close" data-pc-close aria-label="Close the chat"><Icon name="x" size={16} /></button>
    </header>

    <div class="pc-log" data-pc-log aria-live="polite">
      <p class="pc-msg pc-bot">Hello, I am Procyon, a digital agent: an artificial intelligence, not a person. Ask me anything about Numinia or this archive, in any language, and I will point you to the pages that answer it.</p>
    </div>

    <form class="pc-form" data-pc-form>
      <label class="sr-only" for="pc-input">Your question</label>
      <textarea id="pc-input" data-pc-input rows="2" maxlength="800" placeholder="What is Numinia?" required></textarea>
      <button type="submit" class="pc-send" data-pc-send>Ask</button>
    </form>
    <p class="pc-note">A free AI model: it can be wrong, so read the page it links. Nothing you write is kept. <button type="button" class="pc-reset" data-pc-reset>New chat</button></p>
  </section>
</div>

<script>
  type Msg = { role: "user" | "assistant"; content: string };
  const KEY = "numinia-procyon";
  const ORIGIN = "https://numinia.org";
  const MAX_KEEP = 12;

  const root = document.querySelector<HTMLElement>("[data-procyon]");
  if (root) {
    const open = root.querySelector<HTMLButtonElement>("[data-pc-open]")!;
    const panel = root.querySelector<HTMLElement>("[data-pc-panel]")!;
    const close = root.querySelector<HTMLButtonElement>("[data-pc-close]")!;
    const log = root.querySelector<HTMLElement>("[data-pc-log]")!;
    const form = root.querySelector<HTMLFormElement>("[data-pc-form]")!;
    const input = root.querySelector<HTMLTextAreaElement>("[data-pc-input]")!;
    const send = root.querySelector<HTMLButtonElement>("[data-pc-send]")!;
    const reset = root.querySelector<HTMLButtonElement>("[data-pc-reset]")!;
    const greeting = log.firstElementChild?.cloneNode(true);

    let history: Msg[] = [];
    try { history = JSON.parse(sessionStorage.getItem(KEY) || "[]"); } catch { history = []; }
    const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(history.slice(-MAX_KEEP))); } catch {} };

    // A reply is plain text with [label](https://numinia.org/...) links.
    // Build nodes by hand: text stays text, and only numinia.org links become anchors.
    function render(text: string, into: HTMLElement) {
      for (const para of text.split(/\n{2,}/)) {
        const p = document.createElement("p");
        let i = 0;
        const s = para.replaceAll("**", "");
        while (i < s.length) {
          const a = s.indexOf("[", i);
          const mid = a === -1 ? -1 : s.indexOf("](", a);
          const end = mid === -1 ? -1 : s.indexOf(")", mid + 2);
          if (a === -1 || mid === -1 || end === -1) { p.append(s.slice(i)); break; }
          p.append(s.slice(i, a));
          const label = s.slice(a + 1, mid);
          const href = s.slice(mid + 2, end).trim();
          if (href.startsWith(ORIGIN + "/") || href === ORIGIN) {
            const link = document.createElement("a");
            link.href = href.slice(ORIGIN.length) || "/";
            link.textContent = label;
            p.append(link);
          } else p.append(label);
          i = end + 1;
        }
        into.append(p);
      }
    }

    function bubble(m: Msg) {
      const div = document.createElement("div");
      div.className = `pc-msg ${m.role === "user" ? "pc-me" : "pc-bot"}`;
      if (m.role === "user") div.textContent = m.content;
      else render(m.content, div);
      log.append(div);
      log.scrollTop = log.scrollHeight;
      return div;
    }

    function redraw() {
      log.replaceChildren();
      if (greeting) log.append(greeting.cloneNode(true));
      history.forEach(bubble);
    }

    function setOpen(on: boolean) {
      panel.hidden = !on;
      open.hidden = on;
      open.setAttribute("aria-expanded", String(on));
      try { sessionStorage.setItem(KEY + "-open", on ? "1" : ""); } catch {}
      if (on) { redraw(); input.focus({ preventScroll: true }); }
      else open.focus({ preventScroll: true });
    }

    open.addEventListener("click", () => setOpen(true));
    close.addEventListener("click", () => setOpen(false));
    panel.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
    reset.addEventListener("click", () => { history = []; save(); redraw(); input.focus(); });
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
    });

    const SORRY: Record<string, string> = {
      too_many: "That is a lot of questions in a minute. Give me a moment and ask again.",
      busy: "Several people are asking right now. Try again in a few seconds.",
      default: "I could not answer just now. Try again in a moment, or write to hola@numengames.com, where a person answers.",
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q || send.disabled) return;
      history.push({ role: "user", content: q });
      save();
      bubble(history[history.length - 1]);
      input.value = "";
      send.disabled = true;
      const wait = bubble({ role: "assistant", content: "…" });
      wait.classList.add("pc-wait");
      try {
        const r = await fetch("/api/procyon", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ messages: history.slice(-MAX_KEEP), page: location.pathname }),
        });
        const data = await r.json().catch(() => ({}));
        wait.remove();
        if (r.ok && data.reply) {
          history.push({ role: "assistant", content: data.reply });
          save();
          bubble(history[history.length - 1]);
        } else {
          history.pop();
          save();
          const note = bubble({ role: "assistant", content: SORRY[data.error] || SORRY.default });
          note.classList.add("pc-err");
          input.value = q;
        }
      } catch {
        wait.remove();
        history.pop();
        save();
        bubble({ role: "assistant", content: SORRY.default }).classList.add("pc-err");
        input.value = q;
      } finally {
        send.disabled = false;
        input.focus({ preventScroll: true });
      }
    });

    try { if (sessionStorage.getItem(KEY + "-open")) setOpen(true); } catch {}
  }
</script>

<style>
  .procyon { position: fixed; left: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 50; }
  .pc-open {
    display: inline-flex; align-items: center; gap: 0.5rem;
    border-radius: 9999px; border: 1px solid rgb(var(--border) / 0.7);
    background: rgb(var(--bg-card) / 0.75); backdrop-filter: blur(12px);
    color: rgb(var(--foreground)); padding: 0.6rem 1rem;
    font: 600 0.72rem/1 var(--font-mono, ui-monospace, monospace);
    text-transform: uppercase; letter-spacing: 0.12em;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14); cursor: pointer;
  }
  .pc-open:hover, .pc-open:focus-visible { border-color: rgb(var(--accent)); color: rgb(var(--accent)); }
  .pc-open[hidden] { display: none; }

  .pc-panel {
    width: min(380px, calc(100vw - 32px));
    max-height: min(560px, calc(100dvh - 96px));
    display: flex; flex-direction: column;
    border-radius: 8px; border: 1px solid rgb(var(--border) / 0.8);
    background: rgb(var(--bg-card) / 0.92); backdrop-filter: blur(16px);
    color: rgb(var(--foreground));
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22);
  }
  .pc-panel[hidden] { display: none; }
  .pc-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 0.85rem 1rem 0.6rem; border-bottom: 1px solid rgb(var(--border) / 0.6); }
  .pc-name { display: flex; align-items: center; gap: 0.4rem; font-weight: 600; font-size: 0.95rem; color: rgb(var(--accent)); }
  .pc-sub { font: 0.68rem/1.4 var(--font-mono, ui-monospace, monospace); text-transform: uppercase; letter-spacing: 0.1em; color: rgb(var(--muted-foreground)); }
  .pc-close { border-radius: 9999px; padding: 0.35rem; color: rgb(var(--muted-foreground)); }
  .pc-close:hover, .pc-close:focus-visible { color: rgb(var(--accent)); }

  .pc-log { flex: 1; overflow-y: auto; padding: 0.85rem 1rem; display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.9rem; line-height: 1.5; }
  .pc-msg { max-width: 92%; border-radius: 8px; padding: 0.55rem 0.75rem; }
  .pc-msg :global(p + p) { margin-top: 0.5rem; }
  .pc-msg :global(a) { color: rgb(var(--accent)); text-decoration: underline; text-underline-offset: 2px; }
  .pc-bot { align-self: flex-start; background: rgb(var(--muted) / 0.55); }
  .pc-me { align-self: flex-end; background: rgb(var(--accent) / 0.14); white-space: pre-wrap; }
  .pc-wait { color: rgb(var(--muted-foreground)); animation: pc-pulse 1.2s ease-in-out infinite; }
  .pc-err { color: rgb(var(--muted-foreground)); font-style: italic; }
  @keyframes pc-pulse { 50% { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) { .pc-wait { animation: none; } }

  .pc-form { display: flex; gap: 0.5rem; align-items: flex-end; padding: 0.6rem 1rem 0.4rem; border-top: 1px solid rgb(var(--border) / 0.6); }
  .pc-form textarea {
    flex: 1; resize: none; border-radius: 6px; border: 1px solid rgb(var(--border));
    background: rgb(var(--background) / 0.6); color: rgb(var(--foreground));
    padding: 0.5rem 0.6rem; font: inherit; font-size: 0.9rem;
  }
  .pc-form textarea:focus-visible { outline: 2px solid rgb(var(--accent)); outline-offset: 1px; }
  .pc-send {
    border-radius: 6px; border: 1px solid rgb(var(--accent)); color: rgb(var(--accent));
    padding: 0.5rem 0.85rem; font: 600 0.72rem/1 var(--font-mono, ui-monospace, monospace);
    text-transform: uppercase; letter-spacing: 0.12em;
  }
  .pc-send:disabled { opacity: 0.5; cursor: progress; }
  .pc-note { padding: 0 1rem 0.75rem; font-size: 0.7rem; line-height: 1.4; color: rgb(var(--muted-foreground)); }
  .pc-reset { text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 40rem) {
    .procyon { left: 10px; bottom: calc(10px + env(safe-area-inset-bottom)); }
    .pc-panel { width: calc(100vw - 20px); max-height: calc(100dvh - 80px); }
  }
  @media print { .procyon { display: none; } }
</style>
